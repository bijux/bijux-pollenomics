def main() -> None:
    target = SOURCE / "preflight/artificial-metadata-controls"
    require(not target.exists(), "Fresh controlled output required")
    target.mkdir()
    count = 0
    try:
        docs, refs, requirement = fixture()
        result = evaluate(docs, refs, requirement)
        assert (
            result["observed_population_software_no_pollen_semantics_leakage_supported"]
            is True
        )
        assert (
            result["whole_ADNA_001_closed"] is False
            and result["saved_population_observation"][
                "individual_current_v2_population_reproduced"
            ]
            is False
        )
        assert (
            result["current_human_execution"]["country_summaries"][0][
                "duplicate_support_counts"
            ]["ids_with_hull_gaps"]
            == 1
        )
        count += 1
        for name, key, value in [
            ("raw_inner", "actual_exit", True),
            ("raw_outer", "child_native_exit", 1),
            ("raw_producer", "numerical_import_attempts", ["engine"]),
            ("saved_common", "actual_exit", False),
            ("saved_review", "original_whole_actual_exit", 0),
            ("saved_review", "current_default_v2_population_reproduced", True),
            ("saved_review", "exact_whole_requirement_adjudicated", True),
        ]:
            changed = deepcopy(docs)
            changed[name][key] = value
            refuses(partial(evaluate, changed, refs, requirement))
            count += 1
        for field in ("sha256", "bytes"):
            changed = deepcopy(docs)
            changed["saved_plan"]["declared_inputs"]["files"][0][field] = (
                "b" * 64 if field == "sha256" else 2
            )
            refuses(
                partial(
                    joined_legacy_inputs, changed["raw_plan"], changed["saved_plan"]
                )
            )
            count += 1
        changed = deepcopy(docs)
        changed["saved_plan"]["input_pins"][0]["sha256"] = "b" * 64
        refuses(partial(evaluate, changed, refs, requirement))
        count += 1
        changed = deepcopy(docs)
        changed["raw_plan"]["declared_inputs"].append(
            deepcopy(changed["raw_plan"]["declared_inputs"][0])
        )
        refuses(partial(evaluate, changed, refs, requirement))
        count += 1
        changed = deepcopy(docs)
        changed["raw_inner"]["stages"][0]["argv"] = ["wrong"]
        refuses(partial(qualify_raw, changed, refs))
        count += 1
        changed = deepcopy(docs)
        changed["saved_common"]["stages"][0]["must_succeed"] = 1
        refuses(partial(qualify_saved, changed, refs))
        count += 1
        for key in ("pollen_measurement_field_leakage", "pollen_eligibility_promoted"):
            changed = deepcopy(docs)
            changed["saved_review"]["complete_saved_scientific_joins"][key] = True
            refuses(partial(evaluate, changed, refs, requirement))
            count += 1
        changed = deepcopy(docs)
        changed["saved_review"]["source_contracts"]["owned_current_extensions"] = [
            "pollen_count"
        ]
        refuses(partial(evaluate, changed, refs, requirement))
        count += 1
        changed = deepcopy(docs)
        changed["saved_review"]["complete_saved_scientific_joins"]["animal"][
            "blocked_source_taxon_witnesses"
        ][0]["cross_species_publication_admitted"] = True
        refuses(partial(evaluate, changed, refs, requirement))
        count += 1
        changed = deepcopy(docs)
        changed["raw_review"]["countries"][0][
            "duplicate_native_chronology_support_audit"
        ]["duplicates"][0]["scientific_support_refusal"] = ""
        refuses(partial(evaluate, changed, refs, requirement))
        count += 1
        changed = deepcopy(requirement)
        changed["requirements"][0]["acceptance"] = "different"
        refuses(partial(evaluate, docs, refs, changed))
        count += 1
        for value in [b'{"a":1,"a":2}', b'{"a":NaN}']:
            refuses(partial(parse_object, value))
            count += 1
        path = target / "metadata.json"
        path.write_bytes(b'{"strict":true}')
        row = {
            "path": str(path),
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "bytes": path.stat().st_size,
        }
        assert read_bound(row) == {"strict": True}
        count += 1
        path.write_bytes(b'{"strict":false}')
        refuses(partial(read_bound, row))
        count += 1
        alias = target / "alias"
        alias.symlink_to(path)
        refuses(partial(read_bound, {**row, "path": str(alias)}))
        count += 1
        fifo = target / "fifo"
        os.mkfifo(fifo)
        refuses(partial(read_bound, {**row, "path": str(fifo)}))
        fifo.unlink()
        count += 1
        for size in [True, -1]:
            refuses(partial(identity, {**row, "bytes": size}))
            count += 1
        assert exact(0, False) is False
        count += 1
        copied = target / "source"
        copied.mkdir()
        files = []
        for source in sorted(SOURCE.glob("*.py")):
            p = copied / source.name
            p.write_bytes(source.read_bytes())
            files.append(
                {
                    "path": str(p),
                    "sha256": hashlib.sha256(p.read_bytes()).hexdigest(),
                    "bytes": p.stat().st_size,
                }
            )
        manifest = copied / "prepared-source-manifest.json"
        manifest.write_text(json.dumps({"source_only": True, "files": files}))
        (copied / "independent-source-review.json").write_text(
            json.dumps(
                {
                    "approved": True,
                    "source_manifest_sha256": hashlib.sha256(
                        manifest.read_bytes()
                    ).hexdigest(),
                }
            )
        )
        spec = importlib.util.spec_from_file_location(
            "synthetic_callback", copied / "callback.py"
        )
        assert spec and spec.loader
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        module.verify(copied)
        count += 1
        source = copied / "adjudication.py"
        source.write_bytes(source.read_bytes() + b"\n")
        refuses(partial(module.verify, copied))
        count += 1
    finally:
        shutil.rmtree(target)
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "synthetic_groups": count,
                "actual_metadata_callback_native_data_API_or_runtime_executed": False,
            }
        )
    )


if __name__ == "__main__":
    main()
