        "actual_native_stage_exits": [0, 1],
    }
    validate_history(synthetic_plan, synthetic_common, synthetic_outer)
    for field, value in (
        ("actual_exit", 0),
        ("actual_exit", True),
        ("plan_sha256", "0" * 64),
        ("after_pin_mismatches", ["changed"]),
    ):
        wrong = {**synthetic_common, field: value}
        refuses(partial(validate_history, synthetic_plan, wrong, synthetic_outer))
    wrong = deepcopy(synthetic_common)
    wrong["stages"][0]["actual_exit"] = False
    refuses(partial(validate_history, synthetic_plan, wrong, synthetic_outer))
    wrong = deepcopy(synthetic_common)
    wrong["stages"][0]["argv"] = ["wrong"]
    refuses(partial(validate_history, synthetic_plan, wrong, synthetic_outer))
    count += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as name:
        stream_path = Path(name) / "stream.stdout"
        prefix = b"artificial original stage lines\n"
        expected = {
            "path": str(stream_path),
            "sha256": hashlib.sha256(prefix).hexdigest(),
            "bytes": len(prefix),
        }
        tail = (
            json.dumps(
                {
                    "terminal": str(ORIGINAL / "terminal.json"),
                    "sha256": REFERENCES["terminal.json"][0],
                    "status": "failed",
                }
            )
            + "\n"
        )
        outer_row = {
            "path": str(ORIGINAL / "adna-domain-terminal.json"),
            "sha256": REFERENCES["adna-domain-terminal.json"][0],
            "bytes": REFERENCES["adna-domain-terminal.json"][1],
        }
        tail += (
            json.dumps(
                {
                    "terminal": outer_row,
                    "actual_exit": 1,
                    "tracked_byte_checker_exit": None,
                }
            )
            + "\n"
        )
        raw_stream = prefix + tail.encode()
        stream_path.write_bytes(raw_stream)
        assert (
            stream_authority(stream_path, expected, {}, {})["original_recorded_prefix"]
            == expected
        )
        for changed in (
            raw_stream + b"extra",
            b"x" + raw_stream[1:],
            prefix,
            prefix + tail.replace('"failed"', '"passed"').encode(),
        ):
            stream_path.write_bytes(changed)
            refuses(partial(stream_authority, stream_path, expected, {}, {}))
    count += 1

    # Complete synthetic nested source record checks both chronology/provenance and null/zero.
    sample: dict[str, Any] = dict.fromkeys(schema["animal_normalized"], "value")
    sample.update(
        identity={"stable_token": "animal:x", "namespace": "bos_taurus:archive"},
        locality_identity={"locality_text": "site"},
        political_entity=None,
        coordinates={
            "latitude": 0,
            "longitude": None,
            "latitude_text": "0",
            "longitude_text": "",
            "confidence": "source",
        },
        chronology={
            "original_text": "zero",
            "evidence_class": "source",
            "precision_posture": "exact",
            "dating_basis": "declared",
            "time_start_bp": 0,
            "time_end_bp": None,
            "time_mean_bp": 0,
        },
    )
    projected = normalized_projection(sample, schema["animal_normalized"])
    assert (
        projected["time_start_bp"] == "0"
        and projected["time_end_bp"] == ""
        and projected["latitude"] == "0"
        and projected["longitude"] == ""
        and projected["political_entity"] == ""
    )
    wrong = deepcopy(sample)
    wrong["chronology"]["original_text"] = "changed"
    assert normalized_projection(wrong, schema["animal_normalized"]) != projected
    wrong = deepcopy(sample)
    wrong["chronology_provenance_locator"] = "changed"
    assert normalized_projection(wrong, schema["animal_normalized"]) != projected
    count += 1
    locality: dict[str, Any] = {
        "species_latin_name": "Bos taurus",
        "species_common_name": "cattle",
        "animal_scope": "animal",
        "project_accession": "PRJ",
        "sample_record_ids": ["animal:x"],
    }
    sample.update(
        species_latin_name="Bos taurus",
        species_common_name="cattle",
        group_id="",
        master_id="",
        project_accession="PRJ",
    )
    country = country_projection("Denmark", locality, sample, schema["animal_country"])
    bundle: dict[str, Any] = {
        "schema_version": "country-animal-adna-summary.v1",
        "country": "Denmark",
        "total_sample_rows": 1,
        "total_localities": 1,
        "total_species": 1,
        "total_projects": 1,
        "species_rows": [{"species_latin_name": "Bos taurus"}],
        "localities": [locality],
        "sample_rows": [country],
    }
    bundle_join(
        "Denmark",
        bundle,
        [country],
        {"animal:x": sample},
        {"animal:x": "Denmark"},
        schema["animal_country"],
    )
    wrong_bundle = deepcopy(bundle)
    wrong_bundle["sample_rows"][0]["chronology_provenance_locator"] = "forged"
    refuses(
        lambda: bundle_join(
            "Denmark",
            wrong_bundle,
            [country],
            {"animal:x": sample},
            {"animal:x": "Denmark"},
            schema["animal_country"],
        )
    )
    count += 1
    refuses(
        lambda: animal_partition(
            {"animal:x": sample},
            {
                "rows": [
                    {
                        "sample_count": 1,
                        "sample_record_ids": ["unknown"],
                        "nordic_inclusion": True,
                    }
                ]
            },
            {"rows": []},
        )
    )
    count += 1
    refuses(lambda: human_partition([{"genetic_id": "x"}, {"genetic_id": "x"}], {}))
    count += 1
    # Full synthetic identity partitions exercise denominator joins without reading public samples.
    synthetic_decisions: list[dict[str, str]] = []
    synthetic_countries: dict[str, list[dict[str, str]]] = {}
    for code, name, published, excluded in (
        ("DK", "Denmark", 653, 1),
        ("FI", "Finland", 32, 92),
        ("NO", "Norway", 130, 1),
        ("SE", "Sweden", 416, 0),
    ):
        synthetic_countries[name] = []
        for index in range(published + excluded):
            native_id = code + str(index)
            included = index < published
            synthetic_decisions.append(
                {
                    "genetic_id": native_id,
                    "country": code,
                    "decision": "published" if included else "excluded",
                    "reason": "country_sample_product"
                    if included
                    else "coordinate_missing",
                    "coordinate_status": "admitted" if included else "missing",
                    "chronology_status": "refused",
                    "chronology_reason": "missing_bp",
                    "source_rows": "native:" + native_id,
                }
            )
            if included:
                synthetic_countries[name].append(
                    {
                        "genetic_id": native_id,
                        "schema_version": "adna-sample-record-export.v1",
                        "source_family": "AADR",
                        "species_latin_name": "Homo sapiens",
                        "sample_namespace": "homo_sapiens:aadr_genetic_id",
                        "political_entity": name,
                    }
                )
    assert (
        human_partition(synthetic_decisions, synthetic_countries)["coordinate_excluded"]
        == 94
    )
    changed_countries = deepcopy(synthetic_countries)
    changed_countries["Denmark"][0]["sample_namespace"] = "bos_taurus:curated_sample"
    refuses(lambda: human_partition(synthetic_decisions, changed_countries))
    changed_decisions = deepcopy(synthetic_decisions)
    changed_decisions[0]["country"] = "SE"
    refuses(lambda: human_partition(changed_decisions, synthetic_countries))
    count += 1
    synthetic_samples = {
        "animal:" + str(i): {
            "species_latin_name": "Bos taurus",
            "project_accession": "PRJ",
        }
        for i in range(1468)
    }
    synthetic_features: dict[str, Any] = {
        "rows": [
            {
                "feature_id": "feature:" + str(i),
                "sample_count": 1,
                "sample_record_ids": ["animal:" + str(i)],
                "nordic_inclusion": i < 12,
                "political_entity": "Denmark",
                "species_latin_name": "Bos taurus",
            }
            for i in range(322)
        ],
        "row_count": 322,
    }
    synthetic_exclusions: dict[str, Any] = {
        "rows": [
            {
                "sample_record_id": "animal:" + str(i),
                "project_accession": "PRJ",
                "species_latin_name": "Bos taurus",
            }
            for i in range(322, 1468)
        ],
        "row_count": 1146,
    }
    mapped, nordic = animal_partition(
        synthetic_samples, synthetic_features, synthetic_exclusions
    )
    assert len(mapped) == 322 and len(nordic) == 12
    changed_features = deepcopy(synthetic_features)
    changed_features["rows"][0]["nordic_inclusion"] = 1
    refuses(
        lambda: animal_partition(
            synthetic_samples, changed_features, synthetic_exclusions
        )
    )
    changed_exclusions = deepcopy(synthetic_exclusions)
    changed_exclusions["rows"][0]["sample_record_id"] = "animal:0"
    refuses(
        lambda: animal_partition(
            synthetic_samples, synthetic_features, changed_exclusions
        )
    )
    count += 1

    # Exact actual stage declaration, independently extracted without main execution.
    output = SOURCE / "preflight/controlled-stage-output"
    tree = ast.parse((SOURCE / "prepare.py").read_text())
    expression = next(
        n.value
        for n in ast.walk(tree)
        if isinstance(n, ast.Assign)
        and any(
            isinstance(t, ast.Subscript)
            and isinstance(t.slice, ast.Constant)
            and t.slice.value == "stages"
            for t in n.targets
        )
    )
    stages = eval(
        compile(ast.Expression(expression), "actual-stage-contract", "eval"),
        {"str": str, "BASE": BASE, "SOURCE": SOURCE, "plan_path": output / "plan.json"},
    )
    plan = {"output": str(output), "stages": stages}
    common: dict[str, Any] = {
        "actual_exit": 0,
        "stages": [{**stage, "actual_exit": 0, "timed_out": False} for stage in stages],
    }
    assert stages_passed(plan, common)
    for field, value in (
        ("actual_exit", False),
        ("id", "other"),
        ("timeout_seconds", 46),
        ("must_succeed", False),
        ("argv", ["wrong"]),
        ("timed_out", True),
    ):
        wrong_common = deepcopy(common)
        wrong_common["stages"][0][field] = value
        assert not stages_passed(plan, wrong_common)
    assert not stages_passed(plan, {**common, "stages": common["stages"][:0]})
    count += 1
    pin_row = {"path": "/controlled/source", "sha256": "a" * 64, "bytes": 1}
    assert union([pin_row], [pin_row]) == [pin_row]
    refuses(lambda: union([pin_row], [{**pin_row, "sha256": "b" * 64}]))
    count += 1
    # Execute only the source serializer with synthetic stand-ins; no application imports/data.
    source = ast.parse(
        (ROOT / declaration["source_contracts"]["record_exports"]).read_text()
    )
    functions = [
        n
        for n in source.body
        if isinstance(n, ast.FunctionDef)
        and n.name in {"serialize_sample_record", "_sample_export_fields"}
    ]
    serializer = next(n for n in functions if n.name == "serialize_sample_record")
    attrs = {
        n.attr
        for n in ast.walk(serializer)
        if isinstance(n, ast.Attribute)
        and isinstance(n.value, ast.Name)
        and n.value.id == "sample"
    }
    synthetic = SimpleNamespace(**dict.fromkeys(attrs, "source-value"))
    synthetic.datasets = ()
    synthetic.accession_lineage = ()
    synthetic.time_start_bp = 0
    synthetic.time_end_bp = None

    class Support:
        def __init__(self, **kwargs: Any) -> None:
            self.values = kwargs

        def as_dict(self) -> dict[str, Any]:
            return self.values

    namespace: dict[str, Any] = {
        "SAMPLE_RECORD_SCHEMA": "adna-sample-record-export.v2",
        "LEGACY_SAMPLE_RECORD_SCHEMA": "adna-sample-record-export.v1",
        "SAMPLE_EXPORT_FIELDS": tuple(schema["human_legacy"])
        + ("sample_chronology", "sample_identity"),
        "LEGACY_SAMPLE_EXPORT_FIELDS": tuple(schema["human_legacy"]),
        "AdnaSampleChronologySupport": Support,
    }
    module = ast.Module(
        body=[
            ast.ImportFrom(
                module="__future__", names=[ast.alias(name="annotations")], level=0
            ),
            *functions,
        ],
        type_ignores=[],
    )
    exec(
        compile(
            ast.fix_missing_locations(module),
            "pinned-serializer-synthetic-only",
            "exec",
        ),
        namespace,
    )
    exported = namespace["serialize_sample_record"](synthetic)
    assert (
        exported["time_start_bp"] == 0
        and exported["time_end_bp"] is None
        and exported["sample_identity"]["stable_token"] == synthetic.genetic_id
    )
    assert "sample_chronology" in exported and "sample_identity" in exported
    clean(exported)
    legacy = namespace["serialize_sample_record"](
        synthetic, schema_version="adna-sample-record-export.v1"
    )
    assert set(legacy) == set(schema["human_legacy"])
    refuses(
        lambda: namespace["serialize_sample_record"](
            synthetic, schema_version="unknown"
        )
    )
    count += 1
    # Artificial records exercise the exact source-owned exceptions without
    # opening a normalized population or invoking its producer.
    for (slug, master), (taxon, tax_id, project) in SOURCE_TAXON_EXCEPTIONS.items():
        container = {"bos_taurus": "Bos taurus", "ovis_aries": "Ovis aries"}[slug]
        source_row: dict[str, Any] = {
            "master_id": master,
            "group_id": project,
            "project_accession": project,
            "species_latin_name": taxon,
            "source_family": "ENA",
            "identity": {
                "namespace": slug + ":curated_sample",
                "stable_token": slug + ":sample:" + master,
                "accession_lineage": [
                    "species:" + taxon,
                    "source:ENA",
                    "project:" + project,
                    "sample:" + master,
                ],
            },
            "source_native_scientific_name": taxon,
            "source_native_tax_id": tax_id,
            "source_native_identity_kind": "biological_sample_accession",
            "taxon_alignment_status": "project_species_mismatch",
            "inclusion_status": "sample_context_blocked",
        }
        witness = animal_identity(slug, container, source_row)
        assert (
            witness is not None
            and witness["cross_species_publication_admitted"] is False
        )
        for field, value in [
            ("source_native_scientific_name", container),
            ("source_native_tax_id", 9909),
            ("source_native_tax_id", True),
            ("source_native_tax_id", "unreviewed"),
            ("source_native_identity_kind", "sequencing_experiment"),
            ("taxon_alignment_status", "project_species_match"),
            ("inclusion_status", "site_curated"),
            ("species_latin_name", container),
            ("source_family", "SRA"),
            ("group_id", "foreign"),
            ("master_id", "foreign"),
            ("project_accession", "foreign"),
        ]:
            wrong = deepcopy(source_row)
            wrong[field] = value
            refuses(partial(animal_identity, slug, container, wrong))
        for field, value in [
            ("namespace", "pollen:curated_sample"),
            ("stable_token", "other:sample:" + master),
            (
                "accession_lineage",
                [
                    "species:" + container,
                    "source:ENA",
                    "project:" + project,
                    "sample:" + master,
                ],
            ),
            (
                "accession_lineage",
                ["species:" + taxon, "source:ENA", "project:" + project],
            ),
            (
                "accession_lineage",
                [
                    "sample:" + master,
                    "project:" + project,
                    "source:ENA",
                    "species:" + taxon,
                ],
            ),
        ]:
            wrong = deepcopy(source_row)
            wrong["identity"][field] = value
            refuses(partial(animal_identity, slug, container, wrong))
        count += 1
    ordinary = deepcopy(source_row)
    ordinary["master_id"] = "controlled:ordinary"
    ordinary["species_latin_name"] = container
    ordinary["identity"]["stable_token"] = slug + ":sample:controlled:ordinary"
    ordinary["identity"]["accession_lineage"] = [
        "species:" + container,
        "source:ENA",
        "project:" + project,
        "sample:controlled:ordinary",
    ]
    assert animal_identity(slug, container, ordinary) is None
    wrong = deepcopy(ordinary)
    wrong["species_latin_name"] = taxon
    wrong["identity"]["accession_lineage"][0] = "species:" + taxon
    refuses(partial(animal_identity, slug, container, wrong))
    count += 1
    policy = json.loads((SOURCE / "source-taxon-policy.json").read_bytes())
    for row in policy["original_policy_pins"]:
        assert exact(pin(Path(row["path"])), row)

    def literal(path: str, target: str) -> Any:
        module = ast.parse(Path(path).read_text())
        node = next(
            n
            for n in module.body
            if isinstance(n, (ast.Assign, ast.AnnAssign))
            and any(
                isinstance(v, ast.Name) and v.id == target
                for v in (n.targets if isinstance(n, ast.Assign) else [n.target])
            )
        )
        assert node.value is not None
        return ast.literal_eval(node.value)

    policy_paths = {
        Path(row["path"]).name: row["path"] for row in policy["original_policy_pins"]
    }
    aliases = literal(policy_paths["obishir_sheep.py"], "_ALIASES")
    assert aliases["SAMEA8022722"] == ("OB21-04", "Capra hircus")
    assert literal(policy_paths["species.py"], "_EXPECTED_TAXA") == {
        "Bos primigenius": 3,
        "Bos taurus": 8,
    }
    assert literal(policy_paths["species.py"], "_NATIVE_TAXA")[
        (("9909",), ("Bos primigenius",))
    ] == ("Bos primigenius", "aurochs")
    assert len(SOURCE_TAXON_EXCEPTIONS) == 4
    count += 1
    print(
        json.dumps(
            {
                "source_only": True,
                "controlled_groups": count,
                "actual_saved_payloads_decoded": False,
                "normalization_export_or_model_producers_executed": False,
            },
            indent=2,
        )
    )


