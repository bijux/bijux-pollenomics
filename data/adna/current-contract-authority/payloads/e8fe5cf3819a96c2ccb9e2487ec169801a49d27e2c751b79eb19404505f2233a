def refuses(call: Callable[[], Any]) -> None:
    try:
        call()
    except (ValueError, KeyError):
        return
    raise AssertionError("Unsafe controlled contract accepted")


def main() -> None:
    count = 0
    declaration = json.loads((SOURCE / "declared-inputs.json").read_bytes())
    schema = export_contracts(ROOT, declaration["source_contracts"])
    assert tuple(
        map(
            len,
            (
                schema["human_legacy"],
                schema["animal_normalized"],
                schema["animal_country"],
            ),
        )
    ) == (27, 44, 48)
    count += 1
    payload: dict[str, Any] = {
        "schema_version": "adna-sample-record-export.v1",
        "evidence_domain": "animal_ancient_dna",
        "pollen_eligible": False,
        "pollen_propagation_eligible": False,
        "samples": [],
        "admitted_sample_count": 0,
        "refused_sample_count": 0,
        "sample_refusals": [],
    }
    flags(payload)
    count += 1
    for key, value in [
        ("pollen_eligible", 0),
        ("pollen_propagation_eligible", "false"),
        ("evidence_domain", "pollen_context"),
        ("admitted_sample_count", False),
        ("refused_sample_count", False),
    ]:
        wrong = {**payload, key: value}
        refuses(partial(flags, wrong))
        count += 1
    for key in (
        "pollen_count",
        "pollen_sum",
        "relative_pollen_percentage",
        "ppe",
        "fall_speed_m_s",
        "whole_pollen",
    ):
        refuses(partial(clean, {"nested": [{key: 0}]}))
        refuses(partial(json_shape, {"nested": [{key: None}]}))
        count += 1
    clean({"notes": "No pollen or whole_pollen inference", "archive_read_count": 100})
    assert cell(None) == "" and cell(0) == "0" and not exact(False, 0)
    refuses(lambda: integer(False, 0))
    count += 1
    for rows in ([{"id": ""}], [{"id": "x"}, {"id": "x"}]):
        refuses(partial(unique, rows, "id"))
        count += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as raw:
        work = Path(raw)
        path = work / "empty.csv"
        path.write_text("sample_record_id\n")
        assert table(path) == [] and measured(path)["rows"] == 0
        path.write_text("sample_record_id,pollen_sum\n")
        refuses(lambda: table(path))
        refuses(lambda: measured(path))
        count += 1
        path.write_text("id,id\nx,x\n")
        refuses(lambda: table(path))
        count += 1
        path.write_text("id,value\nx\n")
        refuses(lambda: table(path))
        count += 1
        path.write_text('{"x": true}')
        # A tiny exact output fixed-point is a storage guard, not native execution.
        assert receipt_bytes(work, {"actual_exit": 0}, 4096)
        refuses(lambda: receipt_bytes(work, {"actual_exit": 0}, 1))
        count += 1
        root = work / "controlled"
        root.mkdir()
        for name in EXPECTED:
            (root / name).write_text("# controlled source\n")
        members: list[dict[str, Any]] = [
            {
                "path": str(root / n),
                "sha256": hashlib.sha256((root / n).read_bytes()).hexdigest(),
                "bytes": (root / n).stat().st_size,
            }
            for n in sorted(EXPECTED)
        ]
        manifest = root / "prepared-source-manifest.json"

        def seal(rows: list[dict[str, Any]]) -> None:
            manifest.write_text(json.dumps({"source_only": True, "files": rows}))
            (root / "independent-source-review.json").write_text(
                json.dumps(
                    {
                        "approved": True,
                        "source_manifest_sha256": hashlib.sha256(
                            manifest.read_bytes()
                        ).hexdigest(),
                    }
                )
            )

        seal(members)
        verify_reviewed(root)
        count += 1
        for name in ("contracts.so", "runtime.so"):
            (root / name).write_bytes(b"unreviewed")
            refuses(lambda: verify_reviewed(root))
            (root / name).unlink()
            count += 1
        os.symlink(root / "contracts.py", root / "unknown.py")
        refuses(lambda: verify_reviewed(root))
        (root / "unknown.py").unlink()
        count += 1
        os.mkfifo(root / "pipe")
        refuses(lambda: verify_reviewed(root))
        (root / "pipe").unlink()
        count += 1
        seal([{**row, "path": Path(row["path"]).name} for row in members])
        refuses(lambda: verify_reviewed(root))
        seal(members)
        (root / "contracts.py").write_text("# changed\n")
        refuses(lambda: verify_reviewed(root))
        count += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as raw:
        directory = Path(raw)
        tool = directory / "git"
        tool.write_bytes(b"controlled-tool")
        expected = pin(tool)
        git_authority(tool, expected, {})
        for key in (
            "DYLD_INSERT_LIBRARIES",
            "LD_PRELOAD",
            "LD_LIBRARY_PATH",
            "_PYTHON_HOST_PLATFORM",
            "__PYVENV_LAUNCHER__",
        ):
            refuses(partial(git_authority, tool, expected, {key: ""}))
        for row in (
            {**expected, "bytes": False},
            {**expected, "bytes": expected["bytes"] + 1},
            {**expected, "sha256": "0" * 64},
        ):
            refuses(partial(git_authority, tool, row, {}))
        alias = directory / "git-alias"
        alias.symlink_to(tool)
        refuses(partial(git_authority, alias, expected, {}))
        count += 1
        plan_path = directory / "registered.json"
        raw_plan = b'{"candidate":"controlled","value":0}'
        plan_path.write_bytes(raw_plan)
        checksum = hashlib.sha256(raw_plan).hexdigest()
        assert registered_plan(plan_path, checksum)["value"] == 0
        invalid_checksums: list[Any] = ["", "x" * 64, "0" * 64, False, None]
        for value in invalid_checksums:
            refuses(partial(registered_plan, plan_path, value))

        class ReboundPath(PosixPath):
            reads = 0
            bad_first = False

            def read_bytes(self) -> bytes:
                type(self).reads += 1
                return (
                    b'{"candidate":"forged"}'
                    if type(self).bad_first or type(self).reads > 1
                    else raw_plan
                )

        rebound = ReboundPath(plan_path)
        assert (
            registered_plan(rebound, checksum)["candidate"] == "controlled"
            and ReboundPath.reads == 1
        )
        ReboundPath.reads = 0
        ReboundPath.bad_first = True
        refuses(partial(registered_plan, rebound, checksum))
        for invalid in (b'{"x":1,"x":2}', b'{"x":NaN}', b"[]"):
            plan_path.write_bytes(invalid)
            refuses(
                partial(registered_plan, plan_path, hashlib.sha256(invalid).hexdigest())
            )
        count += 1
    # The registered SHA is injected after plan environment in both actual parents.
    for name in ("run.py", "common_runner.py"):
        tree = ast.parse((SOURCE / name).read_text())
        inject = [
            node
            for node in ast.walk(tree)
            if isinstance(node, ast.Assign)
            and any(
                isinstance(target, ast.Subscript)
                and isinstance(target.value, ast.Name)
                and target.value.id == "env"
                and isinstance(target.slice, ast.Constant)
                and target.slice.value == "BIJUX_REGISTERED_PLAN_SHA256"
                for target in node.targets
            )
        ]
        assert (
            len(inject) == 1
            and isinstance(inject[0].value, ast.Attribute)
            and inject[0].value.attr == "registered_plan_sha256"
        )
        updates = [
            node.lineno
            for node in ast.walk(tree)
            if isinstance(node, ast.Call)
            and isinstance(node.func, ast.Attribute)
            and isinstance(node.func.value, ast.Name)
            and node.func.value.id == "env"
            and node.func.attr == "update"
        ]
        assert len(updates) == 1 and updates[0] < inject[0].lineno
    count += 1

    catalog = {"data/a.xlsx", "data/b.zip#member.xlsx"}
    assert pointer_components("data/a.xlsx || data/b.zip#member.xlsx", catalog) == [
        "data/a.xlsx",
        "data/b.zip#member.xlsx",
    ]
    assert pointer_components(" data/a.xlsx || data/a.xlsx ", catalog) == [
        "data/a.xlsx"
    ]
    assert pointer_components("", catalog) == []
    for value in (
        "data/a.xlsx || unknown",
        "data/a.xlsx||data/b.zip#member.xlsx",
        "data/a.xlsx || ",
        " ",
    ):
        refuses(partial(pointer_components, value, catalog))
    # Exact maintained source policy is exercised only on artificial pointer strings.
    policy_source = (
        ROOT
        / "packages/bijux-pollenomics/src/bijux_pollenomics/adna/projects/sample_master/identity.py"
    )
    join_function = next(
        n
        for n in ast.parse(policy_source.read_text()).body
        if isinstance(n, ast.FunctionDef) and n.name == "_join_distinct"
    )
    ns: dict[str, Any] = {}
    exec(
        compile(
            ast.fix_missing_locations(
                ast.Module(body=[join_function], type_ignores=[])
            ),
            "actual-pointer-policy-artificial-only",
            "exec",
        ),
        ns,
    )
    assert ns["_join_distinct"](
        " data/a.xlsx || data/b.zip#member.xlsx ", "data/a.xlsx"
    ) == " || ".join(
        pointer_components(
            " data/a.xlsx || data/b.zip#member.xlsx || data/a.xlsx ", catalog
        )
    )
    count += 1
    from retained import (
        CANDIDATE,
        ORIGINAL,
        REFERENCES,
        stream_authority,
        validate_history,
    )

    original_stages = [
        {
            "id": role,
            "argv": [
                str(BASE),
                "-I",
                "-S",
                "-B",
                str(ROOT / "artifacts/science/adna-registered-plan-custody/entry.py"),
                action,
                "--plan",
                str(ORIGINAL / "plan.json"),
            ],
            "timeout_seconds": 45,
            "must_succeed": True,
        }
        for role, action in (
            ("saved-adna-contract-inventory", "inventory"),
            ("independent-adna-domain-joins", "observe"),
        )
    ]
    synthetic_plan: dict[str, Any] = {
        "candidate": CANDIDATE,
        "repository": str(ROOT),
        "output": str(ORIGINAL),
        "input_pins": [{}] * 10104,
        "stages": original_stages,
    }
    synthetic_common: dict[str, Any] = {
        "candidate": CANDIDATE,
        "actual_exit": 1,
        "plan_sha256": REFERENCES["plan.json"][0],
        "before_pin_mismatches": [],
        "after_pin_mismatches": [],
        "absent_input_paths_unchanged": True,
        "stages": [
            {**row, "actual_exit": code, "timed_out": False}
            for row, code in zip(original_stages, (0, 1), strict=True)
        ],
    }
    synthetic_outer: dict[str, Any] = {
        "candidate": CANDIDATE,
        "actual_exit": 1,
        "plan_sha256": REFERENCES["plan.json"][0],
        "timed_out": False,
        "error": None,
