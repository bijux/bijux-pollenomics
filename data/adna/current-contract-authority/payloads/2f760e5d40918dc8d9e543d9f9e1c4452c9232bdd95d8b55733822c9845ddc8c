from pathlib import Path
import subprocess

source = Path(__file__).absolute().parent.parent
root = source.parents[2]
ruff = '/Users/bijan/.cache/uv/archive-v0/2XF0xMG3jR4vPhZZ/ruff-0.15.8.data/scripts/ruff'
