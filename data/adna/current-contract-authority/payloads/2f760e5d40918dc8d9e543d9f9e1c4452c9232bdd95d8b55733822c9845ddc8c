 with (source/'preflight'/f'{label}.stdout').open('x') as out, (source/'preflight'/f'{label}.stderr').open('x') as err:
  result=subprocess.run([ruff,*args], stdout=out,stderr=err,check=False)
 print(label,result.returncode,flush=True)
 if result.returncode:raise SystemExit(result.returncode)
