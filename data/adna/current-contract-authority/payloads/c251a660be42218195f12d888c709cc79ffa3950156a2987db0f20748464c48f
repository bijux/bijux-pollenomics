+def animal_identity(
+    slug: str, container_taxon: str, row: dict[str, Any]
+) -> dict[str, Any] | None:
+    identity = row["identity"]
+    require(
+        type(row["master_id"]) is str
+        and bool(row["master_id"])
+        and type(row["species_latin_name"]) is str
+        and bool(row["species_latin_name"])
+        and type(row["source_family"]) is str
+        and type(row["project_accession"]) is str
+        and identity["namespace"] == slug + ":curated_sample"
+        and identity["stable_token"] == slug + ":sample:" + row["master_id"].casefold()
+        and row["group_id"] == row["project_accession"]
+        and exact(
+            identity["accession_lineage"],
+            [
+                "species:" + row["species_latin_name"],
+                "source:" + row["source_family"],
+                "project:" + row["project_accession"],
+                "sample:" + row["master_id"],
+            ],
+        ),
+        "Animal container namespace or source-owned identity lineage differs",
+    )
+    exception = SOURCE_TAXON_EXCEPTIONS.get((slug, row["master_id"]))
+    if exception is None:
+        require(
+            row["species_latin_name"] == container_taxon,
+            "Unreviewed sample taxon differs from container",
+        )
+        return None
+    taxon, native_tax_id, project = exception
+    require(
+        row["species_latin_name"] == taxon
+        and container_taxon
+        == {"bos_taurus": "Bos taurus", "ovis_aries": "Ovis aries"}[slug]
+        and row["source_native_scientific_name"] == taxon
+        and row["source_native_tax_id"] == native_tax_id
+        and row["project_accession"] == project
+        and row["source_family"] == "ENA"
+        and row["source_native_identity_kind"] == "biological_sample_accession"
+        and row["taxon_alignment_status"] == "project_species_mismatch"
+        and row["inclusion_status"] == "sample_context_blocked",
+        "Reviewed source taxon identity or blocked publication posture changed",
+    )
+    return {
+        "container_namespace": identity["namespace"],
+        "container_species": container_taxon,
+        "native_sample_id": identity["stable_token"],
+        "source_species": taxon,
+        "source_native_tax_id": native_tax_id,
+        "project_accession": project,
+        "accession_lineage": identity["accession_lineage"],
