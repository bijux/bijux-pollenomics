# distinct source taxon and remain blocked from cross-species publication.
SOURCE_TAXON_EXCEPTIONS: dict[tuple[str, str], tuple[str, str, str]] = {
    ("bos_taurus", "prjna705960:samn18106827"): (
        "Bos primigenius",
