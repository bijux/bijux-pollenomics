}


def animal_identity(
    slug: str, container_taxon: str, row: dict[str, Any]
) -> dict[str, Any] | None:
    identity = row["identity"]
    require(
        type(row["master_id"]) is str
        and bool(row["master_id"])
        and type(row["species_latin_name"]) is str
        and bool(row["species_latin_name"])
        and type(row["source_family"]) is str
        and type(row["project_accession"]) is str
        and identity["namespace"] == slug + ":curated_sample"
        and identity["stable_token"] == slug + ":sample:" + row["master_id"].casefold()
        and row["group_id"] == row["project_accession"]
        and exact(
            identity["accession_lineage"],
            [
                "species:" + row["species_latin_name"],
                "source:" + row["source_family"],
                "project:" + row["project_accession"],
                "sample:" + row["master_id"],
            ],
        ),
        "Animal container namespace or source-owned identity lineage differs",
    )
    exception = SOURCE_TAXON_EXCEPTIONS.get((slug, row["master_id"]))
    if exception is None:
        require(
            row["species_latin_name"] == container_taxon,
            "Unreviewed sample taxon differs from container",
        )
        return None
    taxon, native_tax_id, project = exception
    require(
        row["species_latin_name"] == taxon
        and container_taxon
        == {"bos_taurus": "Bos taurus", "ovis_aries": "Ovis aries"}[slug]
        and row["source_native_scientific_name"] == taxon
        and row["source_native_tax_id"] == native_tax_id
        and row["project_accession"] == project
        and row["source_family"] == "ENA"
        and row["source_native_identity_kind"] == "biological_sample_accession"
        and row["taxon_alignment_status"] == "project_species_mismatch"
        and row["inclusion_status"] == "sample_context_blocked",
        "Reviewed source taxon identity or blocked publication posture changed",
    )
    return {
        "container_namespace": identity["namespace"],
        "container_species": container_taxon,
        "native_sample_id": identity["stable_token"],
        "source_species": taxon,
        "source_native_tax_id": native_tax_id,
        "project_accession": project,
        "accession_lineage": identity["accession_lineage"],
        "taxon_alignment_status": row["taxon_alignment_status"],
        "inclusion_status": row["inclusion_status"],
        "cross_species_publication_admitted": False,
        "wild_domestic_analytical_equivalence_claimed": False,
    }


def audit(
    root: Path, declared: dict[str, Any], schema: dict[str, Any]
) -> dict[str, Any]:
    by_role: dict[str, list[Path]] = {}
    for row in declared["files"]:
        by_role.setdefault(row["role"], []).append(root / row["path"])

    def one(role: str) -> Any:
        require(len(by_role[role]) == 1, "Unique public role required: " + role)
        return load(by_role[role][0])

    animal_samples: dict[str, dict[str, Any]] = {}
    families: Counter[str] = Counter()
    modalities: Counter[str] = Counter()
    pointer_usage: Counter[str] = Counter()
    composite_joins: list[dict[str, Any]] = []
    source_taxon_witnesses: list[dict[str, Any]] = []
    backlinks = one("backlink_catalog")
    pointers = {row["reference"] for row in backlinks["references"]}
    integer(len(pointers), 60)
    source_paths = {row["path"] for row in one("original_input_catalog")["inputs"]}
    for row in backlinks["references"]:
        require(
            row["path"] in source_paths
            and row["path"]
            == (
                row["reference"].split("#", 1)[0]
                if row["reference"].startswith("data/")
                else "data/" + row["reference"].split("#", 1)[0]
            ),
            "Backlink catalog source-role lineage differs",
        )
    normalized_tables = {path.parent: path for path in by_role["normalized_csv"]}
    integer(len(normalized_tables), 10)
    for path in by_role["normalized_json"]:
        payload = load(path)
        flags(payload)
        local = unique(
            [
                {"stable_token": row["identity"]["stable_token"], "sample": row}
                for row in payload["samples"]
            ],
            "stable_token",
        )
        require(
            not set(local).intersection(animal_samples),
            "Animal native ID crosses source species",
        )
        csv_rows = table(normalized_tables[path.parent], schema["animal_normalized"])
        expected_csv = []
        for key, wrapped in local.items():
            row = wrapped["sample"]
            source_taxon = animal_identity(
                path.parent.parent.name, payload["species_latin_name"], row
            )
            if source_taxon is not None:
                source_taxon_witnesses.append(source_taxon)
            animal_samples[key] = row
            families[row["source_family"]] += 1
            modalities[row["record_modality"]] += 1
            for name in ("sample_lineage_path", "chronology_provenance_path"):
                reference = row[name]
                if reference:
                    components = pointer_components(reference, pointers)
                    for component in components:
                        pointer_usage[component] += 1
                    if len(components) > 1:
                        composite_joins.append(
                            {
                                "native_sample_id": key,
                                "field": name,
                                "raw_source_path": reference,
                                "exact_catalog_components": components,
                            }
                        )
            expected_csv.append(normalized_projection(row, schema["animal_normalized"]))
        require(
            exact(csv_rows, expected_csv),
            "All normalized CSV source fields/order differ from nested typed JSON",
        )
    require(
        {
            (
                row["container_namespace"].split(":", 1)[0],
                row["native_sample_id"].split(":sample:", 1)[1],
            )
            for row in source_taxon_witnesses
        }
        == set(SOURCE_TAXON_EXCEPTIONS),
        "Complete reviewed source-taxon exception population differs",
    )
    integer(len(animal_samples), 1468)
    require(
        families == Counter(ENA=1411, BioProject=22, SRA=20, GenBank=15)
        and modalities == Counter(archive_reads=1442, mitogenome_only=26),
        "Source family or read/mitogenome partition changed",
    )
    mapped, nordic = animal_partition(
        animal_samples, one("animal_mapped"), one("animal_excluded")
    )
    country_rows = {
        path.parent.name.title(): table(path, schema["human_legacy"])
        for path in by_role["human_country_csv"]
    }
    decisions = table(by_role["human_decisions"][0])
    humans = human_partition(decisions, country_rows)
    for path in by_role["human_country_summary"]:
        payload = load(path)
        clean(payload)
        country = path.parent.name.title()
        require(payload["country"] == country, "Human summary country differs")
        integer(payload["total_unique_samples"], len(country_rows[country]))
    for path in by_role["animal_country_bundle"]:
        country = path.parent.name.title()
        csv_path = next(
            p for p in by_role["animal_country_csv"] if p.parent == path.parent
        )
        bundle_join(
            country,
            load(path),
            table(csv_path, schema["animal_country"]),
            animal_samples,
            nordic,
            schema["animal_country"],
        )
    human = one("human_partition_report")
    animal = one("animal_partition_report")
    accountability = one("human_accountability")
    for payload, names in (
        (human, ("map_admitted", "scientifically_admitted")),
        (animal, ("country_assignment_admitted", "scientifically_admitted")),
        (
            accountability,
            ("map_admitted", "country_assignment_admitted", "scientifically_admitted"),
        ),
    ):
        require(
            all(payload[name] is False for name in names),
            "Source-accountability promoted scientific/country/map admission",
        )
        clean(payload)
    for key, count in {
        "source_genetic_ids": 1325,
        "published": 1231,
        "excluded_missing_coordinates": 94,
    }.items():
        integer(human[key], count)
    for key, count in {
        "normalized_sample_ids": 1468,
        "mapped_sample_ids": 322,
        "excluded_sample_ids": 1146,
        "nordic_mapped_sample_ids": 12,
    }.items():
        integer(animal[key], count)
    foundation = one("animal_foundation")
    integer(foundation["summary"]["sample_row_count"], len(animal_samples))
    integer(foundation["summary"]["tracked_species_count"], 10)
    return {
        "human": humans,
        "animal": {
            "source_ids": len(animal_samples),
            "mapped": len(mapped),
            "excluded": len(animal_samples) - len(mapped),
            "nordic": len(nordic),
            "species_contracts": 10,
            "blocked_source_taxon_witnesses": source_taxon_witnesses,
            "source_families": dict(sorted(families.items())),
            "modalities": dict(sorted(modalities.items())),
        },
        "country_csvs_checked": 8,
        "full_saved_animal_bundles_checked": 4,
        "declared_backlinks": len(pointers),
        "actually_used_backlinks": len(pointer_usage),
        "compound_source_pointer_joins": composite_joins,
        "pointer_split_authority": "sample_master.identity._join_distinct literal separator and trim/distinct order; raw source fields remain unchanged",
        "backlink_use_counts": dict(sorted(pointer_usage.items())),
        "historical_missing_metadata_digest_count": sum(
            row.get("historical_metadata_digest_present") is False
            for row in backlinks["references"]
        ),
        "source_acquisition_reauthenticated": False,
        "pollen_measurement_field_leakage": False,
        "pollen_eligibility_promoted": False,
        "current_v2_human_population_export_executed": False,
        "rights_human_biology_LRA_or_pollen_event_admission": False,
    }
