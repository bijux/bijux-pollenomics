def pin(p):
    raw=p.read_bytes()
    return {'path':str(p),'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)}

def write(name,obj):
    p=D/name
    if p.exists():
        raise ValueError('Source authority already sealed: '+str(p))
    p.write_text(json.dumps(obj,indent=2,allow_nan=False)+'\n')
    return p

