def refuses(call: Any) -> None:
    try:
        call()
    except (ValueError, KeyError, TypeError, ImportError):
        return
    raise AssertionError("Expected finite source-contract refusal")


def artificial() -> tuple[dict[str, str], dict[str, str | None]]:
    row = {prefix[0]: "" for prefix in PREFIXES.values()}
    for key, value in {
        "genetic_id": "ARTIFICIAL:Å",
        "master_id": "ARTIFICIAL-master",
        "group_id": "fixture-group",
        "locality": "Fixture locality",
        "political_entity": "Sweden",
        "latitude": "0",
        "longitude": "-0",
        "date_mean_bp": "100",
        "date_stddev_bp": "5",
        "full_date": "Synthetic interval",
        "publication": "Artificial citation",
        "data_type": "fixture-only",
        "molecular_sex": "not-a-source-record",
    }.items():
        row[PREFIXES[key][0]] = value
    return row, header_schema(list(row))


def actual_writer_cases(sample: dict[str, Any], target: Path) -> int:
    """Execute extracted actual value-object and writer bodies on artificial values only."""
    from collections.abc import Mapping
    from typing import cast

    root = SOURCE.parents[2] / "packages/bijux-pollenomics/src/bijux_pollenomics"
    namespace: dict[str, Any] = {
        "__name__": "__main__",
        "dataclass": dataclass,
        "Mapping": Mapping,
        "cast": cast,
        "csv": __import__("csv"),
        "json": json,
    }
    classes: list[ast.stmt] = []
    for filename, names in (
        (
            "adna/domain/models/identity.py",
            {"AdnaSampleIdentity", "AdnaLocalityIdentity"},
        ),
        ("adna/domain/models/chronology.py", {"AdnaCoordinate", "AdnaChronology"}),
        ("adna/domain/models/occurrence_support.py", {"AdnaSampleChronologySupport"}),
        ("adna/domain/models/samples.py", {"AdnaSampleRecord"}),
    ):
        tree = ast.parse((root / filename).read_text())
        classes.extend(
            n for n in tree.body if isinstance(n, ast.ClassDef) and n.name in names
        )

    def execute(nodes: list[ast.stmt]) -> None:
        tree = ast.Module(
            body=[
                ast.ImportFrom(
                    module="__future__", names=[ast.alias(name="annotations")], level=0
                ),
                *nodes,
            ],
            type_ignores=[],
        )
        ast.fix_missing_locations(tree)
        exec(compile(tree, "actual-source-artificial-fixture", "exec"), namespace)

    execute(classes)
    writer = ast.parse((root / "reporting/rendering/record_exports.py").read_text())
    namespace.update(
        LEGACY_SAMPLE_EXPORT_FIELDS=FIELDS,
        SAMPLE_EXPORT_FIELDS=CURRENT_FIELDS,
        SAMPLE_RECORD_SCHEMA="adna-sample-record-export.v2",
        LEGACY_SAMPLE_RECORD_SCHEMA="adna-sample-record-export.v1",
    )
    functions = {
        "_sample_export_fields",
        "serialize_sample_record",
        "write_samples_csv",
        "write_samples_geojson",
        "build_sample_geojson_feature",
        "build_samples_geojson",
    }
    execute(
        [
            node
            for node in writer.body
            if isinstance(node, ast.FunctionDef) and node.name in functions
        ]
    )
    fields = typed_record(sample)
    fields["identity"] = namespace["AdnaSampleIdentity"](
        **{
            **fields["identity"],
            "accession_lineage": tuple(fields["identity"]["accession_lineage"]),
        }
    )
    fields["locality_identity"] = namespace["AdnaLocalityIdentity"](
        **{
            **fields["locality_identity"],
            "source_anchor_tokens": tuple(
                fields["locality_identity"]["source_anchor_tokens"]
            ),
        }
    )
    fields["coordinates"] = namespace["AdnaCoordinate"](**fields["coordinates"])
    fields["chronology"] = namespace["AdnaChronology"](**fields["chronology"])
    fields["datasets"] = tuple(fields["datasets"])
    actual = namespace["AdnaSampleRecord"](**fields)
    same(json.loads(json.dumps(actual.as_dict())), typed_record(sample))
    same(namespace["serialize_sample_record"](actual), export_record(sample))
    namespace["write_samples_csv"](target / "artificial.csv", [actual])
    with (target / "artificial.csv").open(newline="") as stream:
        rows = list(__import__("csv").DictReader(stream))
    same(rows, [csv_record(sample)])
    namespace["write_samples_geojson"](target / "artificial.geojson", [actual])
    same(json.loads((target / "artificial.geojson").read_bytes()), geojson([sample]))
    return 4


def entry_cases(target: Path) -> int:
    from entry import entry_root, verify
    from source_admission import reviewed_controls
    from source_inputs import pin

    copy = target / "entry-source"
    copy.mkdir()
    names = sorted(
        [p.name for p in SOURCE.glob("*.py")]
        + ["declared-inputs.json", "generated-source-omission.json"]
    )
    for name in names:
        shutil.copyfile(SOURCE / name, copy / name)
    manifest = copy / "prepared-source-manifest.json"
    manifest.write_text(
        json.dumps({"source_only": True, "files": [pin(copy / name) for name in names]})
    )
    peer = copy / "independent-source-review.json"
    peer.write_text(
        json.dumps(
            {"approved": True, "source_manifest_sha256": pin(manifest)["sha256"]}
        )
    )
    assert entry_root(copy / "entry.py") == copy
    verify(copy)
    assert reviewed_controls(copy)[0] == manifest
    member = copy / "contracts.py"
    raw = member.read_bytes()
    member.write_bytes(raw + b"\n")
    refuses(partial(verify, copy))
    member.write_bytes(raw)
    for name, kind in (
        ("unreviewed.so", "file"),
        ("fifo", "fifo"),
        ("unreviewed", "directory"),
        ("linked-entry.py", "link"),
    ):
        path = copy / name
        if kind == "file":
            path.write_bytes(b"artificial")
        elif kind == "fifo":
            os.mkfifo(path)
        elif kind == "directory":
            path.mkdir()
        else:
            path.symlink_to(copy / "entry.py")
        try:
            refuses(partial(verify, copy))
            if kind == "link":
                refuses(partial(entry_root, path))
        finally:
            path.rmdir() if kind == "directory" else path.unlink()
    return 8


def main() -> None:
    value: Any
    target = SOURCE / "preflight/artificial-source-controls"
    require(not target.exists(), "Fresh artificial fixture required")
    target.mkdir()
    cases = 0
    try:
        row, schema = artificial()
        sample = record(row, schema, "1240k")
        assert sample is not None
        cases += actual_writer_cases(sample, target)
        for token, expected in (
            ("", None),
            ("not-numeric", None),
            ("NaN", None),
            ("0", 0),
            ("2.5", 2),
            ("3.5", 4),
            ("1,000", 1000),
        ):
            assert rounded(token) == expected
            cases += 1
        refuses(partial(rounded, "inf"))
        cases += 1
        for mean, std, endpoints, refusal in (
            ("", "", (None, None), ""),
            ("0", "", (0, 0), ""),
            ("100", "5", (90, 110), ""),
            ("-1", "", (None, None), "negative_bp"),
            ("1", "2", (None, None), "negative_bp"),
            (str(2**53), "", (None, None), "unsafe_integer_bp"),
            ("100", "-1", (100, 100), ""),
        ):
            c = chronology(mean, std, "")
            assert (c["time_start_bp"], c["time_end_bp"]) == endpoints and c[
                "refusal_reason_code"
            ] == refusal
            assert c["source_mean_bp_text"] == mean and c["date_stddev_bp"] == std
            cases += 1
        for key, value in (
            ("genetic_id", ""),
            ("latitude", ""),
            ("latitude", "not-a-coordinate"),
        ):
            changed = dict(row)
            changed[PREFIXES[key][0]] = value
            assert record(changed, schema, "1240k") is None
            cases += 1
        refuses(
            partial(record, {**row, PREFIXES["latitude"][0]: "nan"}, schema, "1240k")
        )
        cases += 1
        c0 = deepcopy(sample)
        c0["chronology"] = chronology("0", "", "")
        other = deepcopy(sample)
        other["datasets"] = ["ho"]
        other["identity"]["accession_lineage"] = ["dataset:ho"]
        merged = merge(c0, other)
        assert (
            merged["chronology"]["time_mean_bp"] == 0
            and merged["chronology"]["time_end_bp"] == 110
        )
        assert (
            merged["datasets"] == ["1240k", "ho"]
            and merged["identity"]["stable_token"] == sample["identity"]["stable_token"]
        )
        assert merged["master_id"] != merged["identity"]["stable_token"]
        cases += 1
        cases += actual_writer_cases(merged, target)
        for spans, unequal, disjoint, gap_count in (
            ([(0, 0), (90, 110)], 1, 1, 1),
            ([(90, 110), (90, 110)], 0, 0, 0),
            ([(90, 110), (100, 120)], 1, 0, 0),
            ([(90, 110), (110, 120)], 1, 0, 0),
            ([(0, 1), (3, 4), (1, 3)], 3, 1, 0),
            ([(None, None), (90, 110)], 0, 0, 0),
        ):
            originals = []
            joined = None
            for ordinal, (start, end) in enumerate(spans, 1):
                item = deepcopy(sample)
                item["chronology"]["time_start_bp"] = start
                item["chronology"]["time_end_bp"] = end
                originals.append(
                    {
                        "dataset": "artificial",
                        "source_row_ordinal_after_header": ordinal,
                        "chronology": deepcopy(item["chronology"]),
                    }
                )
                joined = item if joined is None else merge(joined, item)
            assert joined is not None
            result = duplicate_support_audit({"test": originals}, {"test": joined})
            assert result["counts"]["unequal_span_pairs"] == unequal
            assert result["counts"]["disjoint_span_pairs"] == disjoint
            audit = result["duplicates"][0]
            assert len(audit["open_gaps_introduced_by_hull"]) == gap_count
            assert audit["ordered_native_rows"] == originals
            assert bool(audit["scientific_support_refusal"]) == bool(gap_count)
            cases += 1
        assert duplicate_support_audit({}, {})["counts"]["duplicate_ids"] == 0
        cases += 1

        for value in (False, 0.0, "0"):
            refuses(partial(same, {"native_exit": 0}, {"native_exit": value}))
            cases += 1
        refuses(partial(same, math.nan, math.nan))
        refuses(partial(same, -0.0, 0.0))
        cases += 2
        old = {key: csv_record(sample)[key] for key in FIELDS}
        old["schema_version"] = "adna-sample-record-export.v1"
        assert historical([old], [csv_record(sample)])["all_other_legacy_fields_equal"]
        changed = dict(old)
        changed["time_start_bp"] = "0"
        assert not historical([changed], [csv_record(sample)])[
            "all_other_legacy_fields_equal"
        ]
        assert (
            historical([], [csv_record(sample)])["differences"][0]["missing_from"]
            == "old_v1"
        )
        refuses(partial(historical, [old, old], [csv_record(sample)]))
        cases += 4
        assert len(CURRENT_FIELDS) == 29 and len(FIELDS) == 27
        require(
            set(typed_record(sample)["coordinates"])
            == {
                "latitude",
                "longitude",
                "latitude_text",
                "longitude_text",
                "confidence",
            },
            "Nested typed coordinates required",
        )
        assert (
            DEFAULTS["source_native_identity_kind"] == "biological_sample"
            and DEFAULTS["chronology_provenance_path"] == ""
        )
        cases += 2
        refuses(partial(header_schema, list(FIELDS)))
        cases += 1
        path = target / "plan.json"
        raw = b'{"candidate":"artificial"}\n'
        path.write_bytes(raw)
        sha = hashlib.sha256(raw).hexdigest()
        assert registered_plan(path, sha) == {"candidate": "artificial"}
        refuses(partial(registered_plan, path, "0" * 64))
        path.write_bytes(raw + b" ")
        refuses(partial(registered_plan, path, sha))
        path.write_bytes(raw)
        alias = target / "alias.json"
        alias.symlink_to(path)
        refuses(partial(registered_plan, alias, sha))
        alias.unlink()
        cases += 4
        from run import validate_stages

        plan: dict[str, Any] = {
            "resources": RESOURCES,
            "stages": [
                {
                    "id": name,
                    "action": action,
                    "timeout_seconds": 180,
                    "argv": [
                        str(PYTHON),
                        "-I",
                        "-B",
                        str(SOURCE / "entry.py"),
                        action,
                        "--plan",
                        str(path),
                    ],
                }
                for name, action in (
                    ("maintained-sample-producer", "producer"),
                    ("independent-source-sample-observer", "observer"),
                )
            ],
        }
        validate_stages(plan, path)
        cases += 1
        for key, value in (
            ("id", "other"),
            ("action", "model"),
            ("timeout_seconds", 180.0),
            ("argv", ["other"]),
        ):
            changed_plan = deepcopy(plan)
            changed_plan["stages"][0][key] = value
            refuses(partial(validate_stages, changed_plan, path))
            cases += 1
        from execute import DenyNumerical

        deny = DenyNumerical()
        assert deny.find_spec("bijux_pollenomics.adna") is None
        for name in ("bijux_pollenomics_lra", "pollenomics.api"):
            refuses(partial(deny.find_spec, name))
            cases += 1
        assert len(deny.attempts) == 2
        cases += 1
        declaration = json.loads((SOURCE / "declared-inputs.json").read_bytes())
        fixture = target / "source"
        fixture.mkdir()
        for item in declaration["inputs"]:
            file = fixture / item["path"]
            file.parent.mkdir(parents=True, exist_ok=True)
            file.write_bytes(b"artificial only")
            item.update(
                sha256=hashlib.sha256(b"artificial only").hexdigest(),
                bytes=len(b"artificial only"),
            )
        declaration["source_root"] = str(fixture)
        assert len(expected_private(declaration)) == 7
        cases += 1
        last = fixture / declaration["inputs"][-1]["path"]
        last.write_bytes(b"changed")
        refuses(partial(expected_private, declaration))
        last.write_bytes(b"artificial only")
        cases += 1
        from contracts import source_namespace
        from runtime_contracts import verify_base_namespaces

        snapshot = source_namespace(declaration)
        verify_base_namespaces([snapshot])
        cases += 1
        extra = Path(snapshot["root"]) / "extra-empty-directory"
        extra.mkdir()
        refuses(partial(verify_base_namespaces, [snapshot]))
        extra.rmdir()
        cases += 1
        parent = fixture / "data/aadr/v66/ho"
        stored = parent.with_name("original-ho")
        parent.rename(stored)
        parent.symlink_to(stored)
        try:
            refuses(partial(expected_private, declaration))
        finally:
            parent.unlink()
            stored.rename(parent)
        cases += 1
        cases += entry_cases(target)
        import contracts

        old_pin = contracts.__dict__["pin"]
        old_loader = os.environ.get("DYLD_SOURCE_FIXTURE")
        seen: list[object] = []

        def forbidden_pin(path: Path) -> dict[str, Any]:
            seen.append(path)
            raise AssertionError("Loader refusal did not precede pin/tool")

        try:
            contracts.__dict__["pin"] = forbidden_pin
            os.environ["DYLD_SOURCE_FIXTURE"] = ""
            refuses(contracts.identity)
            assert not seen
        finally:
            contracts.__dict__["pin"] = old_pin
            if old_loader is None:
                os.environ.pop("DYLD_SOURCE_FIXTURE", None)
            else:
                os.environ["DYLD_SOURCE_FIXTURE"] = old_loader
        cases += 1
        run_tree = ast.parse((SOURCE / "run.py").read_text())
        assert any(
            isinstance(n, ast.Assign)
            and ast.unparse(n.targets[0])
            == "environment['BIJUX_REGISTERED_PLAN_SHA256']"
            for n in ast.walk(run_tree)
        )
        for filename in ("execute.py", "observe.py"):
            tree = ast.parse((SOURCE / filename).read_text())
            function = next(
                n
                for n in tree.body
                if isinstance(n, ast.FunctionDef) and n.name == "main"
            )
            text = ast.unparse(function)
            assert text.index("stage_plan(") < text.index("execution_scope(")
            if filename == "execute.py":
                assert text.index("execution_scope(") < text.index(
                    "build_homo_sapiens_runtime_manifest_for_version_dir("
                )
            else:
                assert text.index("execution_scope(") < text.index("reconstruct(")
            cases += 1
        print(
            json.dumps(
                {
                    "actual_exit": 0,
                    "artificial_source_groups": cases,
                    "actual_data_API_import_conversion_runtime_or_native_execution": False,
                }
            )
        )
    finally:
        shutil.rmtree(target)


if __name__ == "__main__":
    main()
