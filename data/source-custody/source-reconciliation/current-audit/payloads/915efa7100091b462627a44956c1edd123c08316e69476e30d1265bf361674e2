"""Read native Neotoma entity levels and SEAD denominator contracts independently."""

from __future__ import annotations

from collections import Counter
from pathlib import PurePosixPath
from typing import Any

from review.reader import Reader, digest, object_bytes


def neotoma(reader: Reader) -> dict[str, Any]:
    name = "data/neotoma/relational/manifest.json"
    manifest = reader.obj(name)
    if manifest is None:
        reader.issue("governing_neotoma_manifest_missing", name)
        return {"accounting_status": "missing_manifest", "path": name}
    surfaces = []
    dataset_ids = set()
    variables = []
    for key, spec in sorted(manifest["surfaces"].items()):
        ids = []
        count = 0
        countries: Counter[str] = Counter()
        for part in spec["parts"]:
            relative = str(PurePosixPath(name).parent / part["path"])
            raw = reader.verified(relative, part)
            if raw is None:
                continue
            payload = object_bytes(raw)
            rows = payload["rows"]
            if len(rows) != part["row_count"] or payload["row_count"] != len(rows):
                reader.issue("relational_part_count_mismatch", relative)
            count += len(rows)
            for row in rows:
                identity = row.get(spec["id_field"])
                if identity is None:
                    reader.issue("relational_identity_missing", relative)
                else:
                    ids.append(identity)
                countries[row.get("country_code") or "unresolved"] += 1
                if key == "datasets":
                    dataset_ids.add(row["source_dataset_id"])
                elif key == "variables":
                    variables.append(row)
        duplicates = sorted(
            identity for identity, total in Counter(ids).items() if total > 1
        )
        if duplicates:
            reader.issue(
                "relational_duplicate_identity", name, surface=key, ids=duplicates
            )
        if count != spec["row_count"]:
            reader.issue(
                "relational_surface_count_mismatch",
                name,
                surface=key,
                declared=spec["row_count"],
                observed=count,
            )
        if spec["part_count"] != len(spec["parts"]):
            reader.issue("relational_part_inventory_mismatch", name, surface=key)
        surfaces.append(
            {
                "entity_level": key,
                "declared_row_count": spec["row_count"],
                "observed_row_count": count,
                "distinct_identity_count": len(set(ids)),
                "identity_set_sha256": digest(sorted(set(ids))),
                "duplicate_ids": duplicates,
                "country_counts": dict(sorted(countries.items())),
            }
        )
    raw_name = "data/neotoma/raw/neotoma_pollen_dataset_downloads/manifest.json"
    manifest_raw = reader.obj(raw_name)
    request_audit: dict[str, Any] = {"accounting_status": "missing_raw_manifest"}
    if manifest_raw is None:
        reader.issue("raw_download_manifest_missing", raw_name)
    else:
        requested, downloaded = (
            manifest_raw["requested_dataset_ids"],
            manifest_raw["downloaded_dataset_ids"],
        )
        for key, ids in (("requested", requested), ("downloaded", downloaded)):
            if manifest_raw[key + "_dataset_count"] != len(ids) or len(set(ids)) != len(
                ids
            ):
                reader.issue("dataset_request_count_mismatch", raw_name, field=key)
        differences = {
            "requested_not_downloaded": sorted(set(requested) - set(downloaded)),
            "downloaded_not_requested": sorted(set(downloaded) - set(requested)),
            "downloaded_not_normalized": sorted(set(downloaded) - dataset_ids),
            "normalized_not_downloaded": sorted(dataset_ids - set(downloaded)),
        }
        if any(differences.values()):
            reader.issue("dataset_request_identity_mismatch", raw_name, **differences)
        raw_ids = []
        for part in manifest_raw.get("parts", []):
            relative = str(PurePosixPath(raw_name).parent / part["filename"])
            payload_bytes = reader.verified(relative, part)
            if payload_bytes is None:
                continue
            payload = object_bytes(payload_bytes)
            identities = [
                row["site"]["dataset"]["datasetid"] for row in payload["rows"]
            ]
            raw_ids.extend(identities)
            if (
                len(identities) != part["row_count"]
                or len(identities) != payload["row_count"]
                or sorted(identities) != sorted(part["downloaded_dataset_ids"])
                or sorted(identities) != sorted(payload["downloaded_dataset_ids"])
            ):
                reader.issue("raw_download_part_identity_mismatch", relative)
        if "parts" in manifest_raw and (
            sorted(raw_ids) != sorted(downloaded)
            or manifest_raw["part_count"] != len(manifest_raw["parts"])
        ):
            reader.issue("raw_download_inventory_mismatch", raw_name)
        request_audit = {
            "requested_dataset_ids": requested,
            "downloaded_dataset_ids": downloaded,
            "normalized_dataset_ids": sorted(dataset_ids),
            **differences,
            "raw_part_dataset_ids": sorted(raw_ids),
            "scope_note": "Pinned request scope; not all records in the live provider.",
        }
    return {
        "manifest_path": name,
        "source_snapshot_id": manifest["source_snapshot_id"],
        "surfaces": surfaces,
        "requests": request_audit,
        "taxa_review_inventory": variables,
        "semantic_confirmation": "not_established_by_count_reconciliation",
    }


def sead(reader: Reader, governing: str | None) -> dict[str, Any]:
    if governing is None:
        reader.issue(
            "governing_sead_manifest_reference_missing",
            "data/source_fact_ownership_registry.json",
        )
        return {"accounting_status": "missing_governing_manifest_reference"}
    manifest = reader.obj(governing)
    if manifest is None:
        reader.issue("governing_sead_manifest_missing", governing)
        return {"accounting_status": "missing_governing_manifest", "path": governing}
    parent = PurePosixPath(governing).parent
    for row in manifest["files"]:
        reader.verified(str(parent / row["path"]), row)
    raw_name = "data/sead/raw/acquisitions/" + parent.name + "/manifest.json"
    raw = reader.obj(raw_name)
    if raw is None:
        reader.issue("sead_acquisition_manifest_missing", raw_name)
    else:
        for row in raw["files"]:
            reader.verified(str(PurePosixPath(raw_name).parent / row["path"]), row)
    native_name = str(parent / "source_native_observations.json")
    native = reader.obj(native_name)
    if native is None:
        reader.issue("sead_native_observation_index_missing", native_name)
    result = {
        key: value
        for key, value in manifest.items()
        if key.endswith("count") or key in ("build_id", "source_run_id")
    }
    result["governing_manifest_path"] = governing
    result["acquisition_receipt"] = (
        None
        if raw is None
        else {key: value for key, value in raw.items() if key != "files"}
    )
    if native is not None:
        result["source_native_denominators"] = {
            key: value
            for key, value in native.items()
            if key.endswith("counts") or key == "observation_count"
        }
        total = native["observation_count"]
        for key in (
            "country_counts",
            "observation_table_counts",
            "chronology_link_status_counts",
            "taxon_status_counts",
            "unit_status_counts",
        ):
            if sum(native[key].values()) != total:
                reader.issue(
                    "source_native_denominator_mismatch", native_name, dimension=key
                )
        if total != manifest["observation_count"]:
            reader.issue("source_native_observation_count_mismatch", native_name)
    if (
        manifest["eligible_event_count"] + manifest["refused_event_count"]
        != manifest["observation_count"]
    ):
        reader.issue("event_disposition_count_mismatch", governing)
    result["semantic_confirmation"] = "not_established_by_file_reconciliation"
    return result
