"""Independently account for typed reads and manifest mismatches in owned inputs."""

from __future__ import annotations

import hashlib
import json
import math
from pathlib import Path
from typing import Any


def require(value: object, reason: str) -> None:
    if not value:
        raise ValueError(reason)


def digest(value: object) -> str:
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def same(left: object, right: object) -> None:
    require(type(left) is type(right), "Source audit value type changed")
    if isinstance(left, dict) and isinstance(right, dict):
        require(set(left) == set(right), "Source audit field membership changed")
        for key in left:
            same(left[key], right[key])
    elif isinstance(left, list) and isinstance(right, list):
        require(len(left) == len(right), "Source audit ordered membership changed")
        for a, b in zip(left, right, strict=True):
            same(a, b)
    elif isinstance(left, float) and isinstance(right, float):
        require(
            math.isfinite(left)
            and math.isfinite(right)
            and left == right
            and (left != 0 or math.copysign(1, left) == math.copysign(1, right)),
            "Source audit finite numeric value changed",
        )
    else:
        require(left == right, "Source audit scalar changed")


def object_bytes(raw: bytes) -> dict[str, Any]:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        require(len(rows) == len({key for key, _ in rows}), "Duplicate JSON source key")
        return dict(rows)

    def reject(value: str) -> None:
        raise ValueError("Nonfinite JSON source: " + value)

    value = json.loads(raw, object_pairs_hook=pairs, parse_constant=reject)
    require(type(value) is dict, "Source JSON object required")
    assert isinstance(value, dict)
    return value


class Reader:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.files: dict[str, dict[str, Any]] = {}
        self.verifications: dict[str, dict[str, Any]] = {}
        self.issues: list[dict[str, Any]] = []

    def path(self, name: str) -> Path:
        relative = Path(name)
        require(
            not relative.is_absolute() and ".." not in relative.parts,
            "Independent read leaves owned repository",
        )
        path = self.root / relative
        require(
            not any(node.is_symlink() for node in (path, *path.parents)),
            "Independent source read alias refused",
        )
        return path

    def issue(self, code: str, name: str, **details: Any) -> None:
        self.issues.append({"reason_code": code, "path": name, **details})

    def raw(self, name: str) -> bytes | None:
        path = self.path(name)
        if not path.is_file():
            record: dict[str, Any] = {"path": name, "presence": "missing"}
            raw = None
        else:
            raw = path.read_bytes()
            record = {
                "path": name,
                "presence": "present",
                "byte_count": len(raw),
                "sha256": hashlib.sha256(raw).hexdigest(),
            }
        if name in self.files:
            same(self.files[name], record)
        self.files[name] = record
        return raw

    def obj(self, name: str) -> dict[str, Any] | None:
        raw = self.raw(name)
        return None if raw is None else object_bytes(raw)

    def verified(self, name: str, spec: dict[str, Any]) -> bytes | None:
        raw = self.raw(name)
        if raw is None:
            self.issue("manifest_file_missing", name)
            return None
        observed = self.files[name]
        self.verifications[name] = {
            "path": name,
            "manifest_digest_available": spec.get("sha256") is not None,
            "manifest_byte_count_available": spec.get("byte_count") is not None,
            "observed_sha256": observed["sha256"],
        }
        for key in ("sha256", "byte_count"):
            expected = spec.get(key)
            if key == "sha256" and isinstance(expected, str):
                expected = expected.removeprefix("sha256:")
            if expected is not None and expected != observed[key]:
                self.issue(
                    "manifest_digest_or_size_mismatch",
                    name,
                    field=key,
                    expected=expected,
                    actual=observed[key],
                )
        return raw


def indexed(value: dict[str, Any], key: str) -> dict[str, dict[str, Any]]:
    rows = value["rows"]
    require(
        type(rows) is list and value.get("row_count", len(rows)) == len(rows),
        "Governing registry row count differs",
    )
    result = {row[key]: row for row in rows}
    require(len(result) == len(rows), "Duplicate governing registry identity")
    return result
