def refuses(call: Any) -> None:
    try:
        call()
    except (ValueError, TypeError, KeyError):
        return
    raise AssertionError("Artificial invalid contract accepted")


def emit(root: Path, name: str, value: Any) -> Path:
    target = root / name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(value, sort_keys=True) + "\n")
    return target


def source_modules() -> dict[str, types.ModuleType]:
    package = types.ModuleType("controlled_source_audit")
    package.__path__ = []
    sys.modules[package.__name__] = package
    modules = {}
    for name in ("evidence", "manifests", "landclim", "audit", "intake_custody"):
        module = types.ModuleType(package.__name__ + "." + name)
        module.__package__ = package.__name__
        module.__file__ = str(MAINTAINED / (name + ".py"))
        sys.modules[module.__name__] = module
        exec(
            compile((MAINTAINED / (name + ".py")).read_text(), module.__file__, "exec"),
            module.__dict__,
        )
        modules[name] = module
    return modules


def intake_fixture(root: Path, private: Path) -> None:
    receipts = []
    archives = []
    for ident in sorted(intakes.IDS):
        received = not ident.endswith("OPENLAND-001")
        archive = None
        if received:
            path = private / (ident + ".archive")
            path.write_bytes(b"controlled original archive " + ident.encode())
            archive = {
                "intake_id": ident,
                "relative_path": path.name,
                "sha256": pin(path)["sha256"],
                "bytes": path.stat().st_size,
            }
            archives.append(archive)
        receipt = {
            "intake_id": ident,
            "lifecycle_state": "received" if received else "unavailable",
            "delivery": {
                "materialization_status": "received" if received else "unavailable",
                "sha256": archive["sha256"] if archive else None,
                "byte_size": archive["bytes"] if archive else None,
            },
            "country_coverage": [
                {"country_code": country, "content_state": "unqualified"}
                for country in ("DK", "FI", "NO", "SE")
            ],
            "decision": {
                "public_release_allowed": False,
                "disposition": "retained_only",
            },
            "rights": {"status": "restricted"},
        }
        path = emit(private, "source-intakes/receipts/" + ident + ".json", receipt)
        receipts.append(
            {
                "intake_id": ident,
                "path": path.name,
                "sha256": pin(path)["sha256"],
                "bytes": path.stat().st_size,
            }
        )
    emit(
        private,
        "source-intakes/custody.json",
        {
            "schema_version": "source-intake-custody.v1",
            "receipts": receipts,
            "archives": archives,
        },
    )
    lookup = {row["intake_id"]: row for row in archives}
    emit(
        root,
        intakes.REPORTS["EXT-2026-09-04-OPENLAND-002"],
        {
            "source_archive": {
                "sha256": lookup["EXT-2026-09-04-OPENLAND-002"]["sha256"]
            },
            "independent_vegetation_benchmarks": 0,
            "rights": {"public_map_or_export_authorized": False},
        },
    )
    emit(
        root,
        intakes.REPORTS["EXT-2026-09-04-ROOTSI-001"],
        {"admission": {"ecological": False, "rights": False}},
    )
    emit(
        private,
        "landclim/rootsi-workbooks/manifest.json",
        {"archive_sha256": lookup["EXT-2026-09-04-ROOTSI-001"]["sha256"]},
    )


