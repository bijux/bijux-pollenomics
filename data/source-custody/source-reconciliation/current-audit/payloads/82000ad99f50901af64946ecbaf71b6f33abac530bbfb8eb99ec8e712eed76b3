"""Reconstruct the complete current accounting audit and its selective summary."""

from __future__ import annotations

from pathlib import Path
from typing import Any

from review import intakes, landclim, registries, relations
from review.reader import Reader, digest


def reconstruct(
    repository: Path, private_root: Path
) -> tuple[dict[str, Any], dict[str, Any]]:
    reader = Reader(repository)
    base, families, ownership = registries.reconstruct(reader)
    neotoma = relations.neotoma(reader) if "neotoma" in families else None
    sead = (
        relations.sead(
            reader,
            ownership.get("sead_archaeology_context", {}).get("governing_surface_path"),
        )
        if "sead" in families
        else None
    )
    climate = landclim.reconstruct(reader) if "landclim" in families else None
    files = sorted(reader.files.values(), key=lambda row: row["path"])
    findings = sorted(
        reader.issues, key=lambda row: (row["path"], row["reason_code"], digest(row))
    )
    audit = {
        "schema_version": "source-completion-audit.v1",
        **base,
        "neotoma_relational_reconciliation": neotoma,
        "sead_authority_reconciliation": sead,
        "landclim_publication_inventory": climate,
        "input_files": files,
        "manifest_byte_verifications": sorted(
            reader.verifications.values(), key=lambda row: row["path"]
        ),
        "input_closure_sha256": digest(files),
        "accounting_findings": findings,
        "accounting_checks_pass": not findings,
        "full_source_confirmation": False,
        "scope": "The source registry and explicitly consumed manifests; no assertion of live-provider completeness, qualified approval, or unseen intake admission.",
        "status_namespace_note": "Original source-stage, country-availability and semantic-capability records retain their native fields; accounting_checks_pass is only mechanical reconciliation.",
        "external_intake_custody": intakes.reconstruct(repository, private_root),
    }
    audit["audit_sha256"] = digest(audit)
    return audit, summary(audit)


def summary(audit: dict[str, Any]) -> dict[str, Any]:
    rows = []
    for row in audit["source_rows"]:
        stage = row["source_stage_record"]
        rows.append(
            {
                "source_key": row["source_key"],
                "evidence_role": row["evidence_role"],
                **{
                    key: stage[key]
                    for key in (
                        "authority_status",
                        "raw_status",
                        "normalized_status",
                        "reviewed_status",
                        "published_status",
                    )
                },
                "nordic_publication_availability": {
                    cell["country_code"]: cell["availability_status"]
                    for cell in row["country_availability_records"]
                    if cell["country_code"] in {"DK", "FI", "NO", "SE"}
                    and cell["country_dimension"] == "publication"
                },
                "missing_supported_dimensions": row["missing_supported_dimensions"],
                "qualified_review_dimensions": row["qualified_review_dimensions"],
                "full_confirmation": row["v2_full_confirmation"],
            }
        )
    intake = audit["external_intake_custody"]
    custody = {
        key: intake[key]
        for key in (
            "private_custody_manifest_sha256",
            "receipt_count",
            "verified_original_archives",
            "country_claim_rows",
            "scientific_admission",
        )
    }
    custody["receipts"] = [
        {
            **{
                key: row[key]
                for key in (
                    "intake_id",
                    "receipt_sha256",
                    "historical_disposition",
                    "historical_rights_status",
                    "historical_public_release_allowed",
                    "scientific_admission_from_custody",
                )
            },
            "country_content_states": {
                cell["country_code"]: cell["content_state"]
                for cell in row["historical_country_coverage"]
            },
        }
        for row in intake["historical_receipts"]
    ]
    neotoma, sead, climate = (
        audit[key] or {}
        for key in (
            "neotoma_relational_reconciliation",
            "sead_authority_reconciliation",
            "landclim_publication_inventory",
        )
    )
    result = {
        "schema_version": "source-reconciliation-summary.v1",
        "full_audit_sha256": audit["audit_sha256"],
        **{
            key: audit[key]
            for key in (
                "input_closure_sha256",
                "source_count",
                "country_cell_count",
                "capability_cell_count",
                "accounting_checks_pass",
                "accounting_findings",
                "full_source_confirmation",
                "scope",
                "status_namespace_note",
            )
        },
        "input_file_count": len(audit["input_files"]),
        "present_input_file_count": sum(
            row["presence"] == "present" for row in audit["input_files"]
        ),
        "manifest_byte_verification_count": len(audit["manifest_byte_verifications"]),
        "source_rows": rows,
        "external_intake_custody": custody,
        "source_specific_reconciliation": {
            "neotoma_semantic_confirmation": neotoma.get("semantic_confirmation"),
            "sead_semantic_confirmation": sead.get("semantic_confirmation"),
            "sead_source_table_count": sead.get("source_table_count"),
            "sead_observation_count": sead.get("observation_count"),
            "sead_eligible_event_count": sead.get("eligible_event_count"),
            "sead_refused_event_count": sead.get("refused_event_count"),
            "landclim_semantic_confirmation": climate.get("semantic_confirmation"),
            "landclim_taxon_row_count": climate.get("taxon_row_count"),
            "landclim_taxonomy_pft_count": climate.get("taxonomy_pft_count"),
        },
    }
    result["summary_sha256"] = digest(result)
    return result
