"""Run the maintained source accounting APIs on a frozen, owned read projection."""

from __future__ import annotations

import argparse
import importlib.abc
from pathlib import Path
import sys
from typing import Any

from contracts import bootstrap, checkpoint, execution_scope, require, stage_plan, write
from inputs.closure import verify_prepared_closure
from source_inputs import pin


class DenyNumerical(importlib.abc.MetaPathFinder):
    def __init__(self) -> None:
        self.attempts: list[str] = []

    def find_spec(self, fullname: str, path: Any = None, target: Any = None) -> Any:
        if fullname.split(".")[0] in {"bijux_pollenomics_lra", "pollenomics"}:
            self.attempts.append(fullname)
            raise ImportError("Numerical engines are outside source accounting")
        return None


def origins(plan: dict[str, Any]) -> list[dict[str, Any]]:
    owned = Path(plan["owned_repository"])
    protected = {row["path"]: row for row in plan["input_pins"]}
    rows = []
    for name, module in sorted(sys.modules.items()):
        if name.split(".")[0] not in {
            "bijux_pollenomics",
            "bijux_pollenomics_dev",
            "bijux_pollenomics_lra",
            "pollenomics",
        }:
            continue
        filename = getattr(module, "__file__", None)
        require(type(filename) is str, "First-party module lacks physical source")
        assert isinstance(filename, str)
        path = Path(filename)
        row = pin(path)
        require(
            path.is_relative_to(owned) and protected.get(str(path)) == row,
            "First-party import left complete pinned owned sources",
        )
        if hasattr(module, "__path__"):
            require(
                list(module.__path__) == [str(path.parent)],
                "Mixed package namespace refused",
            )
        rows.append({"module": name, **row})
    require(rows, "Actual maintained package origins absent")
    return rows


def call_contract(plan: dict[str, Any]) -> list[dict[str, Any]]:
    owned = plan["owned_repository"]
    return [
        {"call": "build_source_audit", "root": owned},
        {
            "call": "build_intake_custody_report",
            "repository": owned,
            "private_source_root": plan["owned_private_root"],
        },
        {
            "call": "summarize_source_audit",
            "input": "complete_current_audit_with_intake_custody",
        },
        {
            "call": "publish_json_outputs",
            "outputs": [
                str(Path(plan["output"]) / name)
                for name in ("full-current-audit.json", "summary-current.json")
            ],
        },
    ]


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = stage_plan(args.plan)
    authority, scope = execution_scope(plan)
    roots = bootstrap(plan)
    denial = DenyNumerical()
    require(
        not any(
            name.split(".")[0] in {"bijux_pollenomics_lra", "pollenomics"}
            for name in sys.modules
        ),
        "Numerical engine already imported",
    )
    sys.meta_path.insert(0, denial)
    network: list[str] = []

    def deny_network(event: str, arguments: tuple[Any, ...]) -> None:
        if event in {"socket.connect", "socket.getaddrinfo"}:
            network.append(event)
            raise RuntimeError("Source acquisition prohibited: " + event)

    sys.addaudithook(deny_network)
    from bijux_pollenomics_dev.source_completion.audit import (
        build_source_audit,
        summarize_source_audit,
    )
    from bijux_pollenomics_dev.source_completion.evidence import digest
    from bijux_pollenomics_dev.source_completion.intake_custody import (
        build_intake_custody_report,
    )
    from bijux_pollenomics_dev.source_completion.publication.json_outputs import (
        publish_json_outputs,
    )

    repository = Path(plan["owned_repository"])
    audit = build_source_audit(repository)
    require(
        sorted(row["path"] for row in audit["input_files"])
        == plan["current_input_closure"]["repository"]["reader_paths"],
        "Actual maintained reader path scope differs from frozen literal API closure",
    )
    audit["external_intake_custody"] = build_intake_custody_report(
        repository, Path(plan["owned_private_root"])
    )
    audit["audit_sha256"] = digest(
        {key: value for key, value in audit.items() if key != "audit_sha256"}
    )
    summary = summarize_source_audit(audit)
    output = Path(plan["output"])
    publish_json_outputs(
        [
            (output / "full-current-audit.json", audit),
            (output / "summary-current.json", summary),
        ]
    )
    observed = origins(plan)
    require(
        not network and not denial.attempts,
        "Disallowed source/network/numerical attempt",
    )
    verify_prepared_closure(plan["current_input_closure"])
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    write(
        output / "source-execution.json",
        {
            "schema_version": "current-source-audit-execution.v1",
            "candidate": plan["candidate"],
            "actual_exit": 0,
            "actual_argv": sys.orig_argv,
            "actual_executable": sys.executable,
            "owned_package_search_roots": roots,
            "maintained_public_calls": call_contract(plan),
            "first_party_origins": observed,
            "products": [
                pin(output / name)
                for name in ("full-current-audit.json", "summary-current.json")
            ],
            "accounting_checks_pass": audit["accounting_checks_pass"],
            "accounting_finding_count": len(audit["accounting_findings"]),
            "native_exit_means_API_execution_not_zero_accounting_findings": True,
            "numerical_import_attempts": denial.attempts,
            "network_attempts": network,
            "historical_full_audit_recovered": False,
            "old_summary_byte_equality_claimed": False,
            "live_provider_completeness_or_scientific_admission": False,
        },
    )
