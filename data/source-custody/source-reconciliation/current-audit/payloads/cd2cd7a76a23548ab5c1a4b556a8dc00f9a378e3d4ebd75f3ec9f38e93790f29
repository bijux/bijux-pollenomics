def main() -> None:
    global COUNT
    changed: Any
    value: Any
    plan, ledger, source, manifest, peer, runtime = source_fixture()
    data = packet.data_identity_rows(plan)
    assert len(data) == 1198
    COUNT += 1
    correspondence = packet.data_copy_correspondence(plan)
    assert len(correspondence) == 599 and all(
        row["payload_member"] is None
        and row["original_and_sealed_copy_inputs_required"] is True
        for row in correspondence
    )
    COUNT += 1
    protected = packet.retention_input_rows(plan)
    assert len(protected) == 63315 and {
        row["original"]["path"] for row in correspondence
    } <= {row["path"] for row in protected}
    COUNT += 1
    changed_plan = deepcopy(plan)
    changed_plan["input_pins"][0]["sha256"] = "0" * 64
    refusal(lambda: packet.retention_input_rows(changed_plan))
    roles = packet.input_roles(plan, ledger, source, manifest, peer, runtime)
    assert (
        len(roles) == 63315
        and sum(row["payload_member"] is None for row in roles) == 61080
    )
    COUNT += 1
    assert all(
        row["payload_member"] is None
        for row in roles
        if row["identity"]["path"] in data
    )
    COUNT += 1
    joins = packet.source_join(plan, ledger)
    assert (
        len(joins) == 7142
        and sum(row["role"] == "bytecode_identity_only" for row in joins) == 4356
    )
    COUNT += 1
    catalogue = {
        "files": ledger["copied_sources"]
        + ledger["private_copies"]
        + [identity("/fixture/native/public-" + str(i)) for i in range(11)]
    }
    selected = packet.selected_catalogue_rows(plan, catalogue)
    assert len(selected) == 2204 and not {row["path"] for row in selected}.intersection(
        data
    )
    COUNT += 1
    for target, field, value in [
        ("private_copies", 0, "bad"),
        ("selected_execution_sources", 0, "bad"),
    ]:
        changed = deepcopy(ledger)
        changed[target][field]["sha256"] = hashlib.sha256(value.encode()).hexdigest()
        refusal(lambda changed=changed: packet.source_join(plan, changed))
    changed = deepcopy(ledger)
    changed["omitted_unselected_cache_bytecode"][0]["executed_or_copied"] = True
    refusal(lambda changed=changed: packet.source_join(plan, changed))
    changed = deepcopy(plan)
    changed["input_pins"][0]["bytes"] = True
    refusal(
        lambda: packet.input_roles(changed, ledger, source, manifest, peer, runtime)
    )
    changed = deepcopy(catalogue)
    changed["files"].pop()
    changed["files"] = [
        r for r in changed["files"] if r["path"] != ledger["private_copies"][0]["path"]
    ]
    refusal(lambda: packet.selected_catalogue_rows(plan, changed))
    fixture = native_fixture()
    result = packet.qualify_scope(*fixture)
    assert (
        result["full_source_confirmation"] is False
        and result["original_owner_remains_unresolved"] is True
    )
    COUNT += 1
    mutations: list[tuple[int, str, list[Any]]] = [
        (1, "actual_exit", [True, 1]),
        (2, "child_native_exit", [False, 1]),
        (3, "accounting_finding_count", [False, 1]),
        (4, "source_count", [11.0, True]),
        (4, "current_consumed_input_count", [321.0]),
        (4, "full_source_confirmation", [True]),
        (4, "source_execution_sha256", ["0" * 64]),
    ]
    for index, key, values in mutations:
        for value in values:
            changed = deepcopy(fixture)
            changed[index][key] = value
            refusal(lambda changed=changed: packet.qualify_scope(*changed))
    for value in [True, 359, 361]:
        changed = deepcopy(fixture)
        changed[1]["stages"][0]["timeout_seconds"] = value
        refusal(lambda changed=changed: packet.qualify_scope(*changed))
    for mutation in ("omit", "swap", "argv", "scope", "module", "product"):
        changed = deepcopy(fixture)
        if mutation == "omit":
            changed[0]["stages"].pop()
        elif mutation == "swap":
            changed[1]["stages"].reverse()
        elif mutation == "argv":
            changed[1]["stages"][0]["argv"][4] = "observer"
        elif mutation == "scope":
            changed[3]["historical_full_audit_recovered"] = True
        elif mutation == "module":
            changed[3]["first_party_origins"][0]["path"] = "/foreign/module.py"
        else:
            changed[3]["products"][0]["bytes"] = 1
        refusal(lambda changed=changed: packet.qualify_scope(*changed))
    inner = identity("/fixture/native/source-audit-terminal.json")
    line = (json.dumps({"terminal": inner, "actual_exit": 0}) + "\n").encode()
    outer = {
        "stdout": {
            "path": "/fixture/native/launch.stdout",
            "sha256": hashlib.sha256(line).hexdigest(),
            "bytes": len(line),
        },
        "stderr": identity("/fixture/native/launch.stderr"),
    }
    packet.outer_stream_correspondence({"files": []}, outer, inner)
    COUNT += 1
    refusal(
        lambda: packet.outer_stream_correspondence(
            {"files": [outer["stdout"]]}, outer, inner
        )
    )
    changed = deepcopy(outer)
    changed["stdout"]["bytes"] += 1
    refusal(lambda: packet.outer_stream_correspondence({"files": []}, changed, inner))
    for name in (".", "../payload", "payloads/" + "g" * 64, "/payloads/" + "0" * 64):
        refusal(lambda name=name: packet.member_name(name))
    for raw in (b'{"x":1,"x":2}', b'{"x":NaN}'):
        refusal(lambda raw=raw: packet.json_object(raw))
    refusal(lambda: packet.same({"first": 1, "second": 2}, {"second": 2, "first": 1}))
    with tempfile.TemporaryDirectory(
        dir=Path(__file__).parent / "preflight"
    ) as directory:
        root = Path(directory)
        directory_target = root / "target"
        directory_target.mkdir()
        alias = root / "alias"
        alias.symlink_to(directory_target)
        proof = {
            "lexical_path": str(alias),
            "physical_target": str(directory_target),
            "target_type": "directory",
            "target_contents_read_or_copied": False,
            "full_subtree_or_historical_custody_claimed": False,
            "raw_alias_chain": [
                {
                    "path": str(alias),
                    "raw_link": str(directory_target),
                    "physical_target": str(directory_target),
                    "target_type": "directory",
                }
            ],
        }
        contracts.verify_directory_observation(proof)
        COUNT += 1
        (directory_target / "unconsumed").write_text(
            "An unconsumed subtree is not a source body admission"
        )
        contracts.verify_directory_observation(proof)
        COUNT += 1
        alias.unlink()
        alias.symlink_to(directory_target.name)
        refusal(lambda: contracts.verify_directory_observation(proof))
        alias.unlink()
        alias.symlink_to(directory_target)
        changed_proof = {**proof, "target_contents_read_or_copied": True}
        refusal(lambda: contracts.verify_directory_observation(changed_proof))
        contracts.verify_private_ancestry(root, ["target/unconsumed"])
        COUNT += 1
        refusal(lambda: contracts.verify_private_ancestry(root, ["alias/unconsumed"]))
        raw = b'{"schema_version":"artificial-plan"}'
        path = root / "plan.json"
        path.write_bytes(raw)
        sha = hashlib.sha256(raw).hexdigest()
        assert contracts.registered_plan(path, sha) == {
            "schema_version": "artificial-plan"
        }
        COUNT += 1
        refusal(lambda: contracts.registered_plan(path, "0" * 64))
        path.write_bytes(raw + b" ")
        refusal(lambda: contracts.registered_plan(path, sha))
        path.write_bytes(raw)
        path_alias = root / "plan-alias.json"
        path_alias.symlink_to(path)
        refusal(lambda: contracts.registered_plan(path_alias, sha))
        with (
            patch.dict(os.environ, {"DYLD_LIBRARY_PATH": ""}, clear=True),
            patch.object(
                contracts,
                "physical",
                side_effect=AssertionError("Tool pin must not be reached"),
            ),
        ):
            try:
                contracts.identity()
            except ValueError:
                COUNT += 1
            else:
                raise AssertionError("Loader key was not refused before Git pin/tool")
        logical: dict[str, Any] = {
            "resources": deepcopy(contracts.RESOURCES),
            "stages": [],
        }
        for name, action in [
            ("retained-current-source-audit-assembly", "assemble"),
            ("independent-current-source-audit-capture-observer", "observer"),
        ]:
            logical["stages"].append(
                {
                    "id": name,
                    "action": action,
                    "timeout_seconds": 180,
                    "argv": [
                        str(contracts.PYTHON),
                        "-I",
                        "-B",
                        str(contracts.SOURCE / "entry.py"),
                        action,
                        "--plan",
                        str(path),
                    ],
                }
            )
        run.validate_stages(logical, path)
        COUNT += 1
        stage_mutations: list[tuple[str, Any]] = [
            ("timeout_seconds", True),
            ("timeout_seconds", 181),
            ("action", "producer"),
            ("id", "foreign"),
        ]
        for slot, bad_value in stage_mutations:
            changed_logical = deepcopy(logical)
            changed_logical["stages"][0][slot] = bad_value
            refusal(
                lambda changed_logical=changed_logical: run.validate_stages(
                    changed_logical, path
                )
            )
        changed_logical = deepcopy(logical)
        changed_logical["stages"].append(logical["stages"][0])
        refusal(lambda: run.validate_stages(changed_logical, path))
        assert launch.remaining_seconds(10.0, 11.0, 480) == 479.0
        COUNT += 1
        refusal(lambda: launch.remaining_seconds(10.0, 491.0, 480))
        tree = root / "packet"
        tree.mkdir()
        (tree / "payloads").mkdir()
        (tree / "capture.json").write_bytes(b"{}")
        (tree / "payloads/public").write_bytes(b"public")
        observe.exact_packet_tree(tree, {"payloads/public"})
        COUNT += 1
        fifo = tree / "special"
        os.mkfifo(fifo)
        refusal(lambda: observe.exact_packet_tree(tree, {"payloads/public"}))
        fifo.unlink()
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "artificial_controls": COUNT,
                "actual_data_reader_or_retainer": False,
            }
        )
    )


