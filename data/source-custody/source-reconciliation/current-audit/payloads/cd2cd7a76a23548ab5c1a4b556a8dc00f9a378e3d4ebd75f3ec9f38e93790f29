        + copies[:2193]
        + [plan["source_ledger"]]
        + source["files"]
        + [manifest, peer]
        + list(authority.values())
        + runtime["input_pins"]
    )
    assert len(plan["input_pins"]) == 63315
    return plan, ledger, source, manifest, peer, runtime


