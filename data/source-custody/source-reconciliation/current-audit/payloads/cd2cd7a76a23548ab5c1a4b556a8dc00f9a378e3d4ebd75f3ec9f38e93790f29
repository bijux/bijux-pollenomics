COUNT = 0


def refusal(call: Any) -> None:
    global COUNT
    try:
        call()
    except (ValueError, KeyError, TypeError, AssertionError):
        COUNT += 1
        return
    raise AssertionError("Controlled mutation should refuse")


def identity(path: str) -> dict[str, Any]:
    return {
        "path": path,
        "sha256": hashlib.sha256(path.encode()).hexdigest(),
        "bytes": len(path),
    }


