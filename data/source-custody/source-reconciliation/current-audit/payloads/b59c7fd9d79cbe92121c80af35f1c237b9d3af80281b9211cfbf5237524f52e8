"""Preserve literal publication taxonomy, output headings and sum diagnostics."""

from __future__ import annotations

import csv
import hashlib
import io
import math
import re
from typing import Any
from zipfile import ZipFile

from review.reader import Reader


def reconstruct(reader: Reader) -> dict[str, Any]:
    name = "data/landclim/raw/landclim_ii_taxa_pft_ppe_fsp_values.csv"
    raw = reader.raw(name)
    if raw is None:
        reader.issue("landclim_taxonomy_missing", name)
        return {"accounting_status": "missing_taxonomy", "path": name}
    taxonomy: list[dict[str, Any]] = []
    lct = pft = definition = None
    lct_line = pft_line = None
    for line, row in enumerate(
        csv.DictReader(io.StringIO(raw.decode("utf-8-sig"))), start=2
    ):
        taxon = row.get("Plant taxa/Pollen-morphological types")
        if not taxon:
            continue
        if row["Land-cover types (LCTs)"]:
            lct, lct_line = row["Land-cover types (LCTs)"], line
        if row["PFT"]:
            pft, pft_line, definition = row["PFT"], line, row["PFT definition"]
        if lct is None or pft is None:
            raise ValueError("Taxonomy source lacks a preceding explicit heading")
        taxonomy.append(
            {
                "source_row": line,
                "source_taxon": taxon,
                "source_pft": pft,
                "source_pft_definition": definition,
                "pft_heading_row": pft_line,
                "source_lct": lct,
                "lct_heading_row": lct_line,
                "source_fall_speed": row["FSP (m/s)"],
                "source_ppe_sd": row["PPE (SD)"],
                "review_status": "pending_qualified_review",
            }
        )
    pfts = sorted({row["source_pft"] for row in taxonomy})
    codes = set()
    for row in taxonomy:
        match = re.search(r"\(([^)]+)\)$", row["source_lct"])
        if match is None:
            raise ValueError("Taxonomy LCT code absent")
        codes.add(match.group(1))
    lcts = sorted(codes)
    archive_name = "data/landclim/raw/landclim_ii_reveals_results.zip"
    zipped = reader.raw(archive_name)
    if zipped is None:
        reader.issue("landclim_publication_archive_missing", archive_name)
    members = []
    if zipped is not None:
        with ZipFile(io.BytesIO(zipped)) as archive:
            for member in sorted(archive.namelist()):
                if not member.endswith(".csv"):
                    continue
                payload = archive.read(member)
                records = csv.DictReader(io.StringIO(payload.decode("utf-8-sig")))
                fields = records.fieldnames or []
                first = min(
                    (fields.index(code) for code in pfts if code in fields),
                    default=len(fields),
                )
                output_pfts = [code for code in fields[first:] if code not in lcts]
                sums = []
                count = refused = 0
                for record in records:
                    count += 1
                    try:
                        values = [float(record[code]) for code in lcts]
                    except (ValueError, TypeError, KeyError):
                        refused += 1
                        continue
                    if not all(math.isfinite(value) for value in values):
                        refused += 1
                        continue
                    sums.append(math.fsum(values))
                members.append(
                    {
                        "archive_member": member,
                        "sha256": hashlib.sha256(payload).hexdigest(),
                        "row_count": count,
                        "columns": fields,
                        "output_pft_columns": output_pfts,
                        "pft_columns_without_taxonomy_definition": sorted(
                            set(output_pfts) - set(pfts)
                        ),
                        "taxonomy_pfts_without_output_column": sorted(
                            set(pfts) - set(output_pfts)
                        ),
                        "lct_sum_min": min(sums) if sums else None,
                        "lct_sum_max": max(sums) if sums else None,
                        "numeric_lct_sum_row_count": len(sums),
                        "nonnumeric_lct_row_count": refused,
                        "rows_with_lct_sum_near_one": sum(
                            math.isclose(value, 1, abs_tol=1e-6) for value in sums
                        ),
                        "rows_with_lct_sum_near_100": sum(
                            math.isclose(value, 100, abs_tol=1e-6) for value in sums
                        ),
                    }
                )
    return {
        "source_doi": "10.1594/PANGAEA.937075",
        "taxonomy_path": name,
        "taxon_row_count": len(taxonomy),
        "taxonomy_pft_count": len(pfts),
        "taxonomy_pfts": pfts,
        "taxonomy_lct_codes": lcts,
        "taxa_review_inventory": taxonomy,
        "archive_path": archive_name,
        "archive_members": members,
        "semantic_confirmation": "requires_publication_mapping_and_units_review",
        "interpretation": "Output columns and observed sums are evidence, not a corrected method profile. Standard errors must not be required to sum to one or 100.",
    }
