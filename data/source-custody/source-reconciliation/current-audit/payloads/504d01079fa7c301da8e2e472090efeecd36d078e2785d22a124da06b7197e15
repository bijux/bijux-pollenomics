"""Freeze the current audit's declared reads without asserting historical custody."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
from typing import Any

from source_inputs import exact_union, pin, verify_rows

AUTHORITIES = {
    "families": "data/source_family_contracts.json",
    "stages": "data/source_family_evidence_stage_matrix.json",
    "countries": "data/country_dimension_coverage.json",
    "ownership": "data/source_fact_ownership_registry.json",
    "postures": "data/source_spatiotemporal_posture_registry.json",
}
PRIVATE_CUSTODY = "source-intakes/custody.json"
MAX_FILES = 4000
MAX_BYTES = 3 * 1024**3 - 128 * 1024**2


def require(value: object, reason: str) -> None:
    if not value:
        raise ValueError(reason)


def path_at(root: Path, name: str) -> Path:
    relative = PurePosixPath(name)
    require(
        bool(relative.parts)
        and not relative.is_absolute()
        and ".." not in relative.parts,
        "Audit input name must be confined and normalized",
    )
    path = root / relative
    require(
        not any(p.is_symlink() for p in (path, *path.parents)),
        "Audit input ancestor alias refused: " + str(path),
    )
    return path


def ownership_path_roles(ownership: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:
    """Derive the literal paths whose native ownership consumer tests is_dir first."""
    result: dict[str, list[dict[str, Any]]] = {}
    for fact in ownership["rows"]:
        for field, names in (
            ("governing_surface_path", [fact["governing_surface_path"]]),
            ("supporting_surface_paths", fact["supporting_surface_paths"]),
        ):
            for index, name in enumerate(names):
                if "<" in name:
                    continue
                relative = PurePosixPath(name)
                require(
                    bool(relative.parts)
                    and not relative.is_absolute()
                    and ".." not in relative.parts
                    and relative.as_posix() == name,
                    "Normalized literal ownership path required",
                )
                result.setdefault(name, []).append(
                    {
                        "fact_key": fact["fact_key"],
                        "field": field,
                        "index": index,
                        "native_branch": "is_dir_before_any_file_read",
                    }
                )
    return dict(sorted(result.items()))


def directory_presence(
    root: Path,
    name: str,
    roles: list[dict[str, Any]],
) -> dict[str, Any]:
    """Observe only a declared ownership directory predicate and its alias chain.

    No target contents or subtree identities are read or inferred. Any actual
    file-reading role continues through the independent no-alias path_at guard.
    """
    relative = PurePosixPath(name)
    require(
        bool(relative.parts)
        and not relative.is_absolute()
        and ".." not in relative.parts
        and relative.as_posix() == name
        and bool(roles)
        and all(row["native_branch"] == "is_dir_before_any_file_read" for row in roles),
        "Explicit normalized ownership directory-presence role required",
    )
    require(
        root.is_absolute()
        and root == root.resolve(strict=True)
        and not any(node.is_symlink() for node in (root, *root.parents)),
        "Physical source observation root required",
    )
    path = root / relative
    require(path.is_dir(), "Declared directory predicate is not true")
    pending = [path]
    visited: set[Path] = set()
    aliases: dict[str, dict[str, str]] = {}
    while pending:
        target = pending.pop()
        if target in visited:
            continue
        visited.add(target)
        require(len(visited) <= 256, "Directory alias chain exceeds bound")
        for component in reversed((target, *target.parents)):
            if component.is_symlink():
                raw = os.readlink(component)
                physical = component.resolve(strict=True)
                aliases[str(component)] = {
                    "path": str(component),
                    "raw_link": raw,
                    "physical_target": str(physical),
                    "target_type": "directory"
                    if physical.is_dir()
                    else "file"
                    if physical.is_file()
                    else "special",
                }
                following = (
                    Path(raw) if Path(raw).is_absolute() else component.parent / raw
                )
                pending.append(Path(os.path.normpath(following)))
    physical = path.resolve(strict=True)
    require(physical.is_dir(), "Directory target type changed")
    return {
        "lexical_path": str(path),
        "physical_target": str(physical),
        "target_type": "directory",
        "roles": roles,
        "raw_alias_chain": [aliases[key] for key in sorted(aliases)],
        "target_contents_read_or_copied": False,
        "full_subtree_or_historical_custody_claimed": False,
        "owned_projection": "plain directory satisfying only the native is_dir predicate",
    }


def physical_kind(path: Path) -> str:
    require(not path.is_symlink(), "Audit input alias refused")
    if not path.exists():
        return "missing"
    mode = path.lstat().st_mode
    require(stat.S_ISDIR(mode) or stat.S_ISREG(mode), "Audit special input refused")
    return "directory" if stat.S_ISDIR(mode) else "file"


class Closure:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.files: dict[str, dict[str, Any]] = {}
        self.observations: dict[str, str] = {}
        self.reader_paths: set[str] = set()
        self.patterns: dict[str, list[str]] = {}
        self.verifications: dict[str, dict[str, Any]] = {}
        self.ownership_roles: dict[str, list[dict[str, Any]]] = {}
        self.directory_aliases: dict[str, dict[str, Any]] = {}

    def ownership_path(self, name: str) -> None:
        """Match the maintained directory-existence branch, never a file read."""
        require(name in self.ownership_roles, "Unreviewed directory observation role")
        path = self.root / name
        if path.is_dir():
            proof = directory_presence(self.root, name, self.ownership_roles[name])
            if proof["raw_alias_chain"]:
                require(
                    name not in self.observations
                    or self.observations[name] == "directory_presence_alias",
                    "Directory-only role conflicts with a consumed file role",
                )
                require(
                    name not in self.directory_aliases
                    or self.directory_aliases[name] == proof,
                    "Directory alias changed during source closure freeze",
                )
                self.observations[name] = "directory_presence_alias"
                self.directory_aliases[name] = proof
                return
            self.add(name)
        else:
            self.add(name, reader=True)

    def add(self, name: str, *, reader: bool = False) -> Path:
        path = path_at(self.root, name)
        kind = physical_kind(path)
        require(
            name not in self.observations or self.observations[name] == kind,
            "Input presence/type changed during closure freeze",
        )
        self.observations[name] = kind
        if reader:
            self.reader_paths.add(name)
        if kind == "file":
            current = pin(path)
            require(
                name not in self.files or self.files[name] == current,
                "Current input changed during closure freeze",
            )
            self.files[name] = current
        require(
            len(self.files) <= MAX_FILES
            and sum(row["bytes"] for row in self.files.values()) <= MAX_BYTES,
            "Current audit input closure exceeds forecast",
        )
        return path

    def metadata(self, name: str, *, reader: bool = False) -> dict[str, Any] | None:
        path = self.add(name, reader=reader)
        if self.observations[name] == "missing":
            return None
        require(self.observations[name] == "file", "Metadata must be a regular file")
        raw = path.read_bytes()
        require(
            hashlib.sha256(raw).hexdigest() == self.files[name]["sha256"]
            and len(raw) == self.files[name]["bytes"],
            "Metadata buffer differs from its frozen identity",
        )

        def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
            require(
                len(rows) == len({key for key, _ in rows}), "Duplicate metadata key"
            )
            return dict(rows)

        def refuse(value: str) -> None:
            raise ValueError("Nonfinite metadata: " + value)

        value = json.loads(raw, object_pairs_hook=pairs, parse_constant=refuse)
        require(type(value) is dict, "Audit manifest object required")
        assert isinstance(value, dict)
        return value

    def pattern(self, raw: str) -> None:
        pattern = re.sub(r"<[^/<>]+>", "*", raw)
        require(
            not Path(pattern).is_absolute() and ".." not in Path(pattern).parts,
            "Audit pattern escaped repository",
        )
        names = sorted(
            p.relative_to(self.root).as_posix()
            for p in self.root.glob(pattern)
            if p.is_file()
        )
        for name in names:
            self.add(name)
        require(
            pattern not in self.patterns or self.patterns[pattern] == names,
            "Audit pattern membership changed during freeze",
        )
        self.patterns[pattern] = names

    def verified(self, name: str, spec: dict[str, Any]) -> None:
        self.add(name, reader=True)
        if self.observations[name] == "file":
            value = {key: spec.get(key) for key in ("sha256", "byte_count")}
            require(
                name not in self.verifications or self.verifications[name] == value,
                "Conflicting manifest verification roles",
            )
            self.verifications[name] = value

    def finish(self) -> dict[str, Any]:
        result = {
            "root": str(self.root),
            "files": [self.files[n] for n in sorted(self.files)],
            "observations": dict(sorted(self.observations.items())),
            "reader_paths": sorted(self.reader_paths),
            "patterns": dict(sorted(self.patterns.items())),
            "manifest_verifications": dict(sorted(self.verifications.items())),
            "ownership_path_roles": self.ownership_roles,
            "directory_presence_aliases": dict(sorted(self.directory_aliases.items())),
            "scope": "Current measured read projection and exact pattern memberships; directory-only identities do not claim full original subtrees.",
        }
        verify_projection(result)
        return result


def collect_repository(root: Path, expected: list[dict[str, Any]]) -> dict[str, Any]:
    require(
        {row["path"] for row in expected} == set(AUTHORITIES.values()),
        "Exactly five reviewed governing authorities required",
    )
    fixed = [{**row, "path": str(root / row["path"])} for row in expected]
    for row in fixed:
        path_at(root, Path(row["path"]).relative_to(root).as_posix())
    verify_rows(fixed)
    view = Closure(root)
    authorities = {
        key: view.metadata(name, reader=True) for key, name in AUTHORITIES.items()
    }
    require(
        all(type(value) is dict for value in authorities.values()),
        "Five required authority objects absent",
    )
    families = authorities["families"]
    stages = authorities["stages"]
    ownership = authorities["ownership"]
    assert families is not None and stages is not None and ownership is not None
    view.ownership_roles = ownership_path_roles(ownership)
    for fact in ownership["rows"]:
        for name in (fact["governing_surface_path"], *fact["supporting_surface_paths"]):
            if "<" in name:
                view.pattern(name)
            else:
                view.ownership_path(name)
    for family in families["rows"]:
        for contract in family["layer_contracts"].values():
            for name in contract["example_artifacts"]:
                if not any(c in name for c in "<*>?"):
                    view.add(name, reader=True)
    for capability in stages["capability_materialization_audit"]["rows"]:
        for name in capability["evidence_paths"]:
            if not any(c in name for c in "<*>?"):
                view.add(name, reader=True)
    family_names = {row["source_key"] for row in families["rows"]}
    if "neotoma" in family_names:
        name = "data/neotoma/relational/manifest.json"
        manifest = view.metadata(name, reader=True)
        if manifest is not None:
            for surface in manifest["surfaces"].values():
                for part in surface["parts"]:
                    view.verified(str(PurePosixPath(name).parent / part["path"]), part)
            raw_name = "data/neotoma/raw/neotoma_pollen_dataset_downloads/manifest.json"
            raw = view.metadata(raw_name, reader=True)
            if raw is not None:
                for part in raw.get("parts", []):
                    view.verified(
                        str(PurePosixPath(raw_name).parent / part["filename"]), part
                    )
    if "sead" in family_names:
        governing = next(
            (
                row["governing_surface_path"]
                for row in ownership["rows"]
                if row["fact_key"] == "sead_archaeology_context"
            ),
            None,
        )
        if governing is not None:
            manifest = view.metadata(governing, reader=True)
            if manifest is not None:
                parent = PurePosixPath(governing).parent
                for row in manifest["files"]:
                    view.verified(str(parent / row["path"]), row)
                raw_name = (
                    "data/sead/raw/acquisitions/" + parent.name + "/manifest.json"
                )
                raw = view.metadata(raw_name, reader=True)
                if raw is not None:
                    for row in raw["files"]:
                        view.verified(
                            str(PurePosixPath(raw_name).parent / row["path"]), row
                        )
                view.add(str(parent / "source_native_observations.json"), reader=True)
    if "landclim" in family_names:
        for name in (
            "data/landclim/raw/landclim_ii_taxa_pft_ppe_fsp_values.csv",
            "data/landclim/raw/landclim_ii_reveals_results.zip",
        ):
            view.add(name, reader=True)
    # The separate intake helper reads these current reports without EvidenceReader.
    for name in (
        "data/source_intake_contract.schema.json",
        "docs/report/source-relations/openland-intake/report.json",
        "docs/report/source-relations/rootsi-landclim-overlap/report.json",
    ):
        view.add(name)
    result = view.finish()
    verify_rows(fixed)
    return result


def collect_private(root: Path, expected: dict[str, Any]) -> dict[str, Any]:
    require(
        expected["path"] == PRIVATE_CUSTODY,
        "Exact private intake custody role required",
    )
    path_at(root, PRIVATE_CUSTODY)
    verify_rows([{**expected, "path": str(root / PRIVATE_CUSTODY)}])
    view = Closure(root)
    custody = view.metadata(PRIVATE_CUSTODY)
    require(
        custody is not None and custody["schema_version"] == "source-intake-custody.v1",
        "Original intake custody manifest required",
    )
    assert custody is not None
    for row in custody["receipts"]:
        path = view.add("source-intakes/receipts/" + row["path"])
        require(
            view.files[path.relative_to(root).as_posix()]
            == {"path": str(path), "sha256": row["sha256"], "bytes": row["bytes"]},
            "Original intake receipt identity differs",
        )
    for row in custody["archives"]:
        path = view.add(row["relative_path"])
        require(
            view.files[row["relative_path"]]
            == {"path": str(path), "sha256": row["sha256"], "bytes": row["bytes"]},
            "Original private archive identity differs",
        )
    view.add("landclim/rootsi-workbooks/manifest.json")
    return view.finish()


def verify_projection(value: dict[str, Any]) -> None:
    root = Path(value["root"])
    require(
        set(value["directory_presence_aliases"])
        == {
            name
            for name, kind in value["observations"].items()
            if kind == "directory_presence_alias"
        },
        "Complete directory-only alias observation membership required",
    )
    for name, kind in value["observations"].items():
        if kind == "directory_presence_alias":
            proof = directory_presence(root, name, value["ownership_path_roles"][name])
            require(
                proof == value["directory_presence_aliases"][name],
                "Original directory presence alias chain changed",
            )
            continue
        require(
            physical_kind(path_at(root, name)) == kind,
            "Current read projection presence/type changed: " + name,
        )
    for pattern, wanted in value["patterns"].items():
        actual = sorted(
            p.relative_to(root).as_posix() for p in root.glob(pattern) if p.is_file()
        )
        require(actual == wanted, "Current read pattern membership changed: " + pattern)
        for name in actual:
            path_at(root, name)
    verify_rows(value["files"])


def verify_prepared_closure(value: dict[str, Any]) -> None:
    verify_projection(value["repository"])
    verify_projection(value["private"])


def complete_rows(value: dict[str, Any]) -> list[dict[str, Any]]:
    return exact_union(value["repository"]["files"], value["private"]["files"])
