"""Reconstruct native registry partitions without changing admission namespaces."""

from __future__ import annotations

import re
from typing import Any

from review.reader import Reader, indexed

AUTHORITIES = {
    "families": "data/source_family_contracts.json",
    "stages": "data/source_family_evidence_stage_matrix.json",
    "countries": "data/country_dimension_coverage.json",
    "ownership": "data/source_fact_ownership_registry.json",
    "postures": "data/source_spatiotemporal_posture_registry.json",
}


def reconstruct(reader: Reader) -> tuple[dict[str, Any], set[str], dict[str, Any]]:
    authorities = {}
    for key, path in AUTHORITIES.items():
        value = reader.obj(path)
        if value is None:
            raise ValueError("Required governing registry absent: " + path)
        authorities[key] = value
    families = indexed(authorities["families"], "source_key")
    stages = indexed(authorities["stages"], "source_key")
    postures = indexed(authorities["postures"], "source_key")
    ownership = indexed(authorities["ownership"], "fact_key")
    for key, fact in ownership.items():
        for name in (fact["governing_surface_path"], *fact["supporting_surface_paths"]):
            if "<" in name:
                pattern = re.sub(r"<[^/<>]+>", "*", name)
                if not any(path.is_file() for path in reader.root.glob(pattern)):
                    reader.issue(
                        "source_fact_ownership_pattern_unresolved", name, fact_key=key
                    )
            elif not reader.path(name).is_dir() and reader.raw(name) is None:
                reader.issue("source_fact_ownership_path_missing", name, fact_key=key)
    if set(families) != set(stages):
        reader.issue(
            "source_registry_identity_mismatch",
            AUTHORITIES["stages"],
            only_contract=sorted(set(families) - set(stages)),
            only_stage=sorted(set(stages) - set(families)),
        )
    countries = authorities["countries"]["cells"]
    if authorities["countries"]["cell_count"] != len(countries):
        reader.issue("country_cell_count_mismatch", AUTHORITIES["countries"])
    country_keys = [
        (row["source_family"], row["country_code"], row["country_dimension"])
        for row in countries
    ]
    if len(country_keys) != len(set(country_keys)):
        reader.issue("duplicate_country_dimension_identity", AUTHORITIES["countries"])
    capabilities = authorities["stages"]["capability_materialization_audit"]["rows"]
    source_rows = []
    for key, family in sorted(families.items()):
        stage = stages.get(key)
        materialization = []
        for layer, contract in sorted(family["layer_contracts"].items()):
            examples = []
            for name in contract["example_artifacts"]:
                if any(c in name for c in "<*>?"):
                    examples.append({"path": name, "presence": "template_not_resolved"})
                else:
                    reader.raw(name)
                    examples.append(reader.files[name])
            materialization.append(
                {
                    "layer": layer,
                    "repository_path": contract["repository_path"],
                    "declared_stage_status": None
                    if stage is None
                    else stage.get(layer + "_status"),
                    "contract_examples": examples,
                    "note": "Example presence is not full layer reconciliation or semantic approval.",
                }
            )
        semantic = [row for row in capabilities if row["source_key"] == key]
        for capability in semantic:
            for name in capability["evidence_paths"]:
                if any(c in name for c in "<*>?"):
                    continue
                present = reader.raw(name) is not None
                if (
                    name in capability.get("present_evidence_paths", []) and not present
                ) or (name in capability.get("missing_evidence_paths", []) and present):
                    reader.issue(
                        "capability_evidence_presence_drift",
                        name,
                        source_key=key,
                        dimension=capability["dimension"],
                    )
        cells = [row for row in countries if row["source_family"] == key]
        missing = sorted(
            {"SE", "DK", "NO", "FI"}
            - {
                row["country_code"]
                for row in cells
                if row["country_dimension"] == "source_reported"
            }
        )
        if missing:
            reader.issue(
                "nordic_country_cells_missing",
                AUTHORITIES["countries"],
                source_key=key,
                country_codes=missing,
            )
        source_rows.append(
            {
                "source_key": key,
                "display_name": family["display_name"],
                "domain_group": family["domain_group"],
                "evidence_role": family["evidence_role"],
                "materialization_layers": materialization,
                "source_stage_record": stage,
                "semantic_capability_records": semantic,
                "spatiotemporal_posture_record": postures.get(key),
                "country_availability_records": cells,
                "qualified_review_dimensions": sorted(
                    row["dimension"] for row in semantic if row["human_review_required"]
                ),
                "missing_supported_dimensions": sorted(
                    row["dimension"]
                    for row in semantic
                    if row["support"] != "unsupported"
                    and row["materialization"] in ("missing", "partial")
                ),
                "v2_full_confirmation": "not_established",
            }
        )
    return (
        {
            "authority_paths": AUTHORITIES,
            "source_count": len(families),
            "country_cell_count": len(countries),
            "capability_cell_count": len(capabilities),
            "source_rows": source_rows,
        },
        set(families),
        ownership,
    )
