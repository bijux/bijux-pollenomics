"""Independently reconstruct every current audit field without promoting native findings."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path
from typing import Any

from contracts import (
    PACKAGES,
    PYTHON,
    SOURCE,
    checkpoint,
    execution_scope,
    stage_plan,
    write,
)
from execute import call_contract
from inputs.closure import verify_prepared_closure
from review.reader import object_bytes, require, same
from review.result import reconstruct
from source_inputs import pin


def witness(plan: dict[str, Any], value: dict[str, Any]) -> None:
    require(
        type(value["actual_exit"]) is int
        and value["actual_exit"] == 0
        and value["candidate"] == plan["candidate"],
        "Native producer identity/exit differs",
    )
    same(
        value["actual_argv"][1:],
        [
            "-I",
            "-B",
            str(SOURCE / "entry.py"),
            "producer",
            "--plan",
            str(Path(plan["output"]) / "plan.json"),
        ],
    )
    same(value["actual_executable"], str(PYTHON))
    same(
        value["owned_package_search_roots"],
        [
            str(Path(plan["owned_repository"]) / "packages" / name / "src")
            for name in PACKAGES
        ],
    )
    same(value["maintained_public_calls"], call_contract(plan))
    require(
        type(value["first_party_origins"]) is list and value["first_party_origins"],
        "Actual maintained source origins absent",
    )
    protected = {row["path"]: row for row in plan["input_pins"]}
    modules = set()
    for row in value["first_party_origins"]:
        path = Path(row["path"])
        require(
            path.is_relative_to(Path(plan["owned_repository"]))
            and row["module"] not in modules,
            "Source origin foreign/duplicate",
        )
        modules.add(row["module"])
        same(
            {key: row[key] for key in ("path", "sha256", "bytes")},
            protected.get(str(path)),
        )
    require(
        {
            "bijux_pollenomics_dev.source_completion.audit",
            "bijux_pollenomics_dev.source_completion.intake_custody",
            "bijux_pollenomics_dev.source_completion.publication.json_outputs",
        }.issubset(modules),
        "Actual called module source origins incomplete",
    )
    for field in (
        "historical_full_audit_recovered",
        "old_summary_byte_equality_claimed",
        "live_provider_completeness_or_scientific_admission",
    ):
        require(value[field] is False, "Source accounting scope inflated")
    same(value["numerical_import_attempts"], [])
    same(value["network_attempts"], [])
    require(
        value["native_exit_means_API_execution_not_zero_accounting_findings"] is True,
        "Findings/native status conflated",
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = stage_plan(args.plan)
    authority, scope = execution_scope(plan)
    output = Path(plan["output"])
    actual = object_bytes((output / "source-execution.json").read_bytes())
    witness(plan, actual)
    for row in actual["products"]:
        require(
            Path(row["path"]).parent == output,
            "Producer product escaped registered output",
        )
        same(pin(Path(row["path"])), row)
    same(
        [Path(row["path"]).name for row in actual["products"]],
        ["full-current-audit.json", "summary-current.json"],
    )
    audit, summary = reconstruct(
        Path(plan["owned_repository"]), Path(plan["owned_private_root"])
    )
    for name, expected in (
        ("full-current-audit.json", audit),
        ("summary-current.json", summary),
    ):
        raw = (output / name).read_bytes()
        same(object_bytes(raw), expected)
        require(
            raw
            == (
                __import__("json").dumps(
                    expected, sort_keys=True, indent=2, allow_nan=False
                )
                + "\n"
            ).encode(),
            "Complete maintained JSON serialization differs",
        )
    same(actual["accounting_checks_pass"], audit["accounting_checks_pass"])
    same(actual["accounting_finding_count"], len(audit["accounting_findings"]))
    same(
        sorted(row["path"] for row in audit["input_files"]),
        plan["current_input_closure"]["repository"]["reader_paths"],
    )
    verify_prepared_closure(plan["current_input_closure"])
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    write(
        output / "independent-current-audit-review.json",
        {
            "schema_version": "independent-current-source-audit-review.v1",
            "candidate": plan["candidate"],
            "actual_exit": 0,
            "products": actual["products"],
            "source_execution_sha256": hashlib.sha256(
                (output / "source-execution.json").read_bytes()
            ).hexdigest(),
            "complete_typed_and_byte_reconstruction": True,
            "source_count": audit["source_count"],
            "current_consumed_input_count": len(audit["input_files"]),
            "accounting_checks_pass": audit["accounting_checks_pass"],
            "accounting_findings": audit["accounting_findings"],
            "historical_full_audit_recovered": False,
            "old_summary_reproduced": False,
            "full_source_confirmation": audit["full_source_confirmation"],
            "scope": "Current source accounting and native finding preservation only; original construction, permitted use, rights, human review, ecological and LRA acceptance remain separate.",
        },
    )
