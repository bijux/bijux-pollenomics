"""Freeze a single independent observer over the unchanged successful source product."""

from __future__ import annotations

import argparse
from copy import deepcopy
from pathlib import Path
import shutil

from contracts import (
    BASE,
    GIT,
    MODULE,
    OWNER,
    ROOT,
    SOURCE,
    confined_output,
    dump,
    identity,
    load,
    pin,
    require,
    sha,
    union,
    verify_plan,
    verify_rows,
)
from retained import authenticate
from runtime import profile_guard


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--review-sha256", required=True)
    args = parser.parse_args()
    profile_guard()
    before = identity()
    require(
        before["candidate"] == args.candidate and before["status"] == "",
        "Exact current clean main required",
    )
    output = confined_output(args.output, absent=True)
    manifest = SOURCE / "prepared-source-manifest.json"
    review = SOURCE / "independent-source-review.json"
    require(
        sha(review) == args.review_sha256
        and load(review)["approved"] is True
        and load(review)["source_manifest_sha256"] == sha(manifest),
        "Exact new observer source peer required",
    )
    held = load(manifest)["files"]
    authority_rows = [pin(manifest), pin(review), pin(GIT)]
    verify_rows(held)
    original, old_rows = authenticate()
    old = original["original_plan"]
    require(
        old["candidate"] == args.candidate,
        "Saved observer requires unchanged original candidate while genuine observation runs",
    )
    frozen = union(held, old_rows, authority_rows)
    plan = {
        "schema_version": "amsoldingersee-saved-source-observer-plan.v1",
        "id": "amsoldingersee-saved-source-observer-" + args.candidate[:12],
        "candidate": args.candidate,
        "repository": str(ROOT),
        "canonical_identity": before,
        "output": str(output),
        "owner_id": OWNER,
        "maintained_module": MODULE,
        "input_pins": frozen,
        "runtime_profile": deepcopy(old["runtime_profile"]),
        "first_party_namespaces": deepcopy(old["first_party_namespaces"]),
        "absent_input_paths": deepcopy(old["absent_input_paths"]),
        "original_execution": original,
        "common_runner": str(SOURCE / "common_runner.py"),
        "resources": {
            "overall_timeout_seconds": 110,
            "outer_timeout_seconds": 130,
            "declared_memory_bytes": 1024**3,
            "declared_storage_bytes": 128 * 1024**2,
        },
        "environment": {
            "PATH": str(GIT.parent) + ":/usr/bin:/bin",
            "PYTHONDONTWRITEBYTECODE": "1",
            "TMPDIR": str(output / "scratch"),
            "XDG_CACHE_HOME": str(output / "cache"),
        },
        "scope": "One saved-product source reconstruction observer; no maintained producer repeat. Original source0/metadata0, observer1 and whole1 remain literal; exact pinned framework launcher correspondence only, no alias/equal-byte normalization or historical E#69/rights/model/LRA admission.",
    }
    plan_path = output / "plan.json"
    plan["stages"] = [
        {
            "id": "independent-saved-amsoldingersee-source-joins",
            "argv": [
                str(BASE),
                "-I",
                "-S",
                "-B",
                str(SOURCE / "entry.py"),
                "observe",
                "--plan",
                str(plan_path),
            ],
            "timeout_seconds": 45,
            "must_succeed": True,
        }
    ]
    plan["actual_launch_argv"] = [
        str(BASE),
        "-I",
        "-S",
        "-B",
        str(SOURCE / "entry.py"),
        "run",
        "--plan",
        str(plan_path),
        "--registered-plan-sha256",
        "ACTUAL_REGISTERED_PLAN_SHA256",
    ]
    verify_plan(plan)
    verify_rows(frozen)
    require(identity() == before, "Candidate changed before writes")
    parent = output.parent
    while not parent.exists():
        parent = parent.parent
    require(shutil.disk_usage(parent).free >= 1024**3, "Free artifact reserve required")
    output.parent.mkdir(parents=True, exist_ok=True)
    confined_output(output, absent=True).mkdir()
    for name in ("scratch", "cache"):
        (output / name).mkdir()
    dump(plan_path, plan)
    dump(
        output / "preparation.json",
        {
            "actual_exit": 0,
            "plan": pin(plan_path),
            "original_whole_exit": 1,
            "original_stage_exits": [0, 1],
            "new_native_stages": 1,
            "producer_repeated": False,
        },
    )
    print(plan_path)
