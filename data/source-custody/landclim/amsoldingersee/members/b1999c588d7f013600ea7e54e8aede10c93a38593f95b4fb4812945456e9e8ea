"""Freeze exact current source, private response identities and isolated stdlib custody."""

from __future__ import annotations

import argparse
from pathlib import Path
import shutil

from contracts import (
    AUTHOR,
    AUTHOR_SHA,
    BASE,
    GIT,
    INPUT_MANIFEST,
    INPUT_SHA,
    MAINTAINED,
    MAINTAINED_SHA,
    MODULE,
    OWNER,
    PACKAGE_ROOTS,
    PRIVATE,
    REPORT,
    ROOT,
    SOURCE,
    confined_output,
    dump,
    exact,
    identity,
    load,
    pin,
    require,
    sha,
    source_snapshot,
    union,
    verify_plan,
    verify_rows,
)
from runtime import runtime_inputs


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--review-sha256", required=True)
    args = parser.parse_args()
    before = identity()
    require(
        before["candidate"] == args.candidate and before["status"] == "",
        "Exact clean current main required",
    )
    output = confined_output(args.output, absent=True)
    manifest_path = SOURCE / "prepared-source-manifest.json"
    peer = SOURCE / "independent-source-review.json"
    require(sha(peer) == args.review_sha256, "Peer hash differs")
    approval = load(peer)
    require(
        approval["approved"] is True
        and approval["source_manifest_sha256"] == sha(manifest_path),
        "Held source peer required",
    )
    held = load(manifest_path)["files"]
    verify_rows(held)
    require(sha(MAINTAINED) == MAINTAINED_SHA, "Reviewed maintained source changed")
    require(
        sha(INPUT_MANIFEST) == INPUT_SHA and sha(AUTHOR) == AUTHOR_SHA,
        "Original input manifest or author example identity changed",
    )
    declared = load(INPUT_MANIFEST)
    require(
        declared["schema_version"] == "landclim-amsoldingersee-source-inputs.v1"
        and len(declared["files"]) == 14,
        "Exact fourteen private inputs required",
    )
    expected = [
        {"path": str(PRIVATE / name), **row} for name, row in declared["files"].items()
    ]
    verify_rows(expected)
    policy = ROOT / "configs/ci/report-ownership.json"
    owner = [r for r in load(policy)["owners"] if r["owner_id"] == OWNER]
    relative_report = REPORT.relative_to(ROOT).as_posix()
    require(
        len(owner) == 1
        and owner[0]["role"] == "unresolved"
        and owner[0]["paths"] == [relative_report]
        and owner[0]["producer_paths"] == [MAINTAINED.relative_to(ROOT).as_posix()]
        and owner[0]["producer_inputs"]
        == [INPUT_MANIFEST.relative_to(ROOT).as_posix()],
        "Exact unresolved owner boundary differs",
    )
    initial = union(
        held,
        expected,
        [
            pin(manifest_path),
            pin(peer),
            pin(INPUT_MANIFEST),
            pin(AUTHOR),
            pin(policy),
            pin(REPORT),
            pin(MAINTAINED),
            pin(GIT),
        ],
    )
    namespaces, source_rows = source_snapshot()
    runtime_files, runtime = runtime_inputs()
    frozen = union(initial, source_rows, [pin(path) for path in sorted(runtime_files)])
    verify_rows(initial)
    plan_path = output / "plan.json"
    argv = [
        str(MAINTAINED),
        "--repository",
        str(ROOT),
        "--source-root",
        str(PRIVATE),
        "--output",
        str(output / "producer"),
    ]
    plan = {
        "schema_version": "amsoldingersee-source-refusal-replay-plan.v1",
        "id": "amsoldingersee-source-refusal-" + args.candidate[:12],
        "candidate": args.candidate,
        "repository": str(ROOT),
        "canonical_identity": before,
        "output": str(output),
        "input_pins": frozen,
        "absent_input_paths": [runtime["absent_stdlib_zip"]],
        "runtime_profile": runtime,
        "first_party_namespaces": namespaces,
        "first_party_source_roots": [str(path) for path in PACKAGE_ROOTS],
        "owner_id": OWNER,
        "declared_owner": owner[0],
        "maintained_module": MODULE,
        "maintained_source": pin(MAINTAINED),
        "maintained_source_argv": argv,
        "input_manifest": pin(INPUT_MANIFEST),
        "private_source_root": str(PRIVATE),
        "author_site_input": pin(AUTHOR),
        "historical_report": pin(REPORT),
        "common_runner": str(SOURCE / "common_runner.py"),
        "resources": {
            "overall_timeout_seconds": 110,
            "outer_timeout_seconds": 130,
            "resident_memory_limit_bytes": 1024**3,
            "output_byte_limit": 128 * 1024**2,
            "declared_memory_bytes": 1024**3,
            "declared_storage_bytes": 128 * 1024**2,
        },
        "environment": {
            "PATH": str(GIT.parent) + ":/usr/bin:/bin",
            "PYTHONDONTWRITEBYTECODE": "1",
            "TMPDIR": str(output / "scratch"),
            "XDG_CACHE_HOME": str(output / "cache"),
        },
        "scope": "Current source-bound refusal replay of eleven retained API responses, two acquisition receipts and one publication row plus 17-row author example identity. Retained 2026-09-21 acquisition epoch is not a new HTTP retrieval or original historical E#69 identity recovery. No full 1,128-sequence/model/R/rights/taxonomy/age-depth/human/LRA admission.",
    }
    plan["stages"] = [
        {
            "id": role,
            "argv": [
                str(BASE),
                "-I",
                "-S",
                "-B",
                str(SOURCE / "entry.py"),
                command,
                "--plan",
                str(plan_path),
            ],
            "timeout_seconds": 45,
            "must_succeed": True,
        }
        for role, command in (
            ("maintained-amsoldingersee-source-refusal", "produce"),
            ("independent-amsoldingersee-source-joins", "observe"),
        )
    ]
    plan["actual_launch_argv"] = [
        str(BASE),
        "-I",
        "-S",
        "-B",
        str(SOURCE / "entry.py"),
        "run",
        "--plan",
        str(plan_path),
        "--registered-plan-sha256",
        "PLAN_SHA256",
    ]
    verify_plan(plan)
    parent = output.parent
    while not parent.exists():
        parent = parent.parent
    require(
        shutil.disk_usage(parent).free >= 1024**3,
        "Physical free-space reserve required",
    )
    verify_rows(frozen)
    require(exact(identity(), before), "Candidate changed before preparation writes")
    output.parent.mkdir(parents=True, exist_ok=True)
    confined_output(output, absent=True).mkdir()
    for name in ("scratch", "cache"):
        (output / name).mkdir()
    dump(plan_path, plan)
    dump(
        output / "preparation.json",
        {
            "actual_exit": 0,
            "plan": pin(plan_path),
            "candidate": args.candidate,
            "protected_inputs": len(frozen),
            "private_inputs": 14,
            "author_examples": "Bound original CSV; parsed only by genuine stages",
            "native_consumers_launched": 0,
        },
    )
    print(plan_path)
