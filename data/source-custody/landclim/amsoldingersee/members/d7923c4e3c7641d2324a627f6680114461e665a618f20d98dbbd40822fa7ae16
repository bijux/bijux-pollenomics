"""Authenticate the complete owned import boundary before dispatching native roles."""

from __future__ import annotations

import hashlib
import importlib
import json
from pathlib import Path
import sys

EXPECTED = {
    "entry.py",
    "contracts.py",
    "runtime.py",
    "metadata.py",
    "common_runner.py",
    "prepare.py",
    "retained.py",
    "observe.py",
    "run.py",
    "check_contracts.py",
}


def verify_namespace(root: Path) -> None:
    if root != root.resolve() or any(
        path.is_symlink() for path in (root, *root.parents)
    ):
        raise ValueError("Physical source entry required")
    for path in root.iterdir():
        if path.is_symlink() or not (path.is_file() or path.is_dir()):
            raise ValueError("Controller alias or special before imports")
        if path.is_dir() and path.name != "preflight":
            raise ValueError("Unknown controller import directory")
        if (
            path.suffix in {".py", ".pyc", ".so", ".pyd", ".dylib"}
            and path.name not in EXPECTED
        ):
            raise ValueError("Unknown controller import member")


def verify_reviewed(root: Path) -> None:
    verify_namespace(root)
    manifest = root / "prepared-source-manifest.json"
    review = root / "independent-source-review.json"
    for path in (manifest, review):
        if not path.is_file() or any(
            parent.is_symlink() for parent in (path, *path.parents)
        ):
            raise ValueError("Regular held source authority required")
    raw = manifest.read_bytes()
    document = json.loads(raw)
    approval = json.loads(review.read_bytes())
    if (
        document["source_only"] is not True
        or approval["approved"] is not True
        or approval["source_manifest_sha256"] != hashlib.sha256(raw).hexdigest()
    ):
        raise ValueError("Exact independent source approval required")
    names = [row["path"] for row in document["files"]]
    if names != sorted(set(names)):
        raise ValueError("Absolute sorted unique held members required")
    for row in document["files"]:
        path = Path(row["path"])
        if (
            not path.is_absolute()
            or ".." in path.parts
            or not path.is_relative_to(root)
            or not path.is_file()
            or any(parent.is_symlink() for parent in (path, *path.parents))
        ):
            raise ValueError("Unconfined held source member")
        if type(row["bytes"]) is not int or path.stat().st_size != row["bytes"]:
            raise ValueError("Held source size differs")
        with path.open("rb") as stream:
            if hashlib.file_digest(stream, "sha256").hexdigest() != row["sha256"]:
                raise ValueError("Held source bytes differ")
    if not {Path(name).relative_to(root).as_posix() for name in names} >= EXPECTED:
        raise ValueError("Held manifest omits an importable source member")


def main() -> None:
    source = Path(__file__).absolute()
    if source != source.resolve() or any(
        path.is_symlink() for path in (source, *source.parents)
    ):
        raise ValueError("Physical normalized entrypoint required")
    root = source.parent
    verify_reviewed(root)
    roles = {
        "prepare": "prepare",
        "observe": "observe",
        "run": "run",
    }
    if len(sys.argv) < 2 or sys.argv[1] not in roles:
        raise ValueError("Exact declared native role required")
    module = roles[sys.argv[1]]
    sys.argv = [str(root / (module + ".py")), *sys.argv[2:]]
    sys.path.insert(0, str(root))
    importlib.import_module(module).main()


if __name__ == "__main__":
    main()
