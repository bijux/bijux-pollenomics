"""Independently reconstruct source-capture identity joins without model admission."""

from __future__ import annotations

from collections import Counter
import csv
from pathlib import Path
from typing import Any

from contracts import AUTHOR_SHA, INPUT_SHA, exact, load, require, sha


def objects(payload: Any) -> list[dict[str, Any]]:
    pending = [payload]
    result = []
    while pending:
        value = pending.pop()
        if isinstance(value, dict):
            result.append(value)
            pending.extend(reversed(list(value.values())))
        elif isinstance(value, list):
            pending.extend(reversed(value))
    return result


def literal_values(payload: Any, name: str) -> set[str]:
    return {
        str(row[name])
        for row in objects(payload)
        if name in row and not isinstance(row[name], (dict, list))
    }


def candidate(root: Path, dataset: int) -> dict[str, Any]:
    parent = root / "capture" if dataset == 3875 else root / "capture/siblings001"
    suffix = "" if dataset == 3875 else "-" + str(dataset)
    names = {
        role: parent / (role + suffix + ".raw")
        for role in ("dataset", "download", "chronologies")
    }
    metadata, download, chronology = (load(names[role]) for role in names)
    site = metadata["data"][0]["site"]
    entry = site["datasets"][0]
    require(
        type(site["siteid"]) is int and site["siteid"] == 2973,
        "Candidate native site identity changed",
    )
    units: Counter[str] = Counter()
    elements: Counter[str] = Counter()
    for row in objects(download):
        if "units" in row:
            units[str(row["units"])] += 1
        if "elementtype" in row:
            elements[str(row["elementtype"])] += 1
    return {
        "dataset_id": dataset,
        "site_id": site["siteid"],
        "collection_handle": site["handle"],
        "sample_id_count": len(literal_values(download, "sampleid")),
        "age_range_as_reported": entry.get("agerange"),
        "chronology_ids": sorted(literal_values(chronology, "chronologyid")),
        "age_types": sorted(
            literal_values(download, "agetype") | literal_values(chronology, "agetype")
        ),
        "chronology_record_count": len(chronology.get("data", [])),
        "observation_units": dict(units),
        "element_types": dict(elements),
        "publication_code_e69_present": any(
            b"E#69" in path.read_bytes() for path in names.values()
        ),
        "source_sha256": {role: sha(path) for role, path in names.items()},
    }


def response_event(
    relative: str,
    row: dict[str, Any],
    files: dict[str, Any],
    response_names: set[str],
    seen: set[str],
) -> dict[str, Any]:
    name = (Path(relative).parent / Path(row["raw_path"]).name).as_posix()
    require(
        name in response_names and name not in seen,
        "Duplicate or undeclared provider response",
    )
    require(
        type(row["http_status"]) is int
        and row["http_status"] == 200
        and row["truncated"] is False
        and row["failure"] is None
        and row["raw_sha256"] == files[name]["sha256"],
        "Original provider response status/hash differs",
    )
    seen.add(name)
    return {
        "path": name,
        "http_status": row["http_status"],
        "raw_sha256": row["raw_sha256"],
    }


def reconstruct(
    repository: Path, root: Path, manifest_path: Path, author: Path
) -> tuple[dict[str, Any], dict[str, Any]]:
    require(
        sha(manifest_path) == INPUT_SHA and sha(author) == AUTHOR_SHA,
        "Source manifest or author identity changed",
    )
    manifest = load(manifest_path)
    require(
        manifest["schema_version"] == "landclim-amsoldingersee-source-inputs.v1"
        and len(manifest["files"]) == 14,
        "Fourteen original source identities required",
    )
    files = manifest["files"]
    for name, expected in files.items():
        path = root / name
        require(
            path.stat().st_size == expected["bytes"]
            and sha(path) == expected["sha256"],
            "Original response identity changed",
        )
    response_names = set(files) - {
        "capture/receipt.json",
        "capture/siblings001/receipt.json",
        "capture/selected-publication-row.json",
    }
    seen: set[str] = set()
    response_events = []
    for relative in ("capture/receipt.json", "capture/siblings001/receipt.json"):
        receipt = load(root / relative)
        require(
            receipt["read_set_unchanged"] is True,
            "Retained provider capture read set changed",
        )
        rows = receipt["responses"]
        for row in rows if isinstance(rows, list) else rows.values():
            response_events.append(
                response_event(relative, row, files, response_names, seen)
            )
    require(
        seen == response_names and len(seen) == 11,
        "Complete eleven-response source join required",
    )
    with author.open(newline="") as stream:
        examples = list(csv.DictReader(stream))
    require(len(examples) == 17, "Original author example denominator changed")
    example_names = {row[key] for row in examples for key in ("filename", "SiteName")}
    publication = load(root / "capture/selected-publication-row.json")
    fields = {row["column"]: row["raw"] for row in publication["values"]}
    require(
        publication["source_locator"]
        == "landclim_ii_site_metadata.xlsx#LANDCLIMII metadata file!1059"
        and fields["SiteName"] == "Amsoldingersee"
        and fields["csvfilename"] == "E#69"
        and fields["nPollenSamples"] == "23"
        and fields["chronologySource"] == "Authors chronology",
        "Declared publication selection changed",
    )
    site = load(root / "capture/sites.raw")["data"][0]
    require(
        type(site["siteid"]) is int and site["siteid"] == 2973,
        "Selected provider native site changed",
    )
    candidates = [candidate(root, dataset) for dataset in (3873, 3874, 3875)]
    require(
        not any(row["publication_code_e69_present"] for row in candidates),
        "Captured candidate acquired a declared E#69 bridge",
    )
    result = {
        "schema_version": "landclim-amsoldingersee-source-review.v1",
        "source_capture_date": "2026-09-21",
        "publication_locator": publication["source_locator"],
        "publication_fields": {
            key: fields[key]
            for key in (
                "SiteName",
                "csvfilename",
                "Country",
                "nPollenSamples",
                "chronologySource",
                "DataRestricted/NotRestriced",
            )
        },
        "outside_author_example_set": fields["csvfilename"] not in example_names
        and fields["SiteName"] not in example_names,
        "site_id": site["siteid"],
        "candidates": candidates,
        "denominators": {
            "selected_publication_rows": 1,
            "candidate_core_count": len(candidates),
            "candidate_with_23_current_sample_ids": sum(
                row["sample_id_count"] == 23 for row in candidates
            ),
            "candidate_with_exact_e69_bridge": 0,
            "candidate_with_authenticated_author_chronology": 0,
            "reproduction_ready": 0,
        },
        "admission": "refused_historical_input_identity",
        "required_next_source": "Source-owner E#69-to-core mapping, exact historical 23-sample count revision, author age-depth output, and authenticated taxon/PFT transformation",
        "input_sha256": {
            "source_inputs": sha(
                repository / "data/landclim/review/amsoldingersee-source-inputs.json"
            ),
            "author_example_site_metadata": AUTHOR_SHA,
        },
    }
    ledger = {
        "original_source_files_verified": 14,
        "original_response_events": response_events,
        "author_example_rows": 17,
        "selected_provider_site": 2973,
        "declared_dataset_requests": [3873, 3874, 3875],
        "dataset_identity_scope": "Request identities authenticated by exact captured-response manifest; no independent dataset-id field claim",
        "new_HTTP_requests": 0,
        "tree_outcomes_or_model_calls": 0,
        "source_capture_date_is_retained_history": True,
        "absence_or_historical_identity_proved": False,
        "rights_human_or_LRA_admission": False,
    }
    return result, ledger


def compare(report: dict[str, Any], expected: dict[str, Any]) -> None:
    require(exact(report, expected), "Complete ordered typed source report differs")
    require(
        report["admission"] == "refused_historical_input_identity"
        and report["denominators"]["candidate_with_exact_e69_bridge"] == 0
        and report["denominators"]["candidate_with_authenticated_author_chronology"]
        == 0
        and report["denominators"]["reproduction_ready"] == 0,
        "Source-refusal boundaries changed",
    )
