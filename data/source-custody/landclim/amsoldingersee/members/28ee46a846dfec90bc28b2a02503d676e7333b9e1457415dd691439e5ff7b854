GROUPS: list[str] = []


def refuses(call: Callable[[], Any]) -> None:
    try:
        call()
    except (ValueError, ImportError):
        return
    raise AssertionError("Unsafe controlled value was accepted")


def group(name: str, call: Callable[[], None]) -> None:
    call()
    GROUPS.append(name)


def json_guard(root: Path) -> None:
    assert not exact(0, False) and not exact(0, 0.0)
    assert not exact([1, 2], [2, 1])
    assert exact({"x": 1, "y": None}, {"y": None, "x": 1})
    path = root / "strict.json"
    for raw in ('{"x":1,"x":2}', '{"x":NaN}', '{"x":Infinity}'):
        path.write_text(raw)
        refuses(lambda: load(path))


def expected_pins(root: Path) -> None:
    path = root / "expected.txt"
    path.write_text("original")
    original = pin(path)
    assert union([original], [original]) == [original]
    refuses(lambda: union([original], [{**original, "sha256": "0" * 64}]))
    refuses(lambda: union([{**original, "bytes": False}]))
    path.write_text("changed during census")
    refuses(lambda: verify_rows([original]))


def tree_guard(root: Path) -> None:
    source = root / "namespace"
    source.mkdir()
    (source / "member.py").write_text("x=1\n")
    baseline = tree_membership(source)
    (source / "empty").mkdir()
    assert tree_membership(source) != baseline
    (source / "special").parent.mkdir(exist_ok=True)
    os.mkfifo(source / "special")
    refuses(lambda: tree(source))
    refuses(lambda: tree_membership(source))
    (source / "special").unlink()
    (source / "escaped").symlink_to(root / "expected.txt")
    refuses(lambda: tree(source))


def environment_guard(root: Path) -> None:
    require_environment({})
    for name in (
        "DYLD_LIBRARY_PATH",
        "DYLD_INSERT_LIBRARIES",
        "LD_PRELOAD",
        "LD_LIBRARY_PATH",
        "_PYTHON_HOST_PLATFORM",
        "__PYVENV_LAUNCHER__",
    ):
        refuses(partial(require_environment, {name: ""}))
    path = root / "missing.zip"
    assert absent_path(path)
    path.symlink_to(root / "absent-target")
    assert not absent_path(path)


def closed_entry(root: Path) -> None:
    source = root / "closed"
    source.mkdir()
    for name in EXPECTED:
        (source / name).write_text('"""Controlled module."""\n')

    def authority(relative: bool = False) -> None:
        rows = [pin(p) for p in sorted(source.glob("*.py"), key=str)]
        if relative:
            rows[0]["path"] = Path(rows[0]["path"]).name
        raw = (json.dumps({"source_only": True, "files": rows}) + "\n").encode()
        (source / "prepared-source-manifest.json").write_bytes(raw)
        (source / "independent-source-review.json").write_text(
            json.dumps(
                {
                    "approved": True,
                    "source_manifest_sha256": hashlib.sha256(raw).hexdigest(),
                }
            )
        )

    authority()
    verify_reviewed(source)
    authority(True)
    refuses(lambda: verify_reviewed(source))
    authority()
    (source / "contracts.py").write_text("changed")
    refuses(lambda: verify_reviewed(source))
    authority()
    for name in ("contracts.so", "runtime.pyc"):
        (source / name).write_bytes(b"not code")
        refuses(lambda: verify_namespace(source))
        (source / name).unlink()
    (source / "alias").symlink_to(root / "expected.txt")
    refuses(lambda: verify_namespace(source))
    (source / "alias").unlink()
    os.mkfifo(source / "fifo")
    refuses(lambda: verify_namespace(source))
    (source / "fifo").unlink()
    (source / "unknown").mkdir()
    refuses(lambda: verify_namespace(source))


def source_responses() -> None:
    files = {"capture/dataset.raw": {"sha256": "a" * 64}}
    allowed = set(files)
    row: dict[str, Any] = {
        "raw_path": "/retained/capture/dataset.raw",
        "http_status": 200,
        "truncated": False,
        "failure": None,
        "raw_sha256": "a" * 64,
    }
    seen: set[str] = set()
    event = response_event("capture/receipt.json", row, files, allowed, seen)
    assert event == {
        "path": "capture/dataset.raw",
        "http_status": 200,
        "raw_sha256": "a" * 64,
    }
    refuses(lambda: response_event("capture/receipt.json", row, files, allowed, seen))
    for key, value in (
        ("raw_path", "foreign.raw"),
        ("http_status", True),
        ("http_status", 201),
        ("truncated", True),
        ("truncated", 0),
        ("failure", "network"),
        ("raw_sha256", "b" * 64),
    ):
        changed = {**row, key: value}
        refuses(
            partial(
                response_event, "capture/receipt.json", changed, files, allowed, set()
            )
        )


def native_candidate(root: Path) -> None:
    parent = root / "capture"
    parent.mkdir()
    data = {
        "data": [
            {
                "site": {
                    "siteid": 2973,
                    "handle": "controlled",
                    "datasets": [{"agerange": [None, 0]}],
                }
            }
        ]
    }
    download = {
        "sampleid": 1,
        "child": [
            {"sampleid": 1, "units": None},
            {
                "sampleid": 2,
                "units": "zero",
                "agetype": "Radiocarbon years BP",
                "elementtype": "pollen",
            },
        ],
    }
    for name, payload in (
        ("dataset", data),
        ("download", download),
        ("chronologies", {"data": []}),
    ):
        (parent / (name + ".raw")).write_text(json.dumps(payload))
    result = candidate(root, 3875)
    assert (
        result["sample_id_count"] == 2
        and result["chronology_ids"] == []
        and result["chronology_record_count"] == 0
    )
    assert result["age_range_as_reported"] == [None, 0] and result[
        "observation_units"
    ] == {"None": 1, "zero": 1}
    assert result["source_sha256"]["download"] == pin(parent / "download.raw")["sha256"]
    data["data"][0]["site"]["siteid"] = True
    (parent / "dataset.raw").write_text(json.dumps(data))
    refuses(lambda: candidate(root, 3875))
    assert literal_values({"x": [{"sampleid": 0}, {"sampleid": None}]}, "sampleid") == {
        "0",
        "None",
    }
    assert [
        row["value"] for row in objects([{"value": "first"}, {"value": "second"}])
    ] == ["first", "second"]


def refusal_guard() -> None:
    report: dict[str, Any] = {
        "admission": "refused_historical_input_identity",
        "denominators": {
            "candidate_with_exact_e69_bridge": 0,
            "candidate_with_authenticated_author_chronology": 0,
            "reproduction_ready": 0,
        },
    }
    compare(report, copy.deepcopy(report))
    for key in report["denominators"]:
        changed = copy.deepcopy(report)
        changed["denominators"][key] = True
        refuses(partial(compare, changed, report))
    changed = copy.deepcopy(report)
    changed["admission"] = "admitted"
    refuses(partial(compare, changed, report))


def denied_models() -> None:
    denied: list[str] = []
    guard = RefuseModels(denied)
    assert guard.find_spec("bijux_pollenomics_dev.source_completion.audit") is None
    assert guard.find_spec("json") is None
    for name in ("numpy.linalg", "scipy", "pandas", "bijux_pollenomics_lra.engine"):
        refuses(partial(guard.find_spec, name))
    assert denied == ["numpy.linalg", "scipy", "pandas", "bijux_pollenomics_lra.engine"]


def actual_schedule() -> dict[str, Any]:
    source = ast.parse((SOURCE / "prepare.py").read_text())
    assignment = next(
        n
        for n in ast.walk(source)
        if isinstance(n, ast.Assign)
        and isinstance(n.targets[0], ast.Subscript)
        and isinstance(n.targets[0].slice, ast.Constant)
        and n.targets[0].slice.value == "stages"
    )
    value = eval(
        compile(ast.Expression(assignment.value), str(SOURCE / "prepare.py"), "eval"),
        {
            "str": str,
            "BASE": BASE,
            "SOURCE": SOURCE,
            "plan_path": SOURCE / "preflight" / "plan.json",
        },
    )
    return {"output": str(SOURCE / "preflight"), "stages": value}


def completion_guard() -> None:
    plan = actual_schedule()
    actual: dict[str, Any] = {
        "actual_exit": 0,
        "stages": [
            {**row, "actual_exit": 0, "timed_out": False} for row in plan["stages"]
        ],
    }
    assert stages_passed(plan, actual)
    for key, value in (("actual_exit", False), ("actual_exit", 1)):
        changed = copy.deepcopy(actual)
        changed[key] = value
        assert not stages_passed(plan, changed)
    for mutation in (
        "missing",
        "extra",
        "reverse",
        "argv",
        "timeout",
        "bool",
        "exit",
        "timed",
    ):
        changed = copy.deepcopy(actual)
        declared = copy.deepcopy(plan)
        if mutation == "missing":
            changed["stages"].pop()
        elif mutation == "extra":
            changed["stages"].append(copy.deepcopy(changed["stages"][0]))
        elif mutation == "reverse":
            changed["stages"].reverse()
        elif mutation == "argv":
            changed["stages"][0]["argv"][5] = "observe"
            declared["stages"][0]["argv"][5] = "observe"
        elif mutation == "timeout":
            changed["stages"][0]["timeout_seconds"] = 46
            declared["stages"][0]["timeout_seconds"] = 46
        elif mutation == "bool":
            changed["stages"][0]["actual_exit"] = False
        elif mutation == "exit":
            changed["stages"][0]["actual_exit"] = 1
        else:
            changed["stages"][0]["timed_out"] = True
        assert not stages_passed(declared, changed), mutation


def product_join(root: Path) -> None:
    witness_path = root / "witness.json"
    witness_path.write_text("{}\n")
    produced = root / "report.json"
    produced.write_text('{"admission":"refused"}\n')
    witness = {"generated_report": pin(produced)}
    declared = {
        "source_runtime": pin(witness_path),
        "generated_report": pin(produced),
        "source_exit": 0,
        "metadata_exit": 0,
    }
    source_products(declared, witness, witness_path, produced)
    for key in ("source_exit", "metadata_exit"):
        bad = copy.deepcopy(declared)
        bad[key] = False
        refuses(partial(source_products, bad, witness, witness_path, produced))
    witness_path.write_text('{"changed":true}\n')
    refuses(lambda: source_products(declared, witness, witness_path, produced))
    declared["source_runtime"] = pin(witness_path)
    produced.write_text('{"admission":"promoted"}\n')
    refuses(lambda: source_products(declared, witness, witness_path, produced))


def accounting_guard(root: Path) -> None:
    output = root / "accounting"
    output.mkdir()
    (output / "data").write_bytes(b"1234")
    raw = receipt_bytes(output, {"actual_exit": 0}, 1024)
    document = json.loads(raw)
    assert document["inclusive_output_bytes"] == len(raw) + 4
    refuses(lambda: receipt_bytes(output, {"actual_exit": 0}, len(raw)))
    os.mkfifo(output / "fifo")
    refuses(lambda: receipt_bytes(output, {}, 1024))


def main() -> None:
    base = SOURCE / "preflight"
    with tempfile.TemporaryDirectory(prefix="source-controls-", dir=base) as name:
        root = Path(name)
        for title, call in (
            ("strict JSON/typed ordered values", lambda: json_guard(root)),
            ("original pin freeze/conflicts", lambda: expected_pins(root)),
            ("complete namespace/special/alias", lambda: tree_guard(root)),
            ("empty loader env and dangling absence", lambda: environment_guard(root)),
            ("actual entry held schema/prefix refusals", lambda: closed_entry(root)),
            (
                "native site/sample source reconstruction",
                lambda: native_candidate(root),
            ),
            ("complete response status/hash/duplicate refusal", source_responses),
            ("source refusal nonpromotion", refusal_guard),
            ("model import denial", denied_models),
            ("actual prepare two-stage/completion schema", completion_guard),
            ("actual stdout/witness/product joins", lambda: product_join(root)),
            ("inclusive receipt storage", lambda: accounting_guard(root)),
        ):
            group(title, call)
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "synthetic_source_groups": GROUPS,
                "group_count": len(GROUPS),
                "private_payloads_opened": 0,
                "native_consumers_or_runtime_census": 0,
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
