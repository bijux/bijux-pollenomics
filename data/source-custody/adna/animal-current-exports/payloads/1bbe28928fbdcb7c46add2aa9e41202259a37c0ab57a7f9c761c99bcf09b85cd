"""Bound the complete owned metadata child, including its admission and final custody scans."""

from __future__ import annotations

import argparse
from contextlib import suppress
import os
from pathlib import Path
import resource
import signal
import subprocess
import sys
import time

from contracts import (
    PYTHON,
    RESOURCES,
    SOURCE,
    load,
    registered_plan,
    require,
    strict_equal,
    write,
)
from runtime_contracts import require_runtime_environment
from source_inputs import pin
from source_runtime import clean_child_environment


def remaining_seconds(started: float, now: float, bound: int) -> float:
    require(now >= started and bound == 480, "Invalid outer watchdog clock/bound")
    remaining = bound - (now - started)
    require(remaining > 0, "Outer startup consumed watchdog budget")
    return remaining


def main(started: float) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--registered-plan-sha256", required=True)
    args = parser.parse_args()
    require_runtime_environment(dict(os.environ))
    require(
        Path(sys.executable).absolute() == PYTHON
        and sys.flags.isolated == 1
        and sys.dont_write_bytecode,
        "Qualified isolated lexical launcher required",
    )
    require(
        pin(args.plan)["sha256"] == args.registered_plan_sha256,
        "Registered plan differs",
    )
    plan = registered_plan(args.plan, args.registered_plan_sha256)
    require(strict_equal(plan["resources"], RESOURCES), "Declared resources differ")
    output = Path(plan["output"])
    terminal = output / "capture-launch-terminal.json"
    for path in [terminal, output / "launch.stdout", output / "launch.stderr"]:
        require(
            not path.exists() and not path.is_symlink(),
            "No launch receipt/stream replacement",
        )
    argv = [
        str(PYTHON),
        "-I",
        "-B",
        str(SOURCE / "entry.py"),
        "run",
        "--plan",
        str(args.plan),
        "--registered-plan-sha256",
        args.registered_plan_sha256,
    ]
    environment = clean_child_environment(dict(os.environ))
    environment.update(plan["environment"])
    # Only this child performs the lengthy admission/private/runtime and final scans.
    remaining_seconds(started, time.monotonic(), RESOURCES["outer_timeout_seconds"])
    child = subprocess.Popen(
        argv,
        cwd=plan["owned_repository"],
        env=environment,
        start_new_session=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    timeout = False
    try:
        stdout, stderr = child.communicate(
            timeout=remaining_seconds(
                started, time.monotonic(), RESOURCES["outer_timeout_seconds"]
            )
        )
    except (subprocess.TimeoutExpired, ValueError):
        timeout = True
        with suppress(ProcessLookupError):
            os.killpg(child.pid, signal.SIGKILL)
        stdout, stderr = child.communicate()
    with (output / "launch.stdout").open("xb") as stream:
        stream.write(stdout)
    with (output / "launch.stderr").open("xb") as stream:
        stream.write(stderr)
    inner_path = output / "capture-terminal.json"
    inner = (
        load(inner_path)
        if inner_path.is_file() and not inner_path.is_symlink()
        else None
    )
    plan_unchanged = pin(args.plan)["sha256"] == args.registered_plan_sha256
    total = 0
    for path in output.rglob("*"):
        require(
            not path.is_symlink() and (path.is_file() or path.is_dir()),
            "Output alias/special refused",
        )
        if path.is_file():
            total += path.stat().st_size
    elapsed = time.monotonic() - started
    rss = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
    memory = rss <= RESOURCES["declared_memory_bytes"]
    storage = total + 16384 <= RESOURCES["declared_storage_bytes"]
    wall = elapsed <= RESOURCES["outer_timeout_seconds"]
    passed = (
        not timeout
        and child.returncode == 0
        and inner is not None
        and type(inner.get("actual_exit")) is int
        and inner["actual_exit"] == 0
        and inner.get("plan_sha256") == args.registered_plan_sha256
        and plan_unchanged
        and memory
        and storage
        and wall
    )
    write(
        terminal,
        {
            "schema_version": "animal-current-export-metadata-capture-watchdog.v1",
            "candidate": plan["candidate"],
            "plan_sha256": args.registered_plan_sha256,
            "actual_exit": 0 if passed else 1,
            "actual_child_argv": argv,
            "actual_child_pid_and_session_group": child.pid,
            "child_native_exit": child.returncode,
            "child_timed_out": timeout,
            "registered_plan_unchanged": plan_unchanged,
            "inner_terminal": pin(inner_path) if inner is not None else None,
            "stdout": pin(output / "launch.stdout"),
            "stderr": pin(output / "launch.stderr"),
            "completed_elapsed_from_entry_seconds": elapsed,
            "memory_bound_pass": memory,
            "inclusive_storage_bound_pass": storage,
            "completed_outer_wall_bound_pass": wall,
            "completed_child_peak_RSS_bytes_macos": rss,
            "logical_output_bytes_before_terminal": total,
            "own_receipt_reserve_bytes": 16384,
            "resources": RESOURCES,
            "watchdog_scope": "Entire delegated owned child, including child entry imports, historical-input/runtime guards, both metadata stages and final scans. Minimal parent entry verification/startup and post-reap receipt accounting consume the measured outer budget but have no independent parent watchdog; no detached/aggregate-descendant cleanup or OS quota claim.",
        },
    )
    require(terminal.stat().st_size <= 16384, "Outer receipt exceeds reserve")
    print(
        __import__("json").dumps(
            {"terminal": pin(terminal), "actual_exit": 0 if passed else 1}
        )
    )
    raise SystemExit(0 if passed else 1)
