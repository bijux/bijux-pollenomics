"""Exercise the exact current place dependency on artificial bytes and source AST only."""

from __future__ import annotations

from copy import deepcopy
from functools import partial
import json
import os
from pathlib import Path
import sys
import tempfile
from typing import Any

SOURCE = Path(__file__).absolute().parent
sys.path.insert(0, str(SOURCE))
from check_controls import artificial_data_authority  # noqa: E402
from data_inputs import expected_data, verify_source_ancestry  # noqa: E402
from inputs.place_roles import (  # noqa: E402
    PDF_PATH,
    SOURCE_PATH,
    bind_current_place,
    dependency_identity,
    freeze_current_place,
    validate_roles,
    verify_registered_place,
)
from source_inputs import InputScope, exact_union, pin  # noqa: E402

CASES = 0


def refuses(call: Any) -> None:
    global CASES
    try:
        call()
    except (ValueError, TypeError, KeyError):
        CASES += 1
        return
    raise AssertionError("Invalid current place-hierarchy dependency accepted")


def main() -> None:
    global CASES
    declared = json.loads((SOURCE / "declared-inputs.json").read_bytes())
    root = SOURCE.parents[2]
    validate_roles(declared["current_place_hierarchy_sources"])
    # Only the maintained public Python source is opened; no actual PDF bytes.
    assert (
        dependency_identity(root, declared)
        == declared["current_place_hierarchy_sources"][0]["payload"]
    )
    CASES += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as name:
        controlled = Path(name)
        fixture = artificial_data_authority(controlled, declared)
        frozen, metadata = expected_data(controlled, fixture)
        assert len(frozen) == 162 and len(metadata) == 53
        roles = bind_current_place(controlled, fixture, frozen)
        assert (
            len(roles) == 1 and roles[0]["original_catalog_protection_claimed"] is False
        )
        scope = InputScope(frozen, [])
        scope.verify()
        plan: dict[str, Any] = {
            "repository": str(controlled),
            "owned_repository": str(controlled),
            "source_declaration": fixture,
            "original_data_row_authority": frozen,
            "current_place_hierarchy_sources": roles,
            "input_pins": exact_union(frozen, [pin(controlled / SOURCE_PATH)]),
        }
        verify_registered_place(plan, roles)
        CASES += 1
        for key, value in (
            ("project_accession", "other"),
            ("source_role", "original_catalog"),
            ("original_catalog_protection_claimed", True),
        ):
            wrong = deepcopy(roles)
            wrong[0][key] = value
            refuses(partial(validate_roles, wrong))
        for key, value in (
            ("path", "../outside.pdf"),
            ("sha256", "bad"),
            ("bytes", True),
        ):
            wrong = deepcopy(roles)
            wrong[0]["payload"][key] = value
            refuses(partial(validate_roles, wrong))
        refuses(partial(validate_roles, []))
        refuses(partial(validate_roles, roles + roles))
        wrong_declared = deepcopy(fixture)
        wrong_declared["other_source_inputs"].append(roles[0]["payload"])
        refuses(partial(dependency_identity, controlled, wrong_declared))
        wrong_declared = deepcopy(fixture)
        wrong_declared["original_source_library_roles"].append(roles[0]["payload"])
        refuses(partial(dependency_identity, controlled, wrong_declared))
        wrong = deepcopy(roles)
        wrong[0]["payload"]["sha256"] = "0" * 64
        refuses(partial(verify_registered_place, plan, wrong))
        wrong_plan = deepcopy(plan)
        wrong_plan["current_place_hierarchy_sources"] = []
        refuses(partial(verify_registered_place, wrong_plan, roles))
        wrong_plan = deepcopy(plan)
        wrong_plan["input_pins"] = [
            row
            for row in plan["input_pins"]
            if row["path"] != str(controlled / PDF_PATH)
        ]
        refuses(partial(verify_registered_place, wrong_plan, roles))
        source = controlled / SOURCE_PATH
        body = source.read_bytes()
        source.write_bytes(body + b"\n")
        refuses(partial(freeze_current_place, controlled, fixture))
        source.write_bytes(body)
        altered = deepcopy(fixture)
        changed = body.replace(b"42003_2021_2794_MOESM2_ESM.pdf", b"other.pdf")
        source.write_bytes(changed)
        altered["place_hierarchy_source_contract"] = {
            **pin(source),
            "path": SOURCE_PATH,
        }
        refuses(partial(dependency_identity, controlled, altered))
        source.write_bytes(body)
        payload = controlled / PDF_PATH
        original = payload.read_bytes()
        payload.write_bytes(original + b"changed")
        refuses(partial(freeze_current_place, controlled, fixture))
        refuses(scope.verify)
        refuses(partial(scope.extend, [pin(payload)]))
        payload.write_bytes(original)
        payload.unlink()
        os.mkfifo(payload)
        refuses(partial(freeze_current_place, controlled, fixture))
        payload.unlink()
        payload.write_bytes(original)
        alternate = payload.with_name("controlled.pdf")
        payload.rename(alternate)
        payload.symlink_to(alternate)
        refuses(partial(freeze_current_place, controlled, fixture))
        refuses(partial(verify_source_ancestry, controlled, frozen))
        payload.unlink()
        alternate.rename(payload)
        scope.verify()
        verify_registered_place(plan, roles)
        CASES += 1
    print(
        json.dumps(
            {
                "source_only": True,
                "actual_exit": 0,
                "artificial_cases": CASES,
                "actual_PDF_body_or_hash_API_preparation_or_runtime": False,
            }
        )
    )


if __name__ == "__main__":
    main()
