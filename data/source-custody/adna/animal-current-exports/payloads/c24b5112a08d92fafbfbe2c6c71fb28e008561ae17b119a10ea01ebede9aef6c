FORBIDDEN = frozenset(
    {
        "pollen_count",
        "pollen_sum",
        "relative_pollen_percentage",
        "ppe",
        "fall_speed_m_s",
        "whole_pollen",
    }
)


def exact(left: Any, right: Any) -> bool:
    try:
        same(left, right)
    except ValueError:
        return False
    return True


def read(path: Path) -> Any:
    def pairs(values: list[tuple[str, Any]]) -> dict[str, Any]:
        require(
            len(values) == len({key for key, _ in values}), "Repeated source JSON key"
        )
        return dict(values)

    def nonfinite(value: str) -> None:
        raise ValueError("Nonfinite source JSON token: " + value)

    return json.loads(
        path.read_bytes(), object_pairs_hook=pairs, parse_constant=nonfinite
    )


def clean(payload: Any) -> None:
    pending = [payload]
    while pending:
        value = pending.pop()
        if type(value) is dict:
            require(
                not FORBIDDEN.intersection(value),
                "Pollen semantics entered an animal record",
            )
            pending.extend(value.values())
        elif type(value) is list:
            pending.extend(value)
        elif type(value) is float:
            require(math.isfinite(value), "Nonfinite metadata number")


def validate_record(
    species: dict[str, str], row: dict[str, Any]
) -> dict[str, Any] | None:
    require(
        type(row) is dict and set(row) == set(RECORD_FIELDS),
        "Full native record field population differs",
    )
    clean(row)
    nested = {"identity", "locality_identity", "coordinates", "chronology", "datasets"}
    optional = {"locality", "political_entity"}
    for key in set(RECORD_FIELDS) - nested:
        require(
            type(row[key]) is str or (key in optional and row[key] is None),
            "Native text/null type differs: " + key,
        )
    require(
        type(row["datasets"]) is list
        and all(type(value) is str for value in row["datasets"]),
        "Native dataset labels are not a source list",
    )
    identity = row["identity"]
    require(
        type(identity) is dict
        and set(identity) == {"namespace", "stable_token", "accession_lineage"},
        "Native identity key population differs",
    )
    require(
        type(identity["namespace"]) is str
        and type(identity["stable_token"]) is str
        and type(identity["accession_lineage"]) is list
        and all(type(value) is str for value in identity["accession_lineage"]),
        "Native identity scalar/list types differ",
    )
    local = row["locality_identity"]
    require(
        type(local) is dict
        and set(local)
        == {
            "namespace",
            "stable_token",
            "locality_text",
            "political_entity",
            "source_anchor_tokens",
        },
        "Native locality identity key population differs",
    )
    require(
        all(
            type(local[key]) is str
            for key in ("namespace", "stable_token", "locality_text")
        )
        and (
            local["political_entity"] is None or type(local["political_entity"]) is str
        )
        and type(local["source_anchor_tokens"]) is list
        and all(type(value) is str for value in local["source_anchor_tokens"]),
        "Native locality identity field type differs",
    )
    coordinates = row["coordinates"]
    require(
        type(coordinates) is dict
        and set(coordinates)
        == {"latitude", "longitude", "latitude_text", "longitude_text", "confidence"},
        "Native coordinate key population differs",
    )
    for key in ("latitude", "longitude"):
        require(
            coordinates[key] is None
            or (
                type(coordinates[key]) in {int, float}
                and math.isfinite(coordinates[key])
            ),
            "Native coordinate type differs",
        )
    require(
        all(
            type(coordinates[key]) is str
            for key in ("latitude_text", "longitude_text", "confidence")
        ),
        "Native coordinate text differs",
    )
    chronology = row["chronology"]
    endpoints = {"time_start_bp", "time_end_bp", "time_mean_bp"}
    text = {
        "original_text",
        "date_stddev_bp",
        "source_mean_bp_text",
        "dating_basis",
        "evidence_class",
        "precision_posture",
        "refusal_reason_code",
    }
    require(
        type(chronology) is dict and set(chronology) == endpoints | text,
        "Full owned chronology fields differ",
    )
    require(
        all(type(chronology[key]) is str for key in text),
        "Owned chronology source text differs",
    )
    require(
        all(
            chronology[key] is None or type(chronology[key]) is int for key in endpoints
        ),
        "Owned chronology BP type differs",
    )
    # Complete native support is compared; this contract never substitutes a hull or a new date.
    return animal_identity(species["slug"], species["latin_name"], row)


def flat_record(sample: dict[str, Any]) -> dict[str, Any]:
    result = deepcopy(sample)
    coordinate = result.pop("coordinates")
    result.update(
        {
            key: coordinate[key]
            for key in ("latitude", "longitude", "latitude_text", "longitude_text")
        }
    )
    result["coordinate_confidence"] = coordinate["confidence"]
    return result


def csv_bytes(samples: list[dict[str, Any]]) -> bytes:
    output = io.StringIO(newline="")
    writer = csv.DictWriter(
        output, fieldnames=list(CURRENT_FIELDS), lineterminator="\n"
    )
    writer.writeheader()
    for sample in samples:
        writer.writerow(flat_csv_record(flat_record(sample)))
    return output.getvalue().encode("utf-8")


def geojson_document(samples: list[dict[str, Any]]) -> dict[str, Any]:
    return flat_geojson([flat_record(sample) for sample in samples])


def dataset_counts(samples: list[dict[str, Any]]) -> dict[str, int]:
    return dict(
        sorted(
            Counter(dataset for row in samples for dataset in row["datasets"]).items()
        )
    )


def project_roles(owned: Path) -> list[dict[str, str]]:
    base = (
        owned
        / "packages/bijux-pollenomics/src/bijux_pollenomics/adna/sources/archive/catalog"
    )
    factory = ast.parse((base / "factory.py").read_text())
    constructor = next(
        node
        for node in factory.body
        if isinstance(node, ast.FunctionDef) and node.name == "_project"
    )
    defaults = dict(
        zip(
            (node.arg for node in constructor.args.kwonlyargs),
            constructor.args.kw_defaults,
            strict=True,
        )
    )
    family_default = defaults["source_family"]
    assert family_default is not None
    require(
        ast.literal_eval(family_default) == "ENA",
        "Default source family changed",
    )
    result = []
    for path in sorted((base / "taxa").glob("*.py")):
        for node in ast.walk(ast.parse(path.read_text())):
            if (
                not isinstance(node, ast.Call)
                or not isinstance(node.func, ast.Name)
                or node.func.id != "_project"
            ):
                continue
            require(
                len(node.args) == 2
                and all(keyword.arg is not None for keyword in node.keywords),
                "Literal native project authority required",
            )
            values = {keyword.arg: keyword.value for keyword in node.keywords}
            result.append(
                {
                    "species_latin_name": ast.literal_eval(node.args[0]),
                    "project_accession": ast.literal_eval(node.args[1]),
                    "source_family": ast.literal_eval(values["source_family"])
                    if "source_family" in values
                    else "ENA",
                    "archive_status": ast.literal_eval(values["archive_status"]),
                }
            )
    require(bool(result), "No native project source roles")
    return result


def admitted_sources(
    species: dict[str, str], roles: list[dict[str, str]]
) -> set[tuple[str, str]]:
    return {
        (row["source_family"], row["project_accession"])
        for row in roles
        if row["species_latin_name"] == species["latin_name"]
        and row["archive_status"]
        in {
            "paper_pinned_core",
            "archive_verified_needs_paper_pinning",
            "comparator_only",
        }
    }


def source_population(
    species: dict[str, str], document: dict[str, Any], roles: list[dict[str, str]]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    require(
        document["species_latin_name"] == species["latin_name"]
        and type(document["samples"]) is list,
        "Normalized source container differs",
    )
    clean(document)
    rows = document["samples"]
    require(
        len({row["identity"]["stable_token"] for row in rows}) == len(rows),
        "Duplicate normalized animal source identity",
    )
    witnesses = []
    selected = []
    excluded = []
    admitted = admitted_sources(species, roles)
    for row in rows:
        finding = validate_record(species, row)
        if finding is not None:
            witnesses.append(finding)
        if (row["source_family"], row["source_release"]) in admitted:
            selected.append(row)
        else:
            excluded.append(
                {
                    "sample_id": row["identity"]["stable_token"],
                    "source_family": row["source_family"],
                    "source_release": row["source_release"],
                    "reason": "not_in_actual_runtime_manifest_source_admission",
                    "inclusion_status": row["inclusion_status"],
                    "taxon_alignment_status": row["taxon_alignment_status"],
                }
            )
    return selected, excluded, witnesses


def country_rows(
    samples: list[dict[str, Any]], country: str | None
) -> list[dict[str, Any]]:
    if country is None:
        return samples
    return [
        row
        for row in samples
        if row["political_entity"] is not None
        and row["political_entity"].casefold() == country.casefold()
    ]
