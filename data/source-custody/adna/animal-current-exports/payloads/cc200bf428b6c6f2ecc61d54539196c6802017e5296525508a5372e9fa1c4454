def refuses(call: Any) -> None:
    try:
        call()
    except (ValueError, TypeError):
        return
    raise AssertionError("Controlled invalid source shape accepted")


def record(species: dict[str, str], master: str = "native-1") -> dict[str, Any]:
    row: dict[str, Any] = dict.fromkeys(RECORD_FIELDS, "")
    taxon, slug = species["latin_name"], species["slug"]
    row.update(
        species_latin_name=taxon,
        species_common_name="fixture",
        source_family="ENA",
        source_release="PRJFIXTURE",
        master_id=master,
        group_id="PRJFIXTURE",
        project_accession="PRJFIXTURE",
        record_modality="archive_reads",
        review_strength="primary_paper_pinned",
        provenance_quality="archive_project_catalog",
        locality=None,
        political_entity="Sweden",
        datasets=["fixture-dataset"],
        inclusion_status="included",
        taxon_alignment_status="project_species_match",
        source_native_identity_kind="biological_sample_accession",
    )
    row["identity"] = {
        "namespace": slug + ":curated_sample",
        "stable_token": slug + ":sample:" + master.casefold(),
        "accession_lineage": [
            "species:" + taxon,
            "source:ENA",
            "project:PRJFIXTURE",
            "sample:" + master,
        ],
    }
    row["locality_identity"] = {
        "namespace": slug + ":sample_locality",
        "stable_token": "owned-place",
        "locality_text": "fixture",
        "political_entity": "Sweden",
        "source_anchor_tokens": ["PRJFIXTURE", "archive"],
    }
    row["coordinates"] = {
        "latitude": 0.0,
        "longitude": -0.0,
        "latitude_text": "0",
        "longitude_text": "-0",
        "confidence": "unknown",
    }
    row["chronology"] = {
        "original_text": "source-owned zero",
        "time_start_bp": 0,
        "time_end_bp": 0,
        "time_mean_bp": 0,
        "date_stddev_bp": "",
        "source_mean_bp_text": "0",
        "dating_basis": "radiocarbon",
        "evidence_class": "sample_precise_point",
        "precision_posture": "sample_precise_point",
        "refusal_reason_code": "",
    }
    return row


def maintained_namespace() -> dict[str, Any]:
    name = "animal_serializer_artificial_only"
    module = types.ModuleType(name)
    sys.modules[name] = module
    ns = module.__dict__
    ns.update(
        dataclass=dataclasses.dataclass,
        Mapping=Mapping,
        cast=cast,
        json=json,
        csv=__import__("csv"),
        Path=Path,
    )
    prefix = ROOT / "packages/bijux-pollenomics/src/bijux_pollenomics"
    selections = [
        (
            "adna/domain/models/identity.py",
            {"AdnaSampleIdentity", "AdnaLocalityIdentity"},
        ),
        ("adna/domain/models/chronology.py", {"AdnaCoordinate", "AdnaChronology"}),
        ("adna/domain/models/samples.py", {"AdnaSampleRecord"}),
        ("adna/domain/models/occurrence_support.py", {"AdnaSampleChronologySupport"}),
        (
            "reporting/rendering/record_exports.py",
            {
                "serialize_sample_record",
                "_sample_export_fields",
                "build_sample_geojson_feature",
                "build_samples_geojson",
                "write_samples_csv",
                "write_samples_geojson",
            },
        ),
    ]
    for path, wanted in selections:
        tree = ast.parse((prefix / path).read_text())
        nodes = [
            node
            for node in tree.body
            if isinstance(node, (ast.ClassDef, ast.FunctionDef)) and node.name in wanted
        ]
        assert {node.name for node in nodes} == wanted
        constants = [
            node
            for node in tree.body
            if isinstance(node, ast.Assign)
            and any(
                isinstance(t, ast.Name)
                and t.id
                in {
                    "LEGACY_SAMPLE_EXPORT_FIELDS",
                    "SAMPLE_EXPORT_FIELDS",
                    "SAMPLE_RECORD_SCHEMA",
                    "LEGACY_SAMPLE_RECORD_SCHEMA",
                }
                for t in node.targets
            )
        ]
        source = ast.Module(
            body=[
                ast.ImportFrom(
                    module="__future__", names=[ast.alias(name="annotations")], level=0
                ),
                *constants,
                *nodes,
            ],
            type_ignores=[],
        )
        exec(
            compile(
                ast.fix_missing_locations(source),
                "actual-model-writer-artificial-records-only",
                "exec",
            ),
            ns,
        )
    return ns


def native_record(ns: dict[str, Any], source: dict[str, Any]) -> Any:
    row = deepcopy(source)
    row["identity"] = ns["AdnaSampleIdentity"](
        **{
            **row["identity"],
            "accession_lineage": tuple(row["identity"]["accession_lineage"]),
        }
    )
    row["locality_identity"] = ns["AdnaLocalityIdentity"](
        **{
            **row["locality_identity"],
            "source_anchor_tokens": tuple(
                row["locality_identity"]["source_anchor_tokens"]
            ),
        }
    )
    row["coordinates"] = ns["AdnaCoordinate"](**row["coordinates"])
    row["chronology"] = ns["AdnaChronology"](**row["chronology"])
    row["datasets"] = tuple(row["datasets"])
    return ns["AdnaSampleRecord"](**row)


def artificial_data_authority(root: Path, original: dict[str, Any]) -> dict[str, Any]:
    value = deepcopy(original)
    value["source_root"] = str(root)
    groups = (
        value["physical_source_library_rows"],
        value["comparison_inputs"],
        value["other_source_inputs"],
        value["additional_current_metadata"],
    )
    physical = {}
    for rows in groups:
        for row in rows:
            target = root / row["path"]
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(
                ("controlled artificial identity " + row["path"]).encode()
            )
            measured = pin(target)
            row["bytes"] = measured["bytes"]
            if "sha256" in row:
                row["sha256"] = measured["sha256"]
            physical[row["path"]] = {
                "path": row["path"],
                "sha256": measured["sha256"],
                "bytes": measured["bytes"],
            }
    logical = {
        row["logical"]["path"]: row["logical"]
        for row in value["logical_transport_roles"]
    }
    value["original_source_library_roles"] = [
        physical.get(row["path"], logical.get(row["path"]))
        for row in value["original_source_library_roles"]
    ]
    for row in value["logical_transport_roles"]:
        row["stored"] = physical[row["stored"]["path"]]
        row["receipt"] = physical[row["receipt"]["path"]]
    for role in value["current_adapter_sources"]:
        payload = ("artificial logical archive " + role["project_accession"]).encode()
        logical = root / role["logical"]["path"]
        logical.parent.mkdir(parents=True, exist_ok=True)
        stored = root / role["stored"]["path"]
        stored.write_bytes(gzip.compress(payload, mtime=0))
        measured = pin(stored)
        lacks_old_SHA = role["project_accession"] == "PRJEB44430"
        role["logical"].update(
            bytes=len(payload),
            sha256=None if lacks_old_SHA else hashlib.sha256(payload).hexdigest(),
        )
        role["stored"].update(
            bytes=measured["bytes"],
            sha256=None if lacks_old_SHA else measured["sha256"],
        )
        role["receipt_identity"].update(
            byte_size=len(payload),
            content_sha256=role["logical"]["sha256"],
            storage_sha256=role["stored"]["sha256"],
            storage_byte_size=measured["bytes"],
        )
        receipt = root / role["receipt"]["path"]
        receipt.write_text(json.dumps(role["receipt_identity"]))
        role["receipt"].update(
            bytes=pin(receipt)["bytes"], sha256=pin(receipt)["sha256"]
        )
    contract = value["official_dependency_source_contract"]
    source_path = root / contract["path"]
    source_path.parent.mkdir(parents=True, exist_ok=True)
    source_path.write_bytes((ROOT / contract["path"]).read_bytes())
    for role in value["current_official_XML_sources"]:
        payload = ("artificial official XML " + role["sample_accession"]).encode()
        path = root / role["payload"]["path"]
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(payload)
        role["payload"].update(
            bytes=len(payload), sha256=hashlib.sha256(payload).hexdigest()
        )
        role["receipt_identity"].update(
            byte_size=len(payload),
            storage_byte_size=len(payload),
            content_sha256=role["payload"]["sha256"],
            storage_sha256=role["payload"]["sha256"],
        )
        receipt = root / role["receipt"]["path"]
        receipt.write_text(json.dumps(role["receipt_identity"]))
        role["receipt"].update(
            bytes=receipt.stat().st_size, sha256=pin(receipt)["sha256"]
        )
    catalog = root / "controlled-catalog.json"
    catalog.write_text(
        json.dumps(
            {
                "inputs": [
                    *value["original_source_library_roles"],
                    *value["other_source_inputs"],
                ]
            }
        )
    )
    value["original_catalog"] = pin(catalog)
    saved = root / "controlled-saved-plan.json"
    saved.write_text(
        json.dumps({"declared_inputs": {"files": value["comparison_inputs"]}})
    )
    value["saved_normalized_authority"] = pin(saved)
    role = value["current_place_hierarchy_sources"][0]
    place = root / role["payload"]["path"]
    place.parent.mkdir(parents=True, exist_ok=True)
    place.write_bytes(b"artificial current place evidence")
    role["payload"] = {**pin(place), "path": role["payload"]["path"]}
    contract = value["place_hierarchy_source_contract"]
    place_source = root / contract["path"]
    place_source.parent.mkdir(parents=True, exist_ok=True)
    # Keep the native literal path AST while substituting only the synthetic PDF hash.
    actual_source = (ROOT / contract["path"]).read_text()
    actual_source = actual_source.replace(
        "4d0cbd7e5c8be63b1e5e51e400f5030ee92fcec52025027a985e58655b88973b",
        role["payload"]["sha256"],
    )
    place_source.write_text(actual_source)
    value["place_hierarchy_source_contract"] = {
        **pin(place_source),
        "path": contract["path"],
    }
    return value


def main() -> None:
    value: Any
    groups = 0
    declaration = json.loads((SOURCE / "declared-inputs.json").read_bytes())
    assert len(role_rows(declaration)) == 90
    for key in (
        "physical_source_library_rows",
        "original_source_library_roles",
        "comparison_inputs",
        "species",
        "additional_current_metadata",
    ):
        for values in (
            [],
            declaration[key][:-1],
            [*declaration[key], declaration[key][0]],
        ):
            wrong = deepcopy(declaration)
            wrong[key] = values
            refuses(partial(role_rows, wrong))
    groups += 1
    require_source_environment({})
    for value in ("", "/outside"):
        refuses(
            partial(
                require_source_environment,
                {"BIJUX_POLLENOMICS_REFERENCE_STASH_ROOT": value},
            )
        )
    groups += 1
    species = {"slug": "bos_taurus", "latin_name": "Bos taurus"}
    original = record(species)
    validate_record(species, original)
    for field, value in (
        ("master_id", True),
        ("species_latin_name", "Bos indicus"),
        ("datasets", "fixture"),
    ):
        wrong = deepcopy(original)
        wrong[field] = value
        refuses(partial(validate_record, species, wrong))
    for field, value in (
        ("time_start_bp", False),
        ("time_mean_bp", 0.0),
        ("refusal_reason_code", None),
    ):
        wrong = deepcopy(original)
        wrong["chronology"][field] = value
        refuses(partial(validate_record, species, wrong))
    wrong = deepcopy(original)
    wrong["chronology"]["pollen_count"] = 10
    refuses(partial(validate_record, species, wrong))
    groups += 1
    exceptions = []
    for (slug, master), (taxon, tax_id, project) in SOURCE_TAXON_EXCEPTIONS.items():
        container = {
            "slug": slug,
            "latin_name": {"bos_taurus": "Bos taurus", "ovis_aries": "Ovis aries"}[
                slug
            ],
        }
        row = record(container, master)
        row.update(
            species_latin_name=taxon,
            source_native_scientific_name=taxon,
            source_native_tax_id=tax_id,
            source_release=project,
            project_accession=project,
            group_id=project,
            taxon_alignment_status="project_species_mismatch",
            inclusion_status="sample_context_blocked",
        )
        row["identity"]["accession_lineage"] = [
            "species:" + taxon,
            "source:ENA",
            "project:" + project,
            "sample:" + master,
        ]
        assert validate_record(container, row) is not None
        for field, value in (
            ("inclusion_status", "included"),
            ("source_native_tax_id", "wrong"),
            ("source_family", "SRA"),
            ("source_native_identity_kind", "sequencing_experiment_accession"),
        ):
            changed = deepcopy(row)
            changed[field] = value
            refuses(partial(validate_record, container, changed))
        exceptions.append((container, row))
    groups += 1
    roles = [
        {
            "species_latin_name": "Bos taurus",
            "source_family": "ENA",
            "project_accession": "PRJFIXTURE",
            "archive_status": "paper_pinned_core",
        }
    ]
    included, excluded, _ = source_population(
        species, {"species_latin_name": "Bos taurus", "samples": [original]}, roles
    )
    assert included == [original] and excluded == []
    assert (
        source_population(
            species,
            {"species_latin_name": "Bos taurus", "samples": [original]},
            [dict(roles[0], archive_status="reject_or_out_of_scope")],
        )[0]
        == []
    )
    assert (
        country_rows(included, "sweden") == included
        and country_rows(included, "Denmark") == []
    )
    assert country_rows(included, None) == included
    changed = deepcopy(original)
    changed["political_entity"] = None
    assert country_rows([changed], "Sweden") == []
    assert dataset_counts([original]) == {"fixture-dataset": 1}
    groups += 1
    actual_roles = project_roles(ROOT)
    same(actual_roles, declaration["project_source_roles"])
    groups += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as temporary:
        root = Path(temporary)
        artificial = root / "artificial-data-authority"
        artificial.mkdir()
        inputs = artificial_data_authority(artificial, declaration)
        frozen_rows, current_metadata = expected_data(artificial, inputs)
        assert len(frozen_rows) == 162 and len(current_metadata) == 53
        frozen_data = InputScope(frozen_rows, [])
        frozen_data.verify()
        verify_source_ancestry(artificial, frozen_rows)
        old_directory = artificial / "data"
        moved_directory = artificial / "relocated-data"
        old_directory.rename(moved_directory)
        old_directory.symlink_to(moved_directory, target_is_directory=True)
        refuses(partial(verify_source_ancestry, artificial, frozen_rows))
        old_directory.unlink()
        moved_directory.rename(old_directory)
        changed_metadata = Path(current_metadata[0]["path"])
        changed_metadata.write_bytes(changed_metadata.read_bytes() + b"changed")
        refuses(frozen_data.verify)
        groups += 1
        ns = maintained_namespace()
        try:
            source_rows = [original, *[row for _, row in exceptions]]
            null = deepcopy(original)
            null["master_id"] = "missing"
            null["coordinates"].update(latitude=None, longitude=None)
            null["chronology"].update(
                time_start_bp=None,
                time_end_bp=None,
                time_mean_bp=None,
                refusal_reason_code="negative_bp",
            )
            source_rows.append(null)
            samples = [native_record(ns, row) for row in source_rows]
            for sample, source in zip(samples, source_rows, strict=True):
                same(json.loads(json.dumps(sample.as_dict())), source)
            for index, selected in enumerate((samples, [], samples[:1])):
                expected = (
                    source_rows if index == 0 else [] if index == 1 else source_rows[:1]
                )
                csv_path, geo_path = root / f"{index}.csv", root / f"{index}.geojson"
                ns["write_samples_csv"](csv_path, selected)
                ns["write_samples_geojson"](geo_path, selected)
                assert csv_path.read_bytes() == csv_bytes(expected)
                assert (
                    geo_path.read_bytes()
                    == json.dumps(
                        geojson_document(expected),
                        indent=2,
                        ensure_ascii=False,
                        allow_nan=False,
                    ).encode()
                )
        finally:
            sys.modules.pop("animal_serializer_artificial_only")
        groups += 1
        logical = root / "logical.html"
        stored = logical.with_name(logical.name + ".gz")
        logical_body = b"controlled source body only"
        stored.write_bytes(gzip.compress(logical_body, mtime=0))
        role = {
            "logical": {
                "path": logical.name,
                "bytes": len(logical_body),
                "sha256": hashlib.sha256(logical_body).hexdigest(),
            },
            "stored": {**pin(stored), "path": stored.name},
        }
        verify_logical_inputs(root, [role])
        wrong = deepcopy(role)
        wrong["logical"]["sha256"] = "f" * 64
        refuses(partial(verify_logical_inputs, root, [wrong]))
        logical.write_bytes(logical_body)
        refuses(partial(verify_logical_inputs, root, [role]))
        groups += 1
        plan_path = root / "plan.json"
        plan_path.write_bytes(b'{"source":0}')
        checksum = pin(plan_path)["sha256"]
        assert registered_plan(plan_path, checksum) == {"source": 0}
        previous = os.environ.get("BIJUX_REGISTERED_PLAN_SHA256")
        try:
            os.environ["BIJUX_REGISTERED_PLAN_SHA256"] = checksum
            assert stage_plan(plan_path) == {"source": 0}
            os.environ["BIJUX_REGISTERED_PLAN_SHA256"] = "f" * 64
            refuses(partial(stage_plan, plan_path))
        finally:
            if previous is None:
                os.environ.pop("BIJUX_REGISTERED_PLAN_SHA256", None)
            else:
                os.environ["BIJUX_REGISTERED_PLAN_SHA256"] = previous
        for value in (False, None, "", "f" * 64):
            refuses(partial(registered_plan, plan_path, value))
        plan_path.write_bytes(b'{"source":false}')
        refuses(partial(registered_plan, plan_path, checksum))
        groups += 1
        one = root / "frozen"
        one.write_bytes(b"original")
        frozen = InputScope([pin(one)], [])
        one.write_bytes(b"changed")
        refuses(partial(frozen.extend, [pin(one)]))
        refuses(frozen.verify)
        groups += 1
        tree = root / "data"
        tree.mkdir()
        leaf = tree / "source.json"
        leaf.write_bytes(b"controlled")
        snapshot = namespace(tree, [pin(leaf)])
        verify_base_namespaces([snapshot])
        (tree / "unknown").write_bytes(b"extra")
        refuses(partial(verify_base_namespaces, [snapshot]))
        (tree / "unknown").unlink()
        os.mkfifo(tree / "fifo")
        refuses(partial(verify_base_namespaces, [snapshot]))
        (tree / "fifo").unlink()
        (tree / "alias").symlink_to(leaf)
        refuses(partial(verify_base_namespaces, [snapshot]))
        groups += 1
        controlled = root / "entry-source"
        controlled.mkdir()
        rows = []
        for path in sorted([*SOURCE.glob("*.py"), *(SOURCE / "inputs").glob("*.py")]):
            target = controlled / path.relative_to(SOURCE)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(path, target)
            rows.append(pin(target))
        manifest = controlled / "prepared-source-manifest.json"

        def seal(values: list[dict[str, Any]]) -> None:
            manifest.write_text(json.dumps({"source_only": True, "files": values}))
            (controlled / "independent-source-review.json").write_text(
                json.dumps(
                    {
                        "approved": True,
                        "source_manifest_sha256": pin(manifest)["sha256"],
                    }
                )
            )

        seal(rows)
        verify(controlled)
        seal([{**row, "path": Path(row["path"]).name} for row in rows])
        refuses(partial(verify, controlled))
        seal(rows)
        (controlled / "contracts.so").write_bytes(b"shadow")
        refuses(partial(verify, controlled))
        groups += 1
    preparation = ast.parse((SOURCE / "prepare.py").read_text())
    main_source = next(
        node
        for node in preparation.body
        if isinstance(node, ast.FunctionDef) and node.name == "main"
    )
    plan_dictionary = next(
        node.value
        for node in main_source.body
        if isinstance(node, ast.AnnAssign)
        and isinstance(node.target, ast.Name)
        and node.target.id == "plan"
    )
    assert isinstance(plan_dictionary, ast.Dict)
    stages_node = next(
        value
        for key, value in zip(plan_dictionary.keys, plan_dictionary.values, strict=True)
        if isinstance(key, ast.Constant) and key.value == "stages"
    )
    schedule = ast.literal_eval(stages_node)
    output = SOURCE / "preflight/prospective-output"
    for stage in schedule:
        stage["argv"] = [
            str(__import__("contracts").PYTHON),
            "-I",
            "-B",
            str(SOURCE / "entry.py"),
            stage["action"],
            "--plan",
            str(output / "plan.json"),
        ]
    validate_stages({"resources": RESOURCES, "stages": schedule}, output / "plan.json")
    for rows in ([], schedule[:1], list(reversed(schedule))):
        refuses(
            partial(
                validate_stages,
                {"resources": RESOURCES, "stages": rows},
                output / "plan.json",
            )
        )
    wrong = deepcopy(schedule)
    wrong[0]["timeout_seconds"] = True
    refuses(
        partial(
            validate_stages,
            {"resources": RESOURCES, "stages": wrong},
            output / "plan.json",
        )
    )
    assert remaining_seconds(10, 20, 570) == 560
    refuses(partial(remaining_seconds, 10, 600, 570))
    fake = {
        "owned_repository": "/owned",
        "output": "/owned-output",
        "species": declaration["species"],
    }
    calls = expected_calls(fake)
    assert (
        len(calls) == 160
        and sum(row["call"] == "load_species_samples" for row in calls) == 50
    )
    groups += 1
    print(
        json.dumps(
            {
                "source_only": True,
                "actual_exit": 0,
                "controlled_groups": groups,
                "real_application_API_private_source_decode_preparer_runtime_or_native_executed": False,
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
