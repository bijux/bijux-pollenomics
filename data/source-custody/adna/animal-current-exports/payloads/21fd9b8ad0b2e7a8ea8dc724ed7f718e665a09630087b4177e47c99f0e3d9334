"""Copy authenticated public execution payloads; never decode original source data or repeat source consumers."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
from typing import Any

from contracts import (
    CAPTURE,
    PACKET_LIMIT,
    checkpoint,
    execution_scope,
    physical,
    registered_plan,
    require,
    write,
)
from packet import member_name
from source_inputs import pin


def materialize(source: Path, target: Path, row: dict[str, Any]) -> None:
    physical(row)
    require(
        str(source) == row["path"]
        and not target.exists()
        and not any(p.is_symlink() for p in (target, *target.parents)),
        "New physical public target required",
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    with source.open("rb") as incoming, target.open("xb") as outgoing:
        shutil.copyfileobj(incoming, outgoing, 1024 * 1024)
    actual = pin(target)
    require(
        all(actual[k] == row[k] for k in ("sha256", "bytes")), "Public copy differs"
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = registered_plan(args.plan)
    authority, scope = execution_scope(plan)
    output = Path(plan["output"])
    root = output / "packet"
    require(not root.exists() and not root.is_symlink(), "New packet root required")
    packet = plan["transport"]["packet"]
    raw = (json.dumps(packet, indent=2, allow_nan=False) + "\n").encode()
    forecast = len(raw) + sum(row["bytes"] for row in packet["members"].values())
    require(
        forecast == plan["transport"]["total_packet_bytes"] <= PACKET_LIMIT,
        "Frozen packet forecast differs",
    )
    root.mkdir()
    for name, row in plan["transport"]["member_sources"].items():
        member_name(name)
        require(
            packet["members"][name] == {k: row[k] for k in ("sha256", "bytes")},
            "Public member source differs",
        )
        materialize(Path(row["path"]), root / name, row)
    with (root / "capture.json").open("xb") as stream:
        stream.write(raw)
    checkpoint(authority, scope, plan["historical_namespaces"])
    write(
        output / "assembly-result.json",
        {
            "actual_exit": 0,
            "metadata_retention_only": True,
            "raw_decode_or_source_consumer_repeated": False,
            "public_capture_path": CAPTURE,
            "capture": pin(root / "capture.json"),
            "public_payload_count": len(packet["members"]),
            "exact_packet_bytes": forecast,
            "original_owner_acceptance_changed": False,
        },
    )


if __name__ == "__main__":
    main()
