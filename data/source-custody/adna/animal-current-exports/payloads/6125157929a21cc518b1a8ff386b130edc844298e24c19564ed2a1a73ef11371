"""Check complete current official XML source roles using artificial payloads only."""

from __future__ import annotations

from copy import deepcopy
from functools import partial
import json
from pathlib import Path
import sys
import tempfile
from typing import Any

SOURCE = Path(__file__).absolute().parent
sys.path.insert(0, str(SOURCE))
from check_controls import artificial_data_authority  # noqa: E402
from data_inputs import expected_data, verify_source_ancestry  # noqa: E402
from inputs.official_roles import (  # noqa: E402
    ADDED_ACCESSIONS,
    bind_current_official,
    dependency_paths,
    freeze_current_official,
    require_projection_coverage,
    typed_equal,
    validate_roles,
    verify_registered_official,
)
from source_inputs import InputScope  # noqa: E402

CASES = 0


def refuses(call: Any) -> None:
    global CASES
    try:
        call()
    except (ValueError, TypeError, KeyError):
        CASES += 1
        return
    raise AssertionError("Official source role accepted an invalid dependency")


def main() -> None:
    global CASES
    declaration = json.loads((SOURCE / "declared-inputs.json").read_bytes())
    validate_roles(declaration["current_official_XML_sources"])
    assert (
        tuple(
            r["sample_accession"] for r in declaration["current_official_XML_sources"]
        )
        == ADDED_ACCESSIONS
    )
    CASES += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as name:
        root = Path(name)
        fixture = artificial_data_authority(root, declaration)
        paths = dependency_paths(root, fixture)
        assert len(paths) == 6 and sum(path.endswith(".xml") for path in paths) == 6
        require_projection_coverage(root, fixture)
        CASES += 1
        frozen, metadata = expected_data(root, fixture)
        assert len(frozen) == 162 and len(metadata) == 53
        scope = InputScope(frozen, [])
        scope.verify()
        CASES += 1
        roles = bind_current_official(root, fixture, frozen)
        assert len(roles) == 3
        plan = {
            "repository": str(root),
            "source_declaration": fixture,
            "original_data_row_authority": frozen,
            "new_current_official_XML_sources": roles,
        }
        verify_registered_official(plan, roles)
        CASES += 1
        for key, value in [
            ("source_role", "original_catalogue"),
            ("original_catalog_protection_claimed", True),
            ("sample_accession", "SAMEA999"),
        ]:
            changed = deepcopy(roles)
            changed[0][key] = value
            refuses(partial(validate_roles, changed))
        for key, value in [
            ("path", "../escape.xml"),
            ("sha256", "bad"),
            ("bytes", True),
        ]:
            changed = deepcopy(roles)
            changed[0]["payload"][key] = value
            refuses(partial(validate_roles, changed))
        for key, value in [
            ("sample_accession", "wrong"),
            ("content_sha256", "0" * 64),
            ("content_encoding", "gzip"),
            ("storage_byte_size", 1.0),
        ]:
            changed = deepcopy(roles)
            changed[0]["receipt_identity"][key] = value
            refuses(partial(validate_roles, changed))
        refuses(partial(validate_roles, roles[:-1]))
        refuses(partial(validate_roles, list(reversed(roles))))
        changed_declaration = deepcopy(fixture)
        changed_declaration["physical_source_library_rows"] = [
            row
            for row in changed_declaration["physical_source_library_rows"]
            if "SAMEA112960291.xml" not in row["path"]
        ]
        refuses(partial(require_projection_coverage, root, changed_declaration))
        changed_declaration = deepcopy(fixture)
        changed_declaration["additional_current_metadata"] = [
            row
            for row in changed_declaration["additional_current_metadata"]
            if "SAMEA112960293.xml.metadata.json" not in row["path"]
        ]
        refuses(partial(require_projection_coverage, root, changed_declaration))
        changed_declaration = deepcopy(fixture)
        changed_declaration["current_official_XML_sources"] = changed_declaration[
            "current_official_XML_sources"
        ][:-1]
        refuses(partial(require_projection_coverage, root, changed_declaration))
        changed = deepcopy(roles)
        changed[0]["payload"]["bytes"] = float(changed[0]["payload"]["bytes"])
        refuses(partial(verify_registered_official, plan, changed))
        source = root / fixture["official_dependency_source_contract"]["path"]
        original = source.read_bytes()
        source.write_bytes(original + b"\n")
        refuses(partial(dependency_paths, root, fixture))
        source.write_bytes(original)
        payload = root / roles[0]["payload"]["path"]
        original = payload.read_bytes()
        payload.write_bytes(original + b"x")
        refuses(partial(freeze_current_official, root, fixture))
        refuses(scope.verify)
        payload.write_bytes(original)
        receipt = root / roles[0]["receipt"]["path"]
        original = receipt.read_bytes()
        receipt.write_bytes(original + b" ")
        refuses(partial(freeze_current_official, root, fixture))
        receipt.write_bytes(original)
        alternate = payload.with_name("alternate.xml")
        alternate.write_bytes(payload.read_bytes())
        payload.unlink()
        payload.symlink_to(alternate)
        refuses(partial(freeze_current_official, root, fixture))
        refuses(partial(verify_source_ancestry, root, frozen))
        payload.unlink()
        payload.write_bytes(alternate.read_bytes())
        alternate.unlink()
        scope.verify()
        CASES += 1
    assert not typed_equal({"size": 2691}, {"size": 2691.0})
    CASES += 1
    print(
        json.dumps(
            {
                "source_only": True,
                "actual_exit": 0,
                "artificial_cases": CASES,
                "real_XML_hash_or_decode_API_preparation_or_runtime": False,
            }
        )
    )


if __name__ == "__main__":
    main()
