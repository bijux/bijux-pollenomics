"""Protect current official XML dependencies without promoting them to original catalogue custody."""

from __future__ import annotations

import ast
from copy import deepcopy
import hashlib
import json
from pathlib import Path
from typing import Any

from source_inputs import exact_union, pin

ADDED_ACCESSIONS = ("SAMEA112960292", "SAMEA112960294", "SAMEA112960295")
XML_PREFIX = "data/adna/governance/source_library/projects/PRJEB59481/ena_samples/"


def require(value: object, reason: str) -> None:
    if not value:
        raise ValueError(reason)


def normalized(row: dict[str, Any]) -> dict[str, Any]:
    name = row["path"]
    path = Path(name)
    require(
        type(name) is str
        and path.parts
        and not path.is_absolute()
        and path.as_posix() == name
        and ".." not in path.parts,
        "Closed relative official-source identity required",
    )
    checksum = row["sha256"]
    require(
        type(checksum) is str
        and len(checksum) == 64
        and all(c in "0123456789abcdef" for c in checksum)
        and type(row["bytes"]) is int
        and row["bytes"] > 0,
        "Exact official-source SHA and size required",
    )
    return {key: row[key] for key in ("path", "sha256", "bytes")}


def typed_equal(left: object, right: object) -> bool:
    if type(left) is not type(right):
        return False
    if isinstance(left, dict) and isinstance(right, dict):
        return set(left) == set(right) and all(
            typed_equal(left[key], right[key]) for key in left
        )
    if isinstance(left, list) and isinstance(right, list):
        return len(left) == len(right) and all(
            typed_equal(a, b) for a, b in zip(left, right, strict=True)
        )
    return left == right


def validate_roles(roles: list[dict[str, Any]]) -> None:
    require(
        type(roles) is list
        and tuple(row["sample_accession"] for row in roles) == ADDED_ACCESSIONS,
        "Only three additional current official XML roles required",
    )
    for row in roles:
        accession = row["sample_accession"]
        payload, receipt = normalized(row["payload"]), normalized(row["receipt"])
        require(
            payload["path"] == XML_PREFIX + accession + ".xml"
            and receipt["path"] == payload["path"] + ".metadata.json"
            and row["source_role"] == "current_adapter_required_official_XML"
            and row["original_catalog_protection_claimed"] is False,
            "Current official-source role or path promoted/crossed",
        )
        metadata = row["receipt_identity"]
        require(
            metadata["schema_version"] == "adna-source-library.v1"
            and metadata["project_accession"] == "PRJEB59481"
            and metadata["sample_accession"] == accession
            and metadata["source_url"]
            == "https://www.ebi.ac.uk/ena/browser/api/xml/" + accession
            and metadata["artifact_kind"] == "ena_sample_xml"
            and metadata["content_type"] == "application/xml"
            and metadata["content_encoding"] is None
            and metadata["storage_path"] == payload["path"].removeprefix("data/")
            and type(metadata["byte_size"]) is int
            and type(metadata["storage_byte_size"]) is int
            and metadata["byte_size"]
            == metadata["storage_byte_size"]
            == payload["bytes"]
            and metadata["content_sha256"]
            == metadata["storage_sha256"]
            == payload["sha256"],
            "Declared official-source receipt does not bind exact source bytes",
        )


def dependency_paths(root: Path, declared: dict[str, Any]) -> list[str]:
    """Derive all five native XML and article dependencies from authenticated source AST."""
    contract = normalized(declared["official_dependency_source_contract"])
    path = root / contract["path"]
    require(
        not any(node.is_symlink() for node in (path, *path.parents)) and path.is_file(),
        "Official dependency source alias/missing",
    )
    raw = path.read_bytes()
    require(
        len(raw) == contract["bytes"]
        and hashlib.sha256(raw).hexdigest() == contract["sha256"],
        "Reviewed official dependency source changed",
    )
    names = {
        "_EXPECTED_IDENTITIES",
        "ENA_SAMPLE_SOURCE_DIRECTORY",
        "ARTICLE_SOURCE_PATH",
        "EXPECTED_SAMPLE_COUNT",
    }
    assignments: dict[str, Any] = {}
    for node in ast.parse(raw).body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id in names:
                    require(
                        target.id not in assignments,
                        "Duplicate official dependency constant",
                    )
                    assignments[target.id] = ast.literal_eval(node.value)
    require(
        set(assignments) == names
        and type(assignments["EXPECTED_SAMPLE_COUNT"]) is int
        and assignments["EXPECTED_SAMPLE_COUNT"]
        == len(assignments["_EXPECTED_IDENTITIES"])
        == 5,
        "Native five-source official dependency set differs",
    )
    prefix = assignments["ENA_SAMPLE_SOURCE_DIRECTORY"]
    require(prefix + "/" == XML_PREFIX, "Official XML directory differs")
    accessions = [row[0] for row in assignments["_EXPECTED_IDENTITIES"].values()]
    require(
        len(accessions) == len(set(accessions)) == 5
        and set(ADDED_ACCESSIONS) < set(accessions),
        "Native official XML accession set differs",
    )
    paths = [prefix + "/" + accession + ".xml" for accession in accessions]
    paths.append(assignments["ARTICLE_SOURCE_PATH"])
    return paths


def require_projection_coverage(root: Path, declared: dict[str, Any]) -> list[str]:
    validate_roles(declared["current_official_XML_sources"])
    selected = {
        row["path"]
        for key in (
            "physical_source_library_rows",
            "additional_current_metadata",
            "comparison_inputs",
            "other_source_inputs",
        )
        for row in declared[key]
    }
    selected.update(
        row["logical"]["path"] for row in declared["logical_transport_roles"]
    )
    for row in declared["current_official_XML_sources"]:
        selected.update(row[key]["path"] for key in ("payload", "receipt"))
    required = dependency_paths(root, declared)
    require(
        all(
            name in selected and name + ".metadata.json" in selected
            for name in required
        ),
        "Current source projection omits a native official XML/article or receipt",
    )
    original = {row["path"] for row in declared["original_source_library_roles"]}
    require(
        all(
            row["payload"]["path"] not in original
            for row in declared["current_official_XML_sources"]
        ),
        "New official source was relabelled as original77 protection",
    )
    return required


def freeze_current_official(
    root: Path, declared: dict[str, Any]
) -> list[dict[str, Any]]:
    require_projection_coverage(root, declared)
    frozen = []
    for row in declared["current_official_XML_sources"]:
        for key in ("payload", "receipt"):
            expected = row[key]
            path = root / expected["path"]
            require(
                not any(node.is_symlink() for node in (path, *path.parents)),
                "Current official source ancestor alias",
            )
            actual = pin(path)
            require(
                {**actual, "path": expected["path"]} == expected,
                "Declared current official-source bytes changed before census",
            )
            frozen.append(actual)
        metadata = json.loads((root / row["receipt"]["path"]).read_bytes())
        require(type(metadata) is dict, "Current official receipt object required")
        require(
            typed_equal(
                {key: metadata.get(key) for key in row["receipt_identity"]},
                row["receipt_identity"],
            ),
            "Current official receipt fields changed",
        )
    return exact_union(frozen)


def bind_current_official(
    root: Path, declared: dict[str, Any], frozen: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    validate_roles(declared["current_official_XML_sources"])
    protected = {row["path"]: row for row in frozen}
    roles: list[dict[str, Any]] = deepcopy(declared["current_official_XML_sources"])
    for row in roles:
        for key in ("payload", "receipt"):
            expected = row[key]
            require(
                protected[str(root / expected["path"])]
                == {**expected, "path": str(root / expected["path"])},
                "Official source lost its exact pre-census authority",
            )
    return roles


def verify_registered_official(
    plan: dict[str, Any], observed: list[dict[str, Any]]
) -> None:
    expected = bind_current_official(
        Path(plan["repository"]),
        plan["source_declaration"],
        plan["original_data_row_authority"],
    )
    require(
        typed_equal(plan["new_current_official_XML_sources"], expected)
        and typed_equal(observed, expected),
        "Registered current official-source roles differ",
    )
