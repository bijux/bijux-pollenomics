"""Keep current reader-required archives separate from original catalogue custody."""

from __future__ import annotations

from copy import deepcopy
import gzip
import hashlib
import json
from pathlib import Path
from typing import Any

from source_inputs import exact_union, pin

PROJECTS = ("PRJEB41594", "PRJEB59481", "PRJEB60484", "PRJEB81815", "PRJEB44430")
PREFIX = "data/adna/governance/source_library/projects/"


def require(value: object, reason: str) -> None:
    if not value:
        raise ValueError(reason)


def checksum(value: object) -> bool:
    return (
        type(value) is str
        and len(value) == 64
        and all(c in "0123456789abcdef" for c in value)
    )


def validate_roles(roles: list[dict[str, Any]]) -> None:
    require(
        type(roles) is list and len(roles) == 5,
        "Exact five current archive roles required",
    )
    require(
        tuple(row["project_accession"] for row in roles) == PROJECTS,
        "Current archive project membership/order differs",
    )
    for row in roles:
        project = row["project_accession"]
        logical = PREFIX + project + "/archive_metadata.html"
        require(
            row["source_role"] == "current_source_adapter_required_archive"
            and row["original_catalog_protection_claimed"] is False,
            "Current archive role promoted to original custody",
        )
        require(
            row["logical"]["path"] == logical
            and row["stored"]["path"] == logical + ".gz"
            and row["receipt"]["path"] == logical + ".metadata.json",
            "Current archive logical/transport/receipt paths differ",
        )
        for key in ("logical", "stored", "receipt"):
            require(
                set(row[key]) == {"path", "sha256", "bytes"}
                and type(row[key]["bytes"]) is int
                and row[key]["bytes"] > 0,
                "Current archive identity schema differs",
            )
        require(checksum(row["receipt"]["sha256"]), "Receipt SHA required")
        unmeasured = project == "PRJEB44430"
        require(
            (
                row["stored"]["sha256"] is None
                and row["logical"]["sha256"] is None
                and row["stored_SHA_authority"] == "current_preparation"
                and row["logical_SHA_authority"] == "new_registered_observation"
            )
            if unmeasured
            else (
                checksum(row["stored"]["sha256"])
                and checksum(row["logical"]["sha256"])
                and row["stored_SHA_authority"] == "declared_current_receipt"
                and row["logical_SHA_authority"] == "declared_current_receipt"
            ),
            "Only exact PRJEB44430 lacks historical receipt SHA fields",
        )
        receipt = row["receipt_identity"]
        require(
            receipt["schema_version"] == "adna-source-library.v1"
            and receipt["project_accession"] == project
            and receipt["artifact_kind"] == "archive_metadata_html"
            and receipt["content_encoding"] == "gzip"
            and receipt["storage_path"] == (logical + ".gz").removeprefix("data/")
            and type(receipt["byte_size"]) is int
            and receipt["byte_size"] == row["logical"]["bytes"]
            and type(receipt["storage_byte_size"]) is int
            and receipt["storage_byte_size"] == row["stored"]["bytes"]
            and receipt["content_sha256"] == row["logical"]["sha256"]
            and receipt["storage_sha256"] == row["stored"]["sha256"],
            "Declared current receipt/transport identities crossed",
        )


def freeze_current_archives(
    root: Path, roles: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    validate_roles(roles)
    frozen = []
    for row in roles:
        for key in ("logical", "stored", "receipt"):
            path = root / row[key]["path"]
            require(
                not any(p.is_symlink() for p in (path, *path.parents)),
                "Current reader archive ancestor alias refused",
            )
        logical = root / row["logical"]["path"]
        require(
            not logical.exists() and not logical.is_symlink(),
            "Current archive plaintext absence changed",
        )
        receipt = root / row["receipt"]["path"]
        measured_receipt = pin(receipt)
        require(
            {**measured_receipt, "path": row["receipt"]["path"]} == row["receipt"],
            "Originally reviewed current receipt changed before freeze",
        )
        metadata = json.loads(receipt.read_bytes())
        require(
            {key: metadata.get(key) for key in row["receipt_identity"]}
            == row["receipt_identity"],
            "Actual current receipt fields differ from reviewed declarations",
        )
        stored = pin(root / row["stored"]["path"])
        require(
            stored["bytes"] == row["stored"]["bytes"]
            and (
                row["stored"]["sha256"] is None
                or stored["sha256"] == row["stored"]["sha256"]
            ),
            "Current stored archive differs from declared receipt",
        )
        # The sole unpinned receipt transport becomes a new current preparation identity.
        frozen.extend([measured_receipt, stored])
    return exact_union(frozen)


def bind_current_archives(
    root: Path, roles: list[dict[str, Any]], frozen: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    validate_roles(roles)
    protected = {row["path"]: row for row in frozen}
    answer = deepcopy(roles)
    for row in answer:
        for key in ("stored", "receipt"):
            current = protected[str(root / row[key]["path"])]
            require(
                type(current["bytes"]) is int
                and current["bytes"] == row[key]["bytes"]
                and checksum(current["sha256"])
                and (
                    row[key]["sha256"] is None
                    or current["sha256"] == row[key]["sha256"]
                ),
                "Current reader archive lost its pre-census frozen identity",
            )
            row[key] = {**current, "path": row[key]["path"]}
    return answer


def observe_current_logical(
    owned: Path, bound: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    require(
        tuple(row["project_accession"] for row in bound) == PROJECTS,
        "Current registered archive order differs",
    )
    observations = []
    for row in bound:
        logical = owned / row["logical"]["path"]
        stored = owned / row["stored"]["path"]
        require(
            not logical.exists() and not logical.is_symlink(),
            "Registered current logical source absence changed",
        )
        require(
            pin(stored) == {**row["stored"], "path": str(stored)},
            "Current registered archive transport changed",
        )
        digest = hashlib.sha256()
        length = 0
        with gzip.open(stored, "rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                length += len(chunk)
                require(
                    length <= row["logical"]["bytes"],
                    "Current gzip exceeds declared size",
                )
                digest.update(chunk)
        measured = {
            "path": row["logical"]["path"],
            "sha256": digest.hexdigest(),
            "bytes": length,
        }
        require(
            length == row["logical"]["bytes"]
            and (
                row["logical"]["sha256"] is None
                or measured["sha256"] == row["logical"]["sha256"]
            ),
            "Current logical archive differs from declared receipt",
        )
        observations.append(
            {
                "project_accession": row["project_accession"],
                "logical": measured,
                "stored": row["stored"],
                "receipt": row["receipt"],
                "logical_SHA_authority": row["logical_SHA_authority"],
                "original_catalog_protection_claimed": False,
            }
        )
    return observations


def verify_observed_archives(
    plan: dict[str, Any], observations: list[dict[str, Any]]
) -> None:
    expected = bind_current_archives(
        Path(plan["repository"]),
        plan["source_declaration"]["current_adapter_sources"],
        plan["original_data_row_authority"],
    )
    require(
        plan["new_current_adapter_sources"] == expected,
        "Registered current archive authority differs from complete frozen input roles",
    )
    require(
        type(observations) is list and len(observations) == 5,
        "Five actual logical observations required",
    )
    for row, actual in zip(expected, observations, strict=True):
        require(
            set(actual)
            == {
                "project_accession",
                "logical",
                "stored",
                "receipt",
                "logical_SHA_authority",
                "original_catalog_protection_claimed",
            },
            "Current archive observation fields differ",
        )
        require(
            actual["project_accession"] == row["project_accession"]
            and actual["stored"] == row["stored"]
            and actual["receipt"] == row["receipt"]
            and actual["original_catalog_protection_claimed"] is False
            and actual["logical_SHA_authority"] == row["logical_SHA_authority"],
            "Current archive observation source role crossed",
        )
        logical = actual["logical"]
        require(
            set(logical) == {"path", "sha256", "bytes"}
            and logical["path"] == row["logical"]["path"]
            and type(logical["bytes"]) is int
            and logical["bytes"] == row["logical"]["bytes"]
            and checksum(logical["sha256"])
            and (
                row["logical"]["sha256"] is None
                or logical["sha256"] == row["logical"]["sha256"]
            ),
            "Current logical observation has wrong type/identity/declared size",
        )
