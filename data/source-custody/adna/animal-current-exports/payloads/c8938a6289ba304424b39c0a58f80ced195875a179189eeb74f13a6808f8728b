def main() -> None:
    global COUNT
    changed: Any
    p, ledger, s, m, q, r = source_fixture()
    assert len(packet.data_identity_rows(p)) == 322
    COUNT += 1
    roles = packet.input_roles(p, ledger, s, m, q, r)
    assert (
        len(roles) == 62435
        and sum(row["payload_member"] is None for row in roles) == 60204
    )
    COUNT += 1
    assert (
        len(packet.source_join(p, ledger)) == 6710
        and len(packet.retention_input_rows(p)) == 62435
    )
    COUNT += 1
    catalogue = {
        "files": ledger["copied_sources"]
        + [identity("/fixture/native/output" + str(i)) for i in range(159)]
    }
    assert (
        len(catalogue["files"]) == 2512
        and len(packet.selected_catalogue_rows(p, catalogue)) == 2352
    )
    COUNT += 1
    original_paths = set(packet.data_identity_rows(p))
    assert not original_paths.intersection(
        row["path"] for row in packet.selected_catalogue_rows(p, catalogue)
    )
    COUNT += 1
    changed = deepcopy(catalogue)
    changed["files"].append(identity("/fixture/native/owned-source/data/unknown"))
    refusal(lambda: packet.selected_catalogue_rows(p, changed))
    changed = deepcopy(p)
    changed["input_pins"][0]["bytes"] = True
    refusal(lambda: packet.retention_input_rows(changed))
    changed = deepcopy(ledger)
    changed["omitted_unselected_cache_bytecode"][0]["executed_or_copied"] = True
    refusal(lambda: packet.source_join(p, changed))
    fixture = native_fixture()
    result = packet.qualify_scope(*fixture)
    assert (
        result["derived_products"] == 150
        and result["rights_biology_human_calibration_LRA_or_whole_ADNA_admitted"]
        is False
    )
    COUNT += 1
    assert len(packet.product_roles(fixture[0], fixture[3], fixture[4])) == 150
    COUNT += 1
    mutations: list[tuple[int, str, Any]] = [
        (1, "actual_exit", True),
        (1, "actual_exit", 1),
        (2, "child_native_exit", False),
        (4, "actual_API_source_admitted_population", 1468.0),
        (4, "no_pollen_measurement_fields_in_typed_or_default_exports", False),
        (4, "original_normalization_native_receipt_requalified", True),
        (3, "API_reads_saved_normalized_JSON_as_producer_input", True),
        (3, "original_logical_source_identities_verified", True),
    ]
    for index, key, value in mutations:
        changed = deepcopy(fixture)
        changed[index][key] = value
        refusal(lambda changed=changed: packet.qualify_scope(*changed))
    for mutation in [
        "stage",
        "timeout",
        "extra",
        "writer",
        "field",
        "block",
        "count",
        "product",
        "ready",
        "oldrole",
        "archive",
        "private",
    ]:
        changed = deepcopy(fixture)
        if mutation == "stage":
            changed[1]["stages"].reverse()
        elif mutation == "timeout":
            changed[1]["stages"][0]["timeout_seconds"] = True
        elif mutation == "extra":
            changed[0]["stages"].append(changed[0]["stages"][0])
        elif mutation == "writer":
            changed[3]["maintained_public_calls"][-1]["schema_argument"] = "legacy_v1"
        elif mutation == "field":
            changed[4]["actual_default_export_fields"][0] = "pollen_count"
        elif mutation == "block":
            changed[4]["source_owned_taxon_exceptions"][0]["inclusion_status"] = (
                "included"
            )
        elif mutation == "count":
            changed[3]["populations"][0]["results"][0]["sample_count"] = True
        elif mutation == "product":
            changed[3]["populations"][0]["results"][0]["products"]["typed"]["path"] = (
                "/fixture/raw/source.json"
            )
        elif mutation == "ready":
            changed[3]["populations"][0]["runtime_manifest"]["runtime_ready"] = True
        elif mutation == "oldrole":
            changed[3]["current_place_hierarchy_input_roles"][0][
                "original_catalog_protection_claimed"
            ] = True
        elif mutation == "archive":
            changed[3]["current_adapter_logical_observations"][4]["logical"][
                "bytes"
            ] = True
        else:
            changed[3]["actual_first_party_origins"][0]["path"] = (
                "/fixture/private/source.py"
            )
        refusal(lambda changed=changed: packet.qualify_scope(*changed))
    packet.object_same({"a": [1, 2], "b": False}, {"b": False, "a": [1, 2]})
    COUNT += 1
    for left, right in [
        ({"a": 1}, {"a": True}),
        ({"a": [1, 2]}, {"a": [2, 1]}),
        ({"a": 0.0}, {"a": -0.0}),
    ]:
        refusal(lambda left=left, right=right: packet.object_same(left, right))
    for name in [".", "../payload", "payloads/" + "g" * 64]:
        refusal(lambda name=name: packet.member_name(name))
    inner = identity("/fixture/native/animal-export-terminal.json")
    raw = (json.dumps({"terminal": inner, "actual_exit": 0}) + "\n").encode()
    outer = {
        "stdout": {
            "path": "/fixture/native/launch.stdout",
            "sha256": hashlib.sha256(raw).hexdigest(),
            "bytes": len(raw),
        },
        "stderr": identity("/fixture/native/launch.stderr"),
    }
    packet.outer_stream_correspondence({"files": []}, outer, inner)
    COUNT += 1
    refusal(
        lambda: packet.outer_stream_correspondence(
            {"files": [outer["stdout"]]}, outer, inner
        )
    )
    path = Path("/fixture/retention/plan.json")
    metadata: dict[str, Any] = {
        "resources": deepcopy(contracts.RESOURCES),
        "stages": [],
    }
    for name, action in [
        ("retained-animal-current-export-assembly", "assemble"),
        ("independent-animal-current-export-capture-observer", "observer"),
    ]:
        metadata["stages"].append(
            {
                "id": name,
                "action": action,
                "timeout_seconds": 180,
                "argv": [
                    str(contracts.PYTHON),
                    "-I",
                    "-B",
                    str(contracts.SOURCE / "entry.py"),
                    action,
                    "--plan",
                    str(path),
                ],
            }
        )
    run.validate_stages(metadata, path)
    COUNT += 1
    for key, value in [
        ("timeout_seconds", True),
        ("timeout_seconds", 181),
        ("id", "foreign"),
    ]:
        changed = deepcopy(metadata)
        changed["stages"][0][key] = value
        refusal(lambda changed=changed: run.validate_stages(changed, path))
    assert launch.remaining_seconds(10.0, 11.0, 480) == 479.0
    COUNT += 1
    refusal(lambda: launch.remaining_seconds(10.0, 491.0, 480))
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "artificial_controls": COUNT,
                "actual_API_data_body_or_retainer": False,
            }
        )
    )


