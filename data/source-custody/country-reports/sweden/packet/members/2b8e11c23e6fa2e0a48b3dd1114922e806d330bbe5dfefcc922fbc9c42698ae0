"""Seal named public source correspondence and the prospective country protocol."""
import ast
import hashlib
import json
from pathlib import Path

SOURCE = Path(__file__).absolute().parents[2]
ROOT = SOURCE.parents[2]

def row(path):
    assert path.is_file() and not any(p.is_symlink() for p in (path, *path.parents))
    raw = path.read_bytes()
    return {'path':str(path), 'sha256':hashlib.sha256(raw).hexdigest(), 'bytes':len(raw)}

def write(name, value):
    (SOURCE/name).write_text(json.dumps(value, indent=2, allow_nan=False)+'\n')

declaration=json.loads((SOURCE/'declared-inputs.json').read_bytes())
prefix=list(declaration['maintained_source_contracts'][:40])
declaration['maintained_source_contracts']=list(prefix)
extra_names=[
    'adna/domain/locality.py',
    'adna/domain/models/localities.py',
    'adna/domain/models/occurrence_support.py',
    'adna/domain/models/chronology.py',
    'adna/domain/models/samples.py',
    'core/repository.py',
    'core/geospatial/distance.py',
    'core/temporal_semantics.py',
    'reporting/rendering/__init__.py',
    'reporting/rendering/artifacts.py',
    'reporting/rendering/record_exports.py',
    'reporting/adna/country_outputs/models.py',
    'adna/governance/atlas_candidates/sample_support.py',
    'analysis/fieldwork/land_use/models.py',
]
existing={item['path'] for item in prefix}
added=[]
for name in extra_names:
    relative='packages/bijux-pollenomics/src/bijux_pollenomics/'+name
    if relative in existing:
        continue
    item=row(ROOT/relative)
    item['path']=relative
    declaration['maintained_source_contracts'].append(item)
    added.append(item)
write('declared-inputs.json',declaration)

local=[]
for path in sorted(SOURCE.glob('*.py')):
    tree=ast.parse(path.read_bytes())
    for node in ast.walk(tree):
        if isinstance(node,ast.BinOp) and isinstance(node.op,ast.Div) and isinstance(node.left,ast.Name) and node.left.id=='SOURCE' and isinstance(node.right,ast.Constant) and isinstance(node.right.value,str):
            name=node.right.value
            # Plan and approval are created by sealing and independent review.
            generated=name in {'prepared-source-manifest.json','independent-source-review.json'}
            output_role=name.startswith('preflight/')
            assert generated or output_role or (SOURCE/name).is_file(), (path,name)
            local.append({'source':path.name,'member':name,'generated_admission_control':generated,'synthetic_output_role':output_role})

helpers=json.loads((SOURCE/'inherited-source-correspondence.json').read_bytes())
for item in helpers['byte_exact_helpers']:
    actual=row(SOURCE/item['name']); original=row(Path(item['source']))
    assert actual['sha256']==original['sha256']==item['sha256'] and actual['bytes']==item['bytes']
human=row(SOURCE/'human_source.py')
human_original=row(Path(helpers['human_independent_source']))
assert human['sha256']==human_original['sha256'] and human['bytes']==human_original['bytes']
