"""Configured source-only formatting and checks for authored controller code."""
from pathlib import Path
import subprocess

source=Path(__file__).absolute().parent.parent
root=source.parents[2]
ruff='/Users/bijan/.cache/uv/archive-v0/2XF0xMG3jR4vPhZZ/ruff-0.15.8.data/scripts/ruff'
inherited={'source_runtime.py','runtime_contracts.py','source_inputs.py','source_projection.py','source_admission.py','human_source.py'}
authored=sorted(str(path) for path in source.glob('*.py') if path.name not in inherited)
all_files=sorted(str(path) for path in source.glob('*.py'))
cache=str(source/'preflight/ruff-cache')
config=str(root/'configs/ruff.toml')
for label,arguments in [('authored-format',['format','--config',config,'--cache-dir',cache,*authored]),('authored-imports',['check','--fix','--select','I,F401,UP035,C420,UP017','--config',config,'--cache-dir',cache,*authored]),('configured-check',['check','--config',config,'--cache-dir',cache,*all_files]),('configured-format',['format','--check','--config',config,'--cache-dir',cache,*all_files])]:
    with (source/'preflight'/f'{label}.stdout').open('w') as out,(source/'preflight'/f'{label}.stderr').open('w') as err:
        result=subprocess.run([ruff,*arguments],stdout=out,stderr=err,check=False)
    print(label,result.returncode,flush=True)
    if result.returncode:
        raise SystemExit(result.returncode)
