    changed = deepcopy(plan)
    changed["stages"].reverse()
    refuses("reordered_stage_contract", lambda: validate_stages(changed, plan_path))
    service = Path(declaration["maintained_source_contracts"][0]["path"])
    text = (SOURCE.parents[2] / service).read_bytes()
    function = next(
        node
        for node in ast.parse(text).body
        if isinstance(node, ast.FunctionDef) and node.name == "generate_country_report"
    )
    require(
        not any(arg.arg == "generated_on" for arg in function.args.args),
        "Public API has no fake clock parameter",
    )
    require(
        sum(
            isinstance(node, ast.Call)
            and isinstance(node.func, ast.Attribute)
            and isinstance(node.func.value, ast.Name)
            and node.func.value.id == "date"
            and node.func.attr == "today"
            for node in ast.walk(function)
        )
        == 1,
        "Exactly one unchanged source date.today",
    )
    checks.append("actual_public_API_has_native_date_today_without_override")
    require(
        declaration["original_owner"]
        == json.loads((SOURCE / "source-design.json").read_bytes())[
            "original_owner_row"
        ],
        "Full original criterion remains exact",
    )
    checks.append("full_original_owner_criterion_preserved")
    preparer = ast.parse((SOURCE / "prepare.py").read_bytes())
    prepare_main = next(
        node
        for node in preparer.body
        if isinstance(node, ast.FunctionDef) and node.name == "main"
    )
    projection_loop = next(
        node
        for node in prepare_main.body
        if isinstance(node, ast.For)
        and isinstance(node.iter, ast.Name)
        and node.iter.id == "PACKAGES"
    )
    require(
        not any(
            isinstance(node, ast.Name)
            and node.id == "selection"
            and isinstance(node.ctx, ast.Store)
            for node in ast.walk(projection_loop)
        ),
        "Package source projection must not overwrite native data selection",
    )
    projection_calls = []
    sentinel = {"native_data_roles": "preserved"}

    def synthetic_projection(path: Path, *args: Any) -> dict[str, Any]:
        projection_calls.append(str(path))
        return {
            "projected_namespace": {"root": str(path), "entries": {}},
            "selected_rows": [],
            "omitted_bytecode_rows": [],
            "omitted_generated_metadata_rows": [],
            "omitted_cache_directories": [],
        }

    environment: dict[str, Any] = {
        "PACKAGES": ["public", "engine", "development", "facade"],
        "ROOT": OUT,
        "Path": Path,
        "regular_tree": lambda *args, **kwargs: ({}, []),
        "project": synthetic_projection,
        "tracked_paths": set(),
        "metadata_omissions": {},
        "source_namespaces": [],
        "projected_namespaces": [],
        "original_source_rows": [],
        "source_rows": [],
        "omitted_bytecode": [],
        "omitted_metadata": [],
        "omitted_directories": [],
        "selection": sentinel,
    }
    exec(
        compile(
            ast.fix_missing_locations(
                ast.Module(body=[projection_loop], type_ignores=[])
            ),
            str(SOURCE / "prepare.py"),
            "exec",
        ),
        environment,
    )
    require(
        len(projection_calls) == 4 and environment["selection"] is sentinel,
        "Actual four-package projection loop preserves complete original data selection",
    )
    checks.append("actual_four_package_projection_loop_preserves_data_selection")
    oversized = deepcopy(declaration)
    oversized["maximum_input_bytes"] = 0
    hash_attempts = []

    def forbidden_pin(path: Path) -> Any:
        hash_attempts.append(str(path))
        raise AssertionError("Body hash occurred before ceiling refusal")

    synthetic_freeze = FunctionType(
        freeze.__code__, {**freeze.__globals__, "pin": forbidden_pin}
    )
    refuses(
        "input_size_ceiling_before_any_body_hash",
        lambda: synthetic_freeze(fixture, oversized),
    )
    require(hash_attempts == [], "No body hash before input-size ceiling")
    for bad in (
        boundary / "__pycache__/module.cpython-314.pyc",
        boundary / "module.pyc",
        boundary / "__pycache__/module.pypy-311.pyc",
    ):
        refuses(
            "noncanonical_missing_bytecode_" + bad.name,
            lambda bad=bad: guard("open", (str(bad), "r", 0)),
        )
    require(
        len(guard.absent_bytecode_attempts) == 1,
        "Only exact missing current-cache-tag read attempt recorded",
    )
    for event, arguments in (
        ("os.mkdir", (str(boundary / "foreign-dir"), 511, -1)),
        ("os.rename", (str(output / "producer/a"), str(source), -1, -1)),
        ("os.rename", (str(source), str(output / "producer/b"), -1, -1)),
        ("os.remove", (str(source), -1)),
        ("os.rmdir", (str(boundary), -1)),
        ("shutil.rmtree", (str(boundary), None)),
        ("os.utime", (str(source), None, None, -1)),
        ("os.symlink", ("x", "y", -1)),
    ):
        count = len(guard.denials)
        refuses(
            "mutation_" + event,
            lambda event=event, arguments=arguments: guard(event, arguments),
        )
        require(
            len(guard.denials) == count + 1,
            "Every attempted mutation denial is recorded",
        )
    guard("os.mkdir", (str(output / "producer/fresh"), 511, -1))
    guard(
        "os.rename",
        (str(output / "producer/fresh"), str(output / "producer/candidate"), -1, -1),
    )
    checks.append("fresh_country_directory_and_both_rename_endpoints_positive")
    descriptor_root = output / "producer"
    descriptor_root.mkdir()
    descriptor = os.open(descriptor_root, os.O_RDONLY)
    try:
        guard("os.mkdir", ("artificial-child", 511, descriptor))
        require(
            guard.descriptor_path(descriptor) == descriptor_root,
            "Actual owned artificial directory descriptor has exact physical identity",
        )
    finally:
        os.close(descriptor)
    checks.append("actual_owned_artificial_directory_F_GETPATH1024_fstat_positive")
    outside_descriptor = os.open(boundary, os.O_RDONLY)
    try:
        refuses(
            "descriptor_outside_owned_mutation_roots",
            lambda: guard("os.mkdir", ("foreign-child", 511, outside_descriptor)),
        )
    finally:
        os.close(outside_descriptor)
    refuses("closed_descriptor", lambda: guard.descriptor_path(descriptor))
    alias_path = boundary / "alias.py"
    alias_path.symlink_to(source)
    previous_denials = len(guard.denials)
    refuses(
        "raw_input_alias_attempt_recorded",
        lambda: guard("open", (str(alias_path), "r", 0)),
    )
    require(
        len(guard.denials) == previous_denials + 1,
        "Alias denial retained even if caller catches it",
    )

    class CountryReport:
        country = "Sweden"
        version = "v66"
        generated_on = "synthetic-day"
        total_unique_samples = 0
        total_unique_localities = 0
        dataset_row_counts: dict[str, int] = {}
        output_dir = OUT / "synthetic-country"
        samples: tuple[Any, ...] = ()
        localities: tuple[Any, ...] = ()

    def synthetic_country(
        version_dir: Path,
        country: str,
        output_dir: Path,
        map_reference: Any = None,
        published_output_dir: Any = None,
        context_root: Any = None,
    ) -> CountryReport:
        return CountryReport()

    def synthetic_replay(repository: Path, output: Path) -> dict[str, Any]:
        synthetic_country(
            repository / "data/aadr/v66",
            "Sweden",
            output / "candidate",
            context_root=repository / "data",
        )
        return {"synthetic_receipt": True}

    telemetry = FunctionType(
        observe_replay.__code__, {**observe_replay.__globals__, "observe_clock": clock}
    )
    telemetry_output = OUT / "synthetic-return"
    telemetry_output.mkdir()
    telemetry_io = CountryIO({"input_pins": [], "output": str(telemetry_output)})
    native_result = telemetry(
        synthetic_replay,
        synthetic_country,
        OUT,
        telemetry_output,
        telemetry_io,
        CountryReport,
    )
    require(
        native_result[2][0]["generated_on"] == "synthetic-day"
        and telemetry_io.enabled is False,
        "Actual telemetry function captures exact artificial return without replacing it",
    )
    checks.append("actual_telemetry_function_exact_artificial_return_positive")
    failure = RuntimeError("original synthetic country failure")

    def failed_country(
        version_dir: Path,
        country: str,
        output_dir: Path,
        map_reference: Any = None,
        published_output_dir: Any = None,
        context_root: Any = None,
