        overlaps(0, 1, 1, 2)
        and not overlaps(0, 1, 2, 3)
        and not overlaps(-1, 1, 0, 1)
        and not overlaps(False, 1, 0, 1)
        and not overlaps(2, 1, 0, 3),
        "Closed interval/nonboolean/direction contract",
    )
    checks.append("closed_individual_intervals_without_hull_or_negative_coercion")
    supports = {
        "sample_ids": ["a", "b"],
        "sample_count": 2,
        "chronology": {"time_start_bp": 0, "time_end_bp": 20},
        "sample_chronologies": [
            {
                "sample_id": "a",
                "chronology": {
                    "time_start_bp": 0,
                    "time_end_bp": 2,
                    "precision_posture": "sample_precise_interval",
