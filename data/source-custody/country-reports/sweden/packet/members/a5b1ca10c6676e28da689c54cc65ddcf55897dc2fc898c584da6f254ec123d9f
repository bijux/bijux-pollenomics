SOURCE = Path(__file__).absolute().parent

OUT = SOURCE / "preflight/controlled-country-fixtures" / str(time.monotonic_ns())
OUT.mkdir(parents=True, exist_ok=True)
checks: list[str] = []


def require(value: object, reason: str) -> None:
    if not value:
        raise AssertionError(reason)


def refuses(name: str, call: Any) -> None:
    try:
        call()
    except (ValueError, TypeError, KeyError, OSError):
        checks.append(name)
        return
    raise AssertionError("Unexpected artificial acceptance: " + name)


def clock(day: str = "2026-10-15") -> dict[str, Any]:
    return {
        "TZ": "UTC0",
        "utc": day + "T12:00:00+00:00",
        "local_date_today": day,
        "time_ns": 1000000000000,
        "monotonic_ns": 1000000000000,
        "tzname": ["UTC", "UTC"],
        "timezone": 0,
        "daylight": 0,
    }


def product(fields: dict[str, Any]) -> dict[str, Any]:
    top: dict[str, Any] = {key: "" for values in fields.values() for key in values}
    for key in (
        "target_count",
        "time_row_count",
        "landclim_covered_target_count",
        "landclim_uncovered_target_count",
    ):
        top[key] = 0
    top.update(rows=[], target_decisions=[])
    return top


def main() -> None:
    sys.path.insert(0, str(SOURCE))
    from clock_contract import certify
    from contracts import PYTHON, RESOURCES, registered_plan
    from contracts import SOURCE as ACTUAL_SOURCE
    from data_roles import discover, freeze, verify_selection
    from execute import observe_replay
    from execution_guard import CountryIO
    from independent import (
        overlaps,
        semantic_changes,
        source_supports,
        synthesis_source_joins,
        within,
    )
    from run import validate_stages
    from semantic_contract import DECISION_FIELDS, ROW_FIELDS, TOP_FIELDS

    before = clock()
    after = deepcopy(before)
    after["time_ns"] += 1000000000
    after["monotonic_ns"] += 1000000000
    require(
        certify(before, after, "2026-10-15")["native_UTC_day"] == "2026-10-15",
        "Native same-day clock positive",
    )
    checks.append("native_same_UTC_day_positive")
    for key, value in (
        ("TZ", "Europe/Stockholm"),
        ("TZ", None),
        ("timezone", 3600),
        ("timezone", False),
        ("daylight", 1),
        ("daylight", False),
        ("tzname", None),
        ("tzname", [False, "UTC"]),
        ("tzname", ["UTC"]),
        ("utc", None),
        ("time_ns", True),
        ("monotonic_ns", 1.0),
        ("local_date_today", "2026-10-16"),
        ("utc", "2026-10-15T12:00:00+02:00"),
    ):
        changed = deepcopy(after)
        changed[key] = value
        refuses(
            "native_clock_" + key,
            lambda changed=changed: certify(before, changed, "2026-10-15"),
        )
    refuses(
        "cross_midnight", lambda: certify(before, clock("2026-10-16"), "2026-10-15")
    )
    refuses(
        "historical_or_fabricated_return_day",
        lambda: certify(before, after, "2026-09-21"),
    )
    changed = deepcopy(after)
    changed["monotonic_ns"] = before["monotonic_ns"] + 601 * 10**9
    refuses(
        "clock_whole_producer_bound", lambda: certify(before, changed, "2026-10-15")
    )
    a = product(TOP_FIELDS)
    b = deepcopy(a)
    require(
        not any(semantic_changes(a, b, True).values()),
        "Complete equal source schema positive",
    )
    checks.append("complete_semantic_equal_positive")
    for category, names in TOP_FIELDS.items():
        if not names:
            continue
        key = sorted(names)[0]
        changed = deepcopy(b)
        changed[key] = 1 if type(changed[key]) is int else "changed"
        if key in {"target_count", "time_row_count"}:
            continue
        result = semantic_changes(a, changed, True)
        require(
            len(result[category]) == 1 and sum(map(len, result.values())) == 1,
            "Exact source category differs: " + category,
        )
        checks.append("semantic_category_" + category)
    changed = deepcopy(a)
    changed["unknown_science"] = 0
    refuses("unclassified_semantic_field", lambda: semantic_changes(a, changed, True))
    for kind, keys, groups in (
        ("rows", {"target_name", "landclim_record_id"}, ROW_FIELDS),
        ("target_decisions", {"requested_name"}, DECISION_FIELDS),
    ):
        row: dict[str, Any] = {key: "" for group in groups.values() for key in group}
        row.update(dict.fromkeys(keys, "ID"), latitude=55.0, longitude=13.0)
        for key in row:
            if key.endswith(("_count", "_count_20km")):
                row[key] = 0
        changed = deepcopy(a)
        changed[kind] = [row, row]
        changed["time_row_count" if kind == "rows" else "target_count"] = 2
        refuses(
            "duplicate_" + kind,
            lambda changed=changed: semantic_changes(changed, changed, True),
        )
