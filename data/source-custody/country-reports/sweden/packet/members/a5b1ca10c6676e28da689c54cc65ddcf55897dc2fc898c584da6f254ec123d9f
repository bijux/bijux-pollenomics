    failed_output.mkdir()
    failed_io = CountryIO({"input_pins": [], "output": str(failed_output)})
    try:
        telemetry(
            failed_replay, failed_country, OUT, failed_output, failed_io, CountryReport
        )
    except RuntimeError as error:
        require(error is failure, "Original country failure object must remain exact")
    else:
        raise AssertionError("Original synthetic failure disappeared")
    raw_failure = json.loads(
        (failed_output / "country-clock-observation.json").read_bytes()
    )
    require(
        raw_failure["maintained_exception"]
        == {"type": "RuntimeError", "message": "original synthetic country failure"}
        and raw_failure["actual_return_events"]
        == [{"object_present": False, "object_type": "NoneType"}]
        and raw_failure["before"]
        and raw_failure["after"]
