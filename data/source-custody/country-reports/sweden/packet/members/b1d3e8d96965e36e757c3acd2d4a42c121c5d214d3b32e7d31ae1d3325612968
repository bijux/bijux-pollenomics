"""Seal the exact callable diagnostic writer correction and its public proof."""
import ast
import copy
import difflib
import hashlib
import json
from pathlib import Path

SOURCE = Path(__file__).absolute().parent.parent
OLD = SOURCE.parent / 'sweden-country-callable-custody'

def pin(path):
    raw=path.read_bytes()
    return {'path':str(path),'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)}

def write(name,value):
    (SOURCE/name).write_text(json.dumps(value,indent=2)+'\n')

old_manifest=pin(OLD/'prepared-source-manifest.json')
assert old_manifest['sha256']=='935ee0e123e1b4dd7b941b9cd3f0fc1525b6ac35ef314bb190b8781519cba476'
old_q=pin(OLD/'source-qualification.json')
assert old_q['sha256']=='b816725dbb9c36474c2d2fa8fbfde1408c6b2ad2bc8c65bec271c84a1fa3612e'
old_files=sorted(OLD.glob('*.py'))
unchanged=[]
for path in old_files:
    if path.name!='execution_guard.py':
        assert path.read_bytes()==(SOURCE/path.name).read_bytes(),path.name
        unchanged.append({'original':pin(path),'current':pin(SOURCE/path.name)})
assert len(unchanged)==21
old=ast.parse((OLD/'execution_guard.py').read_bytes())
new=ast.parse((SOURCE/'execution_guard.py').read_bytes())
restored=copy.deepcopy(new)
klass=next(n for n in restored.body if isinstance(n,ast.ClassDef) and n.name=='CountryIO')
init=next(n for n in klass.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')
removed=[n for n in init.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Attribute) and t.attr=='callable_metadata_path' for t in n.targets)]
assert len(removed)==1
init.body=[n for n in init.body if n not in removed]
call=next(n for n in klass.body if isinstance(n,ast.FunctionDef) and n.name=='__call__')
writing=next(n for n in call.body if isinstance(n,ast.If) and isinstance(n.test,ast.Name) and n.test.id=='writing')
assert isinstance(writing.body[0],ast.If) and isinstance(writing.body[0].test,ast.Compare)
assert ast.unparse(writing.body[0].test)=='path == self.callable_metadata_path'
writing.body.pop(0)
assert ast.dump(old,include_attributes=False)==ast.dump(restored,include_attributes=False)
for path in SOURCE.glob('*.py'):
    ast.parse(path.read_bytes())
assert len(list(SOURCE.glob('*.py')))==23
(SOURCE/'preflight/finite-source-delta.diff').write_text(''.join(difflib.unified_diff((OLD/'execution_guard.py').read_text().splitlines(True),(SOURCE/'execution_guard.py').read_text().splitlines(True),fromfile='reviewed/execution_guard.py',tofile='diagnostic/execution_guard.py')))
correspondence={'schema_version':'sweden-callable-diagnostic-correspondence.v1','source_only':True,'original_manifest':old_manifest,'original_qualification':old_q,'byteexact_old_python':unchanged,'only_production_change':'CountryIO stores one exact wrapper diagnostic path and permits only fresh O_CREAT|O_EXCL open at that path. Existing input reads, all other writes and all mutation handlers remain exact.','CountryIO_full_module_AST_restored_by_removing_only_two_named_additions':True,'unchanged_source_groups_reused':113,'reused_groups_scope':'Exact codegraph, retained-input custody, scientific, UTC-clock and other IO predicates; new diagnostic IO branch separately exercised through real audit hook.','new_synthetic_groups':10,'parsed_root_Python_files':23,'retained_source_data_not_copied_or_executed':True}
write('source-correspondence.json',correspondence)
protocol=json.loads((OLD/'protocol.json').read_bytes())
protocol['schema_version']='sweden-country-callable-diagnostic-protocol.v1'
