q={'schema_version':'sweden-country-callable-diagnostic-source-qualification.v1','source_only':True,'actual_whole_SOURCE_profile_exit':0,'source_profile_sha256':'3331ec5104b2d083c886dcb10ad62551c2f69ff7d00d604aba60b10023e9e08b','new_actual_audit_hook_synthetic_groups':10,'reused_source_groups':113,'strict_changed_or_new_files':2,'configured_Ruff_changed_or_new_files':2,'configured_format_changed_or_new_files':2,'unchanged_old_Python':21,'parsed_AST_files':23,'original_qualification':old_q,'source_correspondence':pin(SOURCE/'source-correspondence.json'),'logs':[pin(p) for p in logs],'actual_country_API_data_runtime_preparer_native_Git_or_STATE_by_author':False}
write('source-qualification.json',q)
