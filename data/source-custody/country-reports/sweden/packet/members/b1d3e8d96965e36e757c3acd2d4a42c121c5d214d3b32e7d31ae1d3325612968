protocol['source_qualification_delta']='113 original source groups retained by exact21-file and restored full CountryIO AST correspondence; 10 new actual-writer/actual-audit-hook artificial controls. No country, API or data-body consumer by author.'
write('protocol.json',protocol)
recipe=json.loads((OLD/'recipe.json').read_bytes())
recipe['schema_version']='sweden-country-callable-diagnostic-recipe.v1'
