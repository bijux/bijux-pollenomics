"""Exercise both actual final member admission gates on complete controlled copies."""
import ast
from collections.abc import Iterable
import hashlib
import json
import os
from pathlib import Path
import shutil
import time
from typing import Any

SOURCE=Path(__file__).absolute().parent.parent
OUT=SOURCE/'preflight/held-entry-fixtures'/str(time.monotonic_ns())
OUT.mkdir(parents=True)
manifest_raw=(SOURCE/'prepared-source-manifest.json').read_bytes()
manifest=json.loads(manifest_raw)
ns={'Path':Path,'hashlib':hashlib,'json':json,'Any':Any,'Iterable':Iterable}
def extract(name,names):
    tree=ast.parse((SOURCE/name).read_bytes())
    nodes=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names]
    assert len(nodes)==len(names)
    module=ast.Module(body=[ast.ImportFrom(module='__future__',names=[ast.alias(name='annotations')],level=0),*nodes],type_ignores=[])
    exec(compile(ast.fix_missing_locations(module),str(SOURCE/name),'exec'),ns)
extract('entry.py',{'entry_root','verify'})
extract('source_inputs.py',{'pin','normalize_row','incoming_rows','exact_union','verify_rows'})
extract('source_admission.py',{'reviewed_controls'})
ns['verify_namespace']=ns['verify']
cases=[]
def fixture(label,mutation=None):
    root=OUT/label
    root.mkdir()
    rows=[]
    for row in manifest['files']:
        original=Path(row['path']);relative=original.relative_to(SOURCE);target=root/relative
        target.parent.mkdir(parents=True,exist_ok=True)
        shutil.copyfile(original,target)
        rows.append({'path':str(target),'sha256':row['sha256'],'bytes':row['bytes']})
    value={**manifest,'files':sorted(rows,key=lambda r:r['path'])}
    if mutation:
        mutation(root,value)
    raw=(json.dumps(value,indent=2)+'\n').encode()
    (root/'prepared-source-manifest.json').write_bytes(raw)
    (root/'independent-source-review.json').write_text(json.dumps({'approved':True,'source_manifest_sha256':hashlib.sha256(raw).hexdigest()}))
    return root
def run(label,mutation=None,positive=False):
    for gate in ['verify','reviewed_controls']:
        root=fixture(label+'-'+gate,mutation)
        try:
            ns[gate](root)
        except ValueError:
            assert not positive,(label,gate)
        else:
            assert positive,(label,gate)
        cases.append(label+'/'+gate)
run('complete_final_members',positive=True)
run('relative_member',lambda root,value:value['files'][0].update(path='entry.py'))
run('duplicate_member',lambda root,value:value['files'].append(dict(value['files'][0])))
run('helper_changed',lambda root,value:(root/'contracts.py').write_text('changed'))
run('unknown_native',lambda root,value:(root/'contracts.so').write_bytes(b'foreign'))
run('unknown_group',lambda root,value:(root/'unreviewed').mkdir())
run('FIFO',lambda root,value:os.mkfifo(root/'extra-fifo'))
run('helper_alias',lambda root,value:((root/'contracts.py').unlink(),(root/'contracts.py').symlink_to(SOURCE/'contracts.py')))
run('metadata_changed',lambda root,value:(root/'declared-inputs.json').write_text('{}'))
run('required_module_omitted',lambda root,value:value.update(files=[row for row in value['files'] if not row['path'].endswith('/execute.py')]))
for row in manifest['files']:
    path=Path(row['path'])
    assert ns['pin'](path)==row
assert (SOURCE/'prepared-source-manifest.json').read_bytes()==manifest_raw
receipt={'schema_version':'sweden-country-held-admission-proof.v1','source_only':True,'actual_whole_SOURCE_profile_exit':0,'manifest_sha256':hashlib.sha256(manifest_raw).hexdigest(),'complete_members':len(manifest['files']),'actual_gate_functions':['entry.verify','source_admission.reviewed_controls'],'synthetic_cases':cases,'held_bytes_unchanged':True,'actual_country_API_data_runtime_preparer_or_native':False}
(SOURCE/'preflight/held-entry-proof.json').write_text(json.dumps(receipt,indent=2)+'\n')
print(json.dumps(receipt))
