"""Protect the complete collected country return and failed-controller history unchanged."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

from contracts import ROOT, SOURCE, registered_plan, require
from runtime_contracts import namespace_snapshot, verify_base_namespaces
from saved_authority import ORIGINAL_PLAN_SHA, qualify_original
from source_inputs import exact_union, pin, verify_rows

ORIGINAL = ROOT / "artifacts/science/current-sweden-callable-evidence-replay"
AUTHORITY_SHA = "b2d202e0cb62088cc9e754effcb8a10db9f2436aae8b1e25ad4429ff7fe8f1c5"


def closed_namespace(rows: list[dict[str, Any]]) -> dict[str, Any]:
    entries: dict[str, dict[str, str]] = {}
    for row in rows:
        path = Path(row["path"])
        require(path.is_relative_to(ORIGINAL), "Original output escaped")
        relative = path.relative_to(ORIGINAL)
        require(bool(relative.parts), "Output identity names root")
        require(
            entries.get(relative.as_posix(), {"kind": "file"}) == {"kind": "file"},
            "Output type conflict",
        )
        entries[relative.as_posix()] = {"kind": "file"}
        for parent in relative.parents:
            if parent != Path("."):
                require(
                    entries.get(parent.as_posix(), {"kind": "directory"})
                    == {"kind": "directory"},
                    "Output ancestor type conflict",
                )
                entries[parent.as_posix()] = {"kind": "directory"}
    for name in ("cache", "cache/matplotlib", "scratch"):
        require(
            entries.get(name, {"kind": "directory"}) == {"kind": "directory"},
            "Original startup directory changed",
        )
        entries[name] = {"kind": "directory"}
    return {
        "root": str(ORIGINAL),
        "excluded": [],
        "entries": dict(sorted(entries.items())),
    }


def original_authority() -> tuple[dict[str, Any], list[dict[str, Any]], dict[str, Any]]:
    authority = registered_plan(SOURCE / "retained-authority.json", AUTHORITY_SHA)
    require(
        authority["original_controller_actual_exit"] == 1
        and authority["original_whole_actual_exit"] == 1,
        "Root authority cannot relabel original failure",
    )
    references = authority["references"]
    docs: dict[str, Any] = {}
    streams = set()
    for name, expected in references.items():
        path = Path(expected["path"])
        require(
            path == ORIGINAL / name
            and path.is_file()
            and path.stat().st_nlink == 1
            and not any(node.is_symlink() for node in (path, *path.parents))
            and type(expected["bytes"]) is int
            and 0 <= expected["bytes"] <= 128 * 1024**2
            and path.stat().st_size == expected["bytes"],
            "Original named metadata type/size/ancestry differs",
        )
        actual = pin(path)
        require(actual == expected, "Original collected reference changed")
        if name.endswith((".stdout", ".stderr")):
            streams.add(name)
        elif name != "producer/receipt.json":
            raw = path.read_bytes()
            require(
                hashlib.sha256(raw).hexdigest() == expected["sha256"],
                "Original metadata buffer changed",
            )
            if name == "stage-progress.json":
                value = json.loads(raw)
                require(type(value) is list, "Original progress must be a list")
                docs[name] = value
            else:
                docs[name] = registered_plan(path, expected["sha256"])
    require(
        len(references) == 12
        and streams
        == {
            "launch.stdout",
            "launch.stderr",
            "maintained-full-Sweden-country-consumer.stdout",
            "maintained-full-Sweden-country-consumer.stderr",
        },
        "Complete root reference roles differ",
    )
    plan = docs["plan.json"]
    require(
        references["plan.json"]["sha256"] == ORIGINAL_PLAN_SHA,
        "Original source plan changed",
    )
    runtime_ref = plan["qualified_source_runtime"]["plan"]
    require(
        runtime_ref["sha256"]
        == "5a34e885c17738c90e7fb65ac8d3780f3f57ebc39a8f5a0842bb811d409a16c4"
        and runtime_ref in plan["input_pins"],
        "Original qualified runtime role differs",
    )
    runtime_plan = registered_plan(Path(runtime_ref["path"]), runtime_ref["sha256"])
    qualified = qualify_original(
        plan,
        docs["sweden-country-semantic-terminal.json"],
        docs["sweden-country-semantic-launch-terminal.json"],
        docs["country-clock-observation.json"],
        docs["country-callable-identity.json"],
        docs["stage-progress.json"],
        references,
        runtime_plan,
    )
    require(
        not (ORIGINAL / "maintained-country-execution.json").exists()
        and not (ORIGINAL / "maintained-country-execution.json").is_symlink()
        and not (ORIGINAL / "independent-country-review.json").exists()
        and not (ORIGINAL / "independent-country-review.json").is_symlink(),
        "Missing original telemetry or unrun observer was fabricated",
    )
    outputs = exact_union(
        docs["output-products.json"]["files"], list(references.values())
    )
    require(
        all(references[name] in outputs for name in references),
        "Original full reference union differs",
    )
    snapshot = closed_namespace(outputs)
    require(
        namespace_snapshot(ORIGINAL, []) == snapshot,
        "Complete collected output membership changed",
    )
    verify_rows(outputs)
    verify_rows(plan["input_pins"])
    verify_base_namespaces(plan["owned_namespace_snapshots"])
    return (
        plan,
        exact_union(plan["input_pins"], outputs),
        {
            "original_plan_sha256": ORIGINAL_PLAN_SHA,
            "original_candidate": plan["candidate"],
            "original_owned_source_candidate": plan["original_owned_source_candidate"],
            "original_whole_actual_exit": 1,
            "original_controller_stage_actual_exits": [1],
            "country_call_returned_normally": True,
            "actual_country_call_return_events": 1,
            "original_outputs": outputs,
            "original_complete_namespace": snapshot,
            "retained_logical_output_bytes": sum(row["bytes"] for row in outputs)
            + plan["retained_logical_output_bytes"],
            "collected_current_output_logical_bytes": sum(
                row["bytes"] for row in outputs
            ),
            "separate_original_owned_tree_logical_bytes": plan[
                "retained_logical_output_bytes"
            ],
            "original_owned_source_data_reused_without_recopy": True,
            "qualified_saved_call_metadata": qualified,
            "original_full_return_read_or_origin_telemetry_recovered": False,
        },
    )
