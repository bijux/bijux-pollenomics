"""Create finite source-only qualification and a sorted absolute member manifest."""
import ast
import hashlib
import json
from pathlib import Path

SOURCE=Path(__file__).absolute().parent.parent

def pin(path):
    assert path.is_file() and not path.is_symlink()
    raw=path.read_bytes()
    return {'path':str(path),'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)}

def write(path,value):
    path.write_text(json.dumps(value,indent=2,allow_nan=False)+'\n')

preflight=SOURCE/'preflight'
assert (preflight/'qualified-strict.stderr').read_text()==''
assert 'Success: no issues found in 19 source files' in (preflight/'qualified-strict.stdout').read_text()
assert (preflight/'qualified-style.stderr').read_text()==''
assert (preflight/'qualified-style.stdout').read_text()=='authored-format 0\nauthored-imports 0\nconfigured-check 0\nconfigured-format 0\n'
assert (preflight/'qualified-controls.stderr').read_text()==''
controls=json.loads((preflight/'qualified-controls.stdout').read_bytes())
assert controls['actual_exit']==0 and controls['artificial_groups']==86
for path in SOURCE.glob('*.py'):
    ast.parse(path.read_bytes())
correspondence=json.loads((SOURCE/'source-correspondence.json').read_bytes())
declaration=json.loads((SOURCE/'declared-inputs.json').read_bytes())
for item in declaration['maintained_source_contracts']:
    actual=pin(SOURCE.parents[2]/item['path'])
    assert actual['sha256']==item['sha256'] and actual['bytes']==item['bytes']
for item in correspondence['source_relative_literal_metadata_and_entry_roles']:
    if not item['generated_admission_control'] and not item['synthetic_output_role']:
        assert (SOURCE/item['member']).is_file()

logs=[
 'qualified-strict.stdout','qualified-strict.stderr',
 'qualified-style.stdout','qualified-style.stderr',
 'configured-check.stdout','configured-check.stderr',
 'configured-format.stdout','configured-format.stderr',
 'qualified-controls.stdout','qualified-controls.stderr','source-controls-result.json',
 'qualified-metadata.stdout','qualified-metadata.stderr',
 'initial-strict.stdout','initial-strict.stderr',
 'final-strict.stdout','final-strict.stderr',
 'final-style.stdout','final-style.stderr',
 'field-style-refusal.stdout','metadata-authoring.stdout','metadata-authoring.stderr',
]
logs += ['initial-configured-style/'+name for name in ['configured-check.stdout','style-wrapper.stdout','style-wrapper.stderr']]
for name in logs:
    assert (preflight/name).is_file(),name
commands={
 'controls':['SOURCE3331','--mode','python','--',str(SOURCE/'check_controls.py')],
 'strict':['SOURCE3331','--mode','mypy','--','--config-file',str(SOURCE.parents[2]/'configs/mypy.ini'),'--strict','--follow-imports=silent','--cache-dir',str(preflight/'mypy-cache'),*[str(path) for path in sorted(SOURCE.glob('*.py'))]],
 'configured_style':['SOURCE3331','--mode','python','--',str(preflight/'qualify_style.py')],
}
q={
 'schema_version':'sweden-country-controller-source-qualification.v1',
 'source_only':True,'actual_whole_SOURCE_profile_exit':0,
 'source_profile_sha256':'3331ec5104b2d083c886dcb10ad62551c2f69ff7d00d604aba60b10023e9e08b',
 'artificial_groups':86,'strict_files':19,'configured_Ruff_files':19,'configured_format_files':19,'parsed_AST_files':19,
 'commands':commands,'logs':[pin(preflight/name) for name in logs],
 'all_source_modules':[pin(path) for path in sorted(SOURCE.glob('*.py'))],
 'source_correspondence':pin(SOURCE/'source-correspondence.json'),
 'source_relative_metadata_roles_closed':True,
 'original_authoring_refusals':'Initial style/fixture annotations and one static metadata-audit fixture output-role assertion are preserved. These were source-authoring checks; no preparer, country API, private input hash/decode, runtime census or native job was run.',
 'actual_country_or_data_consumer_executed':False,
 'actual_native_outcome_claimed':False,
}
write(SOURCE/'source-qualification.json',q)
members=list(SOURCE.glob('*.py'))+list(SOURCE.glob('*.json'))
members=[path for path in members if path.name not in {'prepared-source-manifest.json','independent-source-review.json'}]
members.extend(preflight/name for name in logs)
members.extend([preflight/'qualify_style.py',preflight/'seal_source.py',preflight/'check_held_admission.py',preflight/'source-authoring/finalize_metadata.py'])
names=sorted(set(str(path) for path in members))
manifest={'schema_version':'sweden-country-reviewed-source-manifest.v1','source_only':True,'scope':'A genuine current maintained full Sweden country consumer and independent source/typed/semantic/native-clock observer; source-only qualification, future root registration and execution.','files':[pin(Path(name)) for name in names]}
write(SOURCE/'prepared-source-manifest.json',manifest)
print(json.dumps({'manifest':pin(SOURCE/'prepared-source-manifest.json'),'qualification':pin(SOURCE/'source-qualification.json'),'protocol':pin(SOURCE/'protocol.json'),'recipe':pin(SOURCE/'recipe.json'),'members':len(names)}))
