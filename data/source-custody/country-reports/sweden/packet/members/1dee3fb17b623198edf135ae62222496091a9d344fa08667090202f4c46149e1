"""Independently read country products, source identities and declared semantic changes."""

from __future__ import annotations

from collections import defaultdict
import csv
import hashlib
import json
import math
from pathlib import Path
from typing import Any

from human_source import reconstruct, same, typed_record
from semantic_contract import (
    CATEGORIES,
    DECISION_FIELDS,
    OUTPUT_FILES,
    ROW_FIELDS,
    SOURCE_FILES,
    TOP_FIELDS,
    UPSTREAM_FILES,
)


def require(value: object, reason: str) -> None:
    if not value:
        raise ValueError(reason)


def document(path: Path) -> dict[str, Any]:
    require(
        path.is_file() and path.stat().st_size <= 256 * 1024**2,
        "Bounded country JSON file required",
    )

    def pairs(items: list[tuple[str, Any]]) -> dict[str, Any]:
        require(
            len(items) == len({key for key, _ in items}), "Duplicate country JSON key"
        )
        return dict(items)

    def nonfinite(value: str) -> None:
        raise ValueError("Nonfinite country JSON: " + value)

    value = json.loads(
        path.read_bytes(), object_pairs_hook=pairs, parse_constant=nonfinite
    )
    require(type(value) is dict, "Country JSON object required")
    assert isinstance(value, dict)
    return value


def digest(path: Path) -> str:
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def equivalent(left: Any, right: Any) -> bool:
    return json.dumps(
        left, sort_keys=True, separators=(",", ":"), allow_nan=False
    ) == json.dumps(right, sort_keys=True, separators=(",", ":"), allow_nan=False)


def scientific_schema(product: dict[str, Any]) -> None:
    require(
        set(product)
        == {"rows", "target_decisions"} | set().union(*TOP_FIELDS.values()),
        "Unknown top-level synthesis schema",
    )
    for kind, keys, groups in (
        ("rows", {"target_name", "landclim_record_id"}, ROW_FIELDS),
        ("target_decisions", {"requested_name"}, DECISION_FIELDS),
    ):
        require(type(product[kind]) is list, "Ordered science rows required")
        seen = set()
        for row in product[kind]:
            require(
                type(row) is dict and set(row) == keys | set().union(*groups.values()),
                "Unknown synthesis row schema",
            )
            token = tuple(row[key] for key in sorted(keys))
            require(token not in seen, "Duplicate science row identity")
            seen.add(token)
            for key in ("latitude", "longitude"):
                require(
                    type(row[key]) in {int, float} and math.isfinite(row[key]),
                    "Finite nonboolean source coordinate required",
                )
            for key, value in row.items():
                if key.endswith(("_count", "_count_20km")):
                    require(
                        type(value) is int and value >= 0,
                        "Typed nonnegative context count required",
                    )
    require(
        type(product["target_count"]) is int
        and product["target_count"] == len(product["target_decisions"]),
        "Target accounting differs",
    )
    require(
        type(product["time_row_count"]) is int
        and product["time_row_count"] == len(product["rows"]),
        "Time-row accounting differs",
    )


def semantic_changes(
    before: dict[str, Any], after: dict[str, Any], renderings_equal: bool
) -> dict[str, list[dict[str, Any]]]:
    """Classify every admitted schema field; source ordering is checked separately."""
    scientific_schema(before)
    scientific_schema(after)
    result: dict[str, list[dict[str, Any]]] = {name: [] for name in CATEGORIES}

    def fields(
        a: dict[str, Any], b: dict[str, Any], prefix: str, groups: dict[str, Any]
    ) -> None:
        for category, names in groups.items():
            for name in sorted(names):
                if a[name] != b[name]:
                    result[category].append(
                        {
                            "path": prefix + "." + name,
                            "before": a[name],
                            "after": b[name],
                        }
                    )

    fields(before, after, "product", TOP_FIELDS)
    for kind, keys, groups in (
        ("target_decisions", ("requested_name",), DECISION_FIELDS),
        ("rows", ("target_name", "landclim_record_id"), ROW_FIELDS),
    ):
        a = {"|".join(str(row[k]) for k in keys): row for row in before[kind]}
        b = {"|".join(str(row[k]) for k in keys): row for row in after[kind]}
        for token in sorted(set(a) ^ set(b)):
            result["source_membership"].append(
                {
                    "path": kind + "[" + token + "]",
                    "before": token in a,
                    "after": token in b,
                }
            )
        for token in sorted(set(a) & set(b)):
            fields(a[token], b[token], kind + "[" + token + "]", groups)
    if not renderings_equal and not any(
        result[key] for key in CATEGORIES if key != "presentation"
    ):
        result["presentation"].append(
            {
                "path": "serialized_json_csv_or_markdown",
                "before": "published",
                "after": "replay",
            }
        )
    return result


def typed_changes(before: Any, after: Any, path: str = "$") -> list[dict[str, Any]]:
    """Keep exact historical JSON type/order differences beside native semantic categories."""
    if type(before) is not type(after):
        return [
            {"path": path, "before": before, "after": after, "kind": "type_or_value"}
        ]
    if isinstance(before, dict):
        differences = []
        for key in sorted(set(before) | set(after)):
            if key not in before or key not in after:
                differences.append(
                    {
                        "path": path + "." + key,
                        "before_present": key in before,
                        "after_present": key in after,
                        "kind": "membership",
                    }
                )
            else:
                differences.extend(
                    typed_changes(before[key], after[key], path + "." + key)
                )
        return differences
    if isinstance(before, list):
        differences = []
        for index in range(max(len(before), len(after))):
            if index >= len(before) or index >= len(after):
                differences.append(
                    {
                        "path": path + "[" + str(index) + "]",
                        "before_present": index < len(before),
                        "after_present": index < len(after),
                        "kind": "ordered_membership",
                    }
                )
            else:
                differences.extend(
                    typed_changes(
                        before[index], after[index], path + "[" + str(index) + "]"
                    )
                )
        return differences
    return (
        []
        if equivalent(before, after)
        else [{"path": path, "before": before, "after": after, "kind": "value"}]
    )


def audit_receipt(
    owned: Path, candidate: Path, actual: dict[str, Any]
) -> dict[str, Any]:
    published = owned / "docs/report/countries/sweden"
    require(
        set(actual)
        == {
            "schema_version",
            "product",
            "source_files",
            "policy_files",
            "upstream_products",
            "outputs",
            "semantic_changes",
            "change_counts",
            "status",
        },
        "Unknown maintained replay receipt field",
    )
    require(
        actual["schema_version"] == "sweden-land-use-semantic-replay.v1"
        and actual["product"] == "docs/report/countries/sweden",
        "Replay receipt role differs",
    )
    same(
        actual["source_files"],
        [{"path": str(name), "sha256": digest(owned / name)} for name in SOURCE_FILES],
    )
    science = [
        {
            "path": "docs/report/countries/sweden/" + name,
            "published_sha256": digest(published / name),
            "replay_sha256": digest(candidate / name),
        }
        for name in OUTPUT_FILES
    ]
    upstream = [
        {
            "path": "docs/report/countries/sweden/" + name,
            "published_sha256": digest(published / name),
            "replay_sha256": digest(candidate / name),
        }
        for name in UPSTREAM_FILES
    ]
    same(actual["outputs"], science)
    same(actual["upstream_products"], upstream)
    changes = semantic_changes(
        document(published / OUTPUT_FILES[0]),
        document(candidate / OUTPUT_FILES[0]),
        all(row["published_sha256"] == row["replay_sha256"] for row in science),
    )
    if any(row["published_sha256"] != row["replay_sha256"] for row in upstream):
        changes["normalized_identity_or_value"].append(
            {
                "path": "upstream_country_inputs",
                "before": "published",
                "after": "replay",
            }
        )
    same(actual["semantic_changes"], changes)
    same(actual["change_counts"], {key: len(value) for key, value in changes.items()})
    status = (
        "identical"
        if not any(changes.values())
        and all(row["published_sha256"] == row["replay_sha256"] for row in science)
        else "changed"
    )
    require(actual["status"] == status, "Actual replay status differs")
    return {
        "independently_reconstructed_changes": changes,
        "tracked_byte_checker_actual_exit": 0
        if all(
            row["published_sha256"] == row["replay_sha256"]
            for row in [*science, *upstream]
        )
        else 2,
        "tracked_byte_comparisons": [*upstream, *science],
        "complete_ordered_typed_synthesis_differences": typed_changes(
            document(published / OUTPUT_FILES[0]), document(candidate / OUTPUT_FILES[0])
        ),
        "native_semantic_equality_uses_unchanged_maintained_scalar_rules": True,
        "old_receipt_construction_or_prior_native_outcome_recovered": False,
    }


def audit_human(owned: Path, report: dict[str, Any], candidate: Path) -> dict[str, Any]:
    paths = sorted((owned / "data/aadr/v66").glob("*/*.anno"))
    samples, counts, raw_counts, duplicates = reconstruct(paths, ["Sweden"])
    expected = [typed_record(row) for row in samples["Sweden"]]
    same(report["samples"], expected)
    same(report["dataset_row_counts"], counts["Sweden"])
    require(
        type(report["total_unique_samples"]) is int
        and report["total_unique_samples"] == len(expected),
        "Full human native sample denominator differs",
    )
    grouped: dict[tuple[Any, ...], list[dict[str, Any]]] = defaultdict(list)
    for sample in samples["Sweden"]:
        grouped[
            (sample["locality"], sample["latitude_text"], sample["longitude_text"])
        ].append(sample)
    actual_groups = {
        (
            row["locality"],
            row["coordinates"]["latitude_text"],
            row["coordinates"]["longitude_text"],
        ): row
        for row in report["localities"]
    }
    require(
        len(actual_groups) == len(report["localities"]) == len(grouped),
        "Human locality population/duplicate differs",
    )
    for token, rows in grouped.items():
        locality = actual_groups[token]
        require(
            locality["chronology_role"] == "locality_sample_coverage_hull",
            "Display hull role changed",
        )
        same(locality["identity"], rows[0]["locality_identity"])
        same(
            locality["sample_ids"],
            sorted(row["identity"]["stable_token"] for row in rows),
        )
        require(
            type(locality["sample_count"]) is int
            and locality["sample_count"] == len(rows),
            "Locality count differs",
        )
        supports = locality["sample_chronologies"]
        require(len(supports) == len(rows), "Sample-owned support denominator differs")
        native = {row["identity"]["stable_token"]: row for row in rows}
        require(
            [support["sample_id"] for support in supports] == sorted(native),
            "Sample-owned support order/identity differs",
        )
        for support in supports:
            source = native[support["sample_id"]]
            same(support["chronology"], source["chronology"])
            require(
                support["schema_version"] == "adna-sample-chronology-support.v1"
                and support["source_release"] == source["source_release"],
                "Source support schema/release differs",
            )
            for destination, origin in (
                ("provenance_path", "chronology_provenance_path"),
                ("provenance_locator", "chronology_provenance_locator"),
                ("provenance_excerpt", "chronology_provenance_text"),
                ("provenance_kind", "chronology_provenance_kind"),
                ("chronology_strength", "chronology_strength"),
                ("normalization_status", "chronology_normalization_status"),
                ("conflict_note", "chronology_conflict_note"),
            ):
                same(support[destination], source[origin])
    require(
        type(report["total_unique_localities"]) is int
        and report["total_unique_localities"] == len(grouped),
        "Returned locality denominator differs",
    )
    geo = document(candidate / "sweden_aadr_v66_samples.geojson")
    from human_source import geojson

    same(geo, geojson(samples["Sweden"]))
    # Default CSV is reconstructed independently from the raw native rows too.
    from human_source import csv_record

    with (candidate / "sweden_aadr_v66_samples.csv").open(
        encoding="utf8", newline=""
    ) as stream:
        csv_rows = list(csv.DictReader(stream))
    same(csv_rows, [csv_record(row) for row in samples["Sweden"]])
    return {
        "raw_annotation_rows_by_dataset": raw_counts,
        "current_typed_human_population": len(expected),
        "current_localities": len(grouped),
        "duplicate_support_audit": duplicates["Sweden"],
        "individual_source_chronologies_preserved": True,
        "coverage_hull_used_as_sample_admission": False,
    }


def audit_animal(
    owned: Path, animal: dict[str, Any], declared: dict[str, Any]
) -> dict[str, Any]:
    """Join every transported sample to the source-selected atlas native context."""
    require(
        animal["schema_version"] == "country-animal-adna-summary.v1"
        and animal["country"] == "Sweden",
        "Animal country output role differs",
    )
    lookup: dict[str, Any] = {}
    origins = {}
    order = []
    for path in (owned / "data/adna/species").glob("*/normalized/sample_records.json"):
        order.append(path.relative_to(owned).as_posix())
        for row in document(path).get("samples", []):
            if not isinstance(row, dict):
                continue
            identity = row.get("identity", {})
            token = (
                str(identity.get("stable_token", "")).strip()
                if isinstance(identity, dict)
                else ""
            )
            if token:
                if token in lookup:
                    require(
                        equivalent(lookup[token], row),
                        "Conflicting global sample identity depends on filesystem order",
                    )
                lookup[token] = row
                origins[token] = path.relative_to(owned).as_posix()
    localities = animal["localities"]
    samples = animal["sample_rows"]
    require(
        animal["total_localities"] == len(localities)
        and animal["total_sample_rows"] == len(samples),
        "Animal output population differs",
    )
    admitted = {"site_curated", "nordic_lead_site_curated", "comparator_site_curated"}
    evidence = {row["evidence_row_id"]: row for row in localities}
    require(len(evidence) == len(localities), "Duplicate animal evidence identity")
    expected = []
    for locality in localities:
        identifiers = locality["sample_record_ids"]
        require(
            type(identifiers) is list
            and identifiers == sorted(set(identifiers))
            and type(locality["sample_count"]) is int
            and locality["sample_count"] == len(identifiers),
            "Animal locality sample membership/count differs",
        )
        for token in identifiers:
            require(token in lookup, "Animal locality lacks native sample source")
            native = lookup[token]
            require(
                native.get("inclusion_status") in admitted,
                "Unadmitted animal source status crossed atlas point publication",
            )
            require(
                native["project_accession"] in locality["project_accessions"],
                "Animal project lineage crossed",
            )
            require(
                native["locality_identity"]["stable_token"]
                == locality["site_record_id"],
                "Animal native locality identity crossed",
            )
            expected.append((locality["evidence_row_id"], token))
    require(
        [(row["evidence_row_id"], row["sample_record_id"]) for row in samples]
        == sorted(
            expected,
            key=lambda pair: (
                str(evidence[pair[0]]["species_latin_name"]),
                str(evidence[pair[0]]["project_accession"]),
                pair[1],
            ),
        ),
        "Animal sample membership/order differs",
    )
    for row in samples:
        native = lookup[row["sample_record_id"]]
        locality = evidence[row["evidence_row_id"]]
        for key in (
            "source_native_tax_id",
            "source_native_scientific_name",
            "taxon_alignment_status",
            "sample_evidence_status",
            "sample_lineage_path",
            "sample_lineage_locator",
            "sample_lineage_excerpt",
            "chronology_normalization_status",
            "chronology_provenance_path",
            "chronology_provenance_kind",
            "chronology_provenance_locator",
            "chronology_provenance_text",
            "inclusion_status",
            "inclusion_note",
            "sample_basis",
            "supplementary_source",
        ):
            require(
                row[key] == str(native.get(key, "")),
                "Animal transported native flag/provenance differs: " + key,
            )
        require(
            row["sample_namespace"] == str(native["identity"].get("namespace", "")),
            "Animal sample namespace crossed",
        )
        require(
            row["site_record_id"] == locality["site_record_id"],
            "Animal native site relation differs",
        )
    return {
        "global_source_lookup_membership_in_native_order": order,
        "global_native_identity_population": len(lookup),
        "source_selected_country_sample_rows": len(samples),
        "source_selected_country_localities": len(localities),
        "all_transported_native_sample_status_and_provenance_joined": True,
        "animal_atlas_selection_or_ranking_independently_reproduced": False,
        "fresh_animal_API_population_claimed": False,
        "taxonomy_or_chronology_admission_from_count_only": False,
    }


def within(lat: float, lon: float, y: float, x: float) -> bool:
    a = math.sin(math.radians(y - lat) / 2.0)
    b = math.sin(math.radians(x - lon) / 2.0)
    arc = a * a + math.cos(math.radians(lat)) * math.cos(math.radians(y)) * b * b
    return 2.0 * 6371.0088 * math.asin(math.sqrt(arc)) <= 20


def overlaps(a: Any, b: Any, c: Any, d: Any) -> bool:
    try:
        valid = all(
            type(value) in {int, float}
            and math.isfinite(float(value))
            and value >= 0
            and (type(value) is not int or float(value) == value)
            for value in (a, b, c, d)
        )
    except OverflowError:
        return False
    return valid and a <= b and c <= d and max(a, c) <= min(b, d)


def source_supports(
    locality: dict[str, Any], human: bool
) -> list[tuple[str, Any, Any]]:
    identifiers = locality.get("sample_ids", locality.get("sample_record_ids", []))
    supports = locality.get("sample_chronologies", [])
    if (
        type(identifiers) is not list
        or any(type(value) is not str or not value.strip() for value in identifiers)
        or len(identifiers) != len(set(identifiers))
        or type(supports) is not list
    ):
        return []
    if (
        not supports
        and human
        and locality.get("sample_count") == 1
        and len(identifiers) == 1
    ):
        supports = [{"sample_id": identifiers[0], "chronology": locality["chronology"]}]
    seen = set()
    result = []
    for support in supports:
        if type(support) is not dict or type(support.get("chronology")) is not dict:
            return []
        token = support.get("sample_id")
        if type(token) is not str or token not in identifiers or token in seen:
            return []
        seen.add(token)
        chronology = support["chronology"]
        if not human:
            if support.get("schema_version") != "adna-sample-chronology-support.v1":
                return []
            for key in ("time_start_bp", "time_end_bp", "time_mean_bp"):
                if chronology.get(key) is not None and type(chronology[key]) is not int:
                    return []
            if any(
                type(value) is not str
                for key, value in chronology.items()
                if key not in {"time_start_bp", "time_end_bp", "time_mean_bp"}
            ):
                return []
            for key in (
                "source_release",
                "provenance_path",
                "provenance_locator",
                "provenance_excerpt",
                "provenance_kind",
                "chronology_strength",
                "normalization_status",
                "conflict_note",
                "reference_epoch",
                "age_type",
                "calibration_status",
                "model",
            ):
                if key in support and type(support[key]) is not str:
                    return []
            if (
                not chronology.get("refusal_reason_code")
                and not (
                    chronology.get("time_start_bp") is None
                    and chronology.get("time_end_bp") is None
                )
                and not overlaps(
                    chronology.get("time_start_bp"),
                    chronology.get("time_end_bp"),
                    chronology.get("time_start_bp"),
                    chronology.get("time_end_bp"),
                )
            ):
                return []
        if chronology.get("refusal_reason_code"):
            continue
        a, b = chronology.get("time_start_bp"), chronology.get("time_end_bp")
        if (
            type(a) is int
            and type(b) is int
            and overlaps(a, b, a, b)
            and chronology.get("precision_posture")
            in {
                "sample_precise_point",
                "sample_precise_interval",
                "sample_approximate_or_modeled",
                "contextual_interval",
            }
        ):
            result.append((token, a, b))
    return result


def synthesis_source_joins(
    owned: Path,
    product: dict[str, Any],
    human: list[dict[str, Any]],
    animal: list[dict[str, Any]],
) -> dict[str, Any]:
    land = document(
        owned / "data/landclim/normalized/nordic_reveals_temporal_grid_cells.geojson"
    )["features"]
    sead = document(owned / "data/sead/normalized/nordic_temporal_evidence.geojson")[
        "features"
    ]
    by_id = {feature["properties"]["record_id"]: feature for feature in land}
    require(len(by_id) == len(land), "Duplicate LandClim source record ID")
    scientific_schema(product)
    require(
        product["rows"]
        == sorted(
            product["rows"],
            key=lambda row: (
                row["target_name"],
                -int(row["time_end_bp"]),
                -int(row["time_start_bp"]),
            ),
        ),
        "Current synthesis row ordering differs",
    )
    targets = {row["requested_name"]: row for row in product["target_decisions"]}
    require(
        product["landclim_covered_target_count"]
        == sum(
            row["landclim_coverage_posture"] == "covered_by_governed_grid"
            for row in targets.values()
        ),
        "Covered target accounting differs",
    )
    require(
        product["landclim_uncovered_target_count"]
        == sum(
            row["landclim_coverage_posture"] == "outside_governed_grid"
            for row in targets.values()
        ),
        "Uncovered target accounting differs",
    )
    expected_pairs: list[tuple[str, str]] = []
    for name, target in targets.items():
        selected = []
        for feature in land:
            props, geometry = feature["properties"], feature.get("geometry", {})
            if (
                props.get("dataset_id") != "937075"
                or geometry.get("type") != "Polygon"
                or not geometry.get("coordinates")
            ):
                continue
            ring = geometry["coordinates"][0]
            if min(float(point[0]) for point in ring) <= target["longitude"] <= max(
                float(point[0]) for point in ring
            ) and min(float(point[1]) for point in ring) <= target["latitude"] <= max(
                float(point[1]) for point in ring
            ):
                selected.append(props["record_id"])
        expected_pairs.extend((name, token) for token in selected)
        require(
            target["landclim_window_count"] == len(selected),
            "Target source-window count differs",
        )
        require(
            target["landclim_coverage_posture"]
            == ("covered_by_governed_grid" if selected else "outside_governed_grid"),
            "Target source-grid coverage differs",
        )
    require(
        set(expected_pairs)
        == {(row["target_name"], row["landclim_record_id"]) for row in product["rows"]},
        "Synthesis native target/window population differs",
    )
    metrics = {
        "evergreen_tree_cover": "ET",
        "summergreen_tree_cover": "ST",
        "open_land_cover": "OL",
        "agricultural_land_cover": "AL",
        "grassland_cover": "GL",
        "cereal_type_pollen_cover": "Cerealia.t",
        "rye_pollen_cover": "Secale",
    }
    for row in product["rows"]:
        target = targets[row["target_name"]]
        source = by_id[row["landclim_record_id"]]["properties"]
        for key in ("latitude", "longitude", "target_class", "lake_decision"):
            same(row[key], target[key])
        for key in (
            "time_start_bp",
            "time_end_bp",
            "time_mean_bp",
            "time_label",
            "quality_class",
        ):
            same(row[key], source.get(key))
        same(row["landclim_grid_record_id"], source.get("parent_grid_record_id", ""))
        quality = source["quality_class"]
        require(
            quality in {"high", "low", "no_pollen_data"},
            "Unknown native source quality",
        )
        values: dict[str, float | None] = {}
        for field, key in metrics.items():
            value = (
                None
                if quality == "no_pollen_data"
                else source["reconstruction_values"].get(key)
            )
            if quality == "no_pollen_data":
                require(value is None, "Unavailable modeled source must remain null")
                values[field] = None
            else:
                require(
                    type(value) in {int, float},
                    "Finite nonboolean modeled value required",
                )
                assert isinstance(value, (int, float))
                require(math.isfinite(value), "Finite modeled source required")
                values[field] = round(float(value), 6)
            same(row[field], values[field])
        forest: float | None = None
        if quality != "no_pollen_data":
            evergreen, summergreen = (
                values["evergreen_tree_cover"],
                values["summergreen_tree_cover"],
            )
            assert evergreen is not None and summergreen is not None
            forest = round(evergreen + summergreen, 6)
        same(row["forest_cover"], forest)
        selected = []
        for feature in sead:
            geometry, props = feature.get("geometry", {}), feature.get("properties", {})
            xy = geometry.get("coordinates", [])
            if (
                geometry.get("type") == "Point"
                and len(xy) >= 2
                and within(
                    row["latitude"], row["longitude"], float(xy[1]), float(xy[0])
                )
                and overlaps(
                    row["time_start_bp"],
                    row["time_end_bp"],
                    props.get("time_start_bp"),
                    props.get("time_end_bp"),
                )
            ):
                selected.append(feature)
        require(
            row["sead_temporal_record_count_20km"] == len(selected)
            and row["sead_site_count_20km"]
            == len(
                {
                    str(feature["properties"].get("source_url", ""))
                    for feature in selected
                }
            ),
            "SEAD exact spatial/interval/source joins differ",
        )
        for family, localities in (("human", human), ("animal", animal)):
            locality_count = sample_count = 0
            for locality in localities:
                coordinate = locality["coordinates"] if family == "human" else locality
                if not within(
                    row["latitude"],
                    row["longitude"],
                    float(coordinate["latitude"]),
                    float(coordinate["longitude"]),
                ):
                    continue
                tokens = {
                    token
                    for token, a, b in source_supports(locality, family == "human")
                    if overlaps(row["time_start_bp"], row["time_end_bp"], a, b)
                }
                if tokens:
                    locality_count += 1
                    sample_count += len(tokens)
            require(
                row[family + "_adna_locality_count_20km"] == locality_count
                and row[family + "_adna_sample_count_20km"] == sample_count,
                "Source-owned individual temporal supports differ; hull cannot substitute",
            )
        s, h, a = (
            row["sead_temporal_record_count_20km"],
            row["human_adna_locality_count_20km"],
            row["animal_adna_locality_count_20km"],
        )
        if quality == "no_pollen_data":
            contexts = [
                label
                for label, count in (("archaeology", s), ("human", h), ("animal", a))
                if count
            ]
            posture = (
                "_".join(contexts) + "_context"
                if contexts
                else "no_cross_proxy_context"
            )
            cereal = "The source quality class reports no pollen data for this cell and window; modeled pollen-cover values are unavailable."
        else:
            posture = (
                "pollen_archaeology_human_animal_context"
                if s and h and a
                else "pollen_archaeology_human_context"
                if s and h
                else "pollen_archaeology_animal_context"
                if s and a
                else "pollen_archaeology_context"
                if s
                else "pollen_adna_context"
                if h or a
                else "pollen_model_only"
            )
            cereal = "Cerealia.t and Secale are modeled pollen-cover estimates; they are not observed crop acreage or proof of cultivation at the target"
        require(
            row["cross_proxy_posture"] == posture
            and row["cereal_interpretation_posture"] == cereal,
            "Native descriptive posture/no-pollen limit differs",
        )
    return {
        "actual_source_windows": len(product["rows"]),
        "actual_source_targets": len(targets),
        "all_native_values_null_zero_quality_and_individual_support_joins_checked": True,
        "ranking_independently_recomputed_or_validated_as_ecology": False,
    }
