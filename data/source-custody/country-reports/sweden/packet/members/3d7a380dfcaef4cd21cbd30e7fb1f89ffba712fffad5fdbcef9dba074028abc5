"""Execute the maintained full country replay once with its native clock unchanged."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path
import sys
from types import FrameType
from typing import Any

from clock_contract import certify, observe_clock
from contracts import bootstrap, checkpoint, execution_scope, require, stage_plan, write
from execution_guard import CountryIO
from source_inputs import pin


def origins(plan: dict[str, Any]) -> list[dict[str, Any]]:
    owned = Path(plan["owned_repository"])
    protected = {row["path"]: row for row in plan["input_pins"]}
    rows = []
    for name, module in sorted(sys.modules.items()):
        if name.split(".")[0] not in {
            "bijux_pollenomics",
            "bijux_pollenomics_dev",
            "bijux_pollenomics_lra",
            "pollenomics",
        }:
            continue
        filename = getattr(module, "__file__", None)
        require(isinstance(filename, str), "First-party origin missing")
        assert isinstance(filename, str)
        path = Path(filename)
        row = pin(path)
        require(
            path.is_relative_to(owned) and protected.get(str(path)) == row,
            "First-party import left complete owned source",
        )
        if hasattr(module, "__path__"):
            require(
                list(module.__path__) == [str(path.parent)],
                "Mixed first-party namespace refused",
            )
        rows.append({"module": name, **row})
    return rows


def observe_replay(
    replay: Any,
    country_callable: Any,
    owned: Path,
    output: Path,
    io: CountryIO,
    country_type: type[Any],
) -> tuple[
    dict[str, Any],
    list[dict[str, Any]],
    list[dict[str, Any]],
    dict[str, Any],
    dict[str, Any],
]:
    """Capture exact native return events while retaining original failure and clocks."""
    observed: list[dict[str, Any]] = []
    calls: list[dict[str, Any]] = []
    returns: list[dict[str, Any]] = []
    telemetry_errors: list[str] = []

    def watch(frame: FrameType, event: str, arg: Any) -> None:
        if frame.f_code is not country_callable.__code__:
            return
        try:
            if event == "call":
                calls.append(
                    {
                        "country": frame.f_locals["country"],
                        "version_dir": str(frame.f_locals["version_dir"]),
                        "output_dir": str(frame.f_locals["output_dir"]),
                        "context_root": str(frame.f_locals["context_root"]),
                        "map_reference": frame.f_locals["map_reference"],
                        "published_output_dir": frame.f_locals["published_output_dir"],
                    }
                )
            elif event == "return":
                returns.append(
                    {
                        "object_present": arg is not None,
                        "object_type": type(arg).__name__,
                    }
                )
                if arg is None:
                    return
                if type(arg) is not country_type:
                    telemetry_errors.append("Actual country return type differs")
                    return
                observed.append(
                    {
                        "country": arg.country,
                        "version": arg.version,
                        "generated_on": arg.generated_on,
                        "total_unique_samples": arg.total_unique_samples,
                        "total_unique_localities": arg.total_unique_localities,
                        "dataset_row_counts": arg.dataset_row_counts,
                        "output_dir": str(arg.output_dir),
                        "samples": [sample.as_dict() for sample in arg.samples],
                        "localities": [
                            locality.as_dict() for locality in arg.localities
                        ],
                    }
                )
        except Exception as error:
            telemetry_errors.append(type(error).__name__ + ": " + str(error))

    before = observe_clock()
    after: dict[str, Any] = {}
    clock_error = None
    failure: BaseException | None = None
    receipt = None
    sys.setprofile(watch)
    try:
        receipt = replay(repository=owned, output=output / "producer")
    except BaseException as error:
        failure = error
    finally:
        sys.setprofile(None)
        try:
            after = observe_clock()
        except Exception as error:
            clock_error = type(error).__name__ + ": " + str(error)
        finally:
            io.enabled = False
    raw = {
        "schema_version": "sweden-native-country-clock-observation.v1",
        "before": before,
        "after": after,
        "source_returned_generated_on": observed[0]["generated_on"]
        if len(observed) == 1
        else None,
        "actual_country_calls": calls,
        "actual_return_events": returns,
        "telemetry_errors": telemetry_errors,
        "clock_observation_error": clock_error,
        "maintained_exception": {
            "type": type(failure).__name__,
            "message": str(failure),
        }
        if failure
        else None,
        "IO_denials": list(io.denials),
        "clock_qualification_not_yet_applied": True,
    }
    try:
        write(output / "country-clock-observation.json", raw)
    except Exception as evidence_error:
        if failure is not None:
            failure.add_note("Raw clock receipt write failed: " + repr(evidence_error))
        else:
            raise
    if failure is not None:
        raise failure.with_traceback(failure.__traceback__)
    require(
        clock_error is None and not telemetry_errors,
        "Native clock/return observation did not qualify",
    )
    require(
        len(calls) == len(observed) == 1
        and len(returns) == 1
        and returns[0]["object_present"] is True,
        "Exactly one genuine full country call and returned object required",
    )
    require(isinstance(receipt, dict), "Maintained replay receipt absent")
    assert isinstance(receipt, dict)
    return receipt, calls, observed, before, after


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = stage_plan(args.plan)
    authority, scope = execution_scope(plan)
    roots = bootstrap(plan)
    owned = Path(plan["owned_repository"])
    io = CountryIO(plan)
    sys.addaudithook(io)
    from bijux_pollenomics.reporting.models import CountryReport
    from bijux_pollenomics.reporting.service import generate_country_report
    from bijux_pollenomics_dev.source_completion.sweden_land_use_replay import replay

    source = (
        owned / "packages/bijux-pollenomics/src/bijux_pollenomics/reporting/service.py"
    )
    require(
        Path(generate_country_report.__code__.co_filename) == source,
        "Country callable origin differs",
    )
    # Compare actual code with compilation of the pinned source, without executing that module.
    compiled = compile(source.read_bytes(), str(source), "exec")
    expected = next(
        code
        for code in compiled.co_consts
        if hasattr(code, "co_name") and code.co_name == "generate_country_report"
    )
    import marshal

    require(
        marshal.dumps(expected) == marshal.dumps(generate_country_report.__code__),
        "Country callable code differs from exact pinned source",
    )
    receipt, calls, observed, before, after = observe_replay(
        replay, generate_country_report, owned, Path(plan["output"]), io, CountryReport
    )
    require(
        calls
        == [
            {
                "country": "Sweden",
                "version_dir": str(owned / "data/aadr/v66"),
                "output_dir": str(Path(plan["output"]) / "producer/candidate"),
                "context_root": str(owned / "data"),
                "map_reference": None,
                "published_output_dir": None,
            }
        ],
        "Maintained country invocation differs",
    )
    clock = certify(before, after, observed[0]["generated_on"])
    require(not io.denials, "Undeclared data/tool/network read attempted")
    actual_origins = origins(plan)
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    write(
        Path(plan["output"]) / "maintained-country-execution.json",
        {
            "schema_version": "sweden-country-maintained-execution.v1",
            "actual_exit": 0,
            "candidate": plan["candidate"],
            "actual_argv": sys.orig_argv,
            "actual_executable": sys.executable,
            "owned_package_search_roots": roots,
            "maintained_call": "sweden_land_use_replay.replay(repository,output)",
            "actual_country_calls": calls,
            "actual_returned_country_report": observed[0],
            "clock": clock,
            "first_party_origins": actual_origins,
            "actual_read_paths": sorted(io.reads),
            "absent_exact_source_bytecode_attempts": sorted(
                io.absent_bytecode_attempts
            ),
            "IO_denials": io.denials,
            "maintained_replay_receipt": receipt,
            "country_source_code_sha256": hashlib.sha256(
                marshal.dumps(expected)
            ).hexdigest(),
            "wrapper_created_report_or_clock_override": False,
            "ecology_rights_history_human_or_LRA_admitted": False,
        },
    )


if __name__ == "__main__":
    main()
