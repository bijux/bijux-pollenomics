"""Independently qualify saved country products while preserving the original wrapper failure."""

from __future__ import annotations

import argparse
from pathlib import Path
from types import CodeType
from typing import Any

from callable_identity import code_graph, graph_sha256
from contracts import (
    checkpoint,
    execution_scope,
    registered_plan,
    require,
    stage_plan,
    strict_equal,
    write,
)
from data_roles import verify_selection
from independent import (
    audit_animal,
    audit_human,
    audit_receipt,
    digest,
    document,
    synthesis_source_joins,
)
from localities import independent_human_report
from retained import ORIGINAL, original_authority
from source_inputs import pin


def product_members(root: Path) -> list[dict[str, Any]]:
    require(
        root.is_dir() and not any(node.is_symlink() for node in (root, *root.parents)),
        "Actual country product root absent or linked",
    )
    rows = []
    for path in sorted(root.rglob("*")):
        require(
            not path.is_symlink() and (path.is_file() or path.is_dir()),
            "Country product alias/special refused",
        )
        if path.is_file():
            rows.append(pin(path))
    return rows


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = stage_plan(args.plan)
    authority, scope = execution_scope(plan)
    original, original_rows, observed = original_authority()
    frozen = {row["path"]: row for row in plan["input_pins"]}
    require(
        all(frozen.get(row["path"]) == row for row in original_rows),
        "Original frozen rows absent from saved observer plan",
    )
    history_pin = plan["retained_failed_controller_history"]
    require(
        strict_equal(
            observed, registered_plan(Path(history_pin["path"]), history_pin["sha256"])
        ),
        "Prepared original call authority differs",
    )
    require(
        plan["original_saved_country_output"] == str(ORIGINAL),
        "Original output role rebound",
    )
    output = Path(plan["output"])
    owned = Path(plan["owned_repository"])
    candidate = ORIGINAL / "producer/candidate"
    declaration = plan["source_declaration"]
    verify_selection(owned, declaration, plan["source_input_selection"])
    raw_clock = document(ORIGINAL / "country-clock-observation.json")
    callable_proof = document(ORIGINAL / "country-callable-identity.json")
    source = (
        owned / "packages/bijux-pollenomics/src/bijux_pollenomics/reporting/service.py"
    )
    require(
        __import__("sys").flags.optimize == 0,
        "Exact native code compiler optimization required",
    )
    code = compile(
        source.read_bytes(), str(source), "exec", dont_inherit=True, optimize=0
    )
    selected = [
        value
        for value in code.co_consts
        if type(value) is CodeType and value.co_name == "generate_country_report"
    ]
    require(
        len(selected) == 1
        and graph_sha256(code_graph(selected[0]))
        == callable_proof["expected_code_graph_sha256"],
        "Saved callable proof does not bind unchanged exact owned source",
    )
    clock = observed["qualified_saved_call_metadata"]["native_UTC_clock"]
    require(
        raw_clock["source_returned_generated_on"] == clock["native_UTC_day"],
        "Saved source-owned day differs",
    )
    returned = independent_human_report(owned, candidate, clock["native_UTC_day"])
    presence = plan["source_input_selection"]["named_file_presence"]
    raa = [
        name for name in declaration["optional_data"] if name.startswith("data/raa/")
    ]
    unavailable = {
        "full_SVAR_registry_absent": presence[
            "data/svar/normalized/sweden_lake_registry.geojson"
        ]
        == "absent",
        "RAA_required_authority_incomplete": any(
            presence[name] == "absent" for name in raa
        ),
        "absent_source_is_unknown_or_refused_not_measured_zero": True,
    }
    catalog = product_members(candidate)
    allowed = {row["relative_path"] for row in declaration["published_roles"]}
    actual = {Path(row["path"]).relative_to(candidate).as_posix() for row in catalog}
    require(
        allowed <= actual
        and all(name in allowed or name.startswith("_map_assets/") for name in actual),
        "Full declared country output namespace differs",
    )
    if any(name.startswith("_map_assets/") for name in actual):
        source_assets = (
            owned
            / "packages/bijux-pollenomics/src/bijux_pollenomics/reporting/assets/map"
        )
        expected_assets = {
            path.relative_to(source_assets).as_posix(): pin(path)
            for path in source_assets.rglob("*")
            if path.is_file()
        }
        actual_assets = {
            name.removeprefix("_map_assets/"): pin(candidate / name)
            for name in actual
            if name.startswith("_map_assets/")
        }
        require(
            set(actual_assets) == set(expected_assets),
            "Full copied map-resource membership differs",
        )
        require(
            all(
                all(actual_assets[name][key] == row[key] for key in ("sha256", "bytes"))
                for name, row in expected_assets.items()
            ),
            "Full copied map-resource bytes differ",
        )
    before_catalog = list(catalog)
    summary = document(candidate / "sweden_aadr_v66_summary.json")
    bundle = document(candidate / "sweden_aadr_v66_bundle.json")
    animal = document(candidate / "sweden_animal_adna_v66_summary.json")
    for row in (summary, bundle, animal):
        require(
            row["country"] == "Sweden"
            and row["version"] == "v66"
            and row["generated_on"] == returned["generated_on"],
            "Full bundle clock/country joins differ",
        )
    for row in (summary, bundle):
        for key in (
            "total_unique_samples",
            "total_unique_localities",
            "dataset_row_counts",
        ):
            require(
                strict_equal(row[key], returned[key]),
                "Country report/manifest typed denominator differs",
            )
    human = audit_human(owned, returned, candidate)
    animals = audit_animal(owned, animal, declaration)
    require(
        animals["global_source_lookup_membership_in_native_order"]
        == plan["owned_native_glob_orders"]["global_animal_sample_lookup"],
        "Independent global lookup did not consume exact owned native order",
    )
    synthesis = document(candidate / "sweden_land_use_synthesis_v66.json")
    source_joins = synthesis_source_joins(
        owned, synthesis, returned["localities"], animal["localities"]
    )
    receipt = document(ORIGINAL / "producer/receipt.json")
    semantics = audit_receipt(owned, candidate, receipt)
    for row in receipt["source_files"]:
        require(
            row["sha256"] == digest(owned / row["path"]),
            "Replay original direct input identity differs",
        )
    policy_root = (
        owned
        / "packages/bijux-pollenomics/src/bijux_pollenomics/analysis/fieldwork/land_use"
    )
    policy = [
        {"path": path.relative_to(owned).as_posix(), "sha256": digest(path)}
        for path in sorted(policy_root.glob("*.py"))
    ]
    require(
        strict_equal(receipt["policy_files"], policy),
        "Full land-use source policy footprint differs",
    )
    require(
        product_members(candidate) == before_catalog,
        "Actual country products changed during independent observation",
    )
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    write(
        output / "independent-country-review.json",
        {
            "schema_version": "sweden-saved-country-source-semantic-clock-review.v1",
            "actual_exit": 0,
            "candidate": plan["candidate"],
            "registered_plan_sha256": __import__("os").environ[
                "BIJUX_REGISTERED_PLAN_SHA256"
            ],
            "original_country_execution_candidate": original["candidate"],
            "original_owned_source_candidate": original[
                "original_owned_source_candidate"
            ],
            "original_registered_plan_sha256": observed["original_plan_sha256"],
            "original_controller_actual_exit": 1,
            "original_whole_actual_exit": 1,
            "country_call_returned_normally": True,
            "actual_country_call_return_events": 1,
            "full_captured_return_object_recovered": False,
            "original_read_or_import_origin_ledger_recovered": False,
            "independent_expected_projection_is_not_captured_return": True,
            "retained_call_authority": history_pin,
            "country_callable_identity": pin(
                ORIGINAL / "country-callable-identity.json"
            ),
            "country_clock_observation": pin(
                ORIGINAL / "country-clock-observation.json"
            ),
            "native_UTC_clock": clock,
            "exact_absent_default_import_attempt": observed[
                "qualified_saved_call_metadata"
            ]["exact_absent_default_import_attempt"],
            "human_source_joins": human,
            "animal_source_joins": animals,
            "synthesis_source_joins": source_joins,
            "source_authority_unavailability": unavailable,
            "semantic_receipt": semantics,
            "actual_products": catalog,
            "independent_country_producer_calls": 0,
            "full_source_resource_input_closure_bound": True,
            "new_current_evidence_not_historical_receipt_recovery": True,
            "original_owner_verification": declaration["original_owner"][
                "verification"
            ],
            "historical_generated_ownership_or_vegetation_rights_human_LRA_admitted": False,
        },
    )


if __name__ == "__main__":
    main()
