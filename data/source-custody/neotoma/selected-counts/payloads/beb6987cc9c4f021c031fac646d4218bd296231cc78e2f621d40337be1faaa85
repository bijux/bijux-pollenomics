"""Exercise exact final admission code on a complete controlled source copy."""

import hashlib
import json
from pathlib import Path
import shutil
import sys
import tempfile

SOURCE = Path(__file__).absolute().parent.parent


def pin(path):
    raw = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw)}


def main():
    manifest = SOURCE / "prepared-source-manifest.json"
    document = json.loads(manifest.read_bytes())
    original_rows = document["files"]
    assert all(pin(Path(row["path"])) == row for row in original_rows)
    assert [row["path"] for row in original_rows] == sorted({row["path"] for row in original_rows})
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as temporary:
        copied = Path(temporary)
        for row in original_rows:
            original = Path(row["path"])
            target = copied / original.relative_to(SOURCE)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(original, target)
            assert original.stat().st_ino != target.stat().st_ino
        rows = [pin(copied / Path(row["path"]).relative_to(SOURCE)) for row in original_rows]
        copied_manifest = copied / "prepared-source-manifest.json"

        def seal(selected):
            copied_manifest.write_text(json.dumps({"source_only": True, "files": selected}))
            (copied / "independent-source-review.json").write_text(json.dumps({
                "approved": True, "source_manifest_sha256": pin(copied_manifest)["sha256"]
            }))

        seal(rows)
        sys.path.insert(0, str(copied))
        from entry import verify
        from source_admission import reviewed_controls

        def refuses(callback):
            try:
                callback()
            except ValueError:
                return
            raise AssertionError("Exact actual admission accepted a controlled violation")

        verify(copied)
        returned_manifest, returned_review, authenticated = reviewed_controls(copied)
        assert returned_manifest == copied_manifest
        assert returned_review == copied / "independent-source-review.json"
        assert len(authenticated) == len(rows) + 2
        seal([{**row, "path": str(Path(row["path"]).relative_to(copied))} for row in rows])
        refuses(lambda: verify(copied))
        refuses(lambda: reviewed_controls(copied))
        seal(rows)
        helper = copied / "contracts.py"
        original = helper.read_bytes()
        helper.write_bytes(original + b"\n")
        refuses(lambda: verify(copied))
        refuses(lambda: reviewed_controls(copied))
        helper.write_bytes(original)
        assert all(pin(Path(row["path"])) == row for row in rows)
    receipt = {
        "source_only": True,
        "actual_exit": 0,
        "source_manifest": pin(manifest),
        "exact_final_members": len(original_rows),
        "actual_entry_and_reviewed_controls_positive": True,
        "relative_manifest_and_helper_tamper_refusals": 4,
        "controlled_fixture_copy_only": True,
        "actual_preparer_or_target_runtime_or_private_data_consumer_executed": False,
    }
    target = SOURCE / "preflight/sealed-entry-review.json"
    with target.open("x") as stream:
        stream.write(json.dumps(receipt, indent=2) + "\n")
    print(json.dumps(receipt, indent=2))


if __name__ == "__main__":
    main()
