"""Exercise only typed scientific-row semantics and exact one-call source correspondence."""
from __future__ import annotations
import ast
from copy import deepcopy
import hashlib
import json
from pathlib import Path
from typing import Any
SOURCE=Path(__file__).resolve().parent.parent
OLD=SOURCE.parent/'neotoma-count-capture-custody'


def refuse(call: Any) -> None:
    try:call()
    except ValueError:return
    raise AssertionError('Unsafe scientific row accepted')


def main() -> None:
    old_manifest=(OLD/'prepared-source-manifest.json').read_bytes();assert hashlib.sha256(old_manifest).hexdigest()=='f64fc5066966d02095af8ecf6e8a5ae9a23d411ddf1845f4bef4b7cb79996d53'
    old=json.loads(old_manifest);count=0
    for row in old['files']:
        p=Path(row['path'])
        if p.parent==OLD and p.suffix=='.py':
            b=p.read_bytes();assert hashlib.sha256(b).hexdigest()==row['sha256'] and len(b)==row['bytes']
            if p.name!='packet.py':assert b==(SOURCE/p.name).read_bytes();count+=1
    prior=ast.parse((OLD/'packet.py').read_bytes());current=ast.parse((SOURCE/'packet.py').read_bytes())
    assert sum(isinstance(n,ast.FunctionDef) and n.name=='same_count_row' for n in current.body)==1
    current.body=[n for n in current.body if not(isinstance(n,ast.FunctionDef) and n.name=='same_count_row')]
    changed=[]
    for n in ast.walk(current):
        if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='same_count_row':n.func.id='same';changed.append(n)
    assert len(changed)==1 and ast.dump(current,include_attributes=False)==ast.dump(prior,include_attributes=False);count+=1
    scope: dict[str,Any]={'__name__':'reviewed_scientific_row_source'}
    exec(compile((SOURCE/'packet.py').read_bytes(),'<authored-scientific-row-source>','exec'),scope)
    equal=scope['same_count_row']
    row={'sample_id':'artificial:sample:7','country_code':'SE','source_locator':{'surface':'samples','path':'samples.json','row_index':4,'row_canonical_sha256':'a'*64},'observations':2,'refused_count_observations':1,'source_unit_partitions':[{'source_unit':'NISP','pollen_count_observations':1,'pollen_exact_count_sum':7},{'source_unit':'number','pollen_count_observations':0,'pollen_exact_count_sum':0}],'known_compatible_pollen_denominator_status':'not_evaluated','lra_admission_status':'refused'}
    def reordered(value: Any) -> Any:
        if isinstance(value,dict):return {k:reordered(value[k]) for k in reversed(value)}
        if isinstance(value,list):return [reordered(v) for v in value]
        return value
    equal(row,row);equal(row,reordered(row));refuse(lambda:scope['same'](row,reordered(row)));count+=3
    for key,value in [('observations',True),('observations',2.0),('observations',3),('country_code','DK'),('refused_count_observations',0),('lra_admission_status','admitted'),('known_compatible_pollen_denominator_status','accepted'),('source_locator',None)]:
        altered=deepcopy(row);altered[key]=value;refuse(lambda:equal(row,altered));count+=1
    altered=deepcopy(row);altered['source_unit_partitions'].reverse();refuse(lambda:equal(row,altered));count+=1
    altered=deepcopy(row);altered['source_unit_partitions'][0]['pollen_exact_count_sum']=8;refuse(lambda:equal(row,altered));count+=1
    altered=deepcopy(row);del altered['source_locator']['row_index'];refuse(lambda:equal(row,altered));count+=1
    altered=deepcopy(row);altered['source_locator']['row_index']=False;refuse(lambda:equal(row,altered));count+=1
    altered=deepcopy(row);altered['extra']='field';refuse(lambda:equal(row,altered));count+=1
    for left,right in [(None,0),(0,False),(0.0,-0.0),(float('inf'),float('inf')),(float('nan'),float('nan')),([1],[1,1]),({1:0},{1:0})]:refuse(lambda left=left,right=right:equal(left,right));count+=1
    print(json.dumps({'actual_exit':0,'scientific_row_delta_groups':count,'other_Python_files_byte_exact':13,'global_same_unchanged':True,'only_scientific_saved_count_join_changed':True,'actual_source_or_saved_product_comparison_raw_private_hash_preparer_or_native':False}))


if __name__=='__main__':main()
