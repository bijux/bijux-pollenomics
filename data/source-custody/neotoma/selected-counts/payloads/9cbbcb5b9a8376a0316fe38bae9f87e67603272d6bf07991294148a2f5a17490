"""Read only the registered source authorities for three explicit native sample joins."""

from __future__ import annotations

from collections import Counter, defaultdict
from collections.abc import Iterator
import json
from pathlib import Path
from typing import Any

from independent import (
    COUNTRIES,
    MISSING,
    age_claim,
    canonical,
    clean,
    count_value,
    digest,
    element_status,
    locator,
    mass_row,
    native_id,
    require,
    same,
)

IDS = {
    "sites": "site_id",
    "collection_units": "collection_unit_id",
    "datasets": "dataset_id",
    "chronologies": "chronology_id",
    "chronology_controls": "chronology_control_id",
    "samples": "sample_id",
    "age_claims": "chronology_claim_id",
    "variables": "variable_id",
    "conflicts": "conflict_id",
    "orphans": "orphan_id",
}
UNIT_FAMILY = {
    "NISP": "count",
    "NISP digitized": "count",
    "number": "count",
    "NISP/tablet": "count_per_tablet",
    "grains/tablet": "count_per_tablet",
    "number/tablet": "count_per_tablet",
    "cm3": "volume",
    "cm^3": "volume",
    "ml": "volume",
    "g": "mass",
    "mg": "mass",
    "grains/cm3": "concentration_per_volume",
    "grains/ml": "concentration_per_volume",
    "grains/g": "concentration_per_mass",
    "grains/g sample": "concentration_per_mass",
    "grains/mg": "concentration_per_mass",
    "grains/cm²/yr": "influx_per_area_time",
    "particles/cm²/yr": "influx_per_area_time",
    "yr/cm": "sedimentation_time_per_depth",
}


def read(path: Path) -> Any:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        require(len(rows) == len({key for key, _ in rows}), "Duplicate source JSON key")
        return dict(rows)

    def refuse(value: str) -> None:
        raise ValueError("Nonfinite JSON literal: " + value)

    return json.loads(path.read_bytes(), object_pairs_hook=pairs, parse_constant=refuse)


def requests(rows: list[dict[str, Any]]) -> None:
    same(
        rows,
        [
            {
                "sample_id": 173174,
                "dataset_id": 19913,
                "site_id": 13338,
                "part": "part-004.json",
                "normalized_sample_row_index": 190,
