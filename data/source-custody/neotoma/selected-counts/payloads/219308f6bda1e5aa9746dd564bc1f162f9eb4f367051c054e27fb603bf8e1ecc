def require(value: object, message: str) -> None:
    if not value:
        raise ValueError(message)


def load(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_bytes())
    require(isinstance(value, dict), "JSON object required")
    assert isinstance(value, dict)
    return value


def write(path: Path, value: object) -> None:
    require(
        path.is_absolute()
        and ".." not in path.parts
        and path.is_relative_to(ROOT / "artifacts")
        and not path.exists()
        and not any(node.is_symlink() for node in (path, *path.parents)),
        "Fresh owned regular output required",
    )
    with path.open("x") as stream:
        stream.write(json.dumps(value, indent=2, allow_nan=False) + "\n")


def verify_private_ancestry(root: Path, names: list[str]) -> None:
    for name in names:
        path = root / name
        require(
            not any(node.is_symlink() for node in (path, *path.parents)),
            "Declared private source alias ancestry changed",
        )


def git_environment() -> dict[str, str]:
    require_runtime_environment(dict(os.environ))
    environment = {
        key: value for key, value in os.environ.items() if not key.startswith("GIT_")
    }
    environment.update(
        GIT_OPTIONAL_LOCKS="0", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull
    )
    return environment


def identity() -> dict[str, str]:
    require_runtime_environment(dict(os.environ))
    require(
        not any(node.is_symlink() for node in (GIT, *GIT.parents)),
        "Reviewed Git tool alias refused",
    )
    require(
        pin(GIT)
        == {
            "path": str(GIT),
            "sha256": "a73bf622a2e470d5d57a4b1d5aef1e8680e67278018d4858a2f93825b7d595c7",
            "bytes": 3837392,
        },
        "Reviewed Git tool changed before first invocation",
    )

    def git(*args: str) -> bytes:
        return subprocess.check_output(
            [str(GIT), *args],
            cwd=ROOT,
            timeout=60,
            env=git_environment(),
        )

    require(
        git("branch", "--show-current").strip() == b"main"
        and git("rev-parse", "--show-toplevel").decode().strip() == str(ROOT),
        "Actual repository main required",
    )
    return {
        "candidate": git("rev-parse", "HEAD").decode().strip(),
        "status": git("status", "--porcelain").decode(),
        "tracked_inventory_sha256": hashlib.sha256(
            git("ls-files", "-s", "-z")
        ).hexdigest(),
    }


def fresh_output(path: Path) -> Path:
    path = path.absolute()
    require(
        path.is_relative_to(ROOT / "artifacts")
        and path != ROOT / "artifacts"
        and ".." not in path.parts
        and path.resolve() == path
        and not path.exists()
        and not any(p.is_symlink() for p in (path, *path.parents)),
        "Fresh normalized artifact output required",
    )
    return path


def regular_tree(
    root: Path, *, allow_cache_bytecode: bool = False
) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    require(
        not any(p.is_symlink() for p in (root, *root.parents)),
        "Input root alias refused",
    )
    snapshot = namespace_snapshot(root, [])
    rows = []
    for name, value in snapshot["entries"].items():
        require(value["kind"] in {"file", "directory"}, "Source alias/special refused")
        if value["kind"] == "file":
            path = root / name
            require(
                allow_cache_bytecode or path.suffix not in {".pyc", ".pyo"},
                "Unreviewed source bytecode refused",
            )
            require(path.stat().st_nlink == 1, "Hardlinked source refused")
            rows.append(pin(path))
    return snapshot, rows


def declared_source_roles(
    original: list[dict[str, Any]], declared: dict[str, Any]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    expected = [{**row, "path": str(ROOT / row["path"])} for row in declared["inputs"]]
    require(
        len(original) == len(expected) == 30 and strict_equal(original, expected),
        "Exact thirty original raw/normalized role pins differ",
    )
    for row in expected:
        path = Path(row["path"])
        require(
            path.is_relative_to(ROOT / declared["raw_root"])
            or path.is_relative_to(ROOT / declared["normalized_root"]),
            "Foreign source role in original catalog",
        )
    public = [
        {**row, "path": str(ROOT / row["path"])}
        for row in declared["public_retained_inputs"]
    ]
    require(
        len(public) == 6 and len({row["path"] for row in public}) == 6,
        "Exact two count receipts/manifests/reports required",
    )
    wanted = {
        str(ROOT / "docs/report/source-relations/neotoma" / domain / name)
        for domain in ("abbo-core-identity", "swedish-lake-core-identity")
        for name in ("count-mass-crosscheck.json", "manifest.json", "report.json")
    }
    require({row["path"] for row in public} == wanted, "Public count/core roles differ")
    return expected, public


def expected_private(declared: dict[str, Any]) -> list[dict[str, Any]]:
    from source_inputs import verify_rows

    require(declared["source_root"] == str(ROOT), "Exact retained source root required")
    require(
        declared["raw_root"] == "data/neotoma/raw/neotoma_pollen_dataset_downloads"
        and declared["normalized_root"] == "data/neotoma/relational",
        "Raw download and normalized authority roles differ",
    )
    authority = declared["input_identity_authority"]
    require(
        authority["capture_path"]
        == "data/source-custody/neotoma/lakeparameters/capture.json"
        and authority["sha256"]
        == "25442e43479b87f7cf53a3476f9a825992616e15ab2587f43bfdaffa5ed37305"
        and authority["catalog_member"]
        == "original-input-identities/prerequisites.json",
        "Exact retained input authority required",
    )
    capture_path = ROOT / authority["capture_path"]
    capture_pin = pin(capture_path)
    require(
        capture_pin["sha256"] == authority["sha256"], "Retained source capture changed"
    )
    capture = load(capture_path)
    catalog_path = capture_path.parent / authority["catalog_member"]
    expected_catalog = capture["members"][authority["catalog_member"]]
    actual_catalog = pin(catalog_path)
    require(
        all(actual_catalog[k] == expected_catalog[k] for k in ("sha256", "bytes")),
        "Retained ordered identity catalog changed",
    )
    catalog = json.loads(catalog_path.read_bytes())
    original = [
        {"path": row["path"], "sha256": row["sha256"], "bytes": row["bytes"]}
        for row in catalog
        if row["retention_role"] == "raw_relational_input_identity_only"
    ]
    expected, public = declared_source_roles(original, declared)
    rows = exact_union(expected, public, [capture_pin, actual_catalog])
    verify_private_ancestry(
        ROOT, [str(Path(row["path"]).relative_to(ROOT)) for row in rows]
    )
    verify_rows(rows)
    return rows


def registered_plan(path: Path, expected: str) -> dict[str, Any]:
    require(
        type(expected) is str
        and len(expected) == 64
        and all(c in "0123456789abcdef" for c in expected),
        "Exact registered plan SHA required",
    )
    require(
        path.is_absolute()
        and path == path.resolve()
        and path.is_file()
        and path.stat().st_nlink == 1
        and not any(p.is_symlink() for p in (path, *path.parents)),
        "Physical registered plan required",
    )
    raw = path.read_bytes()
    require(
        hashlib.sha256(raw).hexdigest() == expected, "Registered plan buffer differs"
    )

    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        require(len(rows) == len({key for key, _ in rows}), "Duplicate plan key")
        return dict(rows)

    def refuse(value: str) -> None:
        raise ValueError("Nonfinite registered JSON: " + value)

    value = json.loads(raw, object_pairs_hook=pairs, parse_constant=refuse)
    require(isinstance(value, dict), "Registered plan object required")
    assert isinstance(value, dict)
    return value


def stage_plan(path: Path) -> dict[str, Any]:
    return registered_plan(path, os.environ.get("BIJUX_REGISTERED_PLAN_SHA256", ""))


def source_namespace(declared: dict[str, Any]) -> list[dict[str, Any]]:
    snapshots = []
    for role in ("raw_root", "normalized_root"):
        root = ROOT / declared[role]
        entries: dict[str, dict[str, str]] = {}
        for row in declared["inputs"]:
            path = ROOT / row["path"]
            if not path.is_relative_to(root):
                continue
            relative = path.relative_to(root)
            require(
                relative.parts and ".." not in relative.parts,
                "Normalized source-relative member required",
            )
            entries[relative.as_posix()] = {"kind": "file"}
            for parent in relative.parents:
                if parent != Path("."):
                    entries[parent.as_posix()] = {"kind": "directory"}
        require(bool(entries), "Both complete raw and normalized namespaces required")
        snapshots.append({"root": str(root), "excluded": [], "entries": entries})
    return snapshots


def checkpoint(
    authority: dict[str, Any], scope: InputScope, snapshots: list[dict[str, Any]]
) -> None:
    reviewed_controls(SOURCE)
    declared = load(SOURCE / "declared-inputs.json")
    private_root = Path(declared["source_root"])
    verify_private_ancestry(private_root, [item["path"] for item in declared["inputs"]])
    guarded_namespaces = [*snapshots, *source_namespace(declared)]
    for snapshot in snapshots:
        node = Path(snapshot["root"])
        require(
            not any(parent.is_symlink() for parent in (node, *node.parents)),
            "Owned source ancestry changed",
        )
    scope.verify()
    verify_base_namespaces(guarded_namespaces)
    current, _ = authenticate_runtime()
    require(current == authority, "Qualified source runtime changed")
    scope.verify()
    verify_base_namespaces(guarded_namespaces)


def execution_scope(plan: dict[str, Any]) -> tuple[dict[str, Any], InputScope]:
    _, _, controlled = reviewed_controls(SOURCE)
    authority, _ = authenticate_runtime()
    require(authority == plan["qualified_source_runtime"], "Runtime authority differs")
    scope = InputScope(exact_union(plan["input_pins"], controlled), [PYTHON])
    require(
        scope.rows == plan["input_pins"], "Current controls absent from frozen plan"
    )
    require(
        scope.aliases == plan["runtime_entry_raw_aliases"]
        and scope.entries == plan["runtime_entry_lexical_paths"],
        "Raw lexical entry changed",
    )
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    return authority, scope


def bootstrap(plan: dict[str, Any]) -> list[str]:
    require(
        Path(sys.executable).absolute() == PYTHON
        and sys.flags.isolated == 1
        and sys.dont_write_bytecode,
        "Qualified isolated lexical Python required",
    )
    owned = Path(plan["owned_repository"])
    roots = [owned / "packages" / name / "src" for name in PACKAGES]
    require(
        all(p.is_dir() and not p.is_symlink() for p in roots),
        "Four owned package sources required",
    )
    sys.path[:0] = list(map(str, roots))
    return list(map(str, roots))


def strict_equal(left: object, right: object) -> bool:
    if type(left) is not type(right):
        return False
    if isinstance(left, dict) and isinstance(right, dict):
        return list(left) == list(right) and all(
            strict_equal(left[key], right[key]) for key in left
        )
    if isinstance(left, list) and isinstance(right, list):
        return len(left) == len(right) and all(
            strict_equal(a, b) for a, b in zip(left, right, strict=True)
        )
    return left == right
