"""Independent typed native identity, count, label and age refusal rules."""

from __future__ import annotations

from collections import Counter
import hashlib
import json
import math
from typing import Any

MISSING = [
    "classification_decision_not_supplied",
    "lra_chronology_decision_not_supplied",
    "parameter_binding_not_supplied",
    "basin_geometry_not_supplied",
]
COUNTRIES = ("SE", "DK", "NO", "FI", "UNASSIGNED")


def require(value: object, message: str) -> None:
    if not value:
        raise ValueError(message)


def canonical(value: Any, *, newline: bool = True) -> bytes:
    return (
        json.dumps(
            value,
            ensure_ascii=False,
            allow_nan=False,
            sort_keys=True,
            separators=(",", ":"),
        )
        + ("\n" if newline else "")
    ).encode()


def digest(value: Any, *, newline: bool = False) -> str:
    return hashlib.sha256(canonical(value, newline=newline)).hexdigest()


def same(left: Any, right: Any, context: str = "typed source") -> None:
    require(type(left) is type(right), "Type differs: " + context)
    if type(left) is dict:
        require(left.keys() == right.keys(), "Fields differ: " + context)
        for key in left:
            same(left[key], right[key], context + "." + key)
    elif type(left) is list:
        require(len(left) == len(right), "Multiplicity differs: " + context)
        for index, (a, b) in enumerate(zip(left, right, strict=True)):
            same(a, b, context + "[" + str(index) + "]")
    elif type(left) is float:
        require(
            math.isfinite(left)
            and math.isfinite(right)
            and left == right
            and (left != 0 or math.copysign(1, left) == math.copysign(1, right)),
            "Binary64 source value differs: " + context,
        )
    else:
        require(left == right, "Value differs: " + context)


def clean(value: Any) -> str:
    text = "" if value is None else str(value).strip()
    return "" if text in {"", "null", "None"} else text


def native_id(value: Any) -> str | None:
    if value is None or type(value) is bool:
        return None
    if type(value) is int:
        return str(value)
    if type(value) is float and math.isfinite(value) and value.is_integer():
        return str(int(value))
    return clean(value) or None


def locator(surface: str, path: str, index: int, row: dict[str, Any]) -> dict[str, Any]:
    return {
        "authority": "normalized",
        "surface": surface,
        "path": path,
        "row_index": index,
        "row_sha256": digest(row, newline=True),
    }


def element_status(value: Any, kind: Any) -> str:
    if type(value) is not str or not value.strip():
        return "source_element_missing"
    if type(kind) is not str or not kind.strip():
        return "source_element_type_missing"
    if value.strip().casefold() != kind.strip().casefold():
        return "source_element_labels_disagree"
    return (
        "source_label_pollen"
        if value.strip().casefold() == "pollen"
        else "source_element_not_pollen"
    )


def count_value(datum: dict[str, Any]) -> tuple[int | None, str | None, str]:
    status = (
        "not_provided_by_source"
        if "value" not in datum
        else "source_null"
        if datum["value"] is None
        else "reported_value"
    )
    if status != "reported_value":
        return None, status, status
    if clean(datum.get("units")) not in {"NISP", "NISP digitized", "number"}:
        return None, "source_unit_is_not_count", status
    value = datum["value"]
    if type(value) not in {int, float}:
        return None, "count_is_not_numeric", status
    if type(value) is float and (not math.isfinite(value) or not value.is_integer()):
        return None, "count_is_not_finite_integer", status
    if value < 0:
        return None, "negative_count", status
    return int(value), None, status


def age_posture(age: dict[str, Any]) -> dict[str, Any]:
    basis = clean(age.get("agetype"))
    calibration, status = "unresolved", "unresolved"
    younger: Any = None
    older: Any = None
    reason: str | None = "unknown_age_type"
    if not basis:
        reason = "missing_age_type"
    elif basis == "Radiocarbon years BP":
        calibration, status, reason = (
            "uncalibrated",
            "context_only",
            "uncalibrated_radiocarbon",
        )
    elif basis == "Varve years BP":
        calibration, status, reason = (
            "not_calibrated",
            "context_only",
            "ungoverned_varve_basis",
        )
    elif basis in {"Calibrated radiocarbon years BP", "Calendar years BP"}:
        calibration = (
            "calibrated" if basis.startswith("Calibrated") else "not_applicable"
        )

        def finite(value: Any) -> bool:
            return type(value) in {int, float} and math.isfinite(value)

        lo, hi = age.get("ageyounger"), age.get("ageolder")
        status = "refused"
        if any(v is not None and not finite(v) for v in (lo, hi)):
            reason = "invalid_interval_bound"
        elif (lo is None) != (hi is None):
            reason = "partial_interval"
        else:
            if lo is None and hi is None:
                lo = hi = age.get("age")
            if not finite(lo) or not finite(hi):
                reason = "missing_numeric_age"
            else:
                assert lo is not None and hi is not None
                if lo < 0 or hi < 0:
                    reason = "negative_bp"
                elif lo > hi:
                    reason = "reversed_interval"
                else:
                    status, younger, older, reason = "comparable", lo, hi, None
    return {
        "calibration_status": calibration,
        "comparability_status": status,
        "younger_bp": younger,
        "older_bp": older,
        "reason_code": reason,
    }


def age_claim(
    age: dict[str, Any],
    occurrence: int,
    sample: dict[str, Any],
    default: str | None,
    chronologies: dict[str, str],
) -> dict[str, Any]:
    source_chronology = native_id(age.get("chronologyid"))
    value = digest(
        {
            "sample_id": sample["sample_id"],
            "dataset_id": sample["dataset_id"],
            "source_payload": age,
        }
    )[:24]
    posture = age_posture(age)
    return {
        "chronology_claim_id": f"neotoma:age-claim:{value}:{occurrence}",
        "source_family": "neotoma",
        "source_record_id": sample["sample_id"],
        "subject_type": "sample",
        "subject_id": sample["sample_id"],
        **{
            key: sample[key]
            for key in ("site_id", "collection_unit_id", "dataset_id", "country_code")
        },
        "chronology_id": chronologies.get(source_chronology)
        if source_chronology is not None
        else None,
        "chronology_name": age.get("chronologyname"),
        "is_default_chronology": source_chronology == default
        if source_chronology is not None
        else False,
        "source_age_type": age.get("agetype"),
        "source_age_value": age.get("age"),
        "source_age_younger": age.get("ageyounger"),
        "source_age_older": age.get("ageolder"),
        "source_age_unit": "year"
        if "year" in clean(age.get("agetype")).casefold()
        else None,
        "calibration_status": posture["calibration_status"],
        "comparability_status": posture["comparability_status"],
        "younger_bp": posture["younger_bp"],
        "older_bp": posture["older_bp"],
        "admission_reason": posture["reason_code"],
        "refusal_reason": posture["reason_code"]
        if posture["comparability_status"] == "refused"
        else None,
        "source_payload": age,
        "source_relation_path": f"{sample['dataset_id']}/{sample['sample_id']}/ages/{value}:{occurrence}",
        "provenance_record_id": sample["source_snapshot_id"],
        "source_snapshot_id": sample["source_snapshot_id"],
        "build_id": sample["build_id"],
    }


def mass_row(
    sample: dict[str, Any],
    observations: list[dict[str, Any]],
    sample_locator: dict[str, Any],
) -> dict[str, Any]:
    totals: Counter[str] = Counter()
    units: dict[str, Counter[str]] = {}
    for record in observations:
        totals["observations"] += 1
        if record["count_status"] != "count_candidate":
            totals["refused_count_observations"] += 1
            continue
        value = record["typed_count"]
        require(type(value) is int and value >= 0, "Exact candidate integer required")
        row = record["source_observation"]
        unit = units.setdefault(
            canonical(row["source_unit"]).decode().rstrip("\n"), Counter()
        )
        category = {
            "source_label_pollen": "pollen",
            "source_element_not_pollen": "nonpollen",
        }.get(
            element_status(row["source_element"], row["source_element_type"]),
            "unresolved_label",
        )
        totals["count_candidate_observations"] += 1
        totals[category + "_count_observations"] += 1
        unit[category + "_count_observations"] += 1
        unit[category + "_exact_count_sum"] += value
        if value == 0:
            unit[category + "_observed_zero_observations"] += 1
    return {
        "sample_id": sample["sample_id"],
        "country_code": sample["country_code"],
        "source_locator": sample_locator,
        **{
            key: totals[key]
            for key in (
                "observations",
                "refused_count_observations",
                "count_candidate_observations",
                "pollen_count_observations",
                "nonpollen_count_observations",
                "unresolved_label_count_observations",
            )
        },
        "source_unit_partitions": [
            {
                "source_unit": json.loads(key),
                **{
                    label + "_" + field: values[label + "_" + field]
                    for label in ("pollen", "nonpollen", "unresolved_label")
                    for field in (
                        "count_observations",
                        "exact_count_sum",
                        "observed_zero_observations",
                    )
                },
            }
            for key, values in sorted(units.items())
        ],
        "known_compatible_pollen_denominator_status": "not_evaluated",
        "lra_admission_status": "refused",
    }
