def refuses(call: Callable[[], Any]) -> None:
    try:
        call()
    except (ValueError, KeyError):
        return
    raise AssertionError("Unsafe synthetic source contract accepted")


def extracted(relative: str, name: str, namespace: dict[str, Any]) -> Any:
    source = ast.parse((ROOT / relative).read_text())
    node = next(
        n for n in source.body if isinstance(n, ast.FunctionDef) and n.name == name
    )
    code = ast.Module(
        body=[
            ast.ImportFrom(
                module="__future__", names=[ast.alias(name="annotations")], level=0
            ),
            node,
        ],
        type_ignores=[],
    )
    exec(
        compile(
            ast.fix_missing_locations(code),
            "actual-maintained-source-artificial-input-only",
            "exec",
        ),
        namespace,
    )
    return namespace[name]


