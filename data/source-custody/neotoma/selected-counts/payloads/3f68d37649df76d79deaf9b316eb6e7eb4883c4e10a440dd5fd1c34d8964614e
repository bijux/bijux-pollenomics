def actual_algorithm_on_artificial(artificial: dict[str, Any]) -> Any:
    from collections import Counter, defaultdict
    from collections.abc import Mapping
    from dataclasses import dataclass, field
    import hashlib
    import math
    from types import ModuleType
    from typing import cast

    name = "controlled_neotoma_source_functions"
    module = ModuleType(name)
    sys.modules[name] = module
    namespace = module.__dict__
    namespace.update(
        {
            "Counter": Counter,
            "Mapping": Mapping,
            "defaultdict": defaultdict,
            "dataclass": dataclass,
            "field": field,
            "hashlib": hashlib,
            "json": json,
            "math": math,
            "Any": Any,
            "cast": cast,
            "COUNTRY_CODES": ("SE", "DK", "NO", "FI", "UNASSIGNED"),
            "MAX_SAMPLES": 16,
            "MAX_OBSERVATIONS": 4096,
        }
    )
    prefix = "packages/bijux-pollenomics/src/bijux_pollenomics/"
    contract = ast.parse(
        (ROOT / prefix / "evidence/sources/neotoma/contract.py").read_text()
    )
    namespace["SURFACE_ID_FIELDS"] = next(
        ast.literal_eval(node.value)
        for node in contract.body
        if isinstance(node, ast.Assign)
        and any(
            isinstance(target, ast.Name) and target.id == "SURFACE_ID_FIELDS"
            for target in node.targets
        )
    )
    selections = [
        ("core/text.py", {"clean_optional_text"}),
        ("analysis/lra/materialization/models.py", {"SourceRow", "canonical_bytes"}),
        ("collection/sources/neotoma/relational/variables.py", {"unit_family"}),
        (
            "analysis/lra/materialization/counts.py",
            {"CountAssessment", "assess_count", "assess_nonnegative_integer"},
        ),
        ("analysis/lra/materialization/chronology.py", {"chronology_projection"}),
        (
            "analysis/lra/materialization/neotoma/accounting.py",
            {"SourceAccounting", "source_accounting"},
        ),
        (
            "analysis/lra/materialization/neotoma/series/projection.py",
            {
                "NeotomaCandidateSeries",
                "source_element_status",
                "build_neotoma_candidate_series",
            },
        ),
    ]
    accounting = ast.parse(
        (
            ROOT / prefix / "analysis/lra/materialization/neotoma/accounting.py"
        ).read_text()
    )
    for node in accounting.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id in {
                    "MISSING_LRA_EVIDENCE",
                    "PARENT_SURFACES",
                }:
                    namespace[target.id] = ast.literal_eval(node.value)
    for relative, names in selections:
        tree = ast.parse((ROOT / prefix / relative).read_text())
        for node in tree.body:
            if isinstance(node, ast.Assign) and any(
                isinstance(target, ast.Name) and target.id == "OWNERSHIP_FIELDS"
                for target in node.targets
            ):
                namespace["OWNERSHIP_FIELDS"] = ast.literal_eval(node.value)
        nodes = [
            node
            for node in tree.body
            if isinstance(node, (ast.FunctionDef, ast.ClassDef)) and node.name in names
        ]
        assert {node.name for node in nodes} == names
        owned = ast.Module(
            body=[
                ast.ImportFrom(
                    module="__future__", names=[ast.alias(name="annotations")], level=0
                ),
                *nodes,
            ],
            type_ignores=[],
        )
        exec(
            compile(
                ast.fix_missing_locations(owned),
                "actual-source-functions-artificial-records-only",
                "exec",
            ),
            namespace,
        )
    root = Path(artificial["source_root"])
    normalized = root / artificial["normalized_root"]
    manifest_bytes = (normalized / "manifest.json").read_bytes()
    manifest = json.loads(manifest_bytes)

    class ArtificialEvidence:
        raw_files = (
            (
                "manifest.json",
                pin(root / artificial["raw_root"] / "manifest.json")["sha256"],
            ),
        )

        def __init__(self) -> None:
            self.manifest_bytes = manifest_bytes

        def assert_unchanged(self) -> None:
            assert normalized.is_relative_to(SOURCE / "preflight")

        def manifest(self) -> Any:
            return json.loads(manifest_bytes)

        def rows(self, surface: str) -> Any:
            for part in manifest["surfaces"][surface]["parts"]:
                document = json.loads((normalized / part["path"]).read_bytes())
                for index, row in enumerate(document["rows"]):
                    yield namespace["SourceRow"](
                        surface, part["path"], index, namespace["canonical_bytes"](row)
                    )

    try:
        result = namespace["build_neotoma_candidate_series"](
            ArtificialEvidence(),
            [
                "neotoma:sample:" + str(row["sample_id"])
                for row in artificial["selected_samples"]
            ],
        )
        return json.loads(result.canonical_json)
    finally:
        sys.modules.pop(name)


def main() -> None:
    groups = 0
    declaration = json.loads((SOURCE / "declared-inputs.json").read_bytes())
    requests(declaration["selected_samples"])
    for field in (
        "sample_id",
        "dataset_id",
        "site_id",
        "part",
        "normalized_sample_row_index",
    ):
        bad = deepcopy(declaration["selected_samples"])
        bad[0][field] = bad[1][field]
        refuses(partial(requests, bad))
    refuses(partial(requests, list(reversed(declaration["selected_samples"]))))
    bad = deepcopy(declaration["selected_samples"])
    bad[0]["sample_id"] = True
    refuses(partial(requests, bad))
    groups += 1
    scalar = extracted(
        "packages/bijux-pollenomics/src/bijux_pollenomics/analysis/lra/materialization/counts.py",
        "assess_nonnegative_integer",
        {"math": __import__("math")},
    )
    for value in (
        None,
        True,
        False,
        "0",
        0,
        1,
        1.0,
        0.0,
        -0.0,
        1.25,
        -1,
        float("nan"),
        float("inf"),
    ):
        actual, reason, _ = count_value({"units": "NISP", "value": value})
        if value is None:
            assert reason == "source_null"
        else:
            assert (actual, reason) == scalar(value)
    assert count_value({"units": "NISP"}) == (
        None,
        "not_provided_by_source",
        "not_provided_by_source",
    )
    assert count_value({"units": "cm3", "value": 0})[1] == "source_unit_is_not_count"
    groups += 1
    label = extracted(
        "packages/bijux-pollenomics/src/bijux_pollenomics/analysis/lra/materialization/neotoma/series/projection.py",
        "source_element_status",
        {},
    )
    for a, b in [
        (None, None),
        ("pollen", None),
        (" Pollen ", "pollen"),
        ("spore", "spore"),
        ("pollen", "spore"),
        (False, "pollen"),
        ("", ""),
    ]:
        assert element_status(a, b) == label(a, b)
    groups += 1
    for value in [False, 0, None, "0", -0.0]:
        refuses(partial(same, value, 0 if type(value) is not int else False))
    refuses(partial(same, -0.0, 0.0))
    groups += 1
    for age in [
        {"agetype": "Calendar years BP", "age": 0},
        {"agetype": "Calendar years BP", "age": 10, "ageyounger": 5, "ageolder": 15},
        {"agetype": "Calendar years BP", "age": 10, "ageyounger": 5},
        {"agetype": "Calendar years BP", "age": 10, "ageyounger": "5", "ageolder": 15},
        {"agetype": "Calendar years BP", "age": True},
        {"agetype": "Calendar years BP", "age": -1},
        {"agetype": "Calendar years BP", "ageyounger": 15, "ageolder": 5},
        {"agetype": "Radiocarbon years BP", "age": 5},
        {"agetype": "Varve years BP", "age": 5},
        {"agetype": "unresolved", "age": 5},
    ]:
        namespace: dict[str, Any] = {}
        text = "packages/bijux-pollenomics/src/bijux_pollenomics/collection/sources/neotoma/relational/chronology.py"
        extracted(text, "finite_number", {**namespace, "math": __import__("math")})
        namespace = {
            "math": __import__("math"),
            "clean_optional_text": lambda x: "" if x is None else str(x).strip(),
        }
        extracted(text, "finite_number", namespace)
        extracted(text, "temporal_result", namespace)
        native = extracted(text, "age_temporal_posture", namespace)
        same(
            age_posture(age),
            native(age),
            "actual maintained age refusal artificial record",
        )
    groups += 1
    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as temporary:
        root = Path(temporary)
        artificial = fixture(root, declaration["selected_samples"])
        series, masses, identities = reconstruct(artificial)
        assert len(series["series"]) == len(masses) == len(identities) == 3
        same(
            actual_algorithm_on_artificial(artificial),
            series,
            "actual maintained bounded algorithm on artificial sources",
        )
        assert all(
            row["chronology"]["selected_claim_id"] is None for row in series["series"]
        )
        assert (
            masses[0]["source_unit_partitions"][0]["pollen_observed_zero_observations"]
            == 1
        )
        groups += 1
        # A self-consistent modified native locator and aggregate cannot hide source drift.
        altered = deepcopy(series)
        altered["series"][0]["source_locator"]["row_sha256"] = "f" * 64
        refuses(partial(same, altered, series))
        altered = deepcopy(series)
        altered["series"][0]["observations"][0]["source_observation"][
            "source_value"
        ] = False
        refuses(partial(same, altered, series))
        groups += 1
        for domain, schema, key, rows in [
            (
                "abbo-core-identity",
                "neotoma-sample-count-mass-crosscheck.v1",
                "sample_row",
                masses[:1],
            ),
            (
                "swedish-lake-core-identity",
                "neotoma-swedish-lake-count-mass-crosscheck.v1",
                "sample_rows",
                masses[1:],
            ),
        ]:
            directory = root / "docs/report/source-relations/neotoma" / domain
            directory.mkdir(parents=True)
            receipt = {
                "schema_version": schema,
                "source_snapshot_id": artificial["source_snapshot_id"],
                "original_mass_sha256": "historical-only",
                "lra_accepted_samples": 0,
                key: rows[0] if key == "sample_row" else rows,
            }
            (directory / "count-mass-crosscheck.json").write_text(json.dumps(receipt))
            (directory / "manifest.json").write_text(
                json.dumps({"historical_comparison": {"unrecovered": True}})
            )
            (directory / "report.json").write_text("{}")
        artificial["historical_mass_sha256_claim"] = "historical-only"
        assert all(
            not row["original_mass_object_recovered"]
            for row in retained_rows(artificial, masses)
        )
        wrong = deepcopy(masses)
        wrong[0]["source_unit_partitions"][0]["pollen_exact_count_sum"] = 999
        refuses(partial(retained_rows, artificial, wrong))
        groups += 1
        # Change both normalized bytes and its declared part hash: native raw join still refuses.
        path = root / "normalized/surfaces/observations/part-00001.json"
        values = json.loads(path.read_bytes())
        values["rows"][0]["source_value"] = 999
        path.write_text(json.dumps(values))
        updated = deepcopy(artificial)
        info_path = root / "normalized/manifest.json"
        manifest = json.loads(info_path.read_bytes())
        manifest["surfaces"]["observations"]["parts"][0]["sha256"] = pin(path)["sha256"]
        info_path.write_text(json.dumps(manifest))
        for row in updated["inputs"]:
            if row["path"] == path.relative_to(root).as_posix():
                row.update({k: pin(path)[k] for k in ("sha256", "bytes")})
        refuses(partial(reconstruct, updated))
        groups += 1
        plan = root / "controlled-plan.json"
        plan.write_text('{"scientific":0}')
        checksum = pin(plan)["sha256"]
        assert registered_plan(plan, checksum) == {"scientific": 0}
        previous = os.environ.get("BIJUX_REGISTERED_PLAN_SHA256")
        try:
            os.environ["BIJUX_REGISTERED_PLAN_SHA256"] = checksum
            assert stage_plan(plan) == {"scientific": 0}
            os.environ["BIJUX_REGISTERED_PLAN_SHA256"] = "f" * 64
            refuses(partial(stage_plan, plan))
        finally:
            if previous is None:
                os.environ.pop("BIJUX_REGISTERED_PLAN_SHA256", None)
            else:
                os.environ["BIJUX_REGISTERED_PLAN_SHA256"] = previous
        refuses(partial(registered_plan, plan, ""))
        malformed: list[Any] = [False, None, 0, [], {}]
        for expected_hash in malformed:
            refuses(partial(registered_plan, plan, expected_hash))
        refuses(partial(registered_plan, plan, "f" * 64))
        plan.write_text('{"scientific":false}')
        refuses(partial(registered_plan, plan, checksum))
        groups += 1
        one = root / "one"
        one.write_text("original")
        scope = InputScope([pin(one)], [])
        old = pin(one)
        refuses(partial(exact_union, [old, old]))
        one.write_text("changed")
        refuses(partial(scope.extend, [pin(one)]))
        refuses(scope.verify)
        groups += 1
        controlled = root / "entry-source"
        controlled.mkdir()
        files = []
        for original in sorted(SOURCE.glob("*.py")):
            target = controlled / original.name
            shutil.copyfile(original, target)
            files.append(pin(target))
        manifest_path = controlled / "prepared-source-manifest.json"

        def seal(rows: list[dict[str, Any]]) -> None:
            manifest_path.write_text(json.dumps({"source_only": True, "files": rows}))
            (controlled / "independent-source-review.json").write_text(
                json.dumps(
                    {
                        "approved": True,
                        "source_manifest_sha256": pin(manifest_path)["sha256"],
                    }
                )
            )

        seal(files)
        verify(controlled)
        seal([{**row, "path": Path(row["path"]).name} for row in files])
        refuses(partial(verify, controlled))
        seal(files)
        changed = controlled / "contracts.py"
        original_bytes = changed.read_bytes()
        changed.write_bytes(original_bytes + b"\n")
        refuses(partial(verify, controlled))
        changed.write_bytes(original_bytes)
        for name in ("contracts.so", "unknown.py"):
            target = controlled / name
            target.write_text("unreviewed")
            refuses(partial(verify, controlled))
            target.unlink()
        target = controlled / "alias"
        target.symlink_to(changed)
        refuses(partial(verify, controlled))
        target.unlink()
        os.mkfifo(controlled / "unlisted-fifo")
        refuses(partial(verify, controlled))
        (controlled / "unlisted-fifo").unlink()
        groups += 1
        projection_root = root / "projection"
        projection_root.mkdir()
        module_path = projection_root / "module.py"
        module_path.write_text("source")
        snapshot: dict[str, Any] = {
            "root": str(projection_root),
            "excluded": [],
            "entries": {"module.py": {"kind": "file"}},
        }
        selection = project(
            projection_root, snapshot, [pin(module_path)], {str(module_path)}
        )
        assert (
            selection["selected_rows"] == [pin(module_path)]
            and selection["omitted_bytecode_rows"] == []
        )
        refuses(
            partial(
                project,
                projection_root,
                snapshot,
                [pin(module_path), pin(module_path)],
                {str(module_path)},
            )
        )
        bad_snapshot = deepcopy(snapshot)
        bad_snapshot["entries"]["module.py"]["kind"] = "symlink"
        refuses(
            partial(
                project,
                projection_root,
                bad_snapshot,
                [pin(module_path)],
                {str(module_path)},
            )
        )
        groups += 1
    original_roles = [
        {**row, "path": str(ROOT / row["path"])} for row in declaration["inputs"]
    ]
    private_roles, public_roles = declared_source_roles(original_roles, declaration)
    assert len(private_roles) == 30 and len(public_roles) == 6
    for field in ("inputs", "public_retained_inputs"):
        for values in (
            [],
            declaration[field][:-1],
            [*declaration[field], declaration[field][0]],
        ):
            changed = deepcopy(declaration)
            changed[field] = values
            refuses(partial(declared_source_roles, original_roles, changed))
    changed = deepcopy(declaration)
    changed["inputs"][0]["sha256"] = "f" * 64
    refuses(partial(declared_source_roles, original_roles, changed))
    changed = deepcopy(declaration)
    changed["public_retained_inputs"][0]["path"] = "foreign/public.json"
    refuses(partial(declared_source_roles, original_roles, changed))
    groups += 1
    source_namespaces = source_namespace(declaration)
    from runtime_contracts import verify_base_namespaces

    with tempfile.TemporaryDirectory(dir=SOURCE / "preflight") as temporary:
        shape = Path(temporary)
        snapshots = deepcopy(source_namespaces)
        for index, snapshot in enumerate(snapshots):
            directory = shape / str(index)
            directory.mkdir()
            snapshot["root"] = str(directory)
            for name, item in snapshot["entries"].items():
                target = directory / name
                if item["kind"] == "directory":
                    target.mkdir(parents=True, exist_ok=True)
                else:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(b"controlled nonpayload namespace member")
        verify_base_namespaces(snapshots)
        first = Path(snapshots[0]["root"])
        (first / "unlisted").write_bytes(b"shadow")
        refuses(partial(verify_base_namespaces, snapshots))
        (first / "unlisted").unlink()
        os.mkfifo(first / "unlisted-fifo")
        refuses(partial(verify_base_namespaces, snapshots))
        (first / "unlisted-fifo").unlink()
        (first / "alias").symlink_to(first / "manifest.json")
        refuses(partial(verify_base_namespaces, snapshots))
    groups += 1
    assert len(source_namespaces) == 2
    assert (
        sum(
            value["kind"] == "file"
            for row in source_namespaces
            for value in row["entries"].values()
        )
        == 30
    )
    assert source_namespaces[0]["root"].endswith(declaration["raw_root"])
    groups += 1
    # Actual prepare stage AST must match the actual dispatch predicate.
    module = ast.parse((SOURCE / "prepare.py").read_text())
    expression = next(
        n.value
        for n in ast.walk(module)
        if isinstance(n, ast.AnnAssign)
        and isinstance(n.target, ast.Name)
        and n.target.id == "plan"
    )
    assert isinstance(expression, ast.Dict)
    stages_node = next(
        v
        for k, v in zip(expression.keys, expression.values, strict=True)
        if isinstance(k, ast.Constant) and k.value == "stages"
    )
    stages = ast.literal_eval(stages_node)
    output = SOURCE / "preflight/controlled-output"
    for stage in stages:
        stage["argv"] = [
            str(__import__("contracts").PYTHON),
            "-I",
            "-B",
            str(SOURCE / "entry.py"),
            stage["action"],
            "--plan",
            str(output / "plan.json"),
        ]
    plan_value = {"resources": RESOURCES, "stages": stages}
    validate_stages(plan_value, output / "plan.json")
    for value in [[], stages[:1], list(reversed(stages))]:
        refuses(
            partial(
                validate_stages, {**plan_value, "stages": value}, output / "plan.json"
            )
        )
    wrong_stages = deepcopy(stages)
    wrong_stages[0]["timeout_seconds"] = True
    refuses(
        partial(
            validate_stages,
            {**plan_value, "stages": wrong_stages},
            output / "plan.json",
        )
    )
    assert remaining_seconds(10, 20, 390) == 380
    refuses(partial(remaining_seconds, 10, 400, 390))
    groups += 1
    assert entry_root(SOURCE / "entry.py") == SOURCE
    refuses(partial(entry_root, SOURCE / ".." / SOURCE.name / "entry.py"))
    groups += 1
    print(
        json.dumps(
            {
                "source_only": True,
                "actual_exit": 0,
                "controlled_groups": groups,
                "actual_private_bodies_or_native_consumers_executed": False,
            },
            indent=2,
        )
    )


