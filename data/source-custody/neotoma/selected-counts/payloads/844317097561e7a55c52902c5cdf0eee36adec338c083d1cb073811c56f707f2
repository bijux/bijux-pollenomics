"""Run the maintained bounded Neotoma sample-series source consumer without normalization or models."""

from __future__ import annotations

import argparse
import importlib.abc
from pathlib import Path
import sys
from typing import Any

from contracts import (
    SAMPLE_IDS,
    bootstrap,
    checkpoint,
    execution_scope,
    require,
    stage_plan,
    write,
)
from source_inputs import pin


class DenyNumerical(importlib.abc.MetaPathFinder):
    def __init__(self) -> None:
        self.attempts: list[str] = []

    def find_spec(self, fullname: str, path: Any = None, target: Any = None) -> Any:
        if fullname.split(".")[0] in {"bijux_pollenomics_lra", "pollenomics"}:
            self.attempts.append(fullname)
            raise ImportError(
                "Numerical engine/facade outside Neotoma source count review"
            )
        return None


def origins(plan: dict[str, Any]) -> list[dict[str, Any]]:
    owned = Path(plan["owned_repository"])
    protected = {row["path"]: row for row in plan["input_pins"]}
    rows = []
    for name, module in sorted(sys.modules.items()):
        if name.split(".")[0] not in {
            "bijux_pollenomics",
            "bijux_pollenomics_dev",
            "bijux_pollenomics_lra",
            "pollenomics",
        }:
            continue
        filename = getattr(module, "__file__", None)
        require(isinstance(filename, str), "First-party source origin missing")
        assert isinstance(filename, str)
        path = Path(filename)
        row = pin(path)
        require(
            path.is_relative_to(owned) and protected.get(str(path)) == row,
            "First-party namespace left owned pinned source",
        )
        if hasattr(module, "__path__"):
            require(
                list(module.__path__) == [str(path.parent)],
                "Mixed first-party namespace refused",
            )
        rows.append({"module": name, **row})
    return rows


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = stage_plan(args.plan)
    authority, scope = execution_scope(plan)
    roots = bootstrap(plan)
    selected = [
        "neotoma:sample:" + str(row["sample_id"]) for row in plan["selected_samples"]
    ]
    require(
        tuple(selected) == SAMPLE_IDS,
        "Exact sample IDs required; these are not dataset or download IDs",
    )
    denial = DenyNumerical()
    require(
        not any(
            name.split(".")[0] in {"bijux_pollenomics_lra", "pollenomics"}
            for name in sys.modules
        ),
        "Numerical namespace already loaded",
    )
    sys.meta_path.insert(0, denial)
    from bijux_pollenomics.analysis.lra.materialization.neotoma.series import (
        build_neotoma_candidate_series,
    )
    from bijux_pollenomics.analysis.lra.materialization.reading import (
        read_neotoma_evidence,
    )

    evidence = read_neotoma_evidence(
        Path(plan["raw_root"]), Path(plan["normalized_root"])
    )
    series = build_neotoma_candidate_series(evidence, selected)
    output = Path(plan["output"])
    target = output / "selected-series.json"
    require(
        not target.exists() and not target.is_symlink(), "Fresh source series required"
    )
    with target.open("xb") as stream:
        stream.write(series.canonical_json)
    require(
        pin(target)["sha256"] == series.result_digest,
        "Actual maintained result digest differs",
    )
    actual_origins = origins(plan)
    require(not denial.attempts, "Numerical import attempted")
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    write(
        output / "maintained-producer-execution.json",
        {
            "schema_version": "neotoma-selected-count-maintained-execution.v1",
            "actual_exit": 0,
            "candidate": plan["candidate"],
            "actual_argv": sys.orig_argv,
            "actual_executable": sys.executable,
            "maintained_public_calls": [
                "read_neotoma_evidence(raw_root, normalized_root)",
                "build_neotoma_candidate_series(evidence, selected_sample_ids)",
            ],
            "selected_sample_ids": selected,
            "distinct_native_request_roles": plan["selected_samples"],
            "raw_root": plan["raw_root"],
            "normalized_root": plan["normalized_root"],
            "actual_first_party_origins": actual_origins,
            "owned_package_search_roots": roots,
            "product": pin(target),
            "numerical_import_attempts": denial.attempts,
            "normalization_HTTP_model_or_R_executed": False,
            "original_mass_or_manifest_constructor_recovered": False,
            "physical_core_chronology_denominator_rights_human_or_LRA_admitted": False,
        },
    )


if __name__ == "__main__":
    main()
