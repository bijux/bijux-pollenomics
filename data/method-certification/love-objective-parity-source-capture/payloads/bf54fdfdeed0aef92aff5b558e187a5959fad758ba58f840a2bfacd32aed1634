@contextmanager
def refused() -> Iterator[None]:
    try:
        yield
    except (ValueError, FileNotFoundError, AssertionError):
        return
    raise AssertionError("Expected fail-closed refusal")


def prefix(tree: Path, name: str) -> None:
    """Exercise actual entrypoint statements through the guarded helper boundary."""
    path = tree / name
    module = ast.parse(path.read_bytes())
    nodes = []
    for node in module.body:
        if isinstance(node, ast.ImportFrom) and node.module in {
            "contracts",
            "source_runtime",
        }:
            break
        nodes.append(node)
    code = compile(
        ast.fix_missing_locations(ast.Module(body=nodes, type_ignores=[])),
        str(path),
        "exec",
    )
    exec(code, {"__file__": str(path), "__name__": "entrypoint_source_guard"})


def actual_held_manifest_prefixes(fixture: Path) -> None:
    """Run all actual strict entry guards using the real held manifest's schema."""
    actual_manifest = json.loads(
        (SOURCE / "prepared-source-manifest.json").read_bytes()
    )
    rows = actual_manifest["files"]
    require(
        [row["path"] for row in rows] == sorted({row["path"] for row in rows}),
        "Held manifest sorted unique paths",
    )
    fixture.mkdir()
    copied_rows = []
    for row in rows:
        path = Path(row["path"])
        require(
            path.is_absolute()
            and path.is_relative_to(SOURCE)
            and source_contract_pin(path) == row,
            "Actual held manifest absolute physical member contract",
        )
        target = fixture / path.relative_to(SOURCE)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(path.read_bytes())
        copied_rows.append({**row, "path": str(target)})
    manifest = {**actual_manifest, "files": copied_rows}
    manifest_path, review_path = (
        fixture / "prepared-source-manifest.json",
        fixture / "independent-source-review.json",
    )

    def save_document(value: dict[str, Any]) -> None:
        raw = (json.dumps(value, indent=2) + "\n").encode()
        manifest_path.write_bytes(raw)
        review_path.write_text(
            json.dumps(
                {
                    "approved": True,
                    "source_manifest_sha256": hashlib.sha256(raw).hexdigest(),
                }
            )
        )

    guards = []
    for name in (
        "prepare.py",
        "run.py",
        "produce.py",
        "observe.py",
        "runtime_guarded_runner.py",
    ):
        module = ast.parse((SOURCE / name).read_bytes())
        functions: list[ast.stmt] = [
            n
            for n in module.body
            if isinstance(n, ast.FunctionDef)
            and n.name in {"_verify_entry_namespace", "_verify_reviewed_entry"}
        ]
        require(len(functions) == 2, "Both actual entry guards required")
        scope: dict[str, Any] = {"Path": Path, "json": json, "hashlib": hashlib}
        exec(
            compile(
                ast.fix_missing_locations(ast.Module(body=functions, type_ignores=[])),
                name,
                "exec",
            ),
            scope,
        )
        guards.append(scope)
    save_document(manifest)
    for scope in guards:
        scope["_verify_entry_namespace"](fixture)
        scope["_verify_reviewed_entry"](fixture)
    relative = deepcopy(manifest)
    for row in relative["files"]:
        row["path"] = str(Path(row["path"]).relative_to(fixture))
    save_document(relative)
    for scope in guards:
        with refused():
            scope["_verify_reviewed_entry"](fixture)
    save_document(manifest)
    member = fixture / "retained_python.py"
    raw = member.read_bytes()
    member.write_bytes(raw + b"\n")
    for scope in guards:
        with refused():
            scope["_verify_reviewed_entry"](fixture)
    member.write_bytes(raw)
    for scope in guards:
        scope["_verify_reviewed_entry"](fixture)


