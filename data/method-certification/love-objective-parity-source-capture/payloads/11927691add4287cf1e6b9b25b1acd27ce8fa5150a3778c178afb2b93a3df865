def validate_marker(
    raw: bytes,
    description: dict[str, str],
    inventory: dict[str, Any],
    sources: list[dict[str, Any]],
) -> None:
    require(
        raw == (ARCHIVE_SHA + "\n").encode(), "Installed source archive marker differs"
    )
    require(
        description.get("Package") == "disqover"
        and description.get("Version") == "0.9.14",
        "Observed installed package DESCRIPTION differs",
    )
    require(
        inventory["files"] == 918
        and inventory["source_markers_generated"] is False
        and inventory["source_markers_reused_from_original_failed_observer"] is True,
        "Observed installed inventory or marker epoch differs",
    )
    row = inventory["namespace"]["entries"].get("disqover/" + MARKER_NAME)
    require(
        isinstance(row, dict) and row.get("kind") == "file",
        "Actual marker absent from complete installed namespace",
    )
    selected = [row for row in sources if row.get("package") == "disqover"]
    require(
        len(selected) == 1
        and selected[0]["sha256"] == ARCHIVE_SHA
        and selected[0]["version"] == "0.9.14",
        "Qualified source archive/package identity differs",
    )


def validate_metadata(
    plan: dict[str, Any],
    common: dict[str, Any],
    inner: dict[str, Any],
    outer: dict[str, Any],
    shared: dict[str, Any],
) -> None:
    require(
        plan["numerical_contract"] == CONTRACT,
        "Original shared numerical contract differs",
    )
    checksum = REFS["plan.json"]
    for document in (common, inner, outer):
        require(
            document["plan_sha256"] == checksum
            and type(document["actual_exit"]) is int
            and document["actual_exit"] == 1,
            "Original failed whole must remain literal",
        )
    require(
        common["candidate"]
        == inner["candidate"]
        == outer["source_candidate"]
        == plan["candidate"],
        "Original source epochs differ",
    )
    require(
        common["canonical_before"]
        == common["canonical_after"]
        == plan["canonical_identity"]
        and common["before_pin_mismatches"] == common["after_pin_mismatches"] == []
        and common["absent_input_paths_unchanged"] is True,
        "Original before/after source custody failed",
    )
    require(
        inner["after_input_error"] is None
        and inner["timed_out"] is False
        and inner["common_actual_exit"] == 1,
        "Original inner custody failed",
    )
    require(
        outer["before_runtime_error"] is None
        and outer["after_runtime_error"] is None
        and outer["timed_out"] is False
        and outer["delegate_actual_exit"] == 1
        and outer["output_measurement_error"] is None
        and outer["resource_bounds_met"] is False,
        "Original runtime failure scope differs",
    )
    actual, expected = common["stages"], plan["stages"]
    require(
        len(actual) == 2 and len(expected) == 4, "Original stage membership differs"
    )
    for result, stage in zip(actual, expected[:2], strict=True):
        require(
            all(
                result[key] == stage[key]
                for key in ("id", "argv", "timeout_seconds", "must_succeed")
            )
            and result["timed_out"] is False,
            "Original actual stage argv/timeout differs",
        )
    require(
        type(actual[0]["actual_exit"]) is int
        and actual[0]["actual_exit"] == 0
        and type(actual[1]["actual_exit"]) is int
        and actual[1]["actual_exit"] == 1,
        "Only original fixture export succeeded",
    )
    require(
        actual[0]["id"] == "export-shared-binary64-source-fixture"
        and actual[1]["id"] == "source-R-thirty-two-candidate-replay",
        "Original source stage roles differ",
    )
    require(
        type(shared["actual_exit"]) is int
        and shared["actual_exit"] == 0
        and shared["candidate"] == plan["candidate"]
        and shared["contract"] == CONTRACT,
        "Retained exporter contract/epoch differs",
    )
    require(
        shared["actual_argv"][0] == expected[0]["argv"][0]
        and shared["actual_argv"][1:] == expected[0]["argv"][3:],
        "Retained exporter actual command differs",
    )


def verify_input_directory(directory: Path, records: list[dict[str, Any]]) -> None:
    require(
        directory.is_dir()
        and directory == directory.resolve()
        and not any(p.is_symlink() for p in (directory, *directory.parents)),
        "Retained input root alias/missing",
    )
    expected = sorted(
        str(directory / (name + suffix))
        for name in INPUT_NAMES
        for suffix in (".csv", "-hex.csv")
    )
    require(
        [row["path"] for row in records] == expected,
        "Retained exact10 input membership differs",
    )
    actual = []
    for path in directory.iterdir():
        require(
            path.is_file() and not path.is_symlink(),
            "Retained shared input alias/special/directory",
        )
        actual.append(str(path))
    require(
        sorted(actual) == expected,
        "Retained shared input namespace gained/lost a member",
    )
    for row in records:
        require(pin(Path(row["path"])) == row, "Retained shared input changed")


def authenticate() -> tuple[dict[str, Any], list[dict[str, Any]], dict[str, Any]]:
    references = [pin(ORIGINAL / name) for name in REFS]
    require(
        all(row["sha256"] == REFS[Path(row["path"]).name] for row in references),
        "Original execution reference changed",
    )
    docs = {name: load(ORIGINAL / name) for name in REFS}
    plan = docs["plan.json"]
    shared = docs["shared-inputs.json"]
    common = docs["terminal.json"]
    validate_metadata(
        plan,
        common,
        docs["love-parity-terminal.json"],
        docs["runtime-custody-terminal.json"],
        shared,
    )
    require(
        len(plan["input_pins"]) == 115349,
        "Complete original source/runtime pin count differs",
    )
    files = shared["files"]
    verify_input_directory(ORIGINAL / "input", files)
    proof = []
    for key in ("stdout", "stderr"):
        path = Path(common["stages"][0][key])
        row = pin(path)
        require(
            row["sha256"] == common["stages"][0][key + "_sha256"],
            "Completed export log changed",
        )
        proof.append(row)
    failed_stderr = Path(common["stages"][1]["stderr"])
    failed_row = pin(failed_stderr)
    require(
        failed_row["sha256"] == common["stages"][1]["stderr_sha256"]
        and "SOURCE_SHA256" in failed_stderr.read_text(),
        "Original source-binding refusal changed",
    )
    proof.append(failed_row)
    protected = {row["path"]: row for row in common["products"]}
    for row in [
        *files,
        next(
            row for row in references if Path(row["path"]).name == "shared-inputs.json"
        ),
    ]:
        require(
            protected.get(row["path"]) == row,
            "Retained export lacks original actual product binding",
        )
    require(
        not (ORIGINAL / "python").exists() and not (ORIGINAL / "python").is_symlink(),
        "Original Python stage was not absent",
    )
    require(
        (ORIGINAL / "r").is_dir()
        and not (ORIGINAL / "r").is_symlink()
        and list((ORIGINAL / "r").iterdir()) == [],
        "Original failed R pre-model output was not empty",
    )
    for row in plan["input_pins"]:
        verify_pin(row)
    authority = {
        "references": references,
        "original_candidate": plan["candidate"],
        "original_whole_actual_exit": 1,
        "original_stage_actual_exits": [0, 1],
        "retained_completed_export_stage": common["stages"][0],
        "retained_input_root": str(ORIGINAL / "input"),
        "retained_input_manifest": str(ORIGINAL / "shared-inputs.json"),
        "retained_input_files": files,
        "complete_original_protected_inputs": 115349,
        "old_R_model_completed": False,
        "original_Python_stage_launched": False,
        "new_stages": ["source R", "public Python", "independent observer"],
        "scope": "Reuse only genuine completed shared fixture export. Original whole1 and source-binding R1 remain literal; no old numerical pass is inferred.",
    }
    return authority, union(plan["input_pins"], references, files, proof), plan
