def frame(path: Path) -> Any:
    import pandas as pd

    return pd.read_csv(path, float_precision="round_trip")


def origins(plan: dict[str, Any]) -> list[dict[str, Any]]:
    pins = {row["path"]: row for row in plan["input_pins"]}
    result = []
    for name, module in sorted(sys.modules.items()):
        if not name.startswith(("bijux_pollenomics", "pollenomics")):
            continue
        raw = getattr(module, "__file__", None)
        require(isinstance(raw, str), "First-party origin is missing")
        assert isinstance(raw, str)
        path = Path(raw)
        require(
            any(path.is_relative_to(root) for root in PACKAGE_ROOTS),
            "First-party origin escaped",
        )
        row = pin(path)
        require(pins.get(row["path"]) == row, "First-party source not protected")
        result.append({"module": name, **row})
    return result


def dependency_origins(plan: dict[str, Any]) -> list[dict[str, Any]]:
    protected = {row["path"]: row for row in plan["input_pins"]}
    result = []
    for name, module in sorted(sys.modules.items()):
        if name.split(".")[0] not in {"numpy", "pandas", "scipy"}:
            continue
        raw = getattr(module, "__file__", None)
        if raw is None:
            # Namespace-only packages have no executable file; their children are checked.
            require(
                getattr(module, "__path__", None) is not None,
                "Dependency origin missing",
            )
            continue
        require(isinstance(raw, str), "Dependency origin is not a path")
        assert isinstance(raw, str)
        row = pin(Path(raw))
        require(
            protected.get(row["path"]) == row, "Unqualified numerical dependency origin"
        )
        result.append({"module": name, **row})
    require(
        {"numpy", "pandas"} <= {row["module"] for row in result},
        "Core dependency not observed",
    )
    return result


def export(plan: dict[str, Any]) -> None:
    import numpy as np
    import pandas as pd

    from bijux_pollenomics_lra.resources.examples import load_love_example

    output = Path(plan["output"]) / "input"
    output.mkdir()
    local, regional, params, rings = load_love_example()
    tables = {
        "local": local,
        "regional": regional,
        "ppes": params["ppes"],
        "rings": rings,
        "candidates": pd.DataFrame(np.linspace(0.1, 0.9, 320).reshape(32, 10)),
    }
    require(
        list(local.columns[1:])
        == list(regional.columns[1:])
        == list(params["ppes"]["Taxon"]),
        "Source taxon axes differ",
    )
    for name, table in tables.items():
        table.to_csv(output / (name + ".csv"), index=False, float_format="%.17g")
        numeric = table.select_dtypes(include="number")
        pd.DataFrame(
            {
                column: [float(value).hex() for value in numeric[column]]
                for column in numeric
            }
        ).to_csv(output / (name + "-hex.csv"), index=False)
        restored = frame(output / (name + ".csv"))
        require(
            list(restored.columns) == [str(c) for c in table.columns],
            "Export column order",
        )
        require(
            np.array_equal(
                restored.select_dtypes(include="number").to_numpy(), numeric.to_numpy()
            ),
            "Decimal binary64 round trip failed",
        )
    dump(
        Path(plan["output"]) / "shared-inputs.json",
        {
            "actual_exit": 0,
            "candidate": plan["candidate"],
            "contract": CONTRACT,
            "files": [pin(path) for path in sorted(output.iterdir())],
            "source_origins": origins(plan),
            "dependency_origins": dependency_origins(plan),
            "actual_argv": [sys.executable, *sys.argv],
        },
    )


def numeric_token(value: float) -> str:
    return float(value).hex()


def nested_code(parent: CodeType, name: str) -> CodeType:
    found = [
        code
        for code in parent.co_consts
        if isinstance(code, CodeType) and code.co_name == name
    ]
    require(len(found) == 1, "Unique qualified nested objective code required")
    return found[0]


def objective_event(
    frame: FrameType, codes: dict[str, CodeType]
) -> tuple[str, list[dict[str, Any]]]:
    objective = frame.f_back
    require(
        objective is not None and objective.f_code is codes["objective"],
        "Unknown tf caller",
    )
    assert objective is not None
    caller = objective.f_back
    require(caller is not None, "Missing objective caller")
    assert caller is not None
    if caller.f_code is codes["search"]:
        names = ["objective", "search", "comprehension", "replay", "solver"]
        kind = "search"
    elif caller.f_code is codes["solver"]:
        names = ["objective", "solver"]
        kind = "certification"
    else:
        raise ValueError("Unknown objective evaluation route")
    current: FrameType | None = objective
    stack = []
    for name in names:
        require(
            current is not None and current.f_code is codes[name],
            "Objective stack/code identity differs",
        )
        assert current is not None
        stack.append(
            {
                "role": name,
                "path": current.f_code.co_filename,
                "function": current.f_code.co_name,
                "first_line": current.f_code.co_firstlineno,
                "line": current.f_lineno,
            }
        )
        current = current.f_back
    return kind, stack


def python(plan: dict[str, Any]) -> None:
    import numpy as np

    from bijux_pollenomics_lra.api import LoveConfig, run_love
    from bijux_pollenomics_lra.optimization.solver import ReplayOptimizer, optimize_box
    from bijux_pollenomics_lra.reconstruction.optimized import LOVEoptim, tf

    directory = Path(plan["output"])
    shared = Path(plan["shared_input_root"])
    output = directory / "python"
    output.mkdir()
    tables = {name: frame(shared / (name + ".csv")) for name in INPUT_NAMES}
    candidates = tables["candidates"].to_numpy(dtype=float)
    require(candidates.shape == (32, 10), "Candidate shape differs")
    require(tf.__code__.co_filename == str(TF_SOURCE), "Objective code origin changed")
    solver_source = TF_SOURCE.parents[1] / "optimization/solver.py"
    require(
        optimize_box.__code__.co_filename == str(solver_source)
        and ReplayOptimizer.solve.__code__.co_filename == str(solver_source),
        "Solver code origin differs",
    )
    codes = {
        "objective": nested_code(LOVEoptim.__code__, "objective"),
        "search": nested_code(optimize_box.__code__, "custom_objective"),
        "comprehension": nested_code(ReplayOptimizer.solve.__code__, "<listcomp>"),
        "replay": ReplayOptimizer.solve.__code__,
        "solver": optimize_box.__code__,
    }
    objective_module = compile(TF_SOURCE.read_bytes(), str(TF_SOURCE), "exec")
    solver_module = compile(solver_source.read_bytes(), str(solver_source), "exec")
    expected_solver = nested_code(solver_module, "optimize_box")
    expected_replay = nested_code(
        nested_code(solver_module, "ReplayOptimizer"), "solve"
    )
    expected_codes = {
        "objective": nested_code(
            nested_code(objective_module, "LOVEoptim"), "objective"
        ),
        "search": nested_code(expected_solver, "custom_objective"),
        "comprehension": nested_code(expected_replay, "<listcomp>"),
        "replay": expected_replay,
        "solver": expected_solver,
    }
    require(
        tf.__code__ == nested_code(objective_module, "tf")
        and all(codes[name] == expected_codes[name] for name in codes),
        "Observed objective/solver code differs from exact pinned source compilation",
    )
    values: list[float] = []
    candidates_seen: list[list[str]] = []
    contexts: list[dict[str, Any]] = []
    certifications: list[dict[str, Any]] = []
    events: list[dict[str, Any]] = []

    def watch(f: Any, event: str, value: Any) -> None:
        if event == "return" and f.f_code is tf.__code__:
            kind, stack = objective_event(f, codes)
            candidate = np.asarray(f.f_locals["a"], dtype=float)
            call = len(certifications) + 1
            require(call <= 8, "Unexpected extra active objective")
            context = {
                name: [
                    float(v).hex()
                    for v in np.asarray(f.f_locals[name], dtype=float).ravel(order="F")
                ]
                for name in (
                    "vPoldepRegio",
                    "mKlocal",
                    "vFlocal",
                    "vSampleLocPro",
                    "ppes",
                )
            }
            vector = [float(x).hex() for x in candidate]
            token = numeric_token(float(value))
            if kind == "search":
                index = len(values) - 32 * (call - 1)
                require(
                    0 <= index < 32 and np.array_equal(candidate, candidates[index]),
                    "Objective search candidate order differs",
                )
                if index == 0:
                    contexts.append(context)
                require(
                    context == contexts[call - 1],
                    "Source arguments changed during search",
                )
                values.append(float(value))
                candidates_seen.append(vector)
                index_one_based = index + 1
            else:
                require(
                    len(values) == call * 32,
                    "Certification occurred before complete search",
                )
                block = values[(call - 1) * 32 : call * 32]
                valid = [(v, index) for index, v in enumerate(block) if np.isfinite(v)]
                require(bool(valid), "Certification without finite search result")
                best = min(valid)[1]
                require(
                    vector == [float(x).hex() for x in candidates[best]]
                    and token == numeric_token(block[best])
                    and context == contexts[call - 1],
                    "Certification candidate/value/context differs from first finite minimum",
                )
                index_one_based = best + 1
                certifications.append(
                    {
                        "call": call,
                        "candidate_index": index_one_based,
                        "candidate_binary64": vector,
                        "value_binary64": token,
                    }
                )
            events.append(
                {
                    "kind": kind,
                    "call": call,
                    "candidate_index": index_one_based,
                    "candidate_binary64": vector,
                    "value_binary64": token,
                    "context_binary64": context,
                    "actual_stack": stack,
                }
            )

    config = LoveConfig(
        "optimized",
        "lake",
        300,
        12.9,
        10,
        repeats=2,
        stochastic=False,
        seed=7,
        optimizer_max_evaluations=32,
    )
    require(sys.getprofile() is None, "Unexpected existing profiler")
    try:
        sys.setprofile(watch)
        with warnings.catch_warnings():
            warnings.filterwarnings(
                "ignore", message="Terrestrial area exceeds geometric ring area"
            )
            result = run_love(
                tables["local"],
                tables["regional"],
                tables["ppes"],
                tables["rings"],
                config,
                replay_candidates=candidates,
            )
    finally:
        sys.setprofile(None)
    require(
        len(values) == 256
        and len(result.diagnostics) == len(certifications) == 8
        and len(events) == 264,
        "Actual objective call count differs",
    )
    result.cover["mean"].to_csv(output / "python-cover.csv", index=False)
    result.pollen_percentages["mean"].to_csv(output / "python-pollen.csv", index=False)
    require(result.objective_values is not None, "No objective product")
    assert result.objective_values is not None
    result.objective_values.to_csv(output / "python-objective.csv", index=False)
    result.auxiliary["K"].to_csv(output / "python-k.csv", index=False)
    diagnostics = []
    for item in result.diagnostics:
        selected = np.flatnonzero(np.all(candidates == item.x, axis=1))
        require(
            len(selected) == 1
            and item.nfev == 32
            and item.certification_nfev == 1
            and item.success,
            "Incomplete candidate replay",
        )
        diagnostics.append(
            {
                "best_index": int(selected[0]) + 1,
                "nfev": item.nfev,
                "certification_nfev": item.certification_nfev,
                "bestval": numeric_token(item.fun),
                "algorithm": item.algorithm,
            }
        )
    dump(
        output / "python-trace.json",
        {
            "actual_exit": 0,
            "diagnostics": diagnostics,
            "objective_events": events,
            "code_routes_verified_against_pinned_source": True,
            "certification_events": certifications,
            "search_returns": len(values),
            "certification_returns": len(certifications),
            "all_tf_returns": len(events),
            "objective_values_binary64": [numeric_token(value) for value in values],
            "objective_contexts_binary64": contexts,
            "candidate_vectors_binary64": candidates_seen,
            "source_origins": origins(plan),
            "dependency_origins": dependency_origins(plan),
            "actual_argv": [sys.executable, *sys.argv],
            "instrumentation": "Actual code-object-qualified optimized.tf return stacks distinguish256 search and8 solver certification returns during one unchanged public run_love call; instrumentation adds no objective evaluation.",
        },
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--mode", choices=("shared-inputs", "python"), required=True)
    args = parser.parse_args()
    plan = checked_plan(args.plan)
    sys.path[:0] = [str(path) for path in PACKAGE_ROOTS]
    if args.mode == "shared-inputs":
        export(plan)
    else:
        python(plan)


if __name__ == "__main__":
    main()
