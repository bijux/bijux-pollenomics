args <- commandArgs(trailingOnly=TRUE)
stopifnot(length(args)==5L)
input <- normalizePath(args[1], mustWork=TRUE)
output <- normalizePath(args[2], mustWork=TRUE)
library <- normalizePath(args[3], mustWork=TRUE)
.libPaths(c(library, file.path(R.home(), 'library')))
stopifnot(identical(normalizePath(.libPaths()), c(library, normalizePath(file.path(R.home(),'library')))))
options(digits=17, warn=1)
stopifnot(getRversion()=='4.6.0', as.character(packageVersion('disqover'))=='0.9.14')
stopifnot(readLines(system.file('SOURCE_SHA256',package='disqover'))[1]==args[4])
source(args[5])
snapshot <- function(label) {
  names <- sort(loadedNamespaces())
  rows <- lapply(names, function(name) data.frame(name=name,
    version=as.character(getNamespaceVersion(name)),
    path=normalizePath(getNamespaceInfo(name,'path'),mustWork=TRUE)))
  write.csv(do.call(rbind, rows),file.path(output,paste0('r-',label,'-namespaces.csv')),row.names=FALSE)
  dlls <- getLoadedDLLs()
  rows <- lapply(dlls,function(item) {
    raw <- item[['path']]
    path <- if (identical(raw,'base')) raw else normalizePath(raw,mustWork=TRUE)
    data.frame(name=item[['name']],path=path,dynamic_lookup=item[['dynamicLookup']])
  })
  write.csv(do.call(rbind,rows),file.path(output,paste0('r-',label,'-dlls.csv')),row.names=FALSE)
}
snapshot('before')
for (name in c('local','regional','ppes','rings')) {
  table <- read.csv(file.path(input,paste0(name,'.csv')),check.names=FALSE)
  exact <- read.csv(file.path(input,paste0(name,'-hex.csv')),check.names=FALSE,colClasses='character')
  stopifnot(identical(names(exact), names(table)[vapply(table,is.numeric,logical(1))]))
  for (column in names(exact)) table[[column]] <- as.numeric(exact[[column]])
  assign(name,table)
  write.csv(table,file.path(output,paste0('r-input-',name,'.csv')),row.names=FALSE)
  writeLines(sprintf('%a',as.numeric(unlist(table[vapply(table,is.numeric,logical(1))],use.names=FALSE))),
    file.path(output,paste0('r-input-',name,'-hex.txt')))
}
hex <- read.csv(file.path(input,'candidates-hex.csv'),check.names=FALSE,colClasses='character')
CANDIDATES <- matrix(as.numeric(as.matrix(hex)),nrow=nrow(hex),ncol=ncol(hex))
stopifnot(identical(dim(CANDIDATES),c(32L,10L)),all(is.finite(CANDIDATES)))
writeLines(sprintf('%a',as.numeric(CANDIDATES)),file.path(output,'r-input-candidates-hex.txt'))
stopifnot(identical(names(local)[-1],as.character(ppes$Taxon)),identical(names(regional)[-1],as.character(ppes$Taxon)))
params <- list(ppes=ppes,fallspeed=ppes[,c('Taxon','fallspeed')],dBasinRegional=300,
  tBasinRegional='lake',dBasinLocal=12.9,tBasinLocal='lake',tBasin='lake',dwm='lsm unstable',error=FALSE)
OBJECTIVE_ROWS <- list()
CALL_NUMBER <- 0L
CONTEXT_ROWS <- list()
tracked_replay <- function(fn,lower,upper,control=list(),...) {
  stopifnot(identical(fn,F('tf')),identical(names(formals(fn)),
    c('a','vPoldepRegio','mKlocal','vFlocal','vSampleLocPro','ppes')))
  CALL_NUMBER <<- CALL_NUMBER+1L
  dots <- list(...)
  stopifnot(identical(sort(names(dots)),sort(c('vPoldepRegio','mKlocal','vFlocal','vSampleLocPro','ppes'))))
  for (name in c('vPoldepRegio','mKlocal','vFlocal','vSampleLocPro','ppes')) {
    vector <- as.numeric(dots[[name]])
    CONTEXT_ROWS[[length(CONTEXT_ROWS)+1L]] <<- data.frame(call=CALL_NUMBER,
      argument=name,index=seq_along(vector),value=vector)
  }
  candidate_number <- 0L
  logged <- function(candidate,...) {
    candidate_number <<- candidate_number+1L
    stopifnot(candidate_number<=32L,identical(as.numeric(candidate),as.numeric(CANDIDATES[candidate_number,])))
    value <- fn(candidate,...)
    stopifnot(length(value)==1L,is.numeric(value))
    OBJECTIVE_ROWS[[length(OBJECTIVE_ROWS)+1L]] <<- data.frame(call=CALL_NUMBER,candidate=candidate_number,value=value)
    value
  }
  result <- replay_de_traced(logged,lower,upper,control,...)
  stopifnot(candidate_number==32L)
  result
}
result <- with_binding('RcppDE','DEoptim',tracked_replay,
  clone_with('LOVEoptim',list(REVEALSinR=fixed_reveals,rmultinom=fixed_multinomial))(
    local,regional,params,rings,10,repeats=2))
write.csv(result$cover$mean,file.path(output,'r-cover.csv'),row.names=FALSE,na='NaN')
write.csv(result$pollenpercentages$mean,file.path(output,'r-pollen.csv'),row.names=FALSE,na='NaN')
write.csv(result$mBestValue,file.path(output,'r-objective.csv'),row.names=FALSE,na='NaN')
