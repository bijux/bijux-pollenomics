write.csv(as.data.frame(do.call(rbind,REPLAY_TRACE)),file.path(output,'r-trace.csv'),row.names=FALSE)
write.csv(do.call(rbind,OBJECTIVE_ROWS),file.path(output,'r-candidate-objectives.csv'),row.names=FALSE,na='NaN')
write.csv(do.call(rbind,CONTEXT_ROWS),file.path(output,'r-objective-contexts.csv'),row.names=FALSE,na='NaN')
