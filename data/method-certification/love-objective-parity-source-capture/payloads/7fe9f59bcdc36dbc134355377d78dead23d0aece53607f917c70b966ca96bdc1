def table(path: Path) -> tuple[list[str], list[list[str]]]:
    with path.open(newline="") as stream:
        reader = csv.reader(stream)
        rows = list(reader)
    require(
        bool(rows) and bool(rows[0]) and len(set(rows[0])) == len(rows[0]),
        "CSV header differs",
    )
    require(all(len(row) == len(rows[0]) for row in rows[1:]), "Ragged CSV")
    return rows[0], rows[1:]


def number(value: str) -> float:
    require(value == value.strip() and value != "", "Blank/whitespace numeric cell")
    return float(value)


def same_number(left: float, right: float) -> bool:
    if math.isnan(left) or math.isnan(right):
        return math.isnan(left) and math.isnan(right)
    if math.isinf(left) or math.isinf(right):
        return left == right
    return abs(left - right) <= float(CONTRACT["absolute_tolerance"]) + float(
        CONTRACT["relative_tolerance"]
    ) * abs(right)


def selected(values: list[float]) -> int:
    valid = [
        (value, index + 1) for index, value in enumerate(values) if math.isfinite(value)
    ]
    require(bool(valid), "All replay candidates undefined")
    return min(valid)[1]


def objective_comparison(
    r_values: list[float], python_values: list[float]
) -> list[dict[str, Any]]:
    require(
        len(r_values) == len(python_values) == 256, "Not all 8x32 objectives retained"
    )
    result = []
    for call in range(8):
        r = r_values[call * 32 : (call + 1) * 32]
        p = python_values[call * 32 : (call + 1) * 32]
        require(
            all(same_number(x, y) for x, y in zip(r, p, strict=True)),
            "Per-vector objective mismatch",
        )
        require(selected(r) == selected(p), "Selected candidate differs")
        result.append(
            {
                "call": call + 1,
                "vectors_compared": 32,
                "selected_index_one_based": selected(r),
                "maximum_absolute_finite_error": max(
                    (
                        abs(x - y)
                        for x, y in zip(r, p, strict=True)
                        if math.isfinite(x) and math.isfinite(y)
                    ),
                    default=None,
                ),
            }
        )
    return result


def context_comparison(
    rows: list[list[str]], contexts: list[dict[str, Any]]
) -> dict[str, Any]:
    require(len(contexts) == 8, "Objective context call membership differs")
    expected: list[tuple[str, str, str, float]] = []
    for call, context in enumerate(contexts, 1):
        require(
            list(context)
            == ["vPoldepRegio", "mKlocal", "vFlocal", "vSampleLocPro", "ppes"],
            "Objective argument names/order differ",
        )
        for argument, values in context.items():
            expected.extend(
                (str(call), argument, str(index), float.fromhex(value))
                for index, value in enumerate(values, 1)
            )
    require(len(rows) == len(expected), "Objective context scalar membership differs")
    for row, (call_id, argument, scalar_index, value) in zip(
        rows, expected, strict=True
    ):
        require(
            len(row) == 4
            and row[:3] == [call_id, argument, scalar_index]
            and same_number(number(row[3]), value),
            "Objective source argument differs",
        )
    return {
        "calls": 8,
        "argument_names": [
            "vPoldepRegio",
            "mKlocal",
            "vFlocal",
            "vSampleLocPro",
            "ppes",
        ],
        "scalar_pairs": len(expected),
    }


def numeric_product(
    left: Path, right: Path, shape: tuple[int, int], fields: list[str]
) -> dict[str, Any]:
    lh, lr = table(left)
    rh, rr = table(right)
    require(
        lh == rh == fields and len(lr) == len(rr) == shape[0] and len(lh) == shape[1],
        "Complete output axes/shape differ",
    )
    pairs = [
        (number(x), number(y))
        for a, b in zip(lr, rr, strict=True)
        for x, y in zip(a, b, strict=True)
    ]
    require(all(same_number(x, y) for x, y in pairs), "Output scalar/NaN mask differs")
    return {
        "R": pin(left),
        "Python": pin(right),
        "shape": list(shape),
        "finite_pairs": sum(math.isfinite(x) and math.isfinite(y) for x, y in pairs),
        "NaN_pairs": sum(math.isnan(x) and math.isnan(y) for x, y in pairs),
        "maximum_absolute_finite_error": max(
            (abs(x - y) for x, y in pairs if math.isfinite(x) and math.isfinite(y)),
            default=None,
        ),
    }


def shared_inputs(directory: Path, input_root: Path | None = None) -> dict[str, Any]:
    input_root = directory / "input" if input_root is None else input_root
    records = {}
    for name in INPUT_NAMES:
        headers, rows = table(input_root / (name + ".csv"))
        hh, hexrows = table(input_root / (name + "-hex.csv"))
        require(
            len(rows) == len(hexrows) and set(hh) <= set(headers),
            "Input hex axes differ",
        )
        numeric = {column: i for i, column in enumerate(headers) if column in hh}
        exacts: dict[str, list[float]] = {column: [] for column in hh}
        for row, hexadecimal in zip(rows, hexrows, strict=True):
            for column, cell in zip(hh, hexadecimal, strict=True):
                value = float.fromhex(cell)
                require(
                    math.isfinite(value) and number(row[numeric[column]]) == value,
                    "Decimal/hex source mismatch",
                )
                exacts[column].append(value)
        flat = [v for column in hh for v in exacts[column]]
        native = [
            float.fromhex(line)
            for line in (directory / "r" / ("r-input-" + name + "-hex.txt"))
            .read_text()
            .splitlines()
        ]
        require(flat == native, "R did not parse the identical binary64 inputs")
        if name == "candidates":
            require(
                headers == hh == [str(i) for i in range(10)] and len(rows) == 32,
                "32x10 candidate axes differ",
            )
            require(
                all(0 <= x <= 1 for x in flat) and len(set(flat)) == 320,
                "Candidate bounds/uniqueness differ",
            )
        else:
            native_headers, native_rows = table(
                directory / "r" / ("r-input-" + name + ".csv")
            )
            require(
                native_headers == headers and len(native_rows) == len(rows),
                "Native input axes differ",
            )
            for row, native_row in zip(rows, native_rows, strict=True):
                require(
                    all(
                        row[i] == native_row[i]
                        for i, column in enumerate(headers)
                        if column not in hh
                    ),
                    "Native textual source cells differ",
                )
        records[name] = {
            "rows": len(rows),
            "headers": headers,
            "numeric_headers": hh,
            "binary64_values_compared": len(flat),
        }
    return records


def runtime_observation(plan: dict[str, Any], directory: Path) -> dict[str, Any]:
    pins = {row["path"]: row for row in plan["retained_R_plan"]["input_pins"]}
    library_paths = (directory / "r" / "r-library-paths.txt").read_text().splitlines()
    base = "/Library/Frameworks/R.framework/Versions/4.6/Resources/library"
    require(library_paths == [str(R_LIBRARY), base], "Unexpected R library search root")
    snapshots = {}
    for label in ("before", "after"):
        fields, rows = table(directory / "r" / ("r-" + label + "-namespaces.csv"))
        require(fields == ["name", "version", "path"], "R namespace schema changed")
        require(len(rows) == len({row[0] for row in rows}), "Duplicate R namespace")
        observed = {row[0]: row[1] for row in rows}
        require(
            observed.get("disqover") == "0.9.14",
            "Actual disqover source namespace absent",
        )
        if label == "after":
            require("RcppDE" in observed, "Actual source optimizer namespace absent")
        for name, version, raw in rows:
            path = Path(raw)
            require(
                path.parent in (R_LIBRARY, Path(base)) and path.name == name,
                "R namespace origin escaped qualified library",
            )
            description = path / "DESCRIPTION"
            require(
                str(description) in pins and pin(description) == pins[str(description)],
                "Namespace DESCRIPTION unprotected",
            )
            from r_runtime_contracts import description as parse_description

            declared = parse_description(description.read_text())
            require(
                declared["Package"] == name and declared["Version"] == version,
                "Literal namespace version differs from protected source",
            )
        fields, dlls = table(directory / "r" / ("r-" + label + "-dlls.csv"))
        require(
            fields == ["name", "path", "dynamic_lookup"]
            and len(dlls) == len({r[0] for r in dlls}),
            "R loaded DLL schema/uniqueness differs",
        )
        for name, raw, _ in dlls:
            if raw == "base":
                require(name == "base", "Only builtin base has no physical DLL")
                continue
            path = Path(raw)
            require(
                path.name not in {"R_X11.so", "cairo.so", "R_de.so"},
                "Identity-only graphics DLL loaded",
            )
            require(
                str(path) in pins and pin(path) == pins[str(path)],
                "Unprotected R loaded DLL",
            )
        snapshots[label] = {"namespace_count": len(rows), "DLL_count": len(dlls)}
    return {
        "library_paths": library_paths,
        "snapshots": snapshots,
        "scope": "Observed before/after R namespace and getLoadedDLLs origins. No complete transient OS dyld image census claim.",
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = checked_plan(args.plan)
    directory = Path(plan["output"])
    shared = load(Path(plan["shared_input_manifest"]))
    input_root = Path(plan["shared_input_root"])
    require(
        type(shared.get("actual_exit")) is int
        and shared["actual_exit"] == 0
        and shared["candidate"] == plan["candidate"]
        and shared["contract"] == CONTRACT,
        "Shared exporter identity/contract differs",
    )
    expected_files = [
        input_root / (name + suffix)
        for name in INPUT_NAMES
        for suffix in (".csv", "-hex.csv")
    ]
    expected_files.sort()
    require(
        shared["files"] == [pin(path) for path in expected_files],
        "Shared inputs changed after export",
    )
    inputs = shared_inputs(directory, input_root)
    py = load(directory / "python/python-trace.json")
    require(
        type(py.get("actual_exit")) is int and py["actual_exit"] == 0,
        "Python source trace did not pass",
    )
    protected = {row["path"]: row for row in plan["input_pins"]}
    for origin_document in (shared, py):
        for key in ("source_origins", "dependency_origins"):
            require(
                bool(origin_document[key]), "Actual source/dependency origins missing"
            )
            modules = [row["module"] for row in origin_document[key]]
            require(len(modules) == len(set(modules)), "Repeated actual module origin")
            for record in origin_document[key]:
                row = {key: record[key] for key in ("path", "sha256", "bytes")}
                require(
                    protected.get(row["path"]) == row and pin(Path(row["path"])) == row,
                    "Actual module origin not protected",
                )
    fields, rows = table(directory / "r/r-candidate-objectives.csv")
    require(fields == ["call", "candidate", "value"], "Native objective table schema")
    require(
        [(int(r[0]), int(r[1])) for r in rows]
        == [(c, k) for c in range(1, 9) for k in range(1, 33)],
        "Per-vector R membership/order differs",
    )
    values = [number(r[2]) for r in rows]
    python_values = [float.fromhex(x) for x in py["objective_values_binary64"]]
    calls = objective_comparison(values, python_values)
    fields, contexts = table(directory / "r/r-objective-contexts.csv")
    require(
        fields == ["call", "argument", "index", "value"],
        "Objective context schema differs",
    )
    context_review = context_comparison(contexts, py["objective_contexts_binary64"])
    _, candidate_rows = table(input_root / "candidates-hex.csv")
    require(
        py["candidate_vectors_binary64"] == candidate_rows * 8,
        "Actual Python candidate sequence differs",
    )
    fields, trace = table(directory / "r/r-trace.csv")
    require(
        fields == ["bestval", "iter", "nfev", "success", "best_index"]
        and len(trace) == len(py["diagnostics"]) == 8,
        "Optimizer trace axes differ",
    )
    for call, raw, diagnostic in zip(calls, trace, py["diagnostics"], strict=True):
        require(
            int(raw[4]) == diagnostic["best_index"] == call["selected_index_one_based"]
            and int(raw[2]) == diagnostic["nfev"] == 32
            and number(raw[1]) == number(raw[3]) == 1
            and diagnostic["algorithm"] == "candidate-replay"
            and same_number(number(raw[0]), float.fromhex(diagnostic["bestval"])),
            "Incomplete/different optimizer trace",
        )
    taxa = inputs["local"]["headers"][1:]
    products = {}
    for name, shape, headers in [
        ("cover", (10, 10), taxa),
        ("pollen", (10, 10), taxa),
        ("objective", (10, 2), ["1", "2"]),
        ("k", (inputs["rings"]["rows"], 10), taxa),
    ]:
        products[name] = numeric_product(
            directory / "r" / ("r-" + name + ".csv"),
            directory / "python" / ("python-" + name + ".csv"),
            shape,
            headers,
        )
    dump(
        directory / "independent-review.json",
        {
            "actual_exit": 0,
            "candidate": plan["candidate"],
            "numerical_contract": CONTRACT,
            "shared_inputs": inputs,
            "per_call_objectives": calls,
            "objective_argument_comparison": context_review,
            "products": products,
            "R_runtime_origins": runtime_observation(plan, directory),
            "actual_R_command": plan["stages"][0]["argv"],
            "actual_Python_command": plan["stages"][1]["argv"],
            "old56_source_gate_waived": False,
            "historical_performance_reproduced": False,
            "new_CPP_adopted": False,
            "optimizer_convergence_tested": False,
            "scope": CONTRACT["scope"],
        },
    )


if __name__ == "__main__":
    main()
