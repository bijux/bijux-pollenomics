        require(
            not path.is_symlink() and (path.is_file() or path.is_dir()),
            "Controller special/alias",
        )
        require(
            not path.is_dir() or path.name == "preflight",
            "Unknown controller directory",
        )
        if path.suffix in {".py", ".pyc", ".so"}:
            require(path.name in MODULES, "Unknown controller import")


def output_root(path: Path, *, absent: bool = False) -> Path:
    require(
        path.is_absolute()
        and ".." not in path.parts
        and path == path.resolve()
        and path.is_relative_to(ROOT / "artifacts")
        and path != ROOT / "artifacts"
        and not path.is_relative_to(SOURCE)
        and not SOURCE.is_relative_to(path)
        and not any(p.is_symlink() for p in (path, *path.parents)),
        "Unconfined output",
    )
    if absent:
        require(not path.exists() and not path.is_symlink(), "Output already exists")
    return path


def union(*groups: list[dict[str, Any]]) -> list[dict[str, Any]]:
    rows: dict[str, dict[str, Any]] = {}
    for group in groups:
        for row in group:
            require(
                set(row) == {"path", "sha256", "bytes"} and type(row["bytes"]) is int,
                "Malformed protected pin",
            )
            require(
                row["path"] not in rows or rows[row["path"]] == row, "Conflicting pin"
            )
            rows[row["path"]] = dict(row)
    return [rows[k] for k in sorted(rows)]


def git_environment(environment: dict[str, str]) -> dict[str, str]:
    clean = {
        key: value for key, value in environment.items() if not key.startswith("GIT_")
    }
    clean.update(
        GIT_OPTIONAL_LOCKS="0", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull
    )
    return clean


def identity() -> dict[str, str]:
    require(pin(GIT) == GIT_PIN, "Pinned physical Git tool changed")

    def git(*args: str) -> bytes:
        return subprocess.check_output(
            [str(GIT), *args],
            cwd=ROOT,
            timeout=60,
            env=git_environment(dict(os.environ)),
        )

    require(git("branch", "--show-current").strip() == b"main", "Local main required")
    return {
        "candidate": git("rev-parse", "HEAD").decode().strip(),
        "status": git("status", "--porcelain").decode(),
        "tracked_inventory_sha256": hashlib.sha256(
            git("ls-files", "-s", "-z")
        ).hexdigest(),
    }


def first_party_snapshot() -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    trees: list[dict[str, Any]] = []
    files: list[dict[str, Any]] = []
    for root in PACKAGE_ROOTS:
        tree = namespace_snapshot(root, [])
        require(
            all(row["kind"] != "symlink" for row in tree["entries"].values()),
            "Source alias",
        )
        trees.append(tree)
        files.extend(
            pin(root / name)
            for name, row in tree["entries"].items()
            if row["kind"] == "file"
        )
    return trees, files


def r_authority() -> tuple[dict[str, Any], list[dict[str, Any]], dict[str, Any]]:
    """Authenticate the genuine saved namespace observer, never reinstall R."""
    from r_runtime_contracts import verify_inputs as verify_r_inputs

    refs = [pin(R_AUTHORITY / name) for name in R_REFS]
    require(
        all(row["sha256"] == R_REFS[Path(row["path"]).name] for row in refs),
        "R authority changed",
    )
    saved = load(R_AUTHORITY / "plan.json")
    for name in (
        "terminal.json",
        "R-namespace-terminal.json",
        "independent-namespace-review.json",
    ):
        value = load(R_AUTHORITY / name)
        require(
            type(value.get("actual_exit")) is int and value["actual_exit"] == 0,
            "R observer not zero",
        )
    review = load(R_AUTHORITY / "independent-namespace-review.json")
    require(
        review.get("candidate") == saved["candidate"], "R observation epoch mismatch"
    )
    verify_r_inputs(saved)
    require(len(saved["input_pins"]) == 52393, "R full observed input count changed")
    return (
        {
            "references": refs,
            "observed_candidate": saved["candidate"],
            "library": str(R_LIBRARY),
            "full_observed_inputs": 52393,
            "installed_files": 918,
            "old_installation_whole_exit": 1,
            "fresh_saved_namespace_observer_exit": 0,
            "old913_identity_recovered": False,
        },
        union(refs, saved["input_pins"]),
        saved,
    )


def verify_inputs(plan: dict[str, Any]) -> None:
    namespace()
    require(
        plan["numerical_contract"] == CONTRACT, "Registered numerical contract changed"
    )
    for row in plan["input_pins"]:
        verify_pin(row)
    verify_base_namespaces(plan["first_party_namespaces"])
    verify_absences(plan["absent_input_paths"])
    from r_runtime_contracts import verify_inputs as verify_r_inputs

    verify_r_inputs(plan["retained_R_plan"])
    from retained_export import ORIGINAL, verify_input_directory

    verify_input_directory(
        Path(plan["shared_input_root"]),
        plan["retained_shared_export"]["retained_input_files"],
    )
    require(
        not (ORIGINAL / "python").exists() and not (ORIGINAL / "python").is_symlink(),
        "Old Python stage remains absent",
    )
    require(
        (ORIGINAL / "r").is_dir()
        and not (ORIGINAL / "r").is_symlink()
        and list((ORIGINAL / "r").iterdir()) == [],
        "Old failed R output changed",
    )


def checked_plan(path: Path) -> dict[str, Any]:
    namespace()
    plan = load(path)
    require(
        plan["numerical_contract"] == CONTRACT and plan["repository"] == str(ROOT),
        "Plan contract/root changed",
    )
    output_root(Path(plan["output"]))
    for row in plan["held_control_pins"]:
        require(pin(Path(row["path"])) == row, "Frozen controller changed")
    return plan
