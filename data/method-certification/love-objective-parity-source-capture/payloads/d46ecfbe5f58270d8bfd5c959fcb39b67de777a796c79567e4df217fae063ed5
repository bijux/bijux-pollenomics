def require(value: object, message: str) -> None:
    if not value:
        raise ValueError(message)


def sha(path: Path) -> str:
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def pin(path: Path) -> dict[str, Any]:
    require(
        path.is_absolute()
        and ".." not in path.parts
        and path == path.resolve()
        and not any(p.is_symlink() for p in (path, *path.parents))
        and path.is_file(),
        "Physical regular source required: " + str(path),
    )
    return {"path": str(path), "sha256": sha(path), "bytes": path.stat().st_size}


def load(path: Path) -> dict[str, Any]:
    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        require(len(rows) == len({k for k, _ in rows}), "Duplicate JSON key")
        return dict(rows)

    def constant(value: str) -> None:
        raise ValueError("Nonfinite JSON: " + value)

    value = json.loads(
        path.read_bytes(), object_pairs_hook=pairs, parse_constant=constant
    )
    require(isinstance(value, dict), "JSON object required")
    assert isinstance(value, dict)
    return value


def dump(path: Path, value: object) -> None:
    require(not path.exists() and not path.is_symlink(), "No receipt overwrite")
    with path.open("x") as stream:
        stream.write(json.dumps(value, indent=2, allow_nan=False) + "\n")


def namespace() -> None:
