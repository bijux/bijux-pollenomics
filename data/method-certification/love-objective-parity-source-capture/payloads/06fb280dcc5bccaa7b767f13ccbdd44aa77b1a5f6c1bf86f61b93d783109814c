"""Read-only structural correspondence to the qualified R namespace probe."""

import hashlib
import json
from pathlib import Path
import re

A = Path(__file__).absolute().parent.parent
O = A.parent / "love-installed-source-parity"
R = A.parents[2]
PROBE = R / "artifacts/science/offline-r-namespace-version-custody/observe_namespaces.R"


def require(value: object, message: str) -> None:
    if not value:
        raise ValueError(message)


def compact(text: str) -> str:
    return re.sub(r"\s+", "", text).replace('"', "'")


def validate(new: str, old: str, probe: str) -> None:
    begin = "snapshot <- function(label) {"
    end = "snapshot('before')"
    old_head, old_remaining = old.split(begin, 1)
    _, old_body = old_remaining.split(end, 1)
    new_head, new_remaining = new.split(begin, 1)
    snapshot, new_body = new_remaining.split(end, 1)
    require(new_head == old_head, "Package/source/input preamble changed")
    require(
        new_body
        == old_body.replace(
            "writeLines(capture.output(sessionInfo()),file.path(output,'r-session.txt'))\n",
            "",
        ),
        "Numerical R body or output contract changed",
    )
    p, s = compact(probe), compact(snapshot)
    path = "if(identical(name,'base'))file.path(R.home('library'),'base')elsegetNamespaceInfo(name,'path')"
    version = "if(identical(name,'base'))as.character(getRversion())elseas.character(getNamespaceVersion(name))"
    for fragment in (path, version):
        require(
            fragment in p and fragment in s,
            "Qualified base/nonbase special case differs",
        )
    require(
        s.index("session<-capture.output(sessionInfo())")
        < s.index("loadedNamespaces()")
        < s.index("getLoadedDLLs()"),
        "Session must precede both origin snapshots",
    )
    require(s.count("sessionInfo()") == 1, "Duplicate session snapshot")
    require(
        "raw<-item[['path']]" in s and "name=item[['name']]" in s,
        "Qualified DLL item fields differ",
    )
    require("dynamic_lookup=item[['dynamicLookup']]" in s, "DLL lookup field differs")
    require(
        "built_in<-identical(item[['name']],'base')&&identical(raw,'base')" in s,
        "Builtin DLL requires both exact name and path",
    )
    require(
        "path<-if(built_in)'base'elsenormalizePath(raw,mustWork=TRUE)" in s,
        "Nonbuiltin DLL physical origin required",
    )
    require(
        "writeLines(session,file.path(output,'r-session.txt'))" in s,
        "Session receipt must use captured session",
    )
    require("sessionInfo()" not in new_body, "Session invoked after final DLL snapshot")
    require(
        "dll[['path']]" in p and "dll[['dynamicLookup']]" in p,
        "Known probe DLL field evidence missing",
    )


def main() -> None:
    old, new, probe = (
        (O / "replay.R").read_text(),
        (A / "replay.R").read_text(),
        PROBE.read_text(),
    )
    validate(new, old, probe)
    mutations = [
        ("file.path(R.home('library'),'base')", "getNamespaceInfo(name,'path')"),
        ("as.character(getRversion())", "as.character(getNamespaceVersion(name))"),
        ("session <- capture.output(sessionInfo())", "session <- character()"),
        ("item[['dynamicLookup']]", "item$dynamicLookup"),
        ("identical(item[['name']],'base') && ", ""),
        ("normalizePath(raw,mustWork=TRUE)", "raw"),
        ("c(32L,10L)", "c(31L,10L)"),
        ("snapshot('after')", "snapshot('after')\nsessionInfo()"),
    ]
    for before, after in mutations:
        require(before in new, "Mutation did not select actual source")
        try:
            validate(new.replace(before, after), old, probe)
        except (ValueError, IndexError):
            continue
        raise ValueError("Unsafe source mutation accepted: " + before)
    correspondence = json.loads(
        (A / "namespace-source-correspondence.json").read_bytes()
    )
    require(
        hashlib.sha256(PROBE.read_bytes()).hexdigest()
        == correspondence["qualified_probe"]["sha256"],
        "Qualified probe source changed",
    )
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "groups": 10,
                "positive_actual_driver": True,
                "unsafe_mutations_refused": len(mutations),
                "qualified_probe_sha256": correspondence["qualified_probe"]["sha256"],
                "numerical_R_body_exact": True,
                "R_or_model_or_runtime_census_called": False,
            }
        )
    )


if __name__ == "__main__":
    main()
