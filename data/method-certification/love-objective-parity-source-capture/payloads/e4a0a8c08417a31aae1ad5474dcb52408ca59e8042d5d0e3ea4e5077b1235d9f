_entry_path = Path(__file__).absolute()
if _entry_path != _entry_path.resolve() or any(
    p.is_symlink() for p in (_entry_path, *_entry_path.parents)
):
    raise ValueError("Physical controller entrypoint required before helper imports")
_entry_directory = _entry_path.parent
_expected_python = {
    "check_contracts.py",
    "prepare.py",
    "common_runner.py",
    "observe.py",
    "produce.py",
    "runtime_contracts.py",
    "r_runtime_contracts.py",
    "source_runtime.py",
    "run.py",
    "contracts.py",
    "runtime_guarded_runner.py",
}
for _entry in _entry_directory.iterdir():
    if _entry.is_symlink() or not (_entry.is_file() or _entry.is_dir()):
        raise ValueError("Controller alias/special entry")
    if _entry.is_dir() and _entry.name != "preflight":
        raise ValueError("Unexpected controller directory")
    if _entry.suffix in {".py", ".pyc", ".so"} and _entry.name not in _expected_python:
        raise ValueError("Unexpected controller import")

sys.path.insert(0, str(_entry_directory))

from contracts import (  # noqa: E402 - authenticate local helpers before importing.
    CONTRACT,
    MODULES,
    SOURCE,
    output_root,
    require,
    union,
)
from observe import (  # noqa: E402 - authenticate local helpers before importing.
    context_comparison,
    number,
    objective_comparison,
    same_number,
    selected,
    shared_inputs,
    table,
)
from run import (  # noqa: E402 - guarded local namespace.
    accounted_receipt,  # noqa: E402 - authenticate local helpers before importing.
)


@contextmanager
def refused() -> Iterator[None]:
    try:
        yield
    except (ValueError, FileNotFoundError, AssertionError):
        return
    raise AssertionError("Expected fail-closed refusal")


def prefix(tree: Path, name: str) -> None:
    """Exercise actual entrypoint statements through the guarded helper boundary."""
    path = tree / name
    module = ast.parse(path.read_bytes())
    nodes = []
    for node in module.body:
        if isinstance(node, ast.ImportFrom) and node.module in {
            "contracts",
            "source_runtime",
        }:
            break
        nodes.append(node)
    code = compile(
        ast.fix_missing_locations(ast.Module(body=nodes, type_ignores=[])),
        str(path),
        "exec",
    )
    exec(code, {"__file__": str(path), "__name__": "entrypoint_source_guard"})


def main() -> None:
    passed = []
    directory = SOURCE / "preflight"
    directory.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(dir=directory, prefix="parity-guards-") as raw:
        root = Path(raw)
        values = [float(i + 1) for i in range(32)] * 8
        result = objective_comparison(values, values.copy())
        require(
            len(result) == 8
            and all(x["selected_index_one_based"] == 1 for x in result),
            "Positive objectives",
        )
        passed.append("all256_independent_objective_pairs_and_eight_selections")
        for name, changed in [
            ("missing_vector", values[:-1]),
            ("wrong_objective", values[:-1] + [99.0]),
        ]:
            with refused():
                objective_comparison(values, changed)
            passed.append(name)
        # A tolerance-close value can still reverse the exact selected candidate.
        r = [1.0, 1.0 + 1e-11] + [10.0] * 30
        p = [1.0 + 1e-11, 1.0] + [10.0] * 30
        with refused():
            objective_comparison(r * 8, p * 8)
        passed.append("selection_change_inside_scalar_tolerance_refused")
        require(selected([2.0, 2.0, math.inf]) == 1, "First tie must win")
        passed.append("first_finite_minimum_tie")
        for cells in ([math.nan] * 32, [math.inf] * 32, [-math.inf] * 32):
            with refused():
                selected(cells)
        passed.append("all_nonfinite_candidates_refused")
        require(
            same_number(math.nan, math.nan)
            and not same_number(math.nan, 0)
            and not same_number(math.inf, -math.inf),
            "Nonfinite classification",
        )
        passed.append("NaN_and_signed_infinity_masks_exact")
        require(
            same_number(1.0, 1 + 1e-12) and not same_number(1.0, 1 + 1e-5),
            "Declared scalar tolerance",
        )
        passed.append("predeclared_absolute_relative_tolerance_boundary")
        for value in ("", " 1", "1 "):
            with refused():
                number(value)
        passed.append("blank_and_whitespace_numeric_refusal")
        csv_path = root / "data.csv"
        csv_path.write_text("a,a\n1,2\n")
        with refused():
            table(csv_path)
        csv_path.write_text("a,b\n1\n")
        with refused():
            table(csv_path)
        passed.append("duplicate_header_and_ragged_csv_refusal")
        row = {"path": "/protected/input", "sha256": "a" * 64, "bytes": 5}
        require(union([row], [row]) == [row], "Identical roles deduplicate")
        with refused():
            union([row], [{**row, "sha256": "b" * 64}])
        with refused():
            union([row], [{**row, "bytes": True}])
        passed.append("identical_pin_union_and_conflicting_or_boolean_size_refusal")
        for candidate in (SOURCE / "child/../../escape", SOURCE / "owned-output"):
            with refused():
                output_root(candidate)
        passed.append("output_traversal_and_source_overlap_refusal")
        out = root / "outputs"
        out.mkdir()
        (out / "payload").write_bytes(b"12345")
        encoded = accounted_receipt(out, {"actual_exit": 0}, 1024)
        require(
            json.loads(encoded)["completed_output_bytes_including_receipt"]
            == len(encoded) + 5,
            "Inclusive receipt",
        )
        with refused():
            accounted_receipt(out, {"actual_exit": 0}, 5)
        passed.append("inclusive_output_receipt_and_over_budget_refusal")
        os.mkfifo(out / "pipe")
        with refused():
            accounted_receipt(out, {"actual_exit": 0}, 1024)
        (out / "pipe").unlink()
        passed.append("FIFO_output_refused")
        (out / "link").symlink_to(out / "payload")
        with refused():
            accounted_receipt(out, {"actual_exit": 0}, 1024)
        (out / "link").unlink()
        passed.append("output_alias_refused")
        copied = root / "controllers"
        copied.mkdir()
        for name in MODULES:
            shutil.copyfile(SOURCE / name, copied / name)
        for entry in (
            "prepare.py",
            "run.py",
            "produce.py",
            "observe.py",
            "runtime_guarded_runner.py",
        ):
            prefix(copied, entry)
        passed.append(
            "actual_five_entrypoint_prefixes_accept_complete_helper_namespace"
        )
        for name in ("extra.py", "extra.pyc", "extra.so"):
            (copied / name).write_bytes(b"not imported")
            for entry in (
                "prepare.py",
                "run.py",
                "produce.py",
                "observe.py",
                "runtime_guarded_runner.py",
            ):
                with refused():
                    prefix(copied, entry)
            (copied / name).unlink()
        passed.append("all_five_entrypoints_refuse_unknown_importable_members")
        os.mkfifo(copied / "unexpected")
        with refused():
            prefix(copied, "prepare.py")
        (copied / "unexpected").unlink()
        (copied / "empty").mkdir()
        with refused():
            prefix(copied, "prepare.py")
        (copied / "empty").rmdir()
        (copied / "linked.py").symlink_to(copied / "contracts.py")
        with refused():
            prefix(copied, "prepare.py")
        (copied / "linked.py").unlink()
        passed.append("preimport_FIFO_empty_directory_and_alias_refused")
        synthetic = root / "synthetic-shared"
        (synthetic / "input").mkdir(parents=True)
        (synthetic / "r").mkdir()
        import contracts as source_contracts

        env = source_contracts.git_environment(
            {"GIT_DIR": "/shadow", "GIT_CONFIG_GLOBAL": "/wrong", "HOME": "untouched"}
        )
        require(
            env.get("HOME") == "untouched"
            and "GIT_DIR" not in env
            and env["GIT_CONFIG_GLOBAL"] == "/dev/null"
            and env["GIT_CONFIG_NOSYSTEM"] == "1",
            "Isolated Git environment",
        )
        calls: list[list[str]] = []

        def fake_git(argv: list[str], **kwargs: Any) -> bytes:
            require(
                argv[0] == str(source_contracts.GIT),
                "Git must use absolute qualified tool",
            )
            require(
                kwargs["env"]["GIT_CONFIG_GLOBAL"] == "/dev/null",
                "Git global config not disabled",
            )
            calls.append(argv)
            if argv[1:] == ["branch", "--show-current"]:
                return b"main\n"
            if argv[1:] == ["rev-parse", "HEAD"]:
                return b"controlled-candidate\n"
            return b""

        with (
            patch.object(
                source_contracts, "pin", return_value=source_contracts.GIT_PIN
            ),
            patch.object(subprocess, "check_output", side_effect=fake_git),
        ):
            canonical = source_contracts.identity()
            require(
                set(canonical) == {"candidate", "status", "tracked_inventory_sha256"}
                and len(calls) == 4,
                "Common906 identity schema must remain exact",
            )
        with (
            patch.object(
                source_contracts, "pin", return_value=source_contracts.GIT_PIN
            ),
            patch.object(
                subprocess,
                "check_output",
                return_value=b"other-branch\n",
            ),
            refused(),
        ):
            source_contracts.identity()
        passed.append(
            "absolute_pinned_Git_main_branch_config_isolation_no_actual_Git_execution"
        )
        data: list[list[Any]]
        for name in ("local", "regional", "ppes", "rings", "candidates"):
            if name == "candidates":
                headers = [str(i) for i in range(10)]
                data = [[float(i * 10 + j) / 319 for j in range(10)] for i in range(32)]
                numeric_headers = headers
                exact = [[value.hex() for value in row] for row in data]
                numeric_data = data
            else:
                headers = ["label", "x"]
                data = [["synthetic", 1.25]]
                numeric_headers = ["x"]
                exact = [[(1.25).hex()]]
                numeric_data = [[1.25]]
            for target, fieldnames, body in (
                (synthetic / "input" / (name + ".csv"), headers, data),
                (synthetic / "input" / (name + "-hex.csv"), numeric_headers, exact),
                (synthetic / "r" / ("r-input-" + name + ".csv"), headers, data),
            ):
                with target.open("w", newline="") as stream:
                    writer = csv.writer(stream)
                    writer.writerow(fieldnames)
                    writer.writerows(body)
            native = [
                float(row[column]).hex()
                for column in range(len(numeric_headers))
                for row in numeric_data
            ]
            (synthetic / "r" / ("r-input-" + name + "-hex.txt")).write_text(
                "\n".join(native) + "\n"
            )
        require(
            shared_inputs(synthetic)["candidates"]["binary64_values_compared"] == 320,
            "Synthetic full hex input pipeline",
        )
        target = synthetic / "r/r-input-candidates-hex.txt"
        original = target.read_text()
        target.write_text(
            (0.25).hex() + "\n" + "\n".join(original.splitlines()[1:]) + "\n"
        )
        with refused():
            shared_inputs(synthetic)
        target.write_text(original)
        target = synthetic / "input/local.csv"
        target.write_text("label,x\nmutated,1.25\n")
        with refused():
            shared_inputs(synthetic)
        passed.append(
            "complete_synthetic_shared_decimal_hex_pipeline_and_native_bit_text_mutations"
        )
        # Exercise the exact reviewed-entry functions from every native entrypoint.
        for entry in (
            "prepare.py",
            "run.py",
            "produce.py",
            "observe.py",
            "runtime_guarded_runner.py",
        ):
            tree = ast.parse((SOURCE / entry).read_bytes())
            functions: list[ast.stmt] = [
                n
                for n in tree.body
                if isinstance(n, ast.FunctionDef)
                and n.name in {"_verify_entry_namespace", "_verify_reviewed_entry"}
            ]
            require(len(functions) == 2, "Actual reviewed-entry definitions missing")
            scope: dict[str, Any] = {"Path": Path, "json": json, "hashlib": hashlib}
            exec(
                compile(
                    ast.Module(body=functions, type_ignores=[]),
                    "actual-entry-controls",
                    "exec",
                ),
                scope,
            )
            rows = [
                {
                    "path": str(copied / name),
                    "sha256": hashlib.sha256((copied / name).read_bytes()).hexdigest(),
                    "bytes": (copied / name).stat().st_size,
                }
                for name in sorted(MODULES)
            ]
            manifest = json.dumps({"source_only": True, "files": rows}).encode()
            (copied / "prepared-source-manifest.json").write_bytes(manifest)
            peer = {
                "approved": True,
                "source_manifest_sha256": hashlib.sha256(manifest).hexdigest(),
            }
            (copied / "independent-source-review.json").write_text(json.dumps(peer))
            scope["_verify_entry_namespace"](copied)
            scope["_verify_reviewed_entry"](copied)
            target = copied / "contracts.py"
            saved = target.read_bytes()
            target.write_bytes(saved + b"# changed")
            with refused():
                scope["_verify_reviewed_entry"](copied)
            target.write_bytes(saved)
            (copied / "independent-source-review.json").write_text(
                json.dumps({**peer, "approved": False})
            )
            with refused():
                scope["_verify_reviewed_entry"](copied)
            (copied / "independent-source-review.json").write_text(json.dumps(peer))
            (copied / "shadow.pyd").write_bytes(b"unknown")
            with refused():
                scope["_verify_entry_namespace"](copied)
            (copied / "shadow.pyd").unlink()
        passed.append(
            "actual_five_entrypoint_full_manifest_peer_and_helper_tamper_shadow_guards"
        )
        contexts = [
            {
                name: [float(1).hex()]
                for name in (
                    "vPoldepRegio",
                    "mKlocal",
                    "vFlocal",
                    "vSampleLocPro",
                    "ppes",
                )
            }
            for _ in range(8)
        ]
        context_rows = [
            [str(call), name, "1", "1.0"]
            for call in range(1, 9)
            for name in contexts[0]
        ]
        require(
            context_comparison(context_rows, contexts)["scalar_pairs"] == 40,
            "Positive source arguments",
        )
        with refused():
            context_comparison(context_rows[:-1], contexts)
        context_changed = [list(row) for row in context_rows]
        context_changed[0][3] = "3"
        with refused():
            context_comparison(context_changed, contexts)
        context_changed = [list(row) for row in context_rows]
        context_changed[0][1] = "unmeasured"
        with refused():
            context_comparison(context_changed, contexts)
        passed.append(
            "full_logged_objective_contexts_and_missing_mutated_argument_refusals"
        )
        require(
            CONTRACT["candidate_rows"] == 32
            and CONTRACT["active_optimizer_calls"] == 8
            and CONTRACT["absolute_tolerance"] == 3e-10
            and CONTRACT["relative_tolerance"] == 1e-10,
            "Parity contract",
        )
        passed.append("fixed32_replay_no_performance_or_optimizer_adoption_contract")
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "groups": len(passed),
                "passed": passed,
                "actual_fixture_or_model_called": False,
                "R_called": False,
                "runtime_census_called": False,
            }
        )
    )


if __name__ == "__main__":
    main()
