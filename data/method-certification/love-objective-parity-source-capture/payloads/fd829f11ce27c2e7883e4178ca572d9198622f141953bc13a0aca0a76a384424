"""Reuse only the completed source R stage, preserving its failed surrounding job."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any

from contracts import CONTRACT, ROOT, load, pin, require, union
from runtime_contracts import verify_pin

ORIGINAL = ROOT / "artifacts/science/current-love-namespace-source-parity"
REFS = {
    "plan.json": "2af00a74117e7b8e0d6e46d017076b9f8c0d49742f8f0732b383b9e881376826",
    "terminal.json": "ffbd908d393e5c56b8673516bc5f861c3a35ea7d8ea17e01cba9ef76f5c462c7",
    "love-parity-terminal.json": "d797f572081ce3e0eaacf445c3815a25d885f96e6917bdf54dc42dd68b2d7d82",
    "runtime-custody-terminal.json": "735f334413b7543f8c9ab0a60bbd98dd8d6e140de1e367526483ceba46454c55",
}


def validate_receipts(
    plan: dict[str, Any],
    common: dict[str, Any],
    inner: dict[str, Any],
    outer: dict[str, Any],
) -> None:
    require(
        plan["numerical_contract"] == CONTRACT, "Original R numerical contract differs"
    )
    for document in (common, inner, outer):
        require(
            document["plan_sha256"] == REFS["plan.json"]
            and type(document["actual_exit"]) is int
            and document["actual_exit"] == 1,
            "Original failed whole must remain literal",
        )
    require(
        common["candidate"]
        == inner["candidate"]
        == outer["source_candidate"]
        == plan["candidate"],
        "Original source epochs differ",
    )
    require(
        common["canonical_before"]
        == common["canonical_after"]
        == plan["canonical_identity"]
        and common["before_pin_mismatches"] == common["after_pin_mismatches"] == []
        and common["absent_input_paths_unchanged"] is True,
        "Original source custody failed",
    )
    require(
        inner["after_input_error"] is None
        and inner["timed_out"] is False
        and inner["common_actual_exit"] == 1,
        "Original inner custody failed",
    )
    require(
        outer["before_runtime_error"] is None
        and outer["after_runtime_error"] is None
        and outer["timed_out"] is False
        and outer["delegate_actual_exit"] == 1
        and outer["output_measurement_error"] is None
        and outer["resource_bounds_met"] is False,
        "Original completed runtime/delegate failure scope differs",
    )
    declared, actual = plan["stages"], common["stages"]
    require(
        len(declared) == 3 and len(actual) == 2, "Original stage membership differs"
    )
    for result, stage, code in zip(actual, declared[:2], (0, 1), strict=True):
        require(
            all(
                result[k] == stage[k]
                for k in ("id", "argv", "timeout_seconds", "must_succeed")
            )
            and type(result["actual_exit"]) is int
            and result["actual_exit"] == code
            and result["timed_out"] is False,
            "Original completed R/Python failure roles differ",
        )
    require(
        actual[0]["id"] == "source-R-thirty-two-candidate-replay"
        and actual[1]["id"] == "public-Python-thirty-two-candidate-replay",
        "Original source roles differ",
    )


def verify_R_products(directory: Path, expected: list[dict[str, Any]]) -> None:
    require(
        directory.is_dir()
        and directory == directory.resolve()
        and not any(p.is_symlink() for p in (directory, *directory.parents)),
        "Saved R root alias/missing",
    )
    actual = []
    for path in directory.iterdir():
        require(
            path.is_file() and not path.is_symlink(),
            "Saved R output special/alias/directory",
        )
        actual.append(str(path))
    require(
        sorted(actual) == sorted(row["path"] for row in expected)
        and len(actual) == len({row["path"] for row in expected}) > 0,
        "Saved complete R membership differs",
    )
    for row in expected:
        require(pin(Path(row["path"])) == row, "Saved completed R product changed")


def qualify_product(row: dict[str, Any], raw: bytes, root: Path) -> dict[str, Any]:
    expected = row["sha256"]
    if row["path"] == str(root / "runtime-delegate.stdout"):
        require(
            row["bytes"] == 330
            and expected
            == "bf856195bea4992df8498575aa81cc87cb69cb53d49b46c780d1fb8bf8aee380",
            "Original common stream catalog pin differs",
        )
        tail = (
            json.dumps(
                {
                    "terminal": str(root / "terminal.json"),
                    "sha256": REFS["terminal.json"],
                    "status": "failed",
                }
            )
            + "\n"
        ).encode()
        require(
            len(raw) == row["bytes"] + len(tail)
            and hashlib.sha256(raw[: row["bytes"]]).hexdigest() == expected
            and raw[row["bytes"] :] == tail,
            "Common stream original prefix/exact final receipt differs",
        )
    else:
        require(
            type(row["bytes"]) is int
            and len(raw) == row["bytes"]
            and hashlib.sha256(raw).hexdigest() == expected,
            "Original completed product changed",
        )
    return {
        "path": row["path"],
        "sha256": hashlib.sha256(raw).hexdigest(),
        "bytes": len(raw),
    }


def authenticate() -> tuple[dict[str, Any], list[dict[str, Any]], dict[str, Any]]:
    refs = [pin(ORIGINAL / name) for name in REFS]
    require(
        all(row["sha256"] == REFS[Path(row["path"]).name] for row in refs),
        "Original R execution reference changed",
    )
    documents = {name: load(ORIGINAL / name) for name in REFS}
    plan, common = documents["plan.json"], documents["terminal.json"]
    validate_receipts(
        plan,
        common,
        documents["love-parity-terminal.json"],
        documents["runtime-custody-terminal.json"],
    )
    require(
        len(plan["input_pins"]) == 115389, "Complete original R input count differs"
    )
    for row in plan["input_pins"]:
        verify_pin(row)
    complete_products = []
    for row in common["products"]:
        pin(Path(row["path"]))  # Refuse physical aliases/specials before reading bytes.
        complete_products.append(
            qualify_product(row, Path(row["path"]).read_bytes(), ORIGINAL)
        )
    require(
        len(complete_products) == len({row["path"] for row in complete_products}) == 31,
        "Complete original product catalog differs",
    )
    expected_files = {row["path"] for row in [*complete_products, *refs]}
    expected_directories = {
        "cache",
        "python",
        "r",
        "runtime-temporary",
        "temporary",
        "matplotlib",
        "runtime-temporary/cache",
        "runtime-temporary/matplotlib",
    }
    seen_files, seen_directories = set(), set()
    for path in ORIGINAL.rglob("*"):
        require(
            not path.is_symlink() and (path.is_file() or path.is_dir()),
            "Original output alias/special",
        )
        if path.is_dir():
            seen_directories.add(path.relative_to(ORIGINAL).as_posix())
        else:
            seen_files.add(str(path))
    require(
        seen_files == expected_files and seen_directories == expected_directories,
        "Original complete product/directory namespace changed",
    )
    for row in complete_products:
        require(pin(Path(row["path"])) == row, "Original finalized product changed")
    products = [
        row
        for row in common["products"]
        if Path(row["path"]).is_relative_to(ORIGINAL / "r")
    ]
    verify_R_products(ORIGINAL / "r", products)
    logs = []
    for result in common["stages"]:
        for name in ("stdout", "stderr"):
            row = pin(Path(result[name]))
            require(
                Path(row["path"]).parent == ORIGINAL
                and row["sha256"] == result[name + "_sha256"],
                "Original native stage log changed",
            )
            logs.append(row)
    require(
        "Objective candidate order differs"
        in Path(common["stages"][1]["stderr"]).read_text(),
        "Original Python observer refusal differs",
    )
    failed_python = ORIGINAL / "python"
    require(
        failed_python.is_dir()
        and not failed_python.is_symlink()
        and list(failed_python.iterdir()) == [],
        "Original failed Python output namespace changed",
    )
    data = {
        "references": refs,
        "original_candidate": plan["candidate"],
        "original_whole_actual_exit": 1,
        "original_stage_actual_exits": [0, 1],
        "retained_completed_R_stage": common["stages"][0],
        "retained_R_output_root": str(ORIGINAL / "r"),
        "retained_R_products": products,
        "original_protected_inputs": 115389,
        "original_product_catalog": common["products"],
        "finalized_protected_products": complete_products,
        "common_stdout_tail_contract": "Exact original330B prefix plus only source-defined terminalffbd/statusfailed JSON line; full550B protected separately.",
        "original_Python_complete": False,
        "scope": "Only complete genuine R0 products/logs reused; old Python1/whole1 unchanged. New public Python and independent observer are distinct actual stages.",
    }
    return data, union(plan["input_pins"], refs, complete_products, logs), plan
