def validate_receipts(
    plan: dict[str, Any],
    common: dict[str, Any],
    inner: dict[str, Any],
    outer: dict[str, Any],
) -> None:
    require(
        plan["numerical_contract"] == CONTRACT,
        "Original Python numerical contract differs",
    )
    for document in (common, inner, outer):
        require(
            document["plan_sha256"] == REFS["plan.json"]
            and type(document["actual_exit"]) is int
            and document["actual_exit"] == 1,
            "Original failed whole must remain literal",
        )
    require(
        common["candidate"]
        == inner["candidate"]
        == outer["source_candidate"]
        == plan["candidate"],
        "Original source epochs differ",
    )
    require(
        common["canonical_before"]
        == common["canonical_after"]
        == plan["canonical_identity"]
        and common["before_pin_mismatches"] == common["after_pin_mismatches"] == []
        and common["absent_input_paths_unchanged"] is True,
        "Original source custody failed",
    )
    require(
        inner["after_input_error"] is None
        and inner["timed_out"] is False
        and inner["common_actual_exit"] == 1,
        "Original inner custody failed",
    )
    require(
        outer["before_runtime_error"] is None
        and outer["after_runtime_error"] is None
        and outer["timed_out"] is False
        and outer["delegate_actual_exit"] == 1
        and outer["output_measurement_error"] is None
        and outer["resource_bounds_met"] is False,
        "Original completed runtime/delegate failure scope differs",
    )
    declared, actual = plan["stages"], common["stages"]
    require(
        len(declared) == 2 and len(actual) == 2, "Original stage membership differs"
    )
    for result, stage, code in zip(actual, declared[:2], (0, 1), strict=True):
        require(
            all(
                result[k] == stage[k]
                for k in ("id", "argv", "timeout_seconds", "must_succeed")
            )
            and type(result["actual_exit"]) is int
            and result["actual_exit"] == code
            and result["timed_out"] is False,
            "Original completed Python/observer failure roles differ",
        )
    require(
        actual[0]["id"] == "public-Python-thirty-two-candidate-replay"
        and actual[1]["id"] == "independent-shared-input-and-all-vector-observer",
        "Original source roles differ",
    )


def verify_Python_products(directory: Path, expected: list[dict[str, Any]]) -> None:
    require(
        directory.is_dir()
        and directory == directory.resolve()
        and not any(p.is_symlink() for p in (directory, *directory.parents)),
        "Saved Python root alias/missing",
    )
    actual = []
    for path in directory.iterdir():
        require(
            path.is_file() and not path.is_symlink(),
            "Saved Python output special/alias/directory",
        )
        actual.append(str(path))
    require(
        sorted(actual) == sorted(row["path"] for row in expected)
        and len(actual) == len({row["path"] for row in expected}) > 0,
        "Saved complete Python membership differs",
    )
    for row in expected:
        require(pin(Path(row["path"])) == row, "Saved completed Python product changed")


def qualify_product(row: dict[str, Any], raw: bytes, root: Path) -> dict[str, Any]:
    expected = row["sha256"]
    if row["path"] == str(root / "runtime-delegate.stdout"):
        require(
            row["bytes"] == 343
            and expected
            == "d13bc8fe04167ff98b19ad7a0423cd6eb99696afb83473f8961b2c5d43bd687f",
            "Original common stream catalog pin differs",
        )
        tail = (
            json.dumps(
                {
                    "terminal": str(root / "terminal.json"),
                    "sha256": REFS["terminal.json"],
                    "status": "failed",
                }
            )
            + "\n"
        ).encode()
        require(
            len(raw) == row["bytes"] + len(tail)
            and hashlib.sha256(raw[: row["bytes"]]).hexdigest() == expected
            and raw[row["bytes"] :] == tail,
            "Common stream original prefix/exact final receipt differs",
        )
    else:
        require(
            type(row["bytes"]) is int
            and len(raw) == row["bytes"]
            and hashlib.sha256(raw).hexdigest() == expected,
            "Original completed product changed",
        )
    return {
        "path": row["path"],
        "sha256": hashlib.sha256(raw).hexdigest(),
        "bytes": len(raw),
    }


def verify_output_namespace(
    root: Path, authority: dict[str, Any], *, with_R: bool = False
) -> None:
    """Refuse unlisted files, empty directories, aliases or special saved outputs."""
    require(
        root == root.resolve()
        and root.is_dir()
        and not any(p.is_symlink() for p in (root, *root.parents)),
        "Saved execution root alias",
    )
    files = {
        row["path"]
        for row in authority["references"] + authority["finalized_protected_products"]
    }
    directories = {
        "cache",
        "python",
        "runtime-temporary",
        "temporary",
        "matplotlib",
        "runtime-temporary/cache",
        "runtime-temporary/matplotlib",
    }
    if with_R:
        directories.add("r")
    actual_files, actual_directories = set(), set()
    for path in root.rglob("*"):
        require(
            not path.is_symlink() and (path.is_file() or path.is_dir()),
            "Saved execution special/alias",
        )
        if path.is_dir():
            actual_directories.add(path.relative_to(root).as_posix())
        else:
            actual_files.add(str(path))
    require(
        actual_files == files and actual_directories == directories,
        "Saved complete execution namespace differs",
    )


def writer_contract(producer: bytes, pandas_source: bytes) -> dict[str, Any]:
    """Bind only the four actual output writers and the selected pandas default."""
    tree = ast.parse(producer)
    function = next(
        n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "python"
    )
    writers = [
        n
        for n in ast.walk(function)
        if isinstance(n, ast.Call)
        and isinstance(n.func, ast.Attribute)
        and n.func.attr == "to_csv"
    ]
    expected = {
        "python-" + name + ".csv" for name in ("cover", "pollen", "k", "objective")
    }
    names = []
    for call in writers:
        require(
            len(call.args) == 1
            and isinstance(call.args[0], ast.BinOp)
            and isinstance(call.args[0].op, ast.Div)
            and isinstance(call.args[0].left, ast.Name)
            and call.args[0].left.id == "output"
            and isinstance(call.args[0].right, ast.Constant)
            and call.args[0].right.value in expected
            and len(call.keywords) == 1
            and call.keywords[0].arg == "index"
            and isinstance(call.keywords[0].value, ast.Constant)
            and call.keywords[0].value.value is False,
            "Saved producer CSV writer/default contract differs",
        )
        argument_path = call.args[0]
        assert isinstance(argument_path, ast.BinOp) and isinstance(
            argument_path.right, ast.Constant
        )
        names.append(argument_path.right.value)
    require(
        len(names) == 4 and set(names) == expected, "Four unique CSV writers required"
    )
    pandas_tree = ast.parse(pandas_source)
    cls = next(
        n
        for n in pandas_tree.body
        if isinstance(n, ast.ClassDef) and n.name == "NDFrame"
    )
    functions = [
        n
        for n in cls.body
        if isinstance(n, ast.FunctionDef)
        and n.name == "to_csv"
        and not any(
            isinstance(d, ast.Name) and d.id == "overload" for d in n.decorator_list
        )
    ]
    require(len(functions) == 1, "One real pandas to_csv implementation required")
    defaults = []
    for fn in functions:
        arguments = fn.args.posonlyargs + fn.args.args
        for argument, default in zip(
            arguments[-len(fn.args.defaults) :], fn.args.defaults, strict=True
        ):
            if argument.arg == "na_rep":
                defaults.append(default)
        for argument, keyword_default in zip(
            fn.args.kwonlyargs, fn.args.kw_defaults, strict=True
        ):
            if argument.arg == "na_rep" and keyword_default is not None:
                defaults.append(keyword_default)
    require(
        len(defaults) == 1
        and isinstance(defaults[0], ast.Constant)
        and defaults[0].value == "",
        "Pinned pandas missing encoding differs",
    )
    return {
        "Python_CSV_names": sorted(names),
        "na_rep": "",
        "decode_only_exact_empty": True,
        "global_input_R_parser_changed": False,
        "zero_fill": False,
    }


def encoding_authority(plan: dict[str, Any]) -> dict[str, Any]:
    producer = Path(plan["stages"][0]["argv"][3])
    pandas_source = (
        ROOT
        / "artifacts/science/current-offline-isolated-source-runtime-bootstrap/environment/lib/python3.11/site-packages/pandas/core/generic.py"
    )
    expected = {row["path"]: row for row in plan["input_pins"]}
    rows = [pin(producer), pin(pandas_source)]
    require(
        all(expected.get(row["path"]) == row for row in rows),
        "CSV source not in original inputs",
    )
    require(
        rows[1]["sha256"]
        == "a6a4b494c8896a26c1abe527e6a0d567ea9863dc55726b7bec3c852ff9f81809"
        and rows[1]["bytes"] == 476871,
        "Pinned pandas default source differs",
    )
    return {
        **writer_contract(producer.read_bytes(), pandas_source.read_bytes()),
        "sources": rows,
    }


def validate_observer_refusal(raw: bytes) -> None:
    require(
        hashlib.sha256(raw).hexdigest()
        == "5a4ba7643b8a052f687550babb0a7eca1e124cfbb5b7325cb18b1142c638c58c"
        and raw.endswith(b"ValueError: Blank/whitespace numeric cell\n"),
        "Original exact observer missing-token refusal differs",
    )


def authenticate() -> tuple[dict[str, Any], list[dict[str, Any]], dict[str, Any]]:
    refs = [pin(ORIGINAL / name) for name in REFS]
    require(
        all(row["sha256"] == REFS[Path(row["path"]).name] for row in refs),
        "Original Python execution reference changed",
    )
    documents = {name: load(ORIGINAL / name) for name in REFS}
    plan, common = documents["plan.json"], documents["terminal.json"]
    validate_receipts(
        plan,
        common,
        documents["love-parity-terminal.json"],
        documents["runtime-custody-terminal.json"],
    )
    require(
        len(plan["input_pins"]) == 115446, "Complete original R input count differs"
    )
    for row in plan["input_pins"]:
        verify_pin(row)
    complete_products = []
    for row in common["products"]:
        pin(Path(row["path"]))  # Refuse physical aliases/specials before reading bytes.
        complete_products.append(
            qualify_product(row, Path(row["path"]).read_bytes(), ORIGINAL)
        )
    require(
        len(complete_products) == len({row["path"] for row in complete_products}) == 14,
        "Complete original product catalog differs",
    )
    expected_files = {row["path"] for row in [*complete_products, *refs]}
    expected_directories = {
        "cache",
        "python",
        "runtime-temporary",
        "temporary",
        "matplotlib",
        "runtime-temporary/cache",
        "runtime-temporary/matplotlib",
    }
    seen_files, seen_directories = set(), set()
    for path in ORIGINAL.rglob("*"):
        require(
            not path.is_symlink() and (path.is_file() or path.is_dir()),
            "Original output alias/special",
        )
        if path.is_dir():
            seen_directories.add(path.relative_to(ORIGINAL).as_posix())
        else:
            seen_files.add(str(path))
    require(
        seen_files == expected_files and seen_directories == expected_directories,
        "Original complete product/directory namespace changed",
    )
    for row in complete_products:
        require(pin(Path(row["path"])) == row, "Original finalized product changed")
    products = [
        row
        for row in common["products"]
        if Path(row["path"]).is_relative_to(ORIGINAL / "python")
    ]
    verify_Python_products(ORIGINAL / "python", products)
    logs = []
    for result in common["stages"]:
        for name in ("stdout", "stderr"):
            row = pin(Path(result[name]))
            require(
                Path(row["path"]).parent == ORIGINAL
                and row["sha256"] == result[name + "_sha256"],
                "Original native stage log changed",
            )
            logs.append(row)
    validate_observer_refusal(Path(common["stages"][1]["stderr"]).read_bytes())
    require(
        {Path(row["path"]).name for row in products}
        == {
            "python-cover.csv",
            "python-pollen.csv",
            "python-k.csv",
            "python-objective.csv",
            "python-trace.json",
        },
        "Saved Python five-product role membership differs",
    )
    data = {
        "references": refs,
        "CSV_encoding_authority": encoding_authority(plan),
        "original_candidate": plan["candidate"],
        "original_whole_actual_exit": 1,
        "original_stage_actual_exits": [0, 1],
        "retained_completed_Python_stage": common["stages"][0],
        "retained_Python_output_root": str(ORIGINAL / "python"),
        "retained_Python_products": products,
        "original_protected_inputs": 115446,
        "original_product_catalog": common["products"],
        "finalized_protected_products": complete_products,
        "common_stdout_tail_contract": "Exact original343B prefix plus only source-defined terminaldcb18/statusfailed224B JSON line; full567B protected separately.",
        "original_Python_complete": True,
        "scope": "Only complete genuine Python0 products/logs reused; old observer1/whole1 unchanged. The new plan contains only an independent saved-products observer.",
    }
    return data, union(plan["input_pins"], refs, complete_products, logs), plan
