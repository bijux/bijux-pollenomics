{"status":"success","data":[{"siteid":3372,"sitename":"Råttuvarri","sitedescription":"The site is a small lake on a pine forest-clad bedrock hill in the valley of Skibottsdalen, about 5 km inland from Lyngenfjorden. It lies a couple of km inside the Skibotn end moraines and ice margin deltas, about 20 m above the marine limit.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[20.31667,69.35]}","altitude":121,"recdatecreated":"2013-09-30T14:03:01.000Z","collectionunits":[{"handle":"RATTUV","datasets":[{"datasetid":9147,"datasettype":"geochronologic"}],"collectionunit":"core 2","collectionunitid":4232,"collectionunittype":"Core"}]}],"message":"Retrieved all tables"}