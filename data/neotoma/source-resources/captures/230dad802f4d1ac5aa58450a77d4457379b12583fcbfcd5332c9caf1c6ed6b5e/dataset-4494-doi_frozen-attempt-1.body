{"status":"success","data":[{"download":{"data":{"dataset":{"site":{"handle":"TROLLVAT","siteid":3475,"altitude":188,"sitename":"Trollvatnet","unittype":"Core","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[23.45276,69.87438],[23.46564,69.87438],[23.46564,69.8776],[23.45276,69.8776],[23.45276,69.87438]]]}","collectionunit":"core 1","sitedescription":"The lake is situated on a bedrock hill in the Alta valley sorne 10 km inland from the fiord head. The surroundinj vegetation is open pine forest grading uphill into mountain birch (Betula pubescens ssp. tortuosa) woodland. The tree line (birch) is at 300 to 400 m. The site is a few kilometres inside the Main Sub-stage (Younger Dryas) end-moraines, and it is weIl above the local marine limit (70-80 m.","collectionunitid":4351},"dataset":{"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13762,"ageyoung":2250},{"units":"Radiocarbon years BP","ageold":11080,"ageyoung":2613}],"database":"European Pollen Database","datasetid":4494,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu."}},"samples":[{"ages":[{"age":9010,"agetype":"Radiocarbon years BP","chronologyid":25356,"chronologyname":"EPD"},{"age":10158,"agetype":"Calibrated radiocarbon years BP","ageolder":10391,"ageyounger":9929,"chronologyid":25357,"chronologyname":"Giesecke et al. 2014 (MADCAP)"}],"datum":[{"units":"NISP","value":1,"element":"pollen","elementtype":"pollen","variablename":"Asteraceae"},{"units":"NISP","value":1,"element":"pollen","elementtype":"pollen","variablename":"Corylus"},{"units":"NISP","value":1,"element":"pollen","elementtype":"pollen","variablename":"Myriophyllum alterniflorum"},{"units":"NISP","value":1,"element":"pollen","elementtype":"pollen","variablename":"Saxifraga"},{"units":"NISP","value":2,"element":