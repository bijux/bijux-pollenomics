{"status":"success","data":[{"site":{"area":null,"notes":"String fen in which the strings are not well developed but rather occur as Sphagnum fuscum hummocks with Betula nana, Empetrum nigrum, Vaccinium uliginosum, V. oxycoccus, Ledum palustre, Andromeda polifolia and Rubus chamaemorus, separated by flark areas dominated by Eriophorum vaginatum, Trichophorum caespitosum and Carex spp. There is one extensive pool, some smaller areas of standing water and a stream that drains the mire towards the east.","siteid":30965,"dataset":{"doi":["10.21233/CHMJ-9Q05"],"agerange":[{"units":"Calendar years BP","ageold":171.57,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58534,"datasetpi":[{"initials":"J.","contactid":19545,"firstname":"Jonathan","familyname":"Woodman-Ralph","contactname":"Woodman-Ralph, Jonathan"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","contactname":"Lücke, Andreas"},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"},{"initials":"S.M.","contactid":19544,"firstname":"Siwan","familyname":"Davis","contactname":"Davis, Siwan"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"},{"initials":"H.","contactid":17070,"firstname":"Heidi","familyname":"Hyyppä","contactname":"Hyyppä, Heidi"}],"datasetname":"Palomaa - loi","datasettype":"loss-on-ignition","datasetnotes":null},"altitude":200,"sitename":"Palomaa","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[27.19048,69.2778]}","geopolitical":["Finland","Lappi [Lapland]"],"collectionunit":{"notes":"The peat section for the analysis was taken in two parts. A monolith (length: 52 cm) was dug from one of the larger and higher Sphagnum fuscum hummocks in 2005. A second, deeper profile (length: 64 cm) was taken with a Clymo sampler (Clymo, 1988) in 2006 from the same Sphagnum hummock and as close to the monolith location as was possible without introducing contamination.","handle":"PALOMAA","colldate":"2006-08-15","location":"unspecified","collectors":[{"initials":"O.","contactid":17063,"firstname":"Olga","familyname":"Lisitsyna","contactname":"Lisitsyna, Olga"},{"initials":"L.","contactid":632,"firstname":"Lena","familyname":"Barnekow","contactname":"Barnekow, Lena"},{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"}],"waterdepth":null,"gpslocation":{"gpserror":null,"latitude":null,"longitude":null,"gpsaltitude":null},"collunittype":"Core","collectionunit":"Palomaa core","collectiondevice":"Monolith + Clymo sampler","collectionunitid":42184,"depositionalenvironment":"Fen","dataset":{"doi":["10.21233/CHMJ-9Q05"],"agerange":[{"units":"Calendar years BP","ageold":171.57,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58534,"datasetpi":[{"initials":"J.","contactid":19545,"firstname":"Jonathan","familyname":"Woodman-Ralph","contactname":"Woodman-Ralph, Jonathan"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","