{"status":"success","data":[{"download":{"data":{"site":{"area":3.32,"notes":"String fen in which the strings are not well developed but rather occur as Sphagnum fuscum hummocks with Betula nana, Empetrum nigrum, Vaccinium uliginosum, V. oxycoccus, Ledum palustre, Andromeda polifolia and Rubus chamaemorus, separated by flark areas dominated by Eriophorum vaginatum, Trichophorum caespitosum and Carex spp. There is one extensive pool, some smaller areas of standing water and a stream that drains the mire towards the east.","siteid":30965,"dataset":{"agerange":[{"units":"Calendar years BP","ageold":878.26,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58533,"datasetpi":[{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"},{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","contactname":"Lücke, Andreas"},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"H.","contactid":17070,"firstname":"Heidi","familyname":"Hyyppä","contactname":"Hyyppä, Heidi"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"}],"datasetname":"Palomaa - charcoal","datasettype":"microcharcoal"},"altitude":104,"sitename":"Palomaa","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[27.19048,69.2778]}","geopolitical":["Finland","Lappi [Lapland]"],"collectionunit":{"notes":"The peat section for the analysis was taken in two parts. A monolith (length: 52 cm) was dug from one of the larger and higher Sphagnum fuscum hummocks in 2005. A second, deeper profile (length: 64 cm) was taken with a Clymo sampler (Clymo, 1988) in 2006 from the same Sphagnum hummock and as close to the monolith location as was possible without introducing contamination.","handle":"PALOMAA","colldate":"2006-08-15","location":"unspecified","gpslocation":{},"collunittype":"Core","collectionunit":"Palomaa core","collectiondevice":"Monolith + Clymo sampler","collectionunitid":42184,"depositionalenvironment":"Fen"},"sitedescription":"Small mire located close to the northern limit of pine forest in eastern Finnish Lapland. To the south, forest areas are dominated almost exclusively by Scots Pine (Pinus sylvestris) while, to the north, the regional vegetation type is mountain birch woodland (Betula pubescens ssp. czerepanovii)."},"samples":[{"ages":[{"age":-54.58,"agetype":"Calendar years BP","chronologyid":41153,"chronologyname":"Date AD (created 171009)"}],"datum":[{"units":"cm^3","value":5,"element":"volume","taxonid":276,"taxongroup":"Laboratory analyses","elementtype":"volume","variablename":"Sample quantity","ecologicalgroup":"LABO"},{"units":"grains/tablet","value":18583,"element":"added","taxonid":932,"taxongroup":"Laboratory analyses","variablename":"Lycopodium spike","ecologicalgroup":"LABO"},{"units":"NISP","value":462,"element":"counted","taxonid":932,"taxongroup":"Laboratory analyses","elementtype":"counted","variablename":"Lycopodium spike","ecologicalgroup":"LABO"},{"units":"number","value":1,"element":"<40 µm","taxonid":1062,"taxongroup":"Charcoal","elementtype":"<40 µm","variablename":"Charcoal","ecologicalgroup":"CHAR"},{"units":"number","value":2,"element":"added","taxonid":930,"taxongroup":"Laboratory analyses","variablename":"Lycopodium tablets","ecologicalgroup":"LABO"}],"depth":0.2,"sampleid":648586,"thickness":0.4,"sampleanalyst":[{"initials":"H.","contactid":19536,"firstname":"Henna","familyname":"Suutari","contactname":"Suutari, Henna"}],"analysisunitid":494332,"analysisunitname":"1"},{"ages":[{"age":-53.72,"agetype":"Calend