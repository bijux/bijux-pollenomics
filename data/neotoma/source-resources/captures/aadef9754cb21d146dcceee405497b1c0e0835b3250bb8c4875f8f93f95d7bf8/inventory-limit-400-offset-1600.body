":"Maria B.","familyname":"Nosova","contactname":"Nosova, Maria B."}],"datasettype":"plant macrofossil","datasetnotes":"Data contributed to the EPD/Neotoma by Nosova, M.B.","recdatecreated":"2024-03-26T09:57:13"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":58457,"datasetpi":[{"initials":"M.B.","contactid":17045,"firstname":"Maria B.","familyname":"Nosova","contactname":"Nosova, Maria B."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2024-03-26T09:45:38"},{"doi":["10.21233/jj4p-7712","10.21233/V0E4-R198"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":6559,"ageyoung":26}],"database":"European Pollen Database","datasetid":58458,"datasetpi":[{"initials":"M.B.","contactid":17045,"firstname":"Maria B.","familyname":"Nosova","contactname":"Nosova, Maria B."}],"datasettype":"pollen","datasetnotes":"Data contributed to the EPD/Neotoma by Nosova, M.B.","recdatecreated":"2024-03-26T09:45:44"}]}},{"site":{"siteid":30952,"sitename":"Loch Fadd","sitedescription":"Pools by the side of Loch Fadd","sitenotes":"Original reference states: pools by the side of Loch Fadd. Coordinates are for a location chosen arbitrarily on the E shore of the lake.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-5.07108,55.80609]}","altitude":37,"collectionunitid":42168,"collectionunit":"NODERECENT2","handle":"NODE2","unittype":"Composite","datasets":[{"doi":["10.21233/K82G-ZJ83","10.21233/vcp3-8269"],"agerange":[{"units":"Calendar years BP","ageold":90,"ageyoung":64}],"database":"Neotoma Ostracode Database","datasetid":58488,"datasetpi":[{"initials":"G.S.","contactid":18665,"firstname":"George Stewardson","familyname":"Brady","contactname":"Brady, George Stewardson"}],"datasettype":"ostracode surface sample","datasetnotes":null,"recdatecreated":"2024-03-28T20:11:04"}]}},{"site":{"siteid":30965,"sitename":"Palomaa","sitedescription":"Small mire located close to the northern limit of pine forest in eastern Finnish Lapland. To the south, forest areas are dominated almost exclusively by Scots Pine (Pinus sylvestris) while, to the north, the regional vegetation type is mountain birch woodland (Betula pubescens ssp. czerepanovii).","sitenotes":"String fen in which the strings are not well developed but rather occur as Sphagnum fuscum hummocks with Betula nana, Empetrum nigrum, Vaccinium uliginosum, V. oxycoccus, Ledum palustre, Andromeda polifolia and Rubus chamaemorus, separated by flark areas dominated by Eriophorum vaginatum, Trichophorum caespitosum and Carex spp. There is one extensive pool, some smaller areas of standing water and a stream that drains the mire towards the east.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[27.19048,69.2778]}","altitude":200,"collectionunitid":42184,"collectionunit":"Palomaa core","handle":"PALOMAA","unittype":"Core","datasets":[{"doi":["10.21233/CHMJ-9Q05"],"agerange":[{"units":"Calendar years BP","ageold":171.57,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58534,"datasetpi":[{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","contactname":"Lücke, Andreas"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"H.","contactid":17070,"firstname":"Heidi","familyname":"Hyyppä","contactname":"Hyyppä, Heidi"},{"initials":"J.","contactid":19545,"firstname":"Jonathan","familyname":"Woodman-Ralph","contactname":"Woodman-Ralph, Jonathan"},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"},{"initials":"S.M.","contactid":19544,"firstname":"Siwan","familyname":"Davis","contactname":"Davis, Siwan"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"}],"datasettype":"loss-on-ignition","datasetnotes":null,"recdatecreated":"2024-04-12T11:18:57"},{"doi":["10.21233/d49m-jd45","10.21233/MKRP-9818"],"agerange":[{"units":"Calendar years BP","ageold":878.26,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58530,"datasetpi":[{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","contactname":"Lücke, Andreas"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"H.","contactid":17070,"firstname":"Heidi","familyname":"Hyyppä","contactname":"Hyyppä, Heidi"},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"}],"datasettype":"pollen","datasetnotes":"The samples are consecutive and aim at representing around 1 year. Thus, pollen percentages should be usied with caution. We recommend to amalgamate samples together and calculate averages prior to calculating pollen percentages.","recdatecreated":"2024-04-11T13:39:03"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":58529,"datasetpi":[{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2024-04-11T13:38:58"},{"doi":["10.21233/GMAN-WV23","10.21233/kmkx-r957"],"agerange":[{"units":"Calendar years BP","ageold":878.26,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58539,"datasetpi":[{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","contactname":"Lücke, Andreas"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"H.","contactid":17070,"firstname":"Heidi","familyname":"Hyyppä","contactname":"Hyyppä, Heidi"},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"}],"datasettype":"testate amoebae","datasetnotes":null,"recdatecreated":"2024-04-15T15:10:12"},{"doi":["10.21233/2256-QP08"],"agerange":[{"units":"Calendar years BP","ageold":878.26,"ageyoung":-54.58}],"database":"European Pollen Database","datasetid":58533,"datasetpi":[{"initials":"A.","contactid":18392,"firstname":"Andreas","familyname":"Lücke","contactname":"Lücke, Andreas"},{"initials":"F.","contactid":4065,"firstname":"Friederike","familyname":"Wagner-Cremer","contactname":"Wagner-Cremer, Friederike"},{"initials":"H.","contactid":17070,"firstname":"Heidi","familyname":"Hyyppä","contactname":"Hyyppä, Heidi"},{"initials":"K.","contactid":19530,"firstname":"Kristian","familyname":"Schoning","contactname":"Schoning, Kristian"},{"initials":"S.P.","contactid":1091,"firstname":"Sheila P.","familyname":"Hicks","contactname":"Hicks, Sheila P."},{"initials":"T.","contactid":9628,"firstname":"Tomasz","familyname":"Goslar","contactname":"Goslar, Tomasz"},{"initials":"W.","contactid":8772,"firstname":"Walter","familyname":"Finsinger","contactname":"Finsinger, Walter"}],"datasettype":"microcharcoal","datasetnotes":null,"recdatecreated":"2024-04-12T09:30:57"}]}},{"site":{"siteid":31756,"sitename":"Kosilovo","sitedescription":"Meso-oligotrophic peatbog. Physiography: on the top of a fluvioglacial sandy hill within the glacial fluvial valley of lake Rucheiskoe. Surrounding vegetation: forest.","sitenotes":"Toropets District","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[31.55124,56.72073]}","altitude":200,"collectionunitid":43362,"collectionunit":"KOSILOVO core","handle":"KOSILOVO","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":59894,"datasetpi":[{"initials":"M.B.","contactid":17045,"firstname":"Maria B.","familyname":"Nosova","contactname":"Nosova, Maria B."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2024-09-02T13:26:40"},{"doi":["10.21233/0j1m-hw13","10.21233/W1HC-7M42"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":9846,"ageyoung":-39}],"database":"European Pollen Database","datasetid":59895,"datasetpi":[{"initials":"M.B.","contactid":17045,"firstname":"Maria B.","familyname":"Nosova","contactname":"Nosova, Maria B."}],"datasettype":"pollen","datasetnotes":"Data submitted by Nosova, M. to the EPD/Neotoma.","recdatecreated":"2024-09-02T13:26:51"}]}},{"site":{"siteid":31818,"sitename":"Lillsjön","sitedescription":"Small lake in the hemiboreal vegetation zone dominated by coniferous forest with wide- spread occurrence of deciduous trees, mainly Quercus, Betula, and Populus. It is today a mosaic rural landscape with woodland and agricultural land in varying proportions.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[16.38903,57.93223]}","altitude":16,"collectionunitid":43424,"collectionunit":null,"handle":"LILLSJKL","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":59963,"datasetpi":[{"initials":"O.","contactid":19792,"firstname":"Olena","familyname":"Vinogradova","contactname":"Vinogradova, Olena"},{"initials":"T.","contactid":19795,"firstname":"Thomas","familyname":"Andrén","contactname":"Andrén, Thomas"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2024-09-06T09:31:19"},{"doi":["10.21233/8QPJ-9E08","10.21233/agst-s913"],"agerange":[{"units":"Calendar years BP","ageold":3129,"ageyoung":-65}],"database":"European Pollen Database","datasetid":59965,"datasetpi":[{"initials":"E.","contactid":19794,"firstname":"Elinor","familyname":"Andrén","contactname":"Andrén, Elinor"},{"initials":"M.J.","contactid":1066,"firstname":"Marie-José","familyname":"Gaillard-Lemdahl","contactname":"Gaillard-Lemdahl, Marie-José"},{"initials":"O.","contactid":19792,"firstname":"Olena","familyname":"Vinogradova","contactname":"Vinogradova, Olena"},{"initials":"T.","contactid":19795,"firstname":"Thomas","familyname":"Andrén","contactname":"Andrén, Thomas"}],"datasettype":"charcoal","datasetnotes":null,"recdatecreated":"2024-09-06T09:44:13"},{"doi":["10.21233/RE8D-N374","10.21233/zj2e-hz52"],"agerange":[{"units":"Calendar years BP","ageold":3129,"ageyoung":-65}],"database":"European Pollen Database","datasetid":59966,"datasetpi":[{"initials":"E.","contactid":19794,"firstname":"Elinor","familyname":"Andrén","contactname":"Andrén, Elinor"},{"initials":"M.J.","contactid":1066,"firstname":"Marie-José","familyname":"Gaillard-Lemdahl","contactname":"Gaillard-Lemdahl, Marie-José"},{"initials":"O.","contactid":19792,"firstname":"Olena","familyname":"Vinogradova","contactname":"Vinogradova, Olena"},{"initials":"T.","contactid":19795,"firstname":"Thomas","familyname":"Andrén","contactname":"Andrén, Thomas"}],"datasettype":"loss-on-ignition","datasetnotes":null,"recdatecreated":"2024-09-06T09:51:12"},{"doi":["10.21233/FJ02-0219","10.21233/mjha-j762"],"agerange":[{"units":"Calendar years BP","ageold":3129,"ageyoung":-65}],"database":"European Pollen Database","datasetid":59964,"datasetpi":[{"initials":"E.","contactid":19794,"firstname":"Elinor","familyname":"Andrén","contactname":"Andrén, Elinor"},{"initials":"M.J.","contactid":1066,"firstname":"Marie-José","familyname":"Gaillard-Lemdahl","contactname":"Gaillard-Lemdahl, Marie-José"},{"initials":"O.","contactid":19792,"firstname":"Olena","familyname":"Vinogradova","contactname":"Vinogradova, Olena"},{"initials":"T.","contactid":19795,"firstname":"Thomas","familyname":"Andrén","contactname":"Andrén, Thomas"}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2024-09-06T09:31:24"}]}},{"site":{"siteid":32509,"sitename":"Rostrevor Road Cottage","sitedescription":"Moss. Site comprises a field that was formerly used for crop-growing where an abandoned habitation is in situ; located on the upland fringe. Surrounding vegetation: Around the nearby derelict habitation, Poaceae and Urtica are abundant and there are occasional Digitalis purpurea and Cirsium; Two stands of Crataegus and one stand of Ilex are situated next to the derelict habitation; Poaceae, Calluna vulgaris, Erica tetralix, Erica cinerea and Ulex are present on the rocky slopes that lie above the sampling point; Conifer plantation ~300 m from the sampling point.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.16324,54.14444]}","altitude":223,"collectionunitid":44189,"collectionunit":null,"handle":"RRC1","unittype":"Modern","datasets":[{"doi":["10.21233/she6-0405"],"agerange":[{"units":"Calendar years BP","ageold":-73,"ageyoung":-73}],"database":"European Pollen Database","datasetid":60799,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data submitted by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T07:56:22"}]}},{"site":{"siteid":32510,"sitename":"Skilling Cottage","sitedescription":"Moss. Site comprises a field that was formerly used for crop-growing where an abandoned habitation is in situ; located on the upland fringe. Surrounding vegetation: Eriophorum vaginatum is present in moderate abundance in some areas of the field that the sample was collected but Poaceae otherwise dominates; Surrounding the nearby derelict habitation is Urtica, Ulex and stands of Acer pseudoplatanus, Crataegus, Fraxinus and Larix (there are a greater number of stands in the vicinity of SC2 than QC2); The site is surrounded by formerly cultivated fields to its north and south; Slopes above the sampling point are dominated by Calluna vulgaris and Poaceae; Along the course of the nearby river Pteridium is abundant; Ulex is also present as are glades with abundant Drosera.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-5.91661,54.14814]}","altitude":276,"collectionunitid":44190,"collectionunit":null,"handle":"SC2","unittype":"Modern","datasets":[{"doi":["10.21233/nt63-mj45"],"agerange":[{"units":"Calendar years BP","ageold":-73,"ageyoung":-73}],"database":"European Pollen Database","datasetid":60800,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T08:22:21"},{"doi":["10.21233/3z4g-pr42"],"agerange":[],"database":"European Pollen Database","datasetid":60801,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"charcoal surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:07:33"}]}},{"site":{"siteid":32511,"sitename":"Quinn Cottage","sitedescription":"Moss. Site comprises a field that was formerly used for crop-growing where an abandoned habitation is in situ; located on the upland fringe. Surrounding vegetation: Eriophorum vaginatum is present in low abundance in some areas of the field that the sample was collected; Surrounding the nearby derelict habitation is Urtica, Ulex and stands of Acer pseudoplatanus, Crataegus and Fraxinus; The site is surrounded by formerly cultivated fields to its south only; Slopes above the sampling point are dominated by Calluna vulgaris and Poaceae; Along the course of the nearby stream Pteridium is abundant; Ulex is also present as are glades with abundant Drosera.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-5.9174,54.14992]}","altitude":312,"collectionunitid":44191,"collectionunit":null,"handle":"QC2","unittype":"Modern","datasets":[{"doi":["10.21233/7sg4-9885"],"agerange":[{"units":"Calendar years BP","ageold":-73,"ageyoung":-73}],"database":"European Pollen Database","datasetid":60802,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:16:13"}]}},{"site":{"siteid":32512,"sitename":"Fofanny","sitedescription":"Moss. Blanket bog situated in the bottom of the Fofanny valley; situated immediately adjacent to the course of the Shimna River. Surrounding vegetation: Surrounding area comparable to around the sampling point; primarily comprised of Poaceae but patches of Ericaceae are present; Present are: Calluna vulgaris, Erica cinerea, Vaccinium, Eriophorum vaginatum, Eriophorum angustifolium, Narthecium ossifragum, Drosera, Juncus, Sphagnum cuspidatum, S. capillifolium, Cirsium palustre; There is some Gallium saxatile and Potentilla, but in low abundances; Conifer plantation with mixed broadleaf within ~525 m; comprised of Pinus, Picea, Abies, Betula, Alnus, Fagus and Quercus.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.03223,54.18479]}","altitude":331,"collectionunitid":44192,"collectionunit":null,"handle":"FF3","unittype":"Modern","datasets":[{"doi":["10.21233/7ccm-vq06"],"agerange":[{"units":"Calendar years BP","ageold":-72,"ageyoung":-72}],"database":"European Pollen Database","datasetid":60803,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:19:34"}]}},{"site":{"siteid":32513,"sitename":"Deers Meadow 1","sitedescription":"Moss. Blanket bog that has inundated an upland peneplain; bog has been extensively cut for turf. Surrounding vegetation: Vegetation patchy; combination of wet pasture and heath communities; In some areas Eriophorum spp. is abundant; Wet pasture in the vicinity of streams comprised primarily of Equisetum, Molinia caerulea, Festuca pratensis, Deschampsia caespitosa, Trichophorum cespitosum and Juncus sarophorus; Narthecium ossifragum, Ranunculus, Trifolium, Rumex acetosa, R. acetosella, Cardamine, Polygala vulgaris, Caltha palustris, Veronica and Viola palustris also present; Poaceae dominates the slopes of nearby mountains; Conifer plantation with mixed broad leaf (SG1) ~225 m from the sampling point.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.05253,54.17287]}","altitude":351,"collectionunitid":44193,"collectionunit":null,"handle":"DM1","unittype":"Modern","datasets":[{"doi":["10.21233/3xed-5577"],"agerange":[{"units":"Calendar years BP","ageold":-72,"ageyoung":-72}],"database":"European Pollen Database","datasetid":60804,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:23:06"}]}},{"site":{"siteid":32514,"sitename":"Deers Meadow 2","sitedescription":"Moss. Blanket bog that has inundated an upland peneplain; bog has been extensively cut for turf. Surrounding vegetation: Extra-local: Extra-local vegetation comparable to that at the sampling point; areas with more abundant Eriophorum spp.; Stands of Salix and freshly germinated Betula present within ~100 m of the sampling point; Wet pasture in the vicinity of streams comprised primarily of Equisetum, Molinia caerulea, Festuca pratensis, Deschampsia caespitosa, Trichophorum cespitosum and Juncus sarophorus; Narthecium ossifragum, Ranunculus, Trifolium, Rumex acetosa, R. acetosella, Cardamine, Polygala vulgaris, Caltha palustris, Veronica and Viola palustris also present; By the side of the nearby track Plantago lanceolata, Urtica, Trifolium and Cirsium palustre are present; Poaceae dominates the slopes of nearby mountains; Conifer plantation with mixed broad leaf (SG1) ~850 m from the sampling point.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.05628,54.16768]}","altitude":342,"collectionunitid":44194,"collectionunit":null,"handle":"DM2","unittype":"Modern","datasets":[{"doi":["10.21233/2kwg-1p78"],"agerange":[{"units":"Calendar years BP","ageold":-72,"ageyoung":-72}],"database":"European Pollen Database","datasetid":60805,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:25:48"}]}},{"site":{"siteid":32515,"sitename":"Castle Bog 1","sitedescription":"Moss. Upland blanket bog; peat hags are present in the higher grounds of Castle Bog, where this sample was collected. Surrounding vegetation: Extra-local vegetation comparable to that at the sampling point; Occurrences of Huperzia selago and Neottia cordata; Valley opens to the southwest, visible are the lowlands and conifer plantation ~375 m from the sampling point.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.12419,54.14003]}","altitude":453,"collectionunitid":44195,"collectionunit":null,"handle":"CB1","unittype":"Modern","datasets":[{"doi":["10.21233/wbk1-sw97"],"agerange":[{"units":"Calendar years BP","ageold":-72,"ageyoung":-72}],"database":"European Pollen Database","datasetid":60806,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:28:43"}]}},{"site":{"siteid":32516,"sitename":"Castle Bog 2","sitedescription":"Moss. Upland blanket bog; peat at Castle Bog has been has been extensively cut for turf, sample was collected from an area where intact peat remains. Surrounding vegetation: Extra-local vegetation comparable to that at the sampling point; Stands of Abies, and a few Picea, present within ~50 m of the sampling point; Stands of juvenile Betula and Sorbus present in the wider area; Pteridium present on ground where peat has been removed; Huperzia selago present but in low abundance.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.11872,54.14407]}","altitude":431,"collectionunitid":44196,"collectionunit":null,"handle":"CB2","unittype":"Modern","datasets":[{"doi":["10.21233/5a9d-pg48"],"agerange":[{"units":"Calendar years BP","ageold":-72,"ageyoung":-72}],"database":"European Pollen Database","datasetid":60807,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:34:51"},{"doi":["10.21233/mzvw-a472"],"agerange":[],"database":"European Pollen Database","datasetid":60808,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"charcoal surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:40:13"}]}},{"site":{"siteid":32517,"sitename":"Slievemartin","sitedescription":"Moss. Upland blanket bog. Surrounding vegetation: Slopes above the area of blanket bog are dominated by Poaceae and Calluna vulgaris; Occasional stands of Picea and juvenile Pinus are present on the bog surface within ~100 m of the sampling point; Conifer plantation to the east and north of the sampling point, ~150 m in each direction.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.16368,54.09678]}","altitude":436,"collectionunitid":44197,"collectionunit":null,"handle":"SIMA1","unittype":"Modern","datasets":[{"doi":["10.21233/0fac-9r10"],"agerange":[{"units":"Calendar years BP","ageold":-73,"ageyoung":-73}],"database":"European Pollen Database","datasetid":60809,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:46:08"}]}},{"site":{"siteid":32518,"sitename":"Bog of Donard","sitedescription":"Moss. Upland blanket bog; edges of the bog are eroding and exposed peat hags are extensive, but the interior of the bog remains largely intact. Surrounding vegetation: The fringe of the blanket bog is dominated by Eriophorum spp. and Poaceae but patches of Calluna vulgaris are present within this; Slopes of nearby Slieve Donard are dominated by Poa annuna; small boulders are scattered across the ground surface with Racomitrium situated in proximity to these; The valley slopes directly down from the sampling point has mixed vegetation; Poaceae, Pteridium, Pteridophytes, Calluna vulgaris, Ulex and Myrica gale are all present.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-5.92934,54.1715]}","altitude":533,"collectionunitid":44198,"collectionunit":null,"handle":"SD4","unittype":"Modern","datasets":[{"doi":["10.21233/m8bk-f612"],"agerange":[{"units":"Calendar years BP","ageold":-73,"ageyoung":-73}],"database":"European Pollen Database","datasetid":60810,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:49:30"}]}},{"site":{"siteid":32519,"sitename":"Binnian","sitedescription":"Moss. Mountain summit comprised of exposed granite tors. Surrounding vegetation: Wider area comprised of similar vegetation; Small boulders are abundant across the ground surface; A well-trodden footpath that is devoid of vegetation is situated ~5 m from the sampling point; occasional Digitalis purpurea noted at the edge of the path; Visible is the nearby summit of Slieve Binnian, where there is no vegetation and only rocky tors.","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-5.9797,54.14368]}","altitude":710,"collectionunitid":44199,"collectionunit":null,"handle":"BIN1","unittype":"Modern","datasets":[{"doi":["10.21233/wtnb-tc13"],"agerange":[{"units":"Calendar years BP","ageold":-74,"ageyoung":-74}],"database":"European Pollen Database","datasetid":60811,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T09:59:22"},{"doi":["10.21233/m4gy-wb25"],"agerange":[],"database":"European Pollen Database","datasetid":60812,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"charcoal surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T10:06:33"}]}},{"site":{"siteid":32520,"sitename":"Spelga Forest","sitedescription":"Moss. Mixed woodland; sample taken directly beneath a stand of Alnus. Surrounding vegetation: Mixed woodland comprised of: Pinus, Picea, Abies, Betula, Alnus, Fagus, Quercus and Populus; Understory of Poaceae with some Ranunculus and Rumex acetosa; Blanket bog with combination of wet pasture and heath communities present in wider area (DM1 and DM2).","sitenotes":"Location Reliability: Good for high resolution remote sensing (<100m)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-6.0565,54.17905]}","altitude":347,"collectionunitid":44200,"collectionunit":null,"handle":"SG1","unittype":"Modern","datasets":[{"doi":["10.21233/yf1v-e940"],"agerange":[{"units":"Calendar years BP","ageold":-74,"ageyoung":-74}],"database":"European Pollen Database","datasetid":60813,"datasetpi":[{"initials":"G.","contactid":15624,"firstname":"Gill","familyname":"Plunkett","contactname":"Plunkett, Gill"},{"initials":"H.","contactid":19894,"firstname":"Helen","familyname":"Essell","contactname":"Essell, Helen"}],"datasettype":"pollen surface sample","datasetnotes":"Data contributed by Essell, H. to the EPD/Neotoma.","recdatecreated":"2024-10-29T10:09:51"}]}},{"site":{"siteid":33213,"sitename":"Serteya kettle hole","sitedescription":"Mire. Physiography: the bog fills a kettle hole that has formed in a small and deep closed depression after a block of dead ice. The kettle hole, filled with organic deposits, is cut into the neighbouring glaciofluvial plains. Surrounding vegetation: steep slopes covered with spruce, pine and birch trees.","sitenotes":"catchment area of 48.7 ha","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[31.50892,55.67603]}","altitude":163,"collectionunitid":44955,"collectionunit":"core Serteya","handle":"SERTEYA","unittype":"Core","datasets":[{"doi":["10.21233/rqx9-f436"],"agerange":[{"units":"Calendar years BP","ageold":11102,"ageyoung":6359},{"units":"Calibrated radiocarbon years BP","ageold":13052,"ageyoung":8309}],"database":"European Pollen Database","datasetid":61891,"datasetpi":[{"initials":"E.","contactid":8766,"firstname":"Emilie","familyname":"Gauthier","contactname":"Gauthier, Emilie"}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Gauthier, E. to the EPD/Neotoma.","recdatecreated":"2025-02-18T09:25:45"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":61890,"datasetpi":[{"initials":"E.","contactid":8766,"firstname":"Emilie","familyname":"Gauthier","contactname":"Gauthier, Emilie"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-02-18T09:25:38"}]}},{"site":{"siteid":33272,"sitename":"Loch Doon","sitedescription":"Lake. Physiography: large freshwater reservoir in a large glacially deepened valley. Surrounding vegetation: conifer plantations with relict species like Quercus petraea, Betula pubescens and Sorbus aucupari, with also an understorey including Vaccinium myrtillus, Deschampsia flexuosa, Luzula sylvatica and Pteridium aquilinum.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-4.36528,55.21806]}","altitude":305,"collectionunitid":45021,"collectionunit":"LOCHDOOL core","handle":"LOCHDOOL","unittype":"Core","datasets":[{"doi":["10.21233/r072-gf73"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8023,"ageyoung":3586}],"database":"European Pollen Database","datasetid":61989,"datasetpi":[{"initials":"K.R.","contactid":20255,"firstname":"Kenneth R.","familyname":"Hirons","contactname":"Hirons, Kenneth R."}],"datasettype":"loss-on-ignition","datasetnotes":"Data contributed by Schofield, J.E. to the EPD/Neotoma.","recdatecreated":"2025-03-26T07:44:30"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":61988,"datasetpi":[{"initials":"J.E.","contactid":19421,"firstname":"J. Edward","familyname":"Schofield","contactname":"Schofield, J. Edward"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-03-26T07:44:24"},{"doi":["10.21233/t57w-dh42"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8023,"ageyoung":3586}],"database":"European Pollen Database","datasetid":61990,"datasetpi":[{"initials":"K.J.","contactid":1393,"firstname":"Kevin J.","familyname":"Edwards","contactname":"Edwards, Kevin J."},{"initials":"K.R.","contactid":20255,"firstname":"Kenneth R.","familyname":"Hirons","contactname":"Hirons, Kenneth R."},{"initials":"P.J.","contactid":19420,"firstname":"Patrick J.","familyname":"Newell","contactname":"Newell, Patrick J."}],"datasettype":"charcoal","datasetnotes":"Data contributed by Schofield, J.E. to the EPD/Neotoma.","recdatecreated":"2025-03-26T07:44:33"},{"doi":["10.21233/wexk-b647"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8023,"ageyoung":3586}],"database":"European Pollen Database","datasetid":61991,"datasetpi":[{"initials":"K.J.","contactid":1393,"firstname":"Kevin J.","familyname":"Edwards","contactname":"Edwards, Kevin J."},{"initials":"K.R.","contactid":20255,"firstname":"Kenneth R.","familyname":"Hirons","contactname":"Hirons, Kenneth R."},{"initials":"P.J.","contactid":19420,"firstname":"Patrick J.","familyname":"Newell","contactname":"Newell, Patrick J."}],"datasettype":"pollen","datasetnotes":"Data contributed by Schofield, J.E. to the EPD/Neotoma.","recdatecreated":"2025-03-26T07:44:36"}]}},{"site":{"siteid":33292,"sitename":"Svanåvatnet","sitedescription":"Lake. Physiography: depression. Surrounding vegetation: P. abies with some P. sylvestris and B. pubescens.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[14.05,66.41667]}","altitude":243,"collectionunitid":45043,"collectionunit":"SVAN","handle":"SVAN","unittype":"Core","datasets":[{"doi":["10.21233/sg1z-jc18"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8721,"ageyoung":-50}],"database":"European Pollen Database","datasetid":62017,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Data contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-08T08:07:25"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62015,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"},{"initials":"H.J.B.","contactid":14,"firstname":"Harry John Betteley","familyname":"Birks","contactname":"Birks, Harry John Betteley"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-08T08:07:16"},{"doi":["10.21233/a4ey-3738"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":4139,"ageyoung":-50}],"database":"European Pollen Database","datasetid":62016,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"charcoal","datasetnotes":"Data contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-08T08:07:22"}]}},{"site":{"siteid":33294,"sitename":"Ähijärv","sitedescription":"Lake Ähijärv is a large lake with uneven bottom relief in Karula Upland. The surrounding of the lake is dominated by forests.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[26.49778,57.71139]}","altitude":78,"collectionunitid":45046,"collectionunit":"Ähijärv","handle":"ÄHIJRV","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62020,"datasetpi":[{"initials":"J.","contactid":15763,"firstname":"Jüri","familyname":"Vassiljev","contactname":"Vassiljev, Jüri"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-10T09:58:18"},{"doi":["10.21233/jrqq-xe90"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10536,"ageyoung":-62}],"database":"European Pollen Database","datasetid":62021,"datasetpi":[{"initials":"A.","contactid":1204,"firstname":"Anneli","familyname":"Poska","contactname":"Poska, Anneli"}],"datasettype":"pollen","datasetnotes":"Depths are all from the water surface. Water depth 540 cm.","recdatecreated":"2025-04-10T09:58:23"}]}},{"site":{"siteid":33294,"sitename":"Ähijärv","sitedescription":"Lake Ähijärv is a large lake with uneven bottom relief in Karula Upland. The surrounding of the lake is dominated by forests.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[26.49778,57.71139]}","altitude":78,"collectionunitid":45047,"collectionunit":"Ähijärv","handle":"ÄHIJRVLOI","unittype":"Core","datasets":[{"doi":["10.21233/eq16-ef80"],"agerange":[],"database":"European Pollen Database","datasetid":62022,"datasetpi":[{"initials":"L.","contactid":754,"firstname":"Leili","familyname":"Saarse","contactname":"Saarse, Leili"}],"datasettype":"loss-on-ignition","datasetnotes":"Depths are all from the water surface. Water depth 540 cm.","recdatecreated":"2025-04-10T10:34:08"}]}},{"site":{"siteid":33300,"sitename":"Brattheivatnet","sitedescription":"Small circular lake. Physiography: glacial origin. Surrounding vegetation: dwarf-shrub vegetation dominated by Calluna vulgaris, Empetrum nigrum, and Betula nana, with some stunted B. pubescens ssp. tortuosa.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[16.025,69.21944]}","altitude":114,"collectionunitid":45054,"collectionunit":"core BRP309","handle":"BRATTHEI","unittype":"Core","datasets":[{"doi":["10.21233/wps4-dn37"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15418,"ageyoung":7210}],"database":"European Pollen Database","datasetid":62035,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-11T07:08:52"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62034,"datasetpi":[{"initials":"H.H.","contactid":116,"firstname":"Hilary H.","familyname":"Birks","contactname":"Birks, Hilary H."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-11T07:08:46"}]}},{"site":{"siteid":33301,"sitename":"Lusvatnet","sitedescription":"Small oval lake. Physiography: small cirque glacier that drained into Lusvatnet during the\r\nLateglacial. Surrounding vegetation: Open birch woodland dominated by Betula pubescens ssp. tortuosa and with a predominantly ericaceous or tall-fern-dominated understory clothes the steep lower slopes. Above the tree-line, the vegetation is composed of ericaceous dwarf-shrubs and grasses on sheltered slopes, open grass-heath on exposed ridges, and cliff vegetation around the head of the lake where several arctic-alpine and montane species occur.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[15.56667,69.06667]}","altitude":30,"collectionunitid":45055,"collectionunit":"core LUP207","handle":"LUSVATN","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62036,"datasetpi":[{"initials":"H.H.","contactid":116,"firstname":"Hilary H.","familyname":"Birks","contactname":"Birks, Hilary H."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-11T07:15:32"},{"doi":["10.21233/y9q5-4164"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13705,"ageyoung":7136}],"database":"European Pollen Database","datasetid":62037,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-11T07:15:39"}]}},{"site":{"siteid":36445,"sitename":"Dalsträsk","sitedescription":"Lake. Physiography: glacial origin. Surrounding vegetation: forest.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[19.99883,60.33622]}","altitude":18,"collectionunitid":48265,"collectionunit":"core DALSTRAS","handle":"DALSTRAS","unittype":"Core","datasets":[{"doi":["10.21233/dn3e-aj73"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":2691,"ageyoung":33}],"database":"European Pollen Database","datasetid":65291,"datasetpi":[{"initials":"P.I.","contactid":20417,"firstname":"Petter Ingolf","familyname