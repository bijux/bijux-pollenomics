atasettype":"pollen","datasetnotes":null,"recdatecreated":"2022-08-28T17:14:18"}]}},{"site":{"siteid":29106,"sitename":"Kunda Arusoo","sitedescription":"Former Lake Kunda. Physiography: basin developed in a depression. Surrounding vegetation: forest.","sitenotes":"depression of the Middle Ordovician series of more or less clayish limestones","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[26.52194,59.46667]}","altitude":56,"collectionunitid":39747,"collectionunit":"ARUSOO core","handle":"ARUSOO","unittype":"Core","datasets":[{"doi":["10.21233/R8WN-CK06","10.21233/yq4x-fe11"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10833,"ageyoung":32}],"database":"European Pollen Database","datasetid":54692,"datasetpi":[{"initials":"A.","contactid":1204,"firstname":"Anneli","familyname":"Poska","contactname":"Poska, Anneli"},{"initials":"L.K.","contactid":1127,"firstname":"Lars König","familyname":"Königsson","contactname":"Königsson, Lars König"}],"datasettype":"pollen","datasetnotes":"Data contributed by Poska, A. via Giesecke, T. to the EPD/Neotoma.","recdatecreated":"2022-10-17T10:05:12"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":54691,"datasetpi":[{"initials":"A.","contactid":1204,"firstname":"Anneli","familyname":"Poska","contactname":"Poska, Anneli"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-10-17T10:05:03"}]}},{"site":{"siteid":29161,"sitename":"Vaskna","sitedescription":"Lake. Physiography: depression in morraine relief. Surrounding vegetation: forest and cultivated fields.","sitenotes":"The lake has a weak drainage, the outflow takes place through the rapid Iskna stream. The Järvepere stream is the inflow from Lake Tuuljärv (during high water period), there are also several ditches and a number of springs.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[27.07833,57.71167]}","altitude":248,"collectionunitid":39807,"collectionunit":"Vaskna core","handle":"VASKNA","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55044,"datasetpi":[{"initials":"E.O.","contactid":738,"firstname":"E. O.","familyname":"Ilves","contactname":"Ilves, E. O."},{"initials":"H.","contactid":18658,"firstname":"Helle","familyname":"Mäemets","contactname":"Mäemets, Helle"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-10-24T08:59:14"},{"doi":["10.21233/38ps-t725","10.21233/H5BE-1183"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12109,"ageyoung":434}],"database":"European Pollen Database","datasetid":55045,"datasetpi":[{"initials":"H.","contactid":18658,"firstname":"Helle","familyname":"Mäemets","contactname":"Mäemets, Helle"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T. to the EPD/Neotoma.","recdatecreated":"2022-10-24T08:59:23"}]}},{"site":{"siteid":29165,"sitename":"Velise","sitedescription":"Small  ombrotrophic bog NS orientated. Physiography:  shallow depression between two beach ridges. Surrounding vegetation: forest and cultivated fields.","sitenotes":"Length: is 1 km and it is 0.5 km wide. The whole bog is today used for peat cutting. Exceptionally high rising today over 5 m above the surrounding planes","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[24.46028,58.75667]}","altitude":12,"collectionunitid":39812,"collectionunit":"Velise core","handle":"VELISE","unittype":"Core","datasets":[{"doi":["10.21233/4sjq-g329","10.21233/E1J2-5B08"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10669,"ageyoung":2653}],"database":"European Pollen Database","datasetid":55053,"datasetpi":[{"initials":"S.","contactid":1296,"firstname":"Siim","familyname":"Veski","contactname":"Veski, Siim"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T. to the EPD/Neotoma.\r\nThe age of the top is unknown because the site is mined for peat.","recdatecreated":"2022-10-24T12:03:02"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55052,"datasetpi":[{"initials":"S.","contactid":1296,"firstname":"Siim","familyname":"Veski","contactname":"Veski, Siim"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-10-24T12:02:53"}]}},{"site":{"siteid":29167,"sitename":"Udriku Suurjärv","sitedescription":"Small lake in the NNW Estonia. Physiography: on the NNW slope of the Pandivere Upland. Surrounding vegetation: the Boreo-Nemoral Zone, where Betula pendula, Pinus sylvestris and Picea abies are pre dominant.","sitenotes":"The hummocky and rolling landscape on the lake catchment ranges to 115.2 m a.s.l. and mainly composed of sand and gravel, while the \r\nonly lower part of the sediment in depths from the water surface 650-828 cm was analysed\r\nIn the SW part of the region, the Pikassaare–Ohepalu esker borders the coast and forms the sandy shore. This elongated, dystrophic lake is poorly drained. It receives in flow from Lake Udriku Väikejärv and weak temporal outflow occurs via a ditch and the Palaoja Stream (Fig. 1B) to a river in the west. The lake water is reddish-brown, mildly acidic (pH 6.0), rich in organic (33–38 mg l –1O2) compounds and poor in mineral (<10 mg l–1) compounds and water plants.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[25.93154,59.37186]}","altitude":97,"collectionunitid":39815,"collectionunit":"Udriku core","handle":"UDRIKU","unittype":"Core","datasets":[{"doi":["10.21233/akff-zk13","10.21233/FPAP-6Z76"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14113,"ageyoung":10484}],"database":"European Pollen Database","datasetid":55163,"datasetpi":[{"initials":"S.","contactid":1296,"firstname":"Siim","familyname":"Veski","contactname":"Veski, Siim"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T. to the EPD/Neotoma.","recdatecreated":"2022-10-25T11:56:28"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55162,"datasetpi":[{"initials":"S.","contactid":1296,"firstname":"Siim","familyname":"Veski","contactname":"Veski, Siim"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-10-25T11:56:16"}]}},{"site":{"siteid":29176,"sitename":"Lasva","sitedescription":"Small lake. Physiography: glacial origine. Surrounding vegetation: Pine in north, agrarian landscape with fields and farms.","sitenotes":"This elongated eutrophic hard-water lake is slightly drained; it has an inflow from the south and a weak temporal outflow via a ditch to a river in the northwest. Glaciolacustrine silt and sandy loam with small spots of till near the northeastern shore cover the catchment of the lake. Pine grows north of the lake, on the sandy hill reaching 87.7 m a.s.l. Generally the landscape is agrarian, with some abandoned fields and farms. At the northern shore the lake bottom is covered by sand, elsewhere – by gyttja. The water is yellow-green, moderately transparent (2.3 m) and strongly and the oxygen content is very low in bottom. Temperature difference between\r\nthe surface and bottom layers is up to 14°C. The water is alkaline, with pH of 8.0 near the surface and 6.7 – deeper.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[27.175,57.85944]}","altitude":58,"collectionunitid":39825,"collectionunit":"Lasva","handle":"LASVA","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55308,"datasetpi":[{"initials":"E.","contactid":9660,"firstname":"Eve","familyname":"Niinemets","contactname":"Niinemets, Eve"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-10-27T10:27:17"},{"doi":["10.21233/5KYS-CC48","10.21233/kn47-qm43"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":6283,"ageyoung":-47}],"database":"European Pollen Database","datasetid":55309,"datasetpi":[{"initials":"E.","contactid":9660,"firstname":"Eve","familyname":"Niinemets","contactname":"Niinemets, Eve"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T to the EPD/Neotoma.","recdatecreated":"2022-10-27T10:27:28"}]}},{"site":{"siteid":29180,"sitename":"Hino","sitedescription":"Mire. Physiography: kettelhole. Surrounding vegetation: cultivated fields and forest.","sitenotes":"Coring site was chosen in connection with archaeological excavations at the burial ground and settlement of Siksali near Lake Hino (early farming population). The coring site is in the marschy area between the northeastern shore of Lake Hino and Lake Mustjärv, which was divided off from the former Lake Hino in the 1850s after the water level had dropped by 3.5 m.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[27.23861,57.58306]}","altitude":190,"collectionunitid":39830,"collectionunit":"Hino","handle":"HINO","unittype":"Core","datasets":[{"doi":["10.21233/HGQV-8F41","10.21233/ngeh-ex96"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":11845,"ageyoung":349}],"database":"European Pollen Database","datasetid":55439,"datasetpi":[{"initials":"K.","contactid":1122,"firstname":"Kersti","familyname":"Kihno","contactname":"Kihno, Kersti"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T tyo the EPD/Neotoma","recdatecreated":"2022-10-28T12:04:46"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55438,"datasetpi":[{"initials":"K.","contactid":1122,"firstname":"Kersti","familyname":"Kihno","contactname":"Kihno, Kersti"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-10-28T12:04:37"}]}},{"site":{"siteid":29193,"sitename":"Kiilaspere","sitedescription":"Small quite round-shaped ombrotrophic bog. Physiography: shallow depression  behind the Ancylus Lake beach ridge. Surrounding vegetetion: Pine and cultivated fields.","sitenotes":"The north-eastern parts of the bog have been used for local peat mining as judged from the peat cutting holes. The bog is today largely covered with pine forest due to ditching and peat cutting. The bog lies in a shallow depression.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[24.43611,58.79694]}","altitude":16,"collectionunitid":39845,"collectionunit":"Kiilaspere","handle":"KIILASPE","unittype":"Core","datasets":[{"doi":["10.21233/75F5-MR95","10.21233/cb1g-q949"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":2127,"ageyoung":-35}],"database":"European Pollen Database","datasetid":55574,"datasetpi":[{"initials":"S.","contactid":1296,"firstname":"Siim","familyname":"Veski","contactname":"Veski, Siim"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T. to the EPD/Neotoma.","recdatecreated":"2022-11-02T13:16:44"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55573,"datasetpi":[{"initials":"S.","contactid":1296,"firstname":"Siim","familyname":"Veski","contactname":"Veski, Siim"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-11-02T13:16:35"}]}},{"site":{"siteid":29332,"sitename":"Viitna Pikkjärv","sitedescription":"Lake Pikkjärv NS orientated ice-lock. Physiography: Between kames and esker in the Viitna kame field. Surrounding vegetation: forest.","sitenotes":"The lake has a steep shore and a small catchment area. It is a closed seepage lake without surface inlet or outlet. The lake bottom is uneven, disjointed by kames, two of which are high enough to form islands. The lake bottom is covered by 5 m thick gyttja.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[26.01056,59.44639]}","altitude":59,"collectionunitid":40020,"collectionunit":"Viitna Pikkjärv core","handle":"VIITNAPI","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55814,"datasetpi":[{"initials":"A.","contactid":1204,"firstname":"Anneli","familyname":"Poska","contactname":"Poska, Anneli"},{"initials":"L.","contactid":754,"firstname":"Leili","familyname":"Saarse","contactname":"Saarse, Leili"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2023-01-13T08:54:19"},{"doi":["10.21233/8NQB-FF71","10.21233/wtmc-mj64"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":11028,"ageyoung":-18}],"database":"European Pollen Database","datasetid":55815,"datasetpi":[{"initials":"A.","contactid":1204,"firstname":"Anneli","familyname":"Poska","contactname":"Poska, Anneli"},{"initials":"L.","contactid":754,"firstname":"Leili","familyname":"Saarse","contactname":"Saarse, Leili"}],"datasettype":"pollen","datasetnotes":"Data contributed by Reitalu, T. to the EPD/Neotoma.","recdatecreated":"2023-01-13T08:54:29"}]}},{"site":{"siteid":29371,"sitename":"PS2863","sitedescription":"Fram Strait","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[10.29933,80.55767]}","altitude":-782,"collectionunitid":40073,"collectionunit":"PS2863-1","handle":"PS2863-1","unittype":"Core","datasets":[{"doi":["10.21233/810z-p560","10.21233/T0WS-QN04"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":21266,"ageyoung":8243.6}],"database":"Marine Dinoflagellates Database","datasetid":55891,"datasetpi":[{"initials":"A.","contactid":286,"firstname":"Anne","familyname":"de Vernal","contactname":"de Vernal, Anne"},{"initials":"J.","contactid":18845,"firstname":"Jade","familyname":"Falardeau","contactname":"Falardeau, Jade"},{"initials":"R.F.","contactid":18269,"firstname":"Robert F.","familyname":"Spielhagen","contactname":"Spielhagen, Robert F."}],"datasettype":"dinoflagellates","datasetnotes":null,"recdatecreated":"2023-02-10T21:31:32"},{"doi":[],"agerange":[],"database":"Marine Dinoflagellates Database","datasetid":55890,"datasetpi":[{"initials":"A.","contactid":286,"firstname":"Anne","familyname":"de Vernal","contactname":"de Vernal, Anne"},{"initials":"J.","contactid":18845,"firstname":"Jade","familyname":"Falardeau","contactname":"Falardeau, Jade"},{"initials":"R.F.","contactid":18269,"firstname":"Robert F.","familyname":"Spielhagen","contactname":"Spielhagen, Robert F."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2023-02-10T21:31:27"}]}},{"site":{"siteid":29371,"sitename":"PS2863","sitedescription":"Fram Strait","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[10.29933,80.55767]}","altitude":-782,"collectionunitid":40074,"collectionunit":"PS2863-2","handle":"PS2863-2","unittype":"Core","datasets":[{"doi":["10.21233/YKBN-8H92"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":7713.9,"ageyoung":936}],"database":"Marine Dinoflagellates Database","datasetid":55892,"datasetpi":[{"initials":"A.","contactid":286,"firstname":"Anne","familyname":"de Vernal","contactname":"de Vernal, Anne"},{"initials":"J.","contactid":18845,"firstname":"Jade","familyname":"Falardeau","contactname":"Falardeau, Jade"},{"initials":"R.F.","contactid":18269,"firstname":"Robert F.","familyname":"Spielhagen","contactname":"Spielhagen, Robert F."}],"datasettype":"dinoflagellates","datasetnotes":null,"recdatecreated":"2023-02-14T15:38:25"}]}},{"site":{"siteid":29372,"sitename":"MSM5/5-712-2","sitedescription":"Fram Strait","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[6.76733,78.91567]}","altitude":-1497,"collectionunitid":40075,"collectionunit":"MSM5/5-712-2","handle":"MSM5-712-2","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"Marine Dinoflagellates Database","datasetid":55893,"datasetpi":[{"initials":"A.","contactid":286,"firstname":"Anne","familyname":"de Vernal","contactname":"de Vernal, Anne"},{"initials":"J.","contactid":18845,"firstname":"Jade","familyname":"Falardeau","contactname":"Falardeau, Jade"},{"initials":"R.F.","contactid":18269,"firstname":"Robert F.","familyname":"Spielhagen","contactname":"Spielhagen, Robert F."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2023-02-14T21:54:22"},{"doi":["10.21233/9R7K-AJ80"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":22925.4,"ageyoung":349.5}],"database":"Marine Dinoflagellates Database","datasetid":55894,"datasetpi":[{"initials":"A.","contactid":286,"firstname":"Anne","familyname":"de Vernal","contactname":"de Vernal, Anne"},{"initials":"J.","contactid":18845,"firstname":"Jade","familyname":"Falardeau","contactname":"Falardeau, Jade"},{"initials":"R.F.","contactid":18269,"firstname":"Robert F.","familyname":"Spielhagen","contactname":"Spielhagen, Robert F."}],"datasettype":"dinoflagellates","datasetnotes":null,"recdatecreated":"2023-02-14T21:54:26"}]}},{"site":{"siteid":29383,"sitename":"Lina myr","sitedescription":"Lina myr (57° 34′ 31.764″ N, 18° 37′ 59.124″ E), situated 6.3 km southwest of Åminne and 21 km east of Visby, is a 9-km2 area of\r\ncultivated, drained fenland. The area stretches for 6 km from southwest to northeast and 2 km in an east to west direction. Lina myr drains in a northeast direction toward the east coast of\r\nGotland via the Gothem River. The Gothem River was straightened during the draining of the fen in the 1940s. Today, the elevation\r\nof the Lina myr fen is about 9 m a.s.l. The original basin threshold is estimated to be 9.5–9.9 m a.s.l., based on a cross-section established from modern digital evaluation models (Barliaev, 2017). To the west of the fen the surface geology consists of marl and\r\nfurther to the west of glacial till (Figure 1c). To the east, limestone bedrock is exposed. The island of Gotland consists of Silurian\r\nlimestone (Hede, 1925). The bedrock of Lina myr is classified as the Halla Formation (Laufeld, 1974).","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[18.63309,57.57549]}","altitude":20,"collectionunitid":40090,"collectionunit":"Core 7 (master core)","handle":"LINAMYR","unittype":"Core","datasets":[{"doi":["10.21233/2rkh-ve69","10.21233/GGE8-6342"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10416,"ageyoung":2117}],"database":"European Pollen Database","datasetid":55917,"datasetpi":[{"initials":"A.","contactid":16518,"firstname":"Aleftin","familyname":"Barliaev","contactname":"Barliaev, Aleftin"},{"initials":"H.","contactid":18417,"firstname":"Helene","familyname":"Martinsson-Wallin","contactname":"Martinsson-Wallin, Helene"},{"initials":"I.W.","contactid":18418,"firstname":"Ian","familyname":"Croudace","contactname":"Croudace, Ian"},{"initials":"J.","contactid":1218,"firstname":"Jan","familyname":"Risberg","contactname":"Risberg, Jan"},{"initials":"M.","contactid":17040,"firstname":"Martina","familyname":"Hättestrand","contactname":"Hättestrand, Martina"},{"initials":"M.","contactid":18398,"firstname":"Malin","familyname":"Kylander","contactname":"Kylander, Malin"},{"initials":"N.A.","contactid":16519,"firstname":"Nichola A.","familyname":"Strandberg","contactname":"Strandberg, Nichola A."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2023-02-23T08:10:14"},{"doi":["10.21233/4v4c-rx76","10.21233/Z6X3-PF69"],"agerange":[],"database":"European Pollen Database","datasetid":55918,"datasetpi":[{"initials":"A.","contactid":16518,"firstname":"Aleftin","familyname":"Barliaev","contactname":"Barliaev, Aleftin"},{"initials":"H.","contactid":18417,"firstname":"Helene","familyname":"Martinsson-Wallin","contactname":"Martinsson-Wallin, Helene"},{"init