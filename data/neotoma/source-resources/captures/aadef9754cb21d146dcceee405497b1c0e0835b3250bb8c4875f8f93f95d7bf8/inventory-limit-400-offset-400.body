:"Gunnar","familyname":"Mallon","contactname":"Mallon, Gunnar"},{"initials":"G.T.","contactid":11443,"firstname":"Graeme","familyname":"Swindles","contactname":"Swindles, Graeme"},{"initials":"J.","contactid":15631,"firstname":"Joseph","familyname":"Holden","contactname":"Holden, Joseph"},{"initials":"M.","contactid":7267,"firstname":"Mariusz","familyname":"Lamentowicz","contactname":"Lamentowicz, Mariusz"},{"initials":"M.J.","contactid":7245,"firstname":"Matthew J.","familyname":"Amesbury","contactname":"Amesbury, Matthew J."},{"initials":"R.J.","contactid":6543,"firstname":"Richard","familyname":"Payne","contactname":"Payne, Richard"},{"initials":"T.E.","contactid":604,"firstname":"T. Edward","familyname":"Turner","contactname":"Turner, T. Edward"},{"initials":"T.P.","contactid":13988,"firstname":"Thomas P.","familyname":"Roland","contactname":"Roland, Thomas P."},{"initials":"Y.A.","contactid":9442,"firstname":"Yuri","familyname":"Mazei","contactname":"Mazei, Yuri"}],"datasettype":"testate amoebae surface sample","datasetnotes":null,"recdatecreated":"2019-08-06T16:37:53"}]}},{"site":{"siteid":26163,"sitename":"Oxnop Moor","sitedescription":"Part of a larger area of blanket bog covering the upland watershed between Wensleydale and Swaledale. The moor has a mosaic of habitats and bog types, and is part of the North Pennines SAC and Special Protection Area (SPA), and the Lovely Seat — Stainton Moor SSSI complex of over 10,128 ha. Areas are managed for grouse shooting through gripping and rotationa lC. vulgaris burning, with some livestock grazing. The sampling location lies within a relatively undisturbed area of ombrotrophic blanket bog isolated from groundwater and surface inflow through substrate topography. As well as extensive C. vulgaris cover, typical peat-forming vege- tation is present; Eriophorum spp. and Sphagna including S. capillifolium, S. papillosum and S. cuspidatum.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-2.0961,54.34556]}","altitude":480,"collectionunitid":32378,"collectionunit":"OM148","handle":"OM_OM148","unittype":"Modern","datasets":[{"doi":["10.21233/tpyc-dh78"],"agerange":[{"units":"Calendar years BP","ageold":-62,"ageyoung":-62}],"database":"Neotoma Testate Amoebae Database","datasetid":45565,"datasetpi":[{"initials":"A.","contactid":6308,"firstname":"Antony","familyname":"Blundell","contactname":"Blundell, Antony"},{"initials":"A.A.","contactid":14022,"firstname":"Anatoly A","familyname":"Bobrov","contactname":"Bobrov, Anatoly A"},{"initials":"B.G.","contactid":105,"firstname":"Barry G.","familyname":"Warner","contactname":"Warner, Barry G."},{"initials":"D.J.","contactid":7252,"firstname":"Daniel J.","familyname":"Charman","contactname":"Charman, Daniel J."},{"initials":"E.A.D.","contactid":9337,"firstname":"Edward A. D.","familyname":"Mitchell","contactname":"Mitchell, Edward A. D."},{"initials":"G.","contactid":7272,"firstname":"Gunnar","familyname":"Mallon","contactname":"Mallon, Gunnar"},{"initials":"G.T.","contactid":11443,"firstname":"Graeme","familyname":"Swindles","contactname":"Swindles, Graeme"},{"initials":"J.","contactid":15631,"firstname":"Joseph","familyname":"Holden","contactname":"Holden, Joseph"},{"initials":"M.","contactid":7267,"firstname":"Mariusz","familyname":"Lamentowicz","contactname":"Lamentowicz, Mariusz"},{"initials":"M.J.","contactid":7245,"firstname":"Matthew J.","familyname":"Amesbury","contactname":"Amesbury, Matthew J."},{"initials":"R.J.","contactid":6543,"firstname":"Richard","familyname":"Payne","contactname":"Payne, Richard"},{"initials":"T.E.","contactid":604,"firstname":"T. Edward","familyname":"Turner","contactname":"Turner, T. Edward"},{"initials":"T.P.","contactid":13988,"firstname":"Thomas P.","familyname":"Roland","contactname":"Roland, Thomas P."},{"initials":"Y.A.","contactid":9442,"firstname":"Yuri","familyname":"Mazei","contactname":"Mazei, Yuri"}],"datasetty