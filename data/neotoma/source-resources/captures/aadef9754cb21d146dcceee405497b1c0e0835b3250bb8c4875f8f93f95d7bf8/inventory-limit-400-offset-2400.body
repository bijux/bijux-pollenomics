IND","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"Neotoma","datasetid":74635,"datasetpi":[{"initials":"N.L.","contactid":22312,"firstname":"Nicholas L.","familyname":"Balascio","contactname":"Balascio, Nicholas L."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-07-08T03:35:09"},{"doi":["10.21233/f0bj-5v21","10.21233/z6na-dj37"],"agerange":[],"database":"Neotoma","datasetid":74633,"datasetpi":[{"initials":"M.","contactid":22308,"firstname":"Martina","familyname":"Tingley","contactname":"Tingley, Martina"}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2026-07-08T03:30:22"},{"doi":[],"agerange":[],"database":null,"datasetid":74634,"datasetpi":[],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-07-08T03:32:53"}]}},{"site":{"siteid":42048,"sitename":"Lake Kragsø","sitedescription":"Small lake. Physiography: depression in fluvioglacial Weichselian sand and surrounded by the same on top of which locally are deposited eolian sands. Surrounded by conifer plantation with scattered oak and birch on fluvioglacial sand.","sitenotes":"The bottom two samples in the series have apparent deviant depths. These samples are from a separate coring which reached a bit further back than the main coring.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[9.09108,56.29126]}","altitude":47,"collectionunitid":55909,"collectionunit":"core 2A","handle":"KRAGSO2A","unittype":"Core","datasets":[{"doi":["10.21233/xxzb-9v55"],"agerange":[{"units":"Calendar years AD/BC","ageold":1989,"ageyoung":-8233},{"units":"Calibrated radiocarbon years BP","ageold":9250,"ageyoung":-39}],"database":"European Pollen Database","datasetid":74637,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"charcoal","datasetnotes":"Data contributed by Odgaard, B. to the EPD/Neotoma.","recdatecreated":"2026-07-10T07:25:24"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74636,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"geochronologic","datasetnotes":"Data processor: Jessie Woodbridge","recdatecreated":"2026-07-10T07:25:18"},{"doi":["10.21233/d6zx-ha38"],"agerange":[{"units":"Calendar years AD/BC","ageold":1989,"ageyoung":-8233},{"units":"Calibrated radiocarbon years BP","ageold":9250,"ageyoung":-39}],"database":"European Pollen Database","datasetid":74638,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2026-07-10T07:25:27"}]}},{"site":{"siteid":42057,"sitename":"Reidh Lochan","sitedescription":"Lake. Physiography: Acid, coarse-rained intrusive igneous rock. Soils include\r\ndeep peat, and peaty and humus-iron\r\npodzols. Surrounding vegetation: Blanket mire. Agricultura development in the eastern section.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[4.12389,58.03694]}","altitude":160,"collectionunitid":55916,"collectionunit":null,"handle":"REIDH","unittype":"Core","datasets":[{"doi":["10.21233/dyfv-3x62"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":9397,"ageyoung":-2}],"database":"European Pollen Database","datasetid":74649,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"pollen","datasetnotes":"Data contributed by Froyd, C.A. to the EPD/Neotoma.","recdatecreated":"2026-07-15T06:45:40"},{"doi":["10.21233/eyxe-fx32"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":9397,"ageyoung":-2}],"database":"European Pollen Database","datasetid":74648,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"microcharcoal","datasetnotes":"Data contributed by Froyd, C.A. to the EPD/Neotoma.","recdatecreated":"2026-07-15T06:45:37"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74647,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-07-15T06:45:30"}]}},{"site":{"siteid":42058,"sitename":"Lochan na h-Inghinn","sitedescription":"Lake. Physiography: Precambrian Lewisian gneiss. \"‘Knock-and-lochan\" topography (Linton, 1963). Peaty rankers and peaty gleys on knolls, interspersed with deep peat. Surrounding vegetation: Betula woodland on W and SW hillslopes, remainder of the catchment covered by blanket mire.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-5.09167,58.25417]}","altitude":65,"collectionunitid":55917,"collectionunit":null,"handle":"INGINN","unittype":"Core","datasets":[{"doi":["10.21233/66v8-nq43"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14337,"ageyoung":2}],"database":"European Pollen Database","datasetid":74651,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"microcharcoal","datasetnotes":"Dataset contributed by Froyd, C.A. to the EPD/Neotoma.","recdatecreated":"2026-07-15T12:35:13"},{"doi":["10.21233/wdqp-q352"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14337,"ageyoung":2}],"database":"European Pollen Database","datasetid":74652,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Froyd, C.A. to the EPD/Neotoma.","recdatecreated":"2026-07-15T12:35:16"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74650,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-07-15T12:35:05"}]}},{"site":{"siteid":42059,"sitename":"Dubh-Lochan","sitedescription":"Lake. Physiography: Conglomerate Middle Old Red Sandstone, with intrusive igneous rock in SE. Soils are a mix of peaty and podzolic rankers and humus-iron podzols. Surrounding vegetation: Betula woodland. Open, grazed areas bordering the lake are dominated by Poaceae, Calluna vulgaris and Sphagnum.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[4.43528,57.29056]}","altitude":150,"collectionunitid":55918,"collectionunit":null,"handle":"DUBH","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74653,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-07-15T13:53:06"},{"doi":["10.21233/1m7v-w141"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":11052,"ageyoung":55}],"database":"European Pollen Database","datasetid":74654,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"microcharcoal","datasetnotes":"Data contributed by Froyd, C.A. to the EPD/Neotoma.","recdatecreated":"2026-07-15T13:53:12"},{"doi":["10.21233/xt9d-yd18"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":11052,"ageyoung":55}],"database":"European Pollen Database","datasetid":74655,"datasetpi":[{"initials":"C.A.","contactid":22329,"firstname":"Cynthia A.","familyname":"Froyd","contactname":"Froyd, Cynthia A."}],"datasettype":"pollen","datasetnotes":"Data contributed by Froyd, C.A. to the EPD/Neotoma.","recdatecreated":"2026-07-15T13:53:15"}]}},{"site":{"siteid":42064,"sitename":"Hodson Tarn on Claife Heights","sitedescription":null,"sitenotes":"Validation status: green(see Dataset Notes)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-2.97241,54.37539]}","altitude":null,"collectionunitid":55950,"collectionunit":"NODE-R4135","handle":"NODE-R4135","unittype":"Modern","datasets":[{"doi":["10.21233/22je-vk09"],"agerange":[{"units":"Calendar years BP","ageold":-1,"ageyoung":-3}],"database":"Nonmarine Ostracod Distribution in Europe Database","datasetid":74687,"datasetpi":[{"initials":"W.J.P.","contactid":22330,"firstname":"William","familyname":"Smyly","contactname":"Smyly, William"}],"datasettype":"ostracode surface sample","datasetnotes":"This Ostracoda dataset was uploaded as part of the bulk import of NODE (Non-marine Ostracod Distribution in Europe) to Neotoma in 2026, using the DataBUS upload system (https://github.com/NeotomaDB/DataBUS). This database import was coordinated by Alison Smith, David Horne, Robin Smith, Andrew Anderson, Simon Goring, Socorro Dominguez, and Jack Williams. David Horne is the lead steward for the NODE database which was originally established by members of the EU Human Capital and Mobility Programme project “Evolutionary ecology of reproductive modes in non-marine Ostracoda” (1994-1996), primarily to enable mapping of sexual and parthenogenetic reproductive modes.  Further development of NODE has included continued data entry, application of taxonomic revisions, and validation exercises using Google Earth and other online resources to check, correct and refine the coordinates of every record. Each record is assigned a Validation Status colour: green (accurate), amber (as good as possible given limitations of published information) or red (uncertain or unreliable and in need of further checking). Users are advised to check the Validation Status (in Site Notes) of the data they map and consider eliminating any that are “red”. Species occurrence records are derived mainly from published literature spanning the 19th, 20th and 21st centuries and represent specimens that were (or are assumed to have been) collected alive. Taxonomic names have been updated in accordance with the global checklist of Meisch et al. (2024: https://doi.org/10.5852/ejt.2024.974.2767) but NODE also includes the original “Name in Reference” as given in the source of the occurrence record (see Collection Unit Notes).\\nNODE records include additional metadata such as environmental classifications of sites and taxonomic/nomenclatural comments that are being prepared for future import to Neotoma.","recdatecreated":"2026-07-16T19:36:26"}]}},{"site":{"siteid":42133,"sitename":"Kulivatnet","sitedescription":"Kulivatnet is a small subarctic lake in northern Norway. The lake is located within the Vågneselva, a northeast-southwest trending glacially sculpted lineament. It is situated within a small but hilly catchment area, with hills up to 120 m high.  Runoff from this catchment and from the small boggy area to the southwest supplies the lake with water.  There is a single outflow at the northeast end of the lake. Vegetation around the lake can be characterized as Betula-woodland. The dominant tree is Betula pubescens, although Pinus sylvestris and Picea abies are found planted on a small hill around the pond.  Shrubs include several species of Salix sp., along with Sorbus aucuparia.  Among the common subshrubs are Vaccinium myrtillis, Vaccinium vitis-idaea.   Chamaepericlymenum suecicum, Juniperus communis and Empetrum nigrum.  Along with numerous species of Poaceae and Cyperaceae, common herbs include Geranium cf sylvaticum.  Campanula cf rotundifolia, Solidago virgaurea, Fragaria vesca and Pedicularis sceptrum-carolinum, with members of the Fabaceae, Apiace and Schrophulariaceae.  Equisetum pratense, Eriophorum angustifolium, Bistorta vivipara and Menyanthes trifoliata grow in wetter areas near and along the shore.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[19.28,69.77]}","altitude":75,"collectionunitid":56050,"collectionunit":null,"handle":"KULIVAT","unittype":"Core","datasets":[{"doi":["10.21233/rce6-h991"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14840,"ageyoung":-50}],"database":"Neotoma","datasetid":74808,"datasetpi":[{"initials":"R.S.","contactid":7,"firstname":"R. Scott","familyname":"Anderson","contactname":"Anderson, R. Scott"}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2026-08-18T21:17:00"},{"doi":[],"agerange":[],"database":"Neotoma","datasetid":74807,"datasetpi":[{"initials":"R.S.","contactid":7,"firstname":"R. Scott","familyname":"Anderson","contactname":"Anderson, R. Scott"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-08-18T21:16:54"}]}},{"site":{"siteid":42135,"sitename":"Elbe Palaeovalley (S) AU04 07VC","sitedescription":"North Sea floor northeast of Helgoland","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[8.0699,54.2829]}","altitude":-20,"collectionunitid":56052,"collectionunit":"AU04 07VC","handle":"AU0407VC","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74811,"datasetpi":[{"initials":"A.","contactid":20344,"firstname":"Annemiek","familyname":"Vink","contactname":"Vink, Annemiek"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-08-20T15:18:34"},{"doi":["10.21233/5p5d-vf12"],"agerange":[],"database":"European Pollen Database","datasetid":74812,"datasetpi":[{"initials":"S.","contactid":8711,"firstname":"Steffen","familyname":"W