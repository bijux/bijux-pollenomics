name":"Kanna fen","sitedescription":"Kanna spring fen is located on Saaremaa island on the slope of the higher part of the west Saaremaa upland. Upland forest  is dominated by Pinus sylvestris, Picea abies, Betula pubescens, Alnus glutinosa, and Quercus robur. The landscape is a mosaic of forest, traditionally managed meadows, wooded meadows, fens, and bogs. Local fen vegetation is the Scorpidio-Schoenetum association, dominated by Schoenus ferrugineus, Carex spp., Eriophorum latifolium, Phragmites australis, Molinia caerulea, Juncus subnodulosus, and Menyanthes trifoliata.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[22.09672,58.32503]}","altitude":30,"collectionunitid":35115,"collectionunit":null,"handle":"KANNA","unittype":"Core","datasets":[{"doi":["10.21233/9vap-t645","10.21233/9VAP-T645"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":9397,"ageyoung":-63}],"database":"European Pollen Database","datasetid":48738,"datasetpi":[{"initials":"A.","contactid":16553,"firstname":"Ansis","familyname":"Blaus","contactname":"Blaus, Ansis"}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2020-10-30T21:38:10"},{"doi":["10.21233/8V7W-ZA62"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":9397,"ageyoung":-63}],"database":"Neotoma Charcoal Data","datasetid":48737,"datasetpi":[{"initials":"A.","contactid":16553,"firstname":"Ansis","familyname":"Blaus","contactname":"Blaus, Ansis"}],"datasettype":"microcharcoal","datasetnotes":null,"recdatecreated":"2020-10-30T21:38:07"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":48736,"datasetpi":[{"initials":"A.","contactid":16553,"firstname":"Ansis","familyname":"Blaus","contactname":"Blaus, Ansis"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2020-10-30T21:38:03"}]}},{"site":{"siteid":27265,"sitename":"Doggerbank","sitedescription":"North Sea, souther