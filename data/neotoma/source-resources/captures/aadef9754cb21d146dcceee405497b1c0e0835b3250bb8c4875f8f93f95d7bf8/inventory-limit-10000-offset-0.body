terozoic to Cambrian age sandstones, with quartzite, amphibolite and conglomerate layers. Site is located in tundra, a major component of which are dwarf-shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium vitis-idaea, V. uliginosum, V. myrtillus, and Betula nana as frequent and locally co-dominant components.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[25.36415,71.07382],[25.37327,71.07382],[25.37327,71.07515],[25.36415,71.07515],[25.36415,71.07382]]]}","altitude":38,"collectionunitid":15098,"collectionunit":null,"handle":"CAPPESJA","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20276,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:19"},{"doi":["10.21233/ktat-6f10"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13908,"ageyoung":69}],"database":"European Pollen Database","datasetid":20278,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"loss-on-ignition","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:32"},{"doi":["10.21233/d73q-6954"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13908,"ageyoung":69}],"database":"European Pollen Database","datasetid":20279,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:36"},{"doi":["10.21233/x46r-2615"],"agerange":[],"database":"European Plant Macrofossil Database","datasetid":20277,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"plant macrofossil","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:29"}]}},{"site":{"siteid":13478,"sitename":"Over Gunnarsfjorden","sitedescription":"Glacial origin lake. Metamorphic rocks, mostly micaceous and garnetiferous schists and slates of Caledonian. age (ca 550–400Ma), predominate the catchment. Local vegetation is tundra, dwarf shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium spp. and Betula nana.","sitenotes":"Called Hestevannet on Google Earth.","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[28.16545,71.03753],[28.17268,71.03753],[28.17268,71.03858],[28.16545,71.03858],[28.16545,71.03753]]]}","altitude":75,"collectionunitid":15100,"collectionunit":null,"handle":"GUNNARS","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20282,"datasetpi":[{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-08-09T15:51:48"},{"doi":["10.21233/596x-by72"],"agerange":[],"database":"European Plant Macrofossil Database","datasetid":20283,"datasetpi":[{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"plant macrofossil","datasetnotes":null,"recdatecreated":"2016-08-09T15:51:57"},{"doi":["10.21233/btfj-f709"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10201,"ageyoung":-37}],"database":"European Pollen Database","datasetid":20284,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"loss-on-ignition","datasetnotes":null,"recdatecreated":"2016-08-09T15:52:00"},{"doi":["10.21233/8s7z-k891"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10201,"ageyoung":-37}],"database":"European Pollen Database","datasetid":20285,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2016-08-09T15:52:04"}]}},{"site":{"siteid":13481,"sitename":"Over Kobbkrokvatnet","sitedescription":"Glacial origin lake lying within the Risvik sub-stage ice limit and just outside the Outer Porsanger moraine that runs along the ridge to the south of the lake. Site is located in tundra with are dwarf-shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium vitis-idaea, V. uliginosum, V. myrtillus, and Betula nana as frequent and locally co-dominant components. The local bedrock is mostly dark grey sandstone, alternating with layers of grey-black mudstone and shale, assigned to the Barents Sea group and marginal to the rocks of the Caledonian orogeny.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[29.29295,70.6989],[29.29736,70.6989],[29.29736,70.70018],[29.29295,70.70018],[29.29295,70.6989]]]}","altitude":47,"collectionunitid":15103,"collectionunit":null,"handle":"KOBBKROK","unittype":"Core","datasets":[{"doi":["10.21233/snyf-b526"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13492,"ageyoung":42}],"database":"European Pollen Database","datasetid":20293,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2016-08-11T06:10:41"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20290,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-08-11T06:10:29"},{"do