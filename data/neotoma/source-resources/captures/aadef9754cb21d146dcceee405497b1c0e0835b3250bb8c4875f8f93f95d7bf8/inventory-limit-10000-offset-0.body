62034,"datasetpi":[{"initials":"H.H.","contactid":116,"firstname":"Hilary H.","familyname":"Birks","contactname":"Birks, Hilary H."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-11T07:08:46"}]}},{"site":{"siteid":33301,"sitename":"Lusvatnet","sitedescription":"Small oval lake. Physiography: small cirque glacier that drained into Lusvatnet during the\r\nLateglacial. Surrounding vegetation: Open birch woodland dominated by Betula pubescens ssp. tortuosa and with a predominantly ericaceous or tall-fern-dominated understory clothes the steep lower slopes. Above the tree-line, the vegetation is composed of ericaceous dwarf-shrubs and grasses on sheltered slopes, open grass-heath on exposed ridges, and cliff vegetation around the head of the lake where several arctic-alpine and montane species occur.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[15.56667,69.06667]}","altitude":30,"collectionunitid":45055,"collectionunit":"core LUP207","handle":"LUSVATN","unittype":"Core","datasets":[{"doi":["10.21233/y9q5-4164"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13705,"ageyoung":7136}],"database":"European Pollen Database","datasetid":62037,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-11T07:15:39"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62036,"datasetpi":[{"initials":"H.H.","contactid":116,"firstname":"Hilary H.","familyname":"Birks","contactname":"Birks, Hilary H."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-11T07:15:32"}]}},{"site":{"siteid":36445,"sitename":"Dalsträsk","sitedescription":"Lake. Physiography: glacial origin. Surrounding vegetation: forest.",