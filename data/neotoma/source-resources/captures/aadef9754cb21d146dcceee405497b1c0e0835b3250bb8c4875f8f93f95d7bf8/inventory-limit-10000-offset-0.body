2-gf73"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8023,"ageyoung":3586}],"database":"European Pollen Database","datasetid":61989,"datasetpi":[{"initials":"K.R.","contactid":20255,"firstname":"Kenneth R.","familyname":"Hirons","contactname":"Hirons, Kenneth R."}],"datasettype":"loss-on-ignition","datasetnotes":"Data contributed by Schofield, J.E. to the EPD/Neotoma.","recdatecreated":"2025-03-26T07:44:30"},{"doi":["10.21233/t57w-dh42"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8023,"ageyoung":3586}],"database":"European Pollen Database","datasetid":61990,"datasetpi":[{"initials":"K.J.","contactid":1393,"firstname":"Kevin J.","familyname":"Edwards","contactname":"Edwards, Kevin J."},{"initials":"K.R.","contactid":20255,"firstname":"Kenneth R.","familyname":"Hirons","contactname":"Hirons, Kenneth R."},{"initials":"P.J.","contactid":19420,"firstname":"Patrick J.","familyname":"Newell","contactname":"Newell, Patrick J."}],"datasettype":"charcoal","datasetnotes":"Data contributed by Schofield, J.E. to the EPD/Neotoma.","recdatecreated":"2025-03-26T07:44:33"}]}},{"site":{"siteid":33292,"sitename":"Svanåvatnet","sitedescription":"Lake. Physiography: depression. Surrounding vegetation: P. abies with some P. sylvestris and B. pubescens.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[14.05,66.41667]}","altitude":243,"collectionunitid":45043,"collectionunit":"SVAN","handle":"SVAN","unittype":"Core","datasets":[{"doi":["10.21233/a4ey-3738"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":4139,"ageyoung":-50}],"database":"European Pollen Database","datasetid":62016,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"charcoal","datasetnotes":"Data contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-08T08:07:22"},{"doi":["10.21233/sg1z-jc18"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8721,"ageyoung":-50}],"database":"European Pollen Database","datasetid":62017,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Data contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-08T08:07:25"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62015,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"},{"initials":"H.J.B.","contactid":14,"firstname":"Harry John Betteley","familyname":"Birks","contactname":"Birks, Harry John Betteley"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-08T08:07:16"}]}},{"site":{"siteid":33294,"sitename":"Ähijärv","sitedescription":"Lake Ähijärv is a large lake with uneven bottom relief in Karula Upland. The surrounding of the lake is dominated by forests.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[26.49778,57.71139]}","altitude":78,"collectionunitid":45046,"collectionunit":"Ähijärv","handle":"ÄHIJRV","unittype":"Core","datasets":[{"doi":["10.21233/jrqq-xe90"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10536,"ageyoung":-62}],"database":"European Pollen Database","datasetid":62021,"datasetpi":[{"initials":"A.","contactid":1204,"firstname":"Anneli","familyname":"Poska","contactname":"Poska, Anneli"}],"datasettype":"pollen","datasetnotes":"Depths are all from the water surface. Water depth 540 cm.","recdatecreated":"2025-04-10T09:58:23"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62020,"datasetpi":[{"initials":"J.","contactid":15763,"firstname":"Jüri","familyname":"Vassiljev","contactname":"Vassiljev, Jüri"}],"dataset