icum, H. cupressiforme, Aulacomnium palustre and Racomitrium lanuginosum occurring frequently throughout.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-2.2094,54.24639]}","altitude":565,"collectionunitid":32353,"collectionunit":"FM118","handle":"FM_FM118","unittype":"Modern","datasets":[{"doi":["10.21233/0017-2n24"],"agerange":[{"units":"Calendar years BP","ageold":-62,"ageyoung":-62}],"database":"Neotoma Testate Amoebae Database","datasetid":45540,"datasetpi":[{"initials":"A.","contactid":6308,"firstname":"Antony","familyname":"Blundell","contactname":"Blundell, Antony"},{"initials":"A.A.","contactid":14022,"firstname":"Anatoly A","familyname":"Bobrov","contactname":"Bobrov, Anatoly A"},{"initials":"B.G.","contactid":105,"firstname":"Barry G.","familyname":"Warner","contactname":"Warner, Barry G."},{"initials":"D.J.","contactid":7252,"firstname":"Daniel J.","familyname":"Charman","contactname":"Charman, Daniel J."},{"initials":"E.A.D.","contactid":9337,"firstname":"Edward A. D.","familyname":"Mitchell","contactname":"Mitchell, Edward A. D."},{"initials":"G.","contactid":7272,"firstname":"Gunnar","familyname":"Mallon","contactname":"Mallon, Gunnar"},{"initials":"G.T.","contactid":11443,"firstname":"Graeme","familyname":"Swindles","contactname":"Swindles, Graeme"},{"initials":"J.","contactid":15631,"firstname":"Joseph","familyname":"Holden","contactname":"Holden, Joseph"},{"initials":"M.","contactid":7267,"firstname":"Mariusz","familyname":"Lamentowicz","contactname":"Lamentowicz, Mariusz"},{"initials":"M.J.","contactid":7245,"firstname":"Matthew J.","familyname":"Amesbury","contactname":"Amesbury, Matthew J."},{"initials":"R.J.","contactid":6543,"firstname":"Richard","familyname":"Payne","contactname":"Payne, Richard"},{"initials":"T.E.","contactid":604,"firstname":"T. Edward","familyname":"Turner","contactname":"Turner, T. Edward"},{"initials":"T.P.","contactid":13988,"firstn