:[{"initials":"P.","contactid":8809,"firstname":"Pim","familyname":"de Klerk","contactname":"de Klerk, Pim"}],"datasettype":"pollen","datasetnotes":"Data contributed by de Klerk, P.","recdatecreated":"2019-03-08T13:24:19"}]}},{"site":{"siteid":23888,"sitename":"Eldena","sitedescription":"Small hollow. Physiography: Little hollow in lowland. Surrounding vegetation: Cultivated fields and beech forest.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[13.43908,54.06065],[13.48199,54.06065],[13.48199,54.08281],[13.43908,54.08281],[13.43908,54.06065]]]}","altitude":19,"collectionunitid":28663,"collectionunit":"Hohlform 14 EAB","handle":"ELDENA14","unittype":"Core","datasets":[{"doi":["10.21233/vmst-1k86"],"agerange":[],"database":"European Pollen Database","datasetid":41433,"datasetpi":[{"initials":"P.","contactid":8809,"firstname":"Pim","familyname":"de Klerk","contactname":"de Klerk, Pim"}],"datasettype":"pollen","datasetnotes":"Data contributed by de Klerk, P.","recdatecreated":"2019-03-08T14:04:25"}]}},{"site":{"siteid":23909,"sitename":"Creich Castle","sitedescription":"Drained used for agriculture. Physiography: Small hollow on top of the plateau. Surrounding vegetation: Agricultural land, gorse, rowan, birch.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[-3.08333,56.38333]}","altitude":176,"collectionunitid":28689,"collectionunit":"boring 1","handle":"CREICHCA","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":41478,"datasetpi":[{"initials":"G.","contactid":1311,"firstname":"Graeme","familyname":"Whittington","contactname":"Whittington, Graeme"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2019-03-13T11:13:53"},{"doi":["10.21233/xsk9-bx90"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14766,"ageyoung":11572},{"units":"Radiocarbon years BP","ageold":12802,"ageyoung":9981}],"database":"European Pollen Database","datasetid":41479,"datasetpi":[{"initials":"G.","contactid":1311,"firstname":"Graeme","familyname":"Whittington","contactname":"Whittington, Graeme"}],"datasettype":"pollen","datasetnotes":"Data contributed by Whittington Graeme to the EPD.","recdatecreated":"2019-03-13T11:14:04"}]}},{"site":{"siteid":23911,"sitename":"Lough Mullaghlahan","sitedescription":"Lake occupies a rock basin formed by faulting and glacial scour. No inflowing streams, with a minor outflow, which may be artificial. Blanket peat occupies most of the catchment, with some small fields of rough pasture.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[-8.46915,54.77481],[-8.46732,54.77481],[-8.46732,54.77586],[-8.46915,54.77586],[-8.46915,54.77481]]]}","altitude":15,"collectionunitid":28692,"collectionunit":null,"handle":"MULLAG","unittype":"Core","datasets":[{"doi":["10.21233/chcb-ah47"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15385,"ageyoung":-32},{"units":"Radiocarbon years BP","ageold":12888,"ageyoung":0}],"database":"European Pollen Database","datasetid":41484,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"charcoal","datasetnotes":"Depth is from the water surface.\r\n\r\nCharcoal concentration calculated according to the method of Clark (1982, Pollen et Spores 24:523-535), where:\r\n\r\nVs = volume of sediment\r\nVe = volume exotic suspension\r\nS  = Suspension concentration\r\nF  = field area\r\nP  = total points on eyepiece reticule\r\nC  = points hitting charcoal\r\nE  = points hitting exotic\r\n\r\nAnd:\r\n\r\ncharcoal concentration (cm^2/ml) = C*Ve*S*F)/(E*Vs*P)","recdatecreated":"2019-03-14T00:17:32"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":41483,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2019-03-14T00:17:25"},{"doi":["10.21233/vgxh-qv84"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15385,"ageyoung":-32},{"units":"Radiocarbon years BP","ageold":12888,"ageyoung":0}],"database":"European Pollen Database","datasetid":41485,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"pollen","datasetnotes":"Depth is from the water surface.","recdatecreated":"2019-03-14T00:17:34"}]}},{"site":{"siteid":23911,"sitename":"Lough Mullaghlahan","sitedescription":"Lake occupies a rock basin formed by faulting and glacial scour. No inflowing streams, with a minor outflow, which may be artificial. Blanket peat occupies most of the catchment, with some small fields of rough pasture.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[-8.46915,54.77481],[-8.46732,54.77481],[-8.46732,54.77586],[-8.46915,54.77586],[-8.46915,54.77481]]]}","altitude":15,"collectionunitid":31639,"collectionunit":"Fossitt 1994 SS63","handle":"JAFSS63","unittype":"Modern","datasets":[{"doi":["10.21233/7kh7-fn19"],"agerange":[{"units":"Calendar years BP","ageold":-41,"ageyoung":-41}],"database":"European Pollen Database","datasetid":44716,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"charcoal surface sample","datasetnotes":null,"recdatecreated":"2019-06-18T18:34:52"},{"doi":["10.21233/k7s4-rk76"],"agerange":[{"units":"Calendar years BP","ageold":-41,"ageyoung":-41}],"database":"European Pollen Database","datasetid":44717,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"pollen surface sample","datasetnotes":null,"recdatecreated":"2019-06-18T18:34:55"}]}},{"site":{"siteid":23919,"sitename":"Lough Nabraddan","sitedescription":"Lake with minor inflow and outflow stream. Trees and arable land west of the lake; blanket peat and abandoned farmland east of the lake. Alnus glutinosa and Salix cinerea fringe the lake in the wettest areas, with Populus tremula and Sorbus aucuparia on steeper rocky slopes. Catchment was intesnsively cultivated in the past.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[-8.3499,55.0224],[-8.3485,55.0224],[-8.3485,55.02327],[-8.3499,55.02327],[-8.3499,55.0224]]]}","altitude":10,"collectionunitid":28700,"collectionunit":null,"handle":"NABRAD","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":41500,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2019-03-15T19:31:06"},{"doi":["10.21233/p674-8g06"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15274,"ageyoung":-32},{"units":"Radiocarbon years BP","ageold":12690,"ageyoung":0}],"database":"European Pollen Database","datasetid":41501,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"charcoal","datasetnotes":"Depth is from the water surface.\r\n\r\nCharcoal concentration calculated according to the method of Clark (1982, Pollen et Spores 24:523-535), where:\r\n\r\nVs = volume of sediment\r\nVe = volume exotic suspension\r\nS  = Suspension concentration\r\nF  = field area\r\nP  = total points on eyepiece reticule\r\nC  = points hitting charcoal\r\nE  = points hitting exotic\r\n\r\nAnd:\r\n\r\ncharcoal concentration (cm^2/ml) = C*Ve*S*F)/(E*Vs*P)","recdatecreated":"2019-03-15T19:31:13"},{"doi":["10.21233/3fmj-ne26"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15274,"ageyoung":-32},{"units":"Radiocarbon years BP","ageold":12690,"ageyoung":0}],"database":"European Pollen Database","datasetid":41502,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"pollen","datasetnotes":"Depth is from the water surface.","recdatecreated":"2019-03-15T19:31:16"}]}},{"site":{"siteid":23919,"sitename":"Lough Nabraddan","sitedescription":"Lake with minor inflow and outflow stream. Trees and arable land west of the lake; blanket peat and abandoned farmland east of the lake. Alnus glutinosa and Salix cinerea fringe the lake in the wettest areas, with Populus tremula and Sorbus aucuparia on steeper rocky slopes. Catchment was intesnsively cultivated in the past.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[-8.3499,55.0224],[-8.3485,55.0224],[-8.3485,55.02327],[-8.3499,55.02327],[-8.3499,55.0224]]]}","altitude":10,"collectionunitid":31625,"collectionunit":"Fossitt 1994 SS49","handle":"JAFSS49","unittype":"Modern","datasets":[{"doi":["10.21233/52pm-vy14"],"agerange":[{"units":"Calendar years BP","ageold":-41,"ageyoung":-41}],"database":"European Pollen Database","datasetid":44688,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"charcoal surface sample","datasetnotes":null,"recdatecreated":"2019-06-18T18:31:45"},{"doi":["10.21233/c212-j464"],"agerange":[{"units":"Calendar years BP","ageold":-41,"ageyoung":-41}],"database":"European Pollen Database","datasetid":44689,"datasetpi":[{"initials":"J.A.","contactid":15272,"firstname":"Julie A.","familyname":"Fossitt","contactname":"Fossitt, Julie A."}],"datasettype":"pollen surface sample","datasetnotes":null,"recdatecreated":"2019-06-18T18:31:47"}]}},{"site":{"siteid":24041,"sitename":"Lake Skaidejavri","sitedescription":"Medium size lake. Physiography: Rolling rockland. Surrounding vegetation: Sparse mountain birch forest.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[27.83997,70.0476],[27.85525,70.0476],[27.85525,70.0556],[27.83997,70.0556],[27.83997,70.0476]]]}","altitude":165,"collectionunitid":28852,"collectionunit":"core 1","handle":"SKAIDJVR","unittype":"Core","datasets":[{"doi":["10.21233/fka8-9069"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10977,"ageyoung":-49},{"units":"Radiocarbon years BP","ageold":9880,"ageyoung":0}],"database":"European Pollen Database","datasetid":41764,"datasetpi":[{"initials":"H.","contactid":1233,"firstname":"Heikki","familyname":"Seppä","contactname":"Seppä, Heikki"}],"datasettype":"pollen","datasetnotes":"Data contributed by Seppä Heikki.","recdatecreated":"2019-04-15T12:09:26"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":41763,"datasetpi":[{"initials":"H.","contactid":1233,"firstname":"Heikki","familyname":"Seppä","contactname":"Seppä, Heikki"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2019-04-15T12:09:18"}]}},{"site":{"siteid":24042,"sitename":"Lake Kvarnträsk","sitedescription":null,"sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[19.97168,60.34577]}","altitude":3,"collectionunitid":28853,"collectionunit":"core 2","handle":"KVARNTRA","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":41765,"datasetpi":[{"initials":"K.","contactid":1229,"firstname":"Kaarina","familyname":"Sarmaja-Korjonen","contactname":"Sarmaja-Korjonen, Kaarina"}],"