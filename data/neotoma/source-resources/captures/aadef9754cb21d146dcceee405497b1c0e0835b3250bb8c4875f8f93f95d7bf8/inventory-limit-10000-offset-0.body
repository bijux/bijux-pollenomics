n.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[15.86049,56.15907]}","altitude":11,"collectionunitid":3910,"collectionunit":null,"handle":"FARSKE","unittype":"Core","datasets":[{"doi":["10.21233/5sjg-nn53"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12730,"ageyoung":66},{"units":"Radiocarbon years BP","ageold":10424,"ageyoung":81}],"database":"European Pollen Database","datasetid":4037,"datasetpi":[{"initials":"B.E.","contactid":1000,"firstname":"Björn E.","familyname":"Berglund","contactname":"Berglund, Björn E."}],"datasettype":"pollen","datasetnotes":"Data contributed by Berglund Björn E.\r\nPollen diagram in publications starts at 290 cm. Depths in data sheet at 5 cm. Water depth is 285 cm. Lithology refers to the depths as shown in the pollen diagram.\r\n\r\nUpper section 0-590 cm is in pollen diagram I, lowest section is in pollen diagram VII.","recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":3104,"sitename":"Fjallsjön 1","sitedescription":"A lake. Physiography: an upland plateau with low relief. Surrounding vegetation: surrounded by mire, pine and spruce.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[12.85762,57.75152]}","altitude":275,"collectionunitid":3912,"collectionunit":null,"handle":"FJALLS","unittype":"Core","datasets":[{"doi":["10.21233/5pwr-dm25"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14893,"ageyoung":9780},{"units":"Radiocarbon years BP","ageold":12600,"ageyoung":8775}],"database":"European Pollen Database","datasetid":4039,"datasetpi":[{"initials":"A.","contactid":1092,"firstname":"Arne","familyname":"Hilldén","contactname":"Hilldén, Arne"}],"datasettype":"pollen","datasetnotes":"Data contributed by Berglund Björn E.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Dat