{"status":"success","data":[{"site":{"siteid":3317,"sitename":"Madtjärn","sitedescription":"A small lake in a hilly area. Physiography: surrounded by till and bedrock. Surrounding vegetation: pine and spruce.","sitenotes":"In the downloaded file, this site was called Nedre Madbergagölen. This site is not included in the publication, and we assume this is the site Madtjärn (altitude, pollen data and radiocarbon dates match).\r\n\r\nIn publication:\r\nPresent threshold altitude: 138 m a.sl.\r\nOriginal threshold altitude: 138.5 m a.s.l\r\nCorrected altitude for differantial uplift: 135 m a.s.l","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[12.17463,58.5959]}","altitude":140,"collectionunitid":4172,"collectionunit":null,"handle":"NMADBER","unittype":"Core","datasets":[{"doi":["10.21233/zf76-3490"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14502,"ageyoung":8396},{"units":"Radiocarbon years BP","ageold":11190,"ageyoung":9971}],"database":"European Pollen Database","datasetid":4309,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasettype":"pollen","datasetnotes":"Data contributed by Svante Björck.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":9115,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}}],"message":"Retrieved all tables"}