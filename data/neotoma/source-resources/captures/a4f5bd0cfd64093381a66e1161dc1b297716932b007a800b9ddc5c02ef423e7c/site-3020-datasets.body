{"status":"success","data":[{"site":{"siteid":3020,"sitename":"Björksjödamm","sitedescription":"Bog pool, lake previously much bigger. Physiography: in a small valley surrounded by slopes. Surrounding vegetation: forests with pine and spruce.","sitenotes":"The exact position of site is not clear. Do not have access to the primary publication (Hilldén 1979). The other publication (Björck and Håkansson 1982) does not give suffient information about location.","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[12.32813,57.70368],[12.36469,57.70368],[12.36469,57.71432],[12.32813,57.71432],[12.32813,57.70368]]]}","altitude":94,"collectionunitid":3809,"collectionunit":null,"handle":"BJORKSJO","unittype":"Core","datasets":[{"doi":["10.21233/wyaq-1b97"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15480,"ageyoung":9386},{"units":"Radiocarbon years BP","ageold":12723,"ageyoung":9398}],"database":"European Pollen Database","datasetid":3934,"datasetpi":[{"initials":"B.E.","contactid":1000,"firstname":"Björn E.","familyname":"Berglund","contactname":"Berglund, Björn E."}],"datasettype":"pollen","datasetnotes":"Data contributed by Björn E. Berglund","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":8913,"datasetpi":[{"initials":"B.E.","contactid":1000,"firstname":"Björn E.","familyname":"Berglund","contactname":"Berglund, Björn E."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}}],"message":"Retrieved all tables"}