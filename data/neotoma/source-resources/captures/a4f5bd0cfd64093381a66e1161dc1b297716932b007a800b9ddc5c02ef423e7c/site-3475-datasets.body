{"status":"success","data":[{"site":{"siteid":3475,"sitename":"Trollvatnet","sitedescription":"The lake is situated on a bedrock hill in the Alta valley sorne 10 km inland from the fiord head. The surroundinj vegetation is open pine forest grading uphill into mountain birch (Betula pubescens ssp. tortuosa) woodland. The tree line (birch) is at 300 to 400 m. The site is a few kilometres inside the Main Sub-stage (Younger Dryas) end-moraines, and it is weIl above the local marine limit (70-80 m.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[23.45276,69.87438],[23.46564,69.87438],[23.46564,69.8776],[23.45276,69.8776],[23.45276,69.87438]]]}","altitude":180,"collectionunitid":4351,"collectionunit":"core 1","handle":"TROLLVAT","unittype":"Core","datasets":[{"doi":["10.21233/93pf-0q48"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13762,"ageyoung":2250},{"units":"Radiocarbon years BP","ageold":11080,"ageyoung":2613}],"database":"European Pollen Database","datasetid":4494,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":null,"datasetid":9233,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}}],"message":"Retrieved all tables"}