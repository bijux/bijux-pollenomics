{"status":"success","data":[{"site":{"siteid":13476,"sitename":"Liten Cap’pesjav’ri","sitedescription":"Glacial origin lake on Magerøya Island. The local bedrock is principally metamorphosed Late Proterozoic to Cambrian age sandstones, with quartzite, amphibolite and conglomerate layers. Site is located in tundra, a major component of which are dwarf-shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium vitis-idaea, V. uliginosum, V. myrtillus, and Betula nana as frequent and locally co-dominant components.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[25.36415,71.07382],[25.37327,71.07382],[25.37327,71.07515],[25.36415,71.07515],[25.36415,71.07382]]]}","altitude":38,"collectionunitid":15098,"collectionunit":null,"handle":"CAPPESJA","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20276,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:19"},{"doi":["10.21233/x46r-2615"],"agerange":[],"database":"European Plant Macrofossil Database","datasetid":20277,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"plant macrofossil","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:29"},{"doi":["10.21233/ktat-6f10"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13908,"ageyoung":69}],"database":"European Pollen Database","datasetid":20278,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"loss-on-ignition","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:32"},{"doi":["10.21233/d73q-6954"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13908,"ageyoung":69}],"database":"European Pollen Database","datasetid":20279,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2016-08-08T05:01:36"}]}}],"message":"Retrieved all tables"}