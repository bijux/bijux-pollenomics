{"status":"success","data":[{"site":{"siteid":13478,"sitename":"Over Gunnarsfjorden","sitedescription":"Glacial origin lake. Metamorphic rocks, mostly micaceous and garnetiferous schists and slates of Caledonian. age (ca 550–400Ma), predominate the catchment. Local vegetation is tundra, dwarf shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium spp. and Betula nana.","sitenotes":"Called Hestevannet on Google Earth.","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[28.16545,71.03753],[28.17268,71.03753],[28.17268,71.03858],[28.16545,71.03858],[28.16545,71.03753]]]}","altitude":75,"collectionunitid":15100,"collectionunit":null,"handle":"GUNNARS","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20282,"datasetpi":[{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-08-09T15:51:48"},{"doi":["10.21233/596x-by72"],"agerange":[],"database":"European Plant Macrofossil Database","datasetid":20283,"datasetpi":[{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."}],"datasettype":"plant macrofossil","datasetnotes":null,"recdatecreated":"2016-08-09T15:51:57"},{"doi":["10.21233/btfj-f709"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10201,"ageyoung":-37}],"database":"European Pollen Database","datasetid":20284,"datasetpi":[{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."},{"initials":"B.","contactid":602,"firstname":"Brian","family