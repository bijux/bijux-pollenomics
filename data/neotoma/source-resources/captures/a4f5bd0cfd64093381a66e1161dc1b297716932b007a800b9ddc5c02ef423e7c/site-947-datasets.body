{"status":"success","data":[{"site":{"siteid":947,"sitename":"Grasvatn","sitedescription":"Shallow lake on the island of Frøya. Overgrown by aquatics. Physiography: Shellsand on gneisses. Surrounding vegetation: Heather, fens and bogs.","sitenotes":"The lake is called “Grasvatnet/Grasvatn” by the locals, but on the map the lake is named \"Stutvatnet\". [email from Aage Paus to E.C. Grimm, 25 Feb 2019]","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[8.68656,63.70186],[8.69161,63.70186],[8.69161,63.70395],[8.68656,63.70395],[8.68656,63.70186]]]}","altitude":25,"collectionunitid":946,"collectionunit":null,"handle":"GRASVATN","unittype":"Core","datasets":[{"doi":["10.21233/n3503q","10.21233/n3r13b"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12861,"ageyoung":871},{"units":"Radiocarbon years BP","ageold":10701,"ageyoung":129}],"database":"European Pollen Database","datasetid":977,"datasetpi":[{"initials":"Aa.","contactid":741,"firstname":"Aage","familyname":"Paus","contactname":"Paus, Aage"}],"datasettype":"pollen","datasetnotes":"Data contributed by Aage Paus","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":8154,"datasetpi":[{"initials":"Aa.","contactid":741,"firstname":"Aage","familyname":"Paus","contactname":"Paus, Aage"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}}],"message":"Retrieved all tables"}