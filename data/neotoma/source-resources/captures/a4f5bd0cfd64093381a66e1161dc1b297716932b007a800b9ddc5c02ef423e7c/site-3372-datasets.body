{"status":"success","data":[{"site":{"siteid":3372,"sitename":"Råttuvarri","sitedescription":"The site is a small lake on a pine forest-clad bedrock hill in the valley of Skibottsdalen, about 5 km inland from Lyngenfjorden. It lies a couple of km inside the Skibotn end moraines and ice margin deltas, about 20 m above the marine limit.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[20.31667,69.35]}","altitude":121,"collectionunitid":4232,"collectionunit":"core 2","handle":"RATTUV","unittype":"Core","datasets":[{"doi":["10.21233/zqse-ep64"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12335,"ageyoung":76},{"units":"Radiocarbon years BP","ageold":10533,"ageyoung":2960}],"database":"European Pollen Database","datasetid":4372,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":null,"datasetid":9147,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"},{"initials":"M.","contactid":1056,"firstname":"Matti","familyname":"Eronen","contactname":"Eronen, Matti"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}}],"message":"Retrieved all tables"}