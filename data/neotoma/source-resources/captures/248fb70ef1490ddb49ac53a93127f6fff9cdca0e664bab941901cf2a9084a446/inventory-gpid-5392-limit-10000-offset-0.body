rstname":"Leif","familyname":"Björkman","contactname":"Björkman, Leif"}],"datasettype":"pollen","datasetnotes":"Data contributed by Björkman, L. to the EPD in 2017 (Landclim Project).","recdatecreated":"2022-07-06T07:45:15"}]}},{"site":{"siteid":28892,"sitename":"Bocksten site A","sitedescription":"Bog. Physiography: hollow in hilly landscape. Surrounding vegetation: Fagus and Picea forest.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[12.56667,57.11667]}","altitude":125,"collectionunitid":39261,"collectionunit":"BOCK1 core","handle":"BOCK1","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":54029,"datasetpi":[{"initials":"L.","contactid":9729,"firstname":"Leif","familyname":"Björkman","contactname":"Björkman, Leif"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2022-07-06T08:05:35"},{"doi":["10.21233/cvzy-rn48","10.21233/SF73-CT95"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":2514,"ageyoung":-14},{"units":"Radiocarbon years BP","ageold":2637.2,"ageyoung":0}],"database":"European Pollen Database","datasetid":54030,"datasetpi":[{"initials":"L.","contactid":9729,"firstname":"Leif","familyname":"Björkman","contactname":"Björkman, Leif"}],"datasettype":"pollen","datasetnotes":"Data contributed by Björkman, L. to the EPD in 2017 (Landclim Project).","recdatecreated":"2022-07-06T08:05:47"}]}},{"site":{"siteid":29383,"sitename":"Lina myr","sitedescription":"Lina myr (57° 34′ 31.764″ N, 18° 37′ 59.124″ E), situated 6.3 km southwest of Åminne and 21 km east of Visby, is a 9-km2 area of\r\ncultivated, drained fenland. The area stretches for 6 km from southwest to northeast and 2 km in an east to west direction. Lina myr drains in a northeast direction toward the east coast of\r\nGotland via the Gothem River. The Gothem River was straightened during the draining of the fen in the 1940s. Today, the elevation\r\nof the Lina myr fen is about 9 m a.s.l. The original basin threshold is estimated to be 9.5–9.9 m a.s.l., based on a cross-section established from modern digital evaluation models (Barliaev, 2017). To the west of the fen the surface geology consists of marl and\r\nfurther to the west of glacial till (Figure 1c). To the east, limestone bedrock is exposed. The island of Gotland consists of Silurian\r\nlimestone (Hede, 1925). The bedrock of Lina myr is classified as the Halla Formation (Laufeld, 1974).","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[18.63309,57.57549]}","altitude":20,"collectionunitid":40090,"collectionunit":"Core 7 (master core)","handle":"LINAMYR","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":55916,"datasetpi":[{"initials":"A.","contactid":16518,"firstname":"Aleftin","familyname":"Barliaev","contactname":"Barliaev, Aleftin"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2023-02-23T08:10:03"},{"doi":["10.21233/2rkh-ve69","10.21233/GGE8-6342"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10416,"ageyoung":2117}],"database":"European Pollen Database","datasetid":55917,"datasetpi":[{"initials":"A.","contactid":16518,"firstname":"Aleftin","familyname":"Barliaev","contactname":"Barliaev, Aleftin"},{"initials":"H.","contactid":18417,"firstname":"Helene","familyname":"Martinsson-Wallin","contactname":"Martinsson-Wallin, Helene"},{"initials":"I.W.","contactid":18418,"firstname":"Ian","familyname":"Croudace","contactname":"Croudace, Ian"},{"initials":"J.","contactid":1218,"firstname":"Jan","familyname":"Risberg","contactname":"Risberg, Jan"},{"initials":"M.","contactid":17040,"firstname":"Martina","familyname":"Hättestrand","contactname":"Hättestrand, Martina"},{"initials":"M.","contactid":18398,"firstname":"Malin","familyname":"Kylander","contactname":"Kylander, Malin"},{"initials":"N.A.","contactid":16519,"firstname":"Nichola A.","familyname":"Strandberg","contactname":"Strandberg, Nichola A."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2023-02-23T08:10:14"},{"doi":["10.21233/4v4c-rx76","10.21233/Z6X3-PF69"],"agerange":[],"database":"European Pollen Database","datasetid":55918,"datasetpi":[{"initials":"A.","contactid":16518,"firstname":"Aleftin","familyname":"Barliaev","contactname":"Barliaev, Aleftin"},{"initials":"H.","contactid":18417,"firstname":"Helene","familyname":"Martinsson-Wallin","contactname":"Martinsson-Wallin, Helene"},{"initials":"I.W.","contactid":18418,"firstname":"Ian","familyname":"Croudace","contactname":"Croudace, Ian"},{"initials":"J.","contactid":1218,"firstname":"Jan","familyname":"Risberg","contactname":"Risberg, Jan"},{"initials":"M.","contactid":17040,"firstname":"Martina","familyname":"Hättestrand","contactname":"Hättestrand, Martina"},{"initials":"M.","contactid":18398,"firstname":"Malin","familyname":"Kylander","contactname":"Kylander, Malin"},{"initials":"N.A.","contactid":16519,"firstname":"Nichola A.","familyname":"Strandberg","contactname":"Strandberg, Nichola A."}],"datasettype":"loss-on-ignition","datasetnotes":null,"recdatecreated":"2023-02-23T12:24:43"}]}},{"site":{"siteid":30418,"sitename":"Lake Öagöl","sitedescription":"Lake. Physiography: rolling hilly area. Surrounding vegetation: mixed woodlands and small-scale agriculture.","sitenotes":"Central part of the province of Småland.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[14.80083,57.20944]}","altitude":221,"collectionunitid":41525,"collectionunit":"AOGOL core","handle":"AOGOL","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":57601,"datasetpi":[{"initials":"E.D.","contactid":19224,"firstname":"Erik Daniel","familyname":"Fredh","contactname":"Fredh, Erik Daniel"}],"datasettype":"