:"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[12.13734,58.57941]}","altitude":152,"collectionunitid":4135,"collectionunit":null,"handle":"MLOMMES","unittype":"Core","datasets":[{"doi":["10.21233/9qm4-1r02"],"agerange":[],"database":"European Pollen Database","datasetid":4268,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasettype":"pollen","datasetnotes":"Data contributed by Svante Björck.","recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":3303,"sitename":"Lake Mullsjön","sitedescription":"Round, big lake. Physiography: northern edge of a glacial-fluvial area. Surrounding vegetation: pine forest.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[14.21136,58.31761]}","altitude":155,"collectionunitid":4152,"collectionunit":null,"handle":"MULLSJ","unittype":"Core","datasets":[{"doi":["10.21233/emr2-ry49"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":17322,"ageyoung":9526},{"units":"Radiocarbon years BP","ageold":10205,"ageyoung":8516}],"database":"European Pollen Database","datasetid":4287,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasettype":"pollen","datasetnotes":"Data contributed by Svante Björck.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":9100,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":3311,"sitename":"Nedre Draketjärn","sitedescription":"A small lake in a hilly area. Physiography: surrounded by till and bedrock. Surrounding vegetation: pine and spruce.","sitenotes":null,"ge