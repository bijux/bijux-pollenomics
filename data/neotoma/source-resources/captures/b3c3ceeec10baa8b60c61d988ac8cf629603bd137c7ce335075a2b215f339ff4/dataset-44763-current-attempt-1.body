omb\r\nIntCal13 #cc1\r\nMarine13 #cc2\r\nSHCal13 #cc3\r\nConstCal #cc4\r\ncm #unit\r\n0 #normal\r\n3 #t.a\r\n4 #t.b\r\n0 #d.R\r\n0 #d.STD\r\n0.95 #prob","contact":[{"contactid":44,"givenname":"Eric Christopher","familyname":"Grimm","contactname":"Grimm, Eric Christopher","leadinginitial":"E.C."}],"agemodel":"Bacon","agerange":{"ageboundolder":4780,"ageboundyounger":930},"isdefault":true,"dateprepared":"2019-06-19","modelagetype":"Calibrated radiocarbon years BP","chronologyname":"EPD 1"},"chronologyid":29021,"chroncontrols":[{"depth":0,"geochron":{"agetype":null,"delta13c":null,"delta15n":null,"infinite":null,"percentc":null,"percentn":null,"labnumber":null,"reservoir":null,"geochronid":null,"geochronage":null,"geochrontype":null,"geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":null,"geochronerrorolder":null,"geochronerroryounger":null,"geochronmaterialdated":null},"thickness":1,"agelimitolder":65,"chroncontrolid":91442,"agelimityounger":35,"chroncontrolage":50,"chroncontroltype":"Core top"},{"depth":45,"geochron":{"agetype":null,"delta13c":null,"delta15n":null,"infinite":null,"percentc":null,"percentn":null,"labnumber":null,"reservoir":null,"geochronid":null,"geochronage":null,"geochrontype":null,"geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":null,"geochronerrorolder":null,"geochronerroryounger":null,"geochronmaterialdated":null},"thickness":5,"agelimitolder":2825,"chroncontrolid":91443,"agelimityounger":2575,"chroncontrolage":2700,"chroncontroltype":"Sediment stratigraphic"}]}}],"defaultchronology":29021},"sitedescription":"Raised bog. Currently being mined for peat."}}],"message":"Retrieved all tables"}