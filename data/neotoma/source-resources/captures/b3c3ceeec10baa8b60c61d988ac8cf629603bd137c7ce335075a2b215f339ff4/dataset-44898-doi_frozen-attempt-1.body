ean=c(40,10),d.max=322,depths.file=TRUE)\r\n\r\nBacon settings file:\r\n12 #d.min\r\n322 #d.max\r\n1 #d.by\r\n1 #depths.file\r\nNA #slump\r\n40 10 #acc.mean\r\n1.5 1.5 #acc.shape\r\n0.7 #mem.mean\r\n4 #mem.strength\r\n75 #hiatus.depths\r\n2 #hiatus.mean\r\n1 #hiatus.shape\r\n0 #BCAD\r\n1 #cc\r\n0 #postbomb\r\nIntCal13 #cc1\r\nMarine13 #cc2\r\nSHCal13 #cc3\r\nConstCal #cc4\r\ncm #unit\r\n0 #normal\r\n3 #t.a\r\n4 #t.b\r\n0 #d.R\r\n0 #d.STD\r\n0.95 #prob","contact":[{"contactid":44,"givenname":"Eric Christopher","familyname":"Grimm","contactname":"Grimm, Eric Christopher","leadinginitial":"E.C."}],"agemodel":"Bacon","agerange":{"ageboundolder":9580,"ageboundyounger":2890},"isdefault":true,"dateprepared":"2019-06-28","modelagetype":"Calibrated radiocarbon years BP","chronologyname":"EPD 1"},"chronologyid":29158,"chroncontrols":[{"depth":305,"geochron":{},"thickness":34,"agelimitolder":8950,"chroncontrolid":91613,"agelimityounger":8450,"chroncontrolage":8700,"chroncontroltype":"Biostratigraphic, pollen, regional"},{"depth":75,"geochron":{},"thickness":50,"agelimitolder":5950,"chroncontrolid":91614,"agelimityounger":5450,"chroncontrolage":5700,"chroncontroltype":"Biostratigraphic, pollen, regional"},{"depth":12,"geochron":{},"thickness":30,"agelimitolder":2825,"chroncontrolid":91612,"agelimityounger":2575,"chroncontrolage":2700,"chroncontroltype":"Biostratigraphic, pollen, regional"}]}}]}}}],"message":"Retrieved all tables"}