{"status":"success","data":[{"download":{"data":{"site":{"area":900,"siteid":29383,"dataset":{"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10416,"ageyoung":2117}],"database":"European Pollen Database","datasetid":55917,"datasetpi":[{"initials":"I.W.","contactid":18418,"firstname":"Ian","familyname":"Croudace","contactname":"Croudace, Ian"},{"initials":"N.A.","contactid":16519,"firstname":"Nichola A.","familyname":"Strandberg","contactname":"Strandberg, Nichola A."},{"initials":"M.","contactid":17040,"firstname":"Martina","familyname":"Hättestrand","contactname":"Hättestrand, Martina"},{"initials":"H.","contactid":18417,"firstname":"Helene","familyname":"Martinsson-Wallin","contactname":"Martinsson-Wallin, Helene"},{"initials":"J.","contactid":1218,"firstname":"Jan","familyname":"Risberg","contactname":"Risberg, Jan"},{"initials":"A.","contactid":16518,"firstname":"Aleftin","familyname":"Barliaev","contactname":"Barliaev, Aleftin"},{"initials":"M.","contactid":18398,"firstname":"Malin","familyname":"Kylander","contactname":"Kylander, Malin"}],"datasetname":"Lina myr","datasettype":"pollen"},"sitename":"Lina myr","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[18.63309,57.57549]}","geopolitical":["Sweden","Gotland"],"collectionunit":{"handle":"LINAMYR","colldate":"2016-08-02","location":"Master core (core 7)","waterdepth":0,"gpslocation":{"latitude":57.57549,"longitude":18.63309,"gpsaltitude":9},"collunittype":"Core","collectionunit":"Core 7 (master core)","collectiondevice":"Russian peat corer","collectionunitid":40090,"depositionalenvironment":"Mire"},"sitedescription":"Lina myr (57° 34′ 31.764″ N, 18° 37′ 59.124″ E), situated 6.3 km southwest of Åminne and 21 km east of Visby, is a 9-km2 area of\r\ncultivated, drained fenland. The area stretches for 6 km from southwest to northeast and 2 km in an east to west direction. Lina myr drains in a northeast direction toward the east coast of\r\nGotland via the Gothem River. The Gothem River was straightened during the draining of the fen in the 1940s. Today, the elevation\r\nof the Lina myr fen is about 9 m a.s.l. The original basin threshold is estimated to be 9.5–9.9 m a.s.l., based on a cross-section established from modern digital evaluation models (Barliaev, 2017). To the west of the fen the surface geology consists of marl and\r\nfurther to the west of glacial till (Figure 1c). To the east, limestone bedrock is exposed. The island of Gotland consists of Silurian\r\nlimestone (Hede, 1925). The bedrock of Lina myr is classified as the Halla Formation (Laufeld, 1974)."},"samples":[{"ages":[{"age":2410,"agetype":"Calibrated radiocarbon years BP","ageolder":2716,"ageyounger":2117,"chronologyid":39142,"chronologyname":"Clam age-depth model"}],"datum":[{"units":"NISP","value":1,"element":"pollen","taxonid":25,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Artemisia","ecologicalgroup":"UPHE"},{"units":"NISP","value":1,"element":"pollen","taxonid":92,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Ericaceae","ecologicalgroup":"TRSH"},{"units":"NISP","value":1,"element":"pollen","taxonid":153,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Larix","ecologicalgroup":"TRSH"},{"units":"NISP","value":1,"element":"pollen","taxonid":220,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Plantago lanceolata","ecologicalgroup":"UPHE"},{"units":"NISP","value":1,"element":"pollen","taxonid":282,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Saxifragaceae","ecologicalgroup":"UPHE"},{"units":"NISP","value":1,"element":"pollen","taxonid":302,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Tilia","ecologicalgroup":"TRSH"},{"units":"NISP","value":1,"element":"pollen","taxonid":350,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Ranunculaceae","ecologicalgroup":"UPH