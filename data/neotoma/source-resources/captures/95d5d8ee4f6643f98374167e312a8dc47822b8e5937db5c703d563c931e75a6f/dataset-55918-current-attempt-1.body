arbon-14","geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":"accelerator mass spectrometry","geochronerrorolder":60,"geochronerroryounger":60,"geochronmaterialdated":"2 Betula seeds"},"thickness":1,"agelimitolder":4837,"chroncontrolid":120072,"agelimityounger":4522,"chroncontrolage":4679,"chroncontroltype":"Radiocarbon, calibrated"},{"depth":309,"geochron":{"agetype":"Radiocarbon years BP","delta13c":null,"delta15n":null,"infinite":false,"percentc":null,"percentn":null,"labnumber":"Ua-54319","reservoir":null,"geochronid":47687,"geochronage":7777,"geochrontype":"Carbon-14","geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":"accelerator mass spectrometry","geochronerrorolder":43,"geochronerroryounger":43,"geochronmaterialdated":"9 Betula seeds"},"thickness":1,"agelimitolder":8634,"chroncontrolid":120082,"agelimityounger":8447,"chroncontrolage":8555,"chroncontroltype":"Radiocarbon, calibrated"},{"depth":52,"geochron":{"agetype":"Radiocarbon years BP","delta13c":null,"delta15n":null,"infinite":false,"percentc":null,"percentn":null,"labnumber":"Ua-54979","reservoir":null,"geochronid":47678,"geochronage":2448,"geochrontype":"Carbon-14","geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":"accelerator mass spectrometry","geochronerrorolder":29,"geochronerroryounger":29,"geochronmaterialdated":"1 Betula and 7 Cladium mariscus seeds"},"thickness":1,"agelimitolder":2702,"chroncontrolid":120081,"agelimityounger":2360,"chroncontrolage":2516,"chroncontroltype":"Radiocarbon, calibrated"}]}}],"defaultchronology":39142},"sitedescription":"Lina myr (57° 34′ 31.764″ N, 18° 37′ 59.124″ E), situated 6.3 km southwest of Åminne and 21 km east of Visby, is a 9-km2 area of\r\ncultivated, drained fenland. The area stretches for 6 km from southwest to northeast and 2 km in an east to west direction. Lina myr drains in a northeast direction toward the east coast of\r\nGotland via the Gothem River. The Gothem River was straightened during the draining of the fen in the 1940s. Today, the elevation\r\nof the Lina myr fen is about 9 m a.s.l. The original basin threshold is estimated to be 9.5–9.9 m a.s.l., based on a cross-section established from modern digital evaluation models (Barliaev, 2017). To the west of the fen the surface geology consists of marl and\r\nfurther to the west of glacial till (Figure 1c). To the east, limestone bedrock is exposed. The island of Gotland consists of Silurian\r\nlimestone (Hede, 1925). The bedrock of Lina myr is classified as the Halla Formation (Laufeld, 1974)."}}],"message":"Retrieved all tables"}