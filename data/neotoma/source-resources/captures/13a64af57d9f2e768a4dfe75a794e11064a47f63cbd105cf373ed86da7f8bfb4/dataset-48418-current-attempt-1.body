t":"test","taxonid":28071,"symmetry":null,"taxongroup":"Testate amoebae","elementtype":"test","variablename":"Nebela tincta","ecologicalgroup":"TEAM"},{"units":"percent","value":18.8,"context":null,"element":"test","taxonid":28062,"symmetry":null,"taxongroup":"Testate amoebae","elementtype":"test","variablename":"Heleopera sphagni","ecologicalgroup":"TEAM"},{"units":"Unit","value":4.7,"context":null,"element":"field","taxonid":21266,"symmetry":null,"taxongroup":"Water chemistry","elementtype":"field","variablename":"pH","ecologicalgroup":"WCHM"}],"depth":null,"sampleid":449524,"thickness":null,"samplename":null,"samplenotes":null,"analysisdate":null,"sampleanalyst":[{"initials":null,"contactid":null,"firstname":null,"familyname":null,"contactname":null}],"analysisunitid":333854,"analysisunitname":"LA_SU-15","analysisunitnotes":null}]},"chronologies":[{"chronology":{"chronology":{"notes":null,"contact":[{"contactid":6390,"givenname":"Robert K.","familyname":"Booth","contactname":"Booth, Robert K.","leadinginitial":"R.K."}],"agemodel":"collection date","agerange":{"ageboundolder":-50,"ageboundyounger":-60},"isdefault":true,"dateprepared":"2020-06-22","modelagetype":"Calendar years BP","chronologyname":"Collection date"},"chronologyid":34057,"chroncontrols":[{"depth":null,"geochron":{"agetype":null,"delta13c":null,"delta15n":null,"infinite":null,"percentc":null,"percentn":null,"labnumber":null,"reservoir":null,"geochronid":null,"geochronage":null,"geochrontype":null,"geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":null,"geochronerrorolder":null,"geochronerroryounger":null,"geochronmaterialdated":null},"thickness":null,"agelimitolder":null,"chroncontrolid":105134,"agelimityounger":null,"chroncontrolage":-46,"chroncontroltype":"Collection date"}]}}],"defaultchronology":34057},"sitedescription":"Open peatland with scattered, small trees of Pinus sylvestris. The mire is weakly minerotrophic, but smaller spots are ombrotrophic. The water supplies are both soligenous and, to a lesser extent, topogenous. The mire surface slopes slightly (1: 164) towards the south-south west. The lawn vegetation of the area studied is dominated by Eriophorum angustifolium, Calluna vulgaris, Andro- meda polifolia, Narthecium ossifragum and Scirpus caespitosus. Predominant peat mosses are Sphagnum magellanicum, S. papillosum and S. rubellum."}}],"message":"Retrieved all tables"}