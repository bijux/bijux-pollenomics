axonid":28043,"symmetry":null,"taxongroup":"Testate amoebae","elementtype":"test","variablename":"Archerella flavum","ecologicalgroup":"TEAM"},{"units":"percent","value":11,"context":null,"element":"test","taxonid":29729,"symmetry":null,"taxongroup":"Testate amoebae","elementtype":"test","variablename":"Difflugia leidyi","ecologicalgroup":"TEAM"},{"units":"percent","value":16.2,"context":null,"element":"test","taxonid":625,"symmetry":null,"taxongroup":"Testate amoebae","elementtype":"test","variablename":"Hyalosphenia elegans","ecologicalgroup":"TEAM"},{"units":"percent","value":25,"context":null,"element":"test","taxonid":626,"symmetry":null,"taxongroup":"Testate amoebae","elementtype":"test","variablename":"Hyalosphenia papilio","ecologicalgroup":"TEAM"},{"units":"Unit","value":4.6,"context":null,"element":"field","taxonid":21266,"symmetry":null,"taxongroup":"Water chemistry","elementtype":"field","variablename":"pH","ecologicalgroup":"WCHM"}],"depth":null,"sampleid":449536,"thickness":null,"samplename":null,"samplenotes":null,"analysisdate":null,"sampleanalyst":[{"initials":null,"contactid":null,"firstname":null,"familyname":null,"contactname":null}],"analysisunitid":333866,"analysisunitname":"SAL_FIN-7","analysisunitnotes":null}]},"chronologies":[{"chronology":{"chronology":{"notes":null,"contact":[{"contactid":6390,"givenname":"Robert K.","familyname":"Booth","contactname":"Booth, Robert K.","leadinginitial":"R.K."}],"agemodel":"collection date","agerange":{"ageboundolder":-50,"ageboundyounger":-60},"isdefault":true,"dateprepared":"2020-06-22","modelagetype":"Calendar years BP","chronologyname":"Collection date"},"chronologyid":34069,"chroncontrols":[{"depth":null,"geochron":{"agetype":null,"delta13c":null,"delta15n":null,"infinite":null,"percentc":null,"percentn":null,"labnumber":null,"reservoir":null,"geochronid":null,"geochronage":null,"geochrontype":null,"geochronnotes":null,"percentcollagen":null,"radiocarbonmethod":null,"geochronerrorolder":null,"geochronerroryounger":null,"geochronmaterialdated":null},"thickness":null,"agelimitolder":null,"chroncontrolid":105146,"agelimityounger":null,"chroncontrolage":-46,"chroncontroltype":"Collection date"}]}}],"defaultchronology":34069},"sitedescription":"Mainly open peatland with scattered, small trees of P. sylvestris. Most parts are weakly minerotrophic, but small ombrotrophic spots exist. The water supply is both soligenous and, to a lesser extent, topogenous. The mire surface slopes slightly (1 : 200) towards the west. The vegetation is dominated by graminoids such as Eriophorum vaginatum and Carex pauciflora and, to a lesser extent, by dwarf shrubs such as A. polifolia, Empetrum nigrum, Chamaedaphne calyculata and Vaccinium oxycoccos. Scattered shoots of Carex lasiocarpa can also be found. On lawn communities, the dominant peat mosses are Sphagnum balticum and S. papillosum with the subdominants S. magellanicum and S. rubellum. Scattered hummocks are dominated by S. angustifolium, S. fuscum, Polytrichum strictum and Aulacomnium palustre."}}],"message":"Retrieved all tables"}