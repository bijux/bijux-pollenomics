tname":"Blundell, Antony"},{"initials":"D.J.","contactid":7252,"firstname":"Daniel J.","familyname":"Charman","contactname":"Charman, Daniel J."}],"datasettype":"testate amoebae surface sample","datasetnotes":null,"recdatecreated":"2019-07-16T19:07:07"}]}},{"site":{"siteid":26004,"sitename":"Lille Vildmose","sitedescription":null,"sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[10.1735,56.8526]}","altitude":3,"collectionunitid":31870,"collectionunit":"DK 18","handle":"LIVI_DK18","unittype":"Modern","datasets":[{"doi":["10.21233/da21-yg21"],"agerange":[{"units":"Calendar years BP","ageold":-55,"ageyoung":-55}],"database":"Neotoma Testate Amoebae Database","datasetid":44968,"datasetpi":[{"initials":"A.","contactid":6308,"firstname":"Antony","familyname":"Blundell","contactname":"Blundell, Antony"},{"initials":"D.J.","contactid":7252,"firstname":"Daniel J.","familyname":"Charman","contactname":"Charman, Daniel J."}],"datasettype":"testate amoebae surface sample","datasetnotes":null,"recdatecreated":"2019-07-16T19:07:08"}]}},{"site":{"siteid":27349,"sitename":"Harreskov","sitedescription":"Cromer interglacial locality (Harreskov type) from middle Pleistocene. Sediments are made of calcareous gyttja overlain by diatomaceous gyttja.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[8.91161,56.03796]}","altitude":40,"collectionunitid":35286,"collectionunit":null,"handle":"HARRESK","unittype":"Core","datasets":[{"doi":["10.21233/g7dx-7b23","10.21233/G7DX-7B23"],"agerange":[],"database":"European Pollen Database","datasetid":49047,"datasetpi":[{"initials":"S.Th.","contactid":984,"firstname":"S. Th.","familyname":"Andersen","contactname":"Andersen, S. Th."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2021-03-15T16:53:27"}]}},{"site":{"siteid":40948,"sitename":"Bagsvaerd + ","sitedescription":null,"sitenotes":"Validation status: amber(see Dataset Notes)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[12.45722,55.76472]}","altitude":null,"collectionunitid":54573,"collectionunit":"NODE-R210","handle":"NODE-R210","unittype":"Modern","datasets":[{"doi":["10.21233/fdrs-be79"],"agerange":[],"database":"Nonmarine Ostracod Distribution in Europe Database","datasetid":73116,"datasetpi":[{"initials":"E.K.","contactid":18692,"firstname":"Eugen","familyname":"Kempf","contactname":"Kempf, Eugen"}],"datasettype":"ostracode surface sample","datasetnotes":"This Ostracoda dataset was uploaded as part of the bulk import of NODE (Non-marine Ostracod Distribution in Europe) to Neotoma in 2026, using the DataBUS upload system (https://github.com/NeotomaDB/DataBUS). This database import was coordinated by Alison Smith, David Horne, Robin Smith, Andrew Anderson, Simon Goring, Socorro Dominguez, and Jack Williams. David Horne is the lead steward for the NODE database which was originally established by members of the EU Human Capital and Mobility Programme project “Evolutionary ecology of reproductive modes in non-marine Ostracoda” (1994-1996), primarily to enable mapping of sexual and parthenogenetic reproductive modes.  Further development of NODE has included continued data entry, application of taxonomic revisions, and validation exercises using Google Earth and other online resources to check, correct and refine the coordinates of every record. Each record is assigned a Validation Status colour: green (accurate), amber (as good as possible given limitations of published information) or red (uncertain or unreliable and in need of further checking). Users are advised to check the Validation Status (in Site Notes) of the data they map and consider eliminating any that are “red”. Species occurrence records are derived mainly from published literature spanning the 19th, 20th and 21st centuries and represent specimens that were (or are assumed to have been) collected alive. Taxonomic names have been updated in accordance with the global checklist of Meisch et al. (2024: https://doi.org/10.5852/ejt.2024.974.2767) but NODE also includes the original “Name in Reference” as given in the source of the occurrence record (see Collection Unit Notes).\\nNODE records include additional metadata such as environmental classifications of sites and taxonomic/nomenclatural comments that are being prepared for future import to Neotoma.","recdatecreated":"2026-02-14T04:09:05"}]}},{"site":{"siteid":42019,"sitename":"Lake Skaansø","sitedescription":"Skaansø is a small lake surrounded by conifer plantation with scattered oak and birch on fluvioglacial sand. Sediment distribution is strongly influenced by dominant northwestern winds.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[8.82537,56.50698],[8.82537,56.5117],[8.83272,56.5117],[8.83272,56.50698],[8.82537,56.50698]]]}","altitude":8,"collectionunitid":55876,"collectionunit":"Skaanso A2","handle":"SKANSO-2","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74583,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-06-19T20:55:31"},{"doi":["10.21233/3feq-sa72"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":6165.48,"ageyoung":-35},{"units":"Radiocarbon years BP","ageold":5469,"ageyoung":-35}],"database":"European Pollen Database","datasetid":74584,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2026-06-19T20:55:41"},{"doi":["10.21233/znf4-qs16"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":6165.479492,"ageyoung":-35},{"units":"Radiocarbon years BP","ageold":5469,"ageyoung":-35}],"database":"Neotoma Charcoal Data","datasetid":75265,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"microcharcoal","datasetnotes":"Quantification of microscopic charred particles and dark-coloured hyphae in the pollen slides was done by a calibrated eyepiece graticule with a grid of 21 by 21 lines mounted in a 10X ocular and using a 24X objective.\r\nThis method of estimating microscopic charred particle frequencies is generally similar to the method developed independently by Clark (1982).\r\nThe charred particle concentrations are divided by the pollen concentrations of terrestrial taxa and are shown as area of microfossils per pollen (micrometer square/pollen concentration ).","recdatecreated":"2026-09-25T12:18:32"}]}},{"site":{"siteid":42019,"sitename":"Lake Skaansø","sitedescription":"Skaansø is a small lake surrounded by conifer plantation with scattered oak and birch on fluvioglacial sand. Sediment distribution is strongly influenced by dominant northwestern winds.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[8.82537,56.50698],[8.82537,56.5117],[8.83272,56.5117],[8.83272,56.50698],[8.82537,56.50698]]]}","altitude":8,"collectionunitid":55904,"collectionunit":"Skaansø A8","handle":"SKANSO-8","unittype":"Core","datasets":[{"doi":["10.21233/82x5-e395"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":7575.4091796875,"ageyoung":2345.49365234375},{"units":"Radiocarbon years BP","ageold":10426.3173828125,"ageyoung":5426.970703125}],"database":"European Pollen Database","datasetid":74628,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"pollen","datasetnotes":"Depths are given as depth below the water surface.","recdatecreated":"2026-07-06T15:30:16"},{"doi":["10.21233/ry7w-9x25"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":7575.4091796875,"ageyoung":2345.49365234375},{"units":"Radiocarbon years BP","ageold":10426.3173828125,"ageyoung":5426.970703125}],"database":"Neotoma Charcoal Data","datasetid":75266,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"microcharcoal","datasetnotes":"Depths are given as depth below the water surface.","recdatecreated":"2026-09-25T12:49:33"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74627,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-07-06T15:30:07"}]}},{"site":{"siteid":42048,"sitename":"Lake Kragsø","sitedescription":"Small lake. Physiography: depression in fluvioglacial Weichselian sand and surrounded by the same on top of which locally are deposited eolian sands. Surrounded by conifer plantation with scattered oak and birch on fluvioglacial sand.","sitenotes":"The bottom two samples in the series have apparent deviant depths. These samples are from a separate coring which reached a bit further back than the main coring.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[9.09108,56.29126]}","altitude":47,"collectionunitid":55909,"collectionunit":"core 2A","handle":"KRAGSO2A","unittype":"Core","datasets":[{"doi":["10.21233/d6zx-ha38"],"agerange":[{"units":"Calendar years AD/BC","ageold":1989,"ageyoung":-8233},{"units":"Calibrated radiocarbon years BP","ageold":9250,"ageyoung":-39}],"database":"European Pollen Database","datasetid":74638,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaa