ng vegetation: Salix and Betula shrubs, open grassland. Vegetation formation: Low alpine vegetation.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[8.66667,61.41667]}","altitude":1398,"collectionunitid":14992,"collectionunit":null,"handle":"BRURSKAR","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20043,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-07-19T03:07:43"},{"doi":["10.21233/c71r-jv27"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12278,"ageyoung":0},{"units":"Radiocarbon years BP","ageold":10351,"ageyoung":0}],"database":"European Pollen Database","datasetid":20044,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"loss-on-ignition","datasetnotes":"Data contributed by Bjune Anne E.","recdatecreated":"2016-07-19T03:07:58"},{"doi":["10.21233/2d4h-vx91"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12278,"ageyoung":0},{"units":"Radiocarbon years BP","ageold":10351,"ageyoung":0}],"database":"European Pollen Database","datasetid":20045,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"charcoal","datasetnotes":"Data contributed by Bjune Anne E.","recdatecreated":"2016-07-19T03:08:01"},{"doi":["10.21233/td9p-m745"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12278,"ageyoung":0},{"units":"Radiocarbon years BP","ageold":10351,"ageyoung":0}],"database":"European Pollen Database","datasetid":20046,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contac