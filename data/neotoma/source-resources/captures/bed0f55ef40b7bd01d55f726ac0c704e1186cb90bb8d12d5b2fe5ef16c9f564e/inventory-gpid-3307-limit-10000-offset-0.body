ley"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-08T08:07:16"},{"doi":["10.21233/a4ey-3738"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":4139,"ageyoung":-50}],"database":"European Pollen Database","datasetid":62016,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"charcoal","datasetnotes":"Data contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-08T08:07:22"},{"doi":["10.21233/sg1z-jc18"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":8721,"ageyoung":-50}],"database":"European Pollen Database","datasetid":62017,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Data contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-08T08:07:25"}]}},{"site":{"siteid":33300,"sitename":"Brattheivatnet","sitedescription":"Small circular lake. Physiography: glacial origin. Surrounding vegetation: dwarf-shrub vegetation dominated by Calluna vulgaris, Empetrum nigrum, and Betula nana, with some stunted B. pubescens ssp. tortuosa.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[16.025,69.21944]}","altitude":114,"collectionunitid":45054,"collectionunit":"core BRP309","handle":"BRATTHEI","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62034,"datasetpi":[{"initials":"H.H.","contactid":116,"firstname":"Hilary H.","familyname":"Birks","contactname":"Birks, Hilary H."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-11T07:08:46"},{"doi":["10.21233/wps4-dn37"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":15418,"ageyoung":7210}],"database":"European Pollen Database","datasetid":62035,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-11T07:08:52"}]}},{"site":{"siteid":33301,"sitename":"Lusvatnet","sitedescription":"Small oval lake. Physiography: small cirque glacier that drained into Lusvatnet during the\r\nLateglacial. Surrounding vegetation: Open birch woodland dominated by Betula pubescens ssp. tortuosa and with a predominantly ericaceous or tall-fern-dominated understory clothes the steep lower slopes. Above the tree-line, the vegetation is composed of ericaceous dwarf-shrubs and grasses on sheltered slopes, open grass-heath on exposed ridges, and cliff vegetation around the head of the lake where several arctic-alpine and montane species occur.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[15.56667,69.06667]}","altitude":30,"collectionunitid":45055,"collectionunit":"core LUP207","handle":"LUSVATN","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":62036,"datasetpi":[{"initials":"H.H.","contactid":116,"firstname":"Hilary H.","familyname":"Birks","contactname":"Birks, Hilary H."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2025-04-11T07:15:32"},{"doi":["10.21233/y9q5-4164"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13705,"ageyoung":7136}],"database":"European Pollen Database","datasetid":62037,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasettype":"pollen","datasetnotes":"Dataset contributed by Bjune, A.E. to the EPD/Neotoma.","recdatecreated":"2025-04-11T07:15:39"}]}},{"site":{"siteid":37977,"sitename":"Lake Svartvatnet + ","sitedescription":null,"sitenotes":"Validation status: amber(see Dataset Notes)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[15.675,76.89528]}","altitude":null,"collectionunitid":51445,"collectionunit":"NODE-R1878","handle":"NODE-R1878","unittype":"Modern","datasets":[{"doi":["10.21233/wdwb-mm13"],"agerange":[],"database":"Nonmarine Ostracod Distribution in Europe Database","datasetid":69987,"datasetpi":[{"initials":"A.","contactid":3548,"firstname":"Andre","familyname":"Witkowski","contactname":"Witkowski, Andre"},{"initials":"J.","contactid":20983,"firstname":null,"familyname":"Sell","contactname":"Sell, J."},{"initials":"M.","contactid":21895,"firstname":null,"familyname":"Zajaczkowski","contactname":"Zajaczkowski, M."},{"initials":"T.","contactid":9597,"firstname":"Tadeusz","familyname":"Namiotko","contactname":"Namiotko, Tadeusz"},{"initials":"T.","contactid":18597,"firstname":"Tadeusz","familyname":"Sywula","contactname":"Sywula, Tadeusz"}],"datasettype":"ostracode surface sample","datasetnotes":"This Ostracoda dataset was uploaded as part of the bulk import of NODE (Non-marine Ostracod Distribution in Europe) to Neotoma in 2026, using the DataBUS upload system (https://github.com/NeotomaDB/DataBUS). This database import was coordinated by Alison Smith, David Horne, Robin Smith, Andrew Anderson, Simon Goring, Socorro Dominguez, and Jack Williams. David Horne is the lead steward for the NODE database which was originally established by members of the EU Human Capital and Mobility Programme project “Evolutionary ecology of reproductive modes in non-marine Ostracoda” (1994-1996), primarily to enable mapping of sexual and parthenogenetic reproductive modes.  Further development of NODE has included continued data entry, application of taxonomic revisions, and validation exercises using Google Earth and other online resources to check, correct and refine the coordinates of every record. Each record is assigned a Validation Status colour: green (accurate), amber (as good as possible given limitations of published information) or red (uncertain or unreliable and in need of further checking). Users are advised to check the Validation Status (in Site Notes) of the data they map and consider eliminating any that are “red”. Species occurrence records are derived mainly from published literature spanning the 19th, 20th and 21st centuries and represent specimens that were (or are assumed to have been) collected alive. Taxonomic names have been updated in accordance with the global checklist of Meisch et al. (2024: https://doi.org/10.5852/ejt.2024.974.2767) but NODE also includes the original “Name in Reference” as given in the source of the occurrence record (see Collection Unit Notes).\\nNODE records include additional metadata such as environmental classifications of sites and taxonomic/nomenclatural comments that are being prepared for future import to Neotoma.","recdatecreated":"2026-02-13T23:56:49"}]}},{"site":{"siteid":38304,"sitename":"Vansjo + Near Moss","sitedescription":null,"sitenotes":"Validation status: green(see Dataset Notes)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[10.67472,59.43528]}","altitude":null,"collectionunitid":51789,"collectionunit":"NODE-R3887","handle":"NODE-R3887","unittype":"Modern","datasets":[{"doi":["10.21233/dx85-c258"],"agerange":[],"database":"Nonmarine Ostracod Distribution in Europe Database","datasetid":70331,"datasetpi":[{"initials":"G.O.","contactid":9023,"firstname":"Georg Ossian","familyname":"Sars","contactname":"Sars, Georg Ossian"}],"datasettype":"ostracode surface sample","datasetnotes":"This Ostracoda dataset was uploaded as part of the bulk import of NODE (Non-marine Ostracod Distribution in Europe) to Neotoma in 2026, using the DataBUS upload system (https://github.com/NeotomaDB/DataBUS). This database import was coordinated by Alison Smith, David Horne, Robin Smith, Andrew Anderson, Simon Goring, Socorro Dominguez, and Jack Williams. David Horne is the lead steward for the NODE database which was originally established by members of the EU Human Capital and Mobility Programme project “Evolutionary ecology of reproductive modes in non-marine Ostracoda” (1994-1996), primarily to enable mapping of sexual and parthenogenetic reproductive modes.  Further development of NODE has included continued data entry, application of taxonomic revisions, and validation exercises using Google Earth and other online resources to check, correct and refine the coordinates of every record. Each record is assigned a Validation Status colour: green (accurate), amber (as good as possible given limitations of published information) or red (uncertain or unreliable and in need of further checking). Users are advised to check the Validation Status (in Site Notes) of the data they map and consider eliminating any that are “red”. Species occurrence records are derived mainly from published literature spanning the 19th, 20th and 21st centuries and represent specimens that were (or are assumed to have been) collected alive. Taxonomic names have been updated in accordance with the global checklist of Meisch et al. (2024: https://doi.org/10.5852/ejt.2024.974.2767) but NODE also includes the original “Name in Reference” as given in the source of the occurrence record (see Collection Unit Notes).\\nNODE records include additional metadata such as environmental classifications of sites and taxonomic/nomenclatural comments that are being prepared for future import to Neotoma.","recdatecreated":"2026-02-14T00:36:17"}]}},{"site":{"siteid":38348,"sitename":"Noklevand Lake + ","sitedescription":null,"sitenotes":"Validation status: amber(see Dataset Notes)","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[10.8775,59.87583]}","altitude":null,"collectionunitid":51836,"collectionunit