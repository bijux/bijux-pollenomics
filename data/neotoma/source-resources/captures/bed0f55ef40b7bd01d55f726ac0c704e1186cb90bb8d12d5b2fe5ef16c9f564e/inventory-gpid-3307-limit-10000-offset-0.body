raines and ice margin deltas, about 20 m above the marine limit.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[20.31667,69.35]}","altitude":121,"collectionunitid":4232,"collectionunit":"core 2","handle":"RATTUV","unittype":"Core","datasets":[{"doi":["10.21233/zqse-ep64"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12335,"ageyoung":76},{"units":"Radiocarbon years BP","ageold":10533,"ageyoung":2960}],"database":"European Pollen Database","datasetid":4372,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":null,"datasetid":9147,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"},{"initials":"M.","contactid":1056,"firstname":"Matti","familyname":"Eronen","contactname":"Eronen, Matti"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":3475,"sitename":"Trollvatnet","sitedescription":"The lake is situated on a bedrock hill in the Alta valley sorne 10 km inland from the fiord head. The surroundinj vegetation is open pine forest grading uphill into mountain birch (Betula pubescens ssp. tortuosa) woodland. The tree line (birch) is at 300 to 400 m. The site is a few kilometres inside the Main Sub-stage (Younger Dryas) end-moraines, and it is weIl above the local marine limit (70-80 m.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[23.45276,69.87438],[23.46564,69.87438],[23.46564,69.8776],[23.45276,69.8776],[23.45276,69.87438]]]}","altitude":180,"collectionunitid":4351,"collectionunit":"core 1","handle":"TROLLVAT","unittype":"Core","datasets":[{"doi":["10.21233/93pf-0q48"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13762,"ageyoung":2250},{"units":"Radiocarbon years BP","ageold":11080,"ageyoung":2613}],"database":"European Pollen Database","datasetid":4494,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":null,"datasetid":9233,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":13381,"sitename":"Donvold","sitedescription":"Partly disturbed bog. Surrounding vegetation: Open.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[13.58333,68.13333]}","altitude":4,"collectionunitid":14981,"collectionunit":null,"handle":"DONVOLD","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":20010,"datasetpi":[{"initials":"E.J.","contactid":1176,"firstname":"Eilif J.","familyname":"Nilssen","contactname":"Nilssen, Eilif J."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2016-07-17T05:23:26"},{"doi":["10.21233/vs74-px57"],"agerange":[{"units":"Radiocarbon years BP","ageold":7827,"ageyoung":234}],"database":"European Pollen Database","datasetid":20011,"datasetpi":[{"initials":"E.J.","contactid":1176,"firstname":"Eilif J.","familyname":"Nilssen","contactname":"Nilssen, Eilif J."}],"datasettype":"testate amoebae","datasetnotes":"Data contributed by Nilssen Eilif J.","recdatecreated":"2016-07-17T05:23:32"},{"doi":["10.21233/057s-wr75"],"agerange":[{"units":"Radiocarbon years BP","ageold":8367,"ageyoung":41}],"database":"Euro