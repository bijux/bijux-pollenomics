A lay-by from the marginal road has now encircled the bog, the vegetation has been transformed to grass and shrubs. The site still exists but one would have to dig up the garden to sample it.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[4.88333,60.53333]}","altitude":9,"collectionunitid":3816,"collectionunit":null,"handle":"BLOMOY","unittype":"Core","datasets":[{"doi":["10.21233/jhaq-tk78"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14948,"ageyoung":810},{"units":"Radiocarbon years BP","ageold":12495,"ageyoung":6987}],"database":"European Pollen Database","datasetid":3941,"datasetpi":[{"initials":"J.","contactid":1156,"firstname":"Jan","familyname":"Mangerud","contactname":"Mangerud, Jan"}],"datasettype":"pollen","datasetnotes":"Data contributed by Mangerud Jan.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":8918,"datasetpi":[{"initials":"J.","contactid":1156,"firstname":"Jan","familyname":"Mangerud","contactname":"Mangerud, Jan"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":3106,"sitename":"Flaatevatn","sitedescription":"Limnogenic bog. Physiography: Underlying bedrock (Phyllite +  Quartz). Surrounding vegetation: Subalpine birch forest rich in grasses.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[6.16444,59.69702],[6.18225,59.69702],[6.18225,59.70527],[6.16444,59.70527],[6.16444,59.69702]]]}","altitude":548,"collectionunitid":3914,"collectionunit":null,"handle":"FLAATEVA","unittype":"Core","datasets":[{"doi":["10.21233/x43j-z193"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":11141,"ageyoung":751},{"units":"Radiocarbon years BP","ageold":9705,"ageyoung":717}],"database":"European Pollen Database","datasetid":4041,"datasetpi":[