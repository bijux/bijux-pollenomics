{"status":"success","data":[{"site":{"siteid":310,"sitename":"Bruvatnet [Rovvejávri]","sitedescription":"Lake. Physiography: Bedrock hills mantled by gl. drift (till. Surrounding vegetation: Thin mountain birch scrub.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[28.39012,70.17739],[28.42429,70.17739],[28.42429,70.18479],[28.39012,70.18479],[28.39012,70.17739]]]}","altitude":110,"collectionunitid":310,"collectionunit":"core 2","handle":"BRUVAT","unittype":"Core","datasets":[{"doi":["10.21233/n3870x","10.21233/n3p59c"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":14441,"ageyoung":315},{"units":"Radiocarbon years BP","ageold":11383,"ageyoung":331}],"database":"European Pollen Database","datasetid":317,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":7958,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":700,"sitename":"Domsvatnet","sitedescription":"The lake occupies a shallow oblong basin, measuring about 150 m by 600 m, between gently sloping hills covered by drift. There are no apparent influents and only a small stream as an outflow. The dominant vegetation on the surrounding slopes is a dwarf-shrub tundra with Betula nana, Empetrum, Salix, Arctostaphylos alpinum, and Rubus chamaemorus as prominent elements. Cottongrass-sedge communities are abundant in wetter depressions.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[31.01975,70.32333],[31.03198,70.32333],[31.03198,70.32834],[31.01975,70.32834],[31.01975,70.32333]]]}","altitude":107,"collectionunitid":700,"collectionunit":null,"handle":"DOMSV","unittype":"Core","datasets":[{"doi":["10.21233/n32g8h","10.21233/n3nh7r"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":11704,"ageyoung":161},{"units":"Radiocarbon years BP","ageold":9931,"ageyoung":197}],"database":"European Pollen Database","datasetid":720,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"pollen","datasetnotes":"Data contributed by Hyvärinen Hannu.","recdatecreated":"2013-09-30T14:02:42"},{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":8071,"datasetpi":[{"initials":"H.","contactid":697,"firstname":"Hannu","familyname":"Hyvärinen","contactname":"Hyvärinen, Hannu"}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2013-09-30T14:02:42"}]}},{"site":{"siteid":947,"sitename":"Grasvatn","sitedescription":"Shallow lake on the island of Frøya. Overgrown by aquatics. Physiography: Shellsand on gneisses. Surrounding vegetation: Heather, fens and bogs.","sitenotes":"The lake is called “Grasvatnet/Grasvatn” by the locals, but on the map the lake is named \"Stutvatnet\". [email from Aage Paus to E.C. Grimm, 25 Feb 2019]","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[8.68656,63.70186],[8.69161,63.70186],[8.69161,63.70395],[8.68656,63.70395],[8.68656,63.70186]]]}","altitude":25,"collectionunitid":946,"collectionunit":null,"handle":"GRASVATN","unittype":"Core","datasets":[{"doi":["10.21233/n3503q","10.21233/n3r13b"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":12861,"ageyoung":871},{"units":"Radiocarbon years BP","ageold":10701,"ageyoung":129}],"database":"European Pollen Database","datasetid":977,"datasetpi":[{"initials":"Aa.","contact