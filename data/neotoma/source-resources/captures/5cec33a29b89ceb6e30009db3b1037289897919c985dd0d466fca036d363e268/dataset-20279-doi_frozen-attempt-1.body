{"status":"success","data":[{"download":{"data":{"dataset":{"site":{"handle":"CAPPESJA","siteid":13476,"altitude":41,"sitename":"Liten Cap’pesjav’ri","unittype":"Core","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[25.36415,71.07382],[25.37327,71.07382],[25.37327,71.07515],[25.36415,71.07515],[25.36415,71.07382]]]}","sitedescription":"Glacial origin lake on Magerøya Island. The local bedrock is principally metamorphosed Late Proterozoic to Cambrian age sandstones, with quartzite, amphibolite and conglomerate layers. Site is located in tundra, a major component of which are dwarf-shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium vitis-idaea, V. uliginosum, V. myrtillus, and Betula nana as frequent and locally co-dominant components.","collectionunitid":15098},"dataset":{"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13908,"ageyoung":69}],"database":"European Pollen Database","datasetid":20279,"datasetpi":[{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."}],"datasettype":"pollen"}},"samples":[{"ages":[{"age":69,"agetype":"Calibrated radiocarbon years BP","chronologyid":11738,"chronologyname":"Huntley et al. 2013"}],"datum":[{"units":"grains/g sample","value":68250,"element":"concentration","elementtype":"concentration","variablename":"Eucalyptus suspension"},{"units":"ml","value":0.5,"element":"quantity added","elementtype":"quantity added","variablename":"Eucalyptus suspension"},{"units":"ml","value":1,"element":"volume","elementtype":"volume","variablename":"Sample quantity"},{"units":"NISP","value":1,"element":"pollen","elementtype":"pollen","variablename":"Am