{"status":"success","data":[{"download":{"data":{"dataset":{"site":{"handle":"CAPPESJA","siteid":13476,"altitude":41,"sitename":"Liten Cap’pesjav’ri","unittype":"Core","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[25.36415,71.07382],[25.37327,71.07382],[25.37327,71.07515],[25.36415,71.07515],[25.36415,71.07382]]]}","sitedescription":"Glacial origin lake on Magerøya Island. The local bedrock is principally metamorphosed Late Proterozoic to Cambrian age sandstones, with quartzite, amphibolite and conglomerate layers. Site is located in tundra, a major component of which are dwarf-shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium vitis-idaea, V. uliginosum, V. myrtillus, and Betula nana as frequent and locally co-dominant components.","collectionunitid":15098},"dataset":{"agerange":[{}],"database":"European Pollen Database","datasetid":20277,"datasetpi":[{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."}],"datasettype":"plant macrofossil"}},"samples":[{"ages":[{"age":1001,"agetype":"Calibrated radiocarbon years BP","ageolder":1068,"ageyounger":930,"chronologyid":11739,"chronologyname":"Specimen dates"}],"datum":[{"units":"present/absent","value":1,"element":"leaf","elementtype":"leaf","variablename":"Empetrum"}],"depth":37,"sampleid":185219,"sampleanalyst":[{}]},{"ages":[{"age":1343,"agetype":"Calibrated radiocarbon years BP","ageolder":1403,"ageyounger":1296,"chronologyid":11739,"chronologyname":"Specimen dates"}],"datum":[{"units":"present/absent","value":1,"element":"leaf","elementtype":"leaf","variablename":"Empetrum"}],"depth":51.5,"sampleid":185220,"sampleanalyst":[{}]},{"a