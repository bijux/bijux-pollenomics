{"status":"success","data":[{"download":{"data":{"dataset":{"site":{"handle":"KOBBKROK","siteid":13481,"altitude":51,"sitename":"Over Kobbkrokvatnet","unittype":"Core","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[29.29295,70.6989],[29.29736,70.6989],[29.29736,70.70018],[29.29295,70.70018],[29.29295,70.6989]]]}","sitedescription":"Glacial origin lake lying within the Risvik sub-stage ice limit and just outside the Outer Porsanger moraine that runs along the ridge to the south of the lake. Site is located in tundra with are dwarf-shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium vitis-idaea, V. uliginosum, V. myrtillus, and Betula nana as frequent and locally co-dominant components. The local bedrock is mostly dark grey sandstone, alternating with layers of grey-black mudstone and shale, assigned to the Barents Sea group and marginal to the rocks of the Caledonian orogeny.","collectionunitid":15103},"dataset":{"agerange":[{}],"database":"European Pollen Database","datasetid":20291,"datasetpi":[{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."}],"datasettype":"plant macrofossil"}},"samples":[{"ages":[{"age":1260,"agetype":"Calibrated radiocarbon years BP","ageolder":1300,"ageyounger":1181,"chronologyid":11746,"chronologyname":"Specimen dates"}],"datum":[{"units":"present/absent","value":1,"element":"leaf","elementtype":"leaf","variablename":"Empetrum"}],"depth":56.5,"sampleid":185809,"sampleanalyst":[{}]},{"ages":[{"age":2337,"agetype":"Calibrated radiocarbon years BP","ageolder":2439,"ageyounger":2161,"chronologyid":11746,"chronologyname":"Specimen dates"}],"datum":[{"units":"p