{"status":"success","data":[{"download":{"data":{"dataset":{"site":{"handle":"GUNNARS","siteid":13478,"altitude":78,"sitename":"Over Gunnarsfjorden","unittype":"Core","geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[28.16545,71.03753],[28.17268,71.03753],[28.17268,71.03858],[28.16545,71.03858],[28.16545,71.03753]]]}","sitenotes":"Called Hestevannet on Google Earth.","sitedescription":"Glacial origin lake. Metamorphic rocks, mostly micaceous and garnetiferous schists and slates of Caledonian. age (ca 550–400Ma), predominate the catchment. Local vegetation is tundra, dwarf shrub communities dominated by Empetrum nigrum ssp. hermaphroditum, with Vaccinium spp. and Betula nana.","collectionunitid":15100},"dataset":{"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":10201,"ageyoung":-37}],"database":"European Pollen Database","datasetid":20284,"datasetpi":[{"initials":"J.R.M.","contactid":601,"firstname":"Judy R. M.","familyname":"Allen","contactname":"Allen, Judy R. M."},{"initials":"B.","contactid":602,"firstname":"Brian","familyname":"Huntley","contactname":"Huntley, Brian"},{"initials":"A.J.","contactid":8862,"firstname":"Antony J.","familyname":"Long","contactname":"Long, Antony J."}],"datasettype":"loss-on-ignition"}},"samples":[{"ages":[{"age":-37,"agetype":"Calibrated radiocarbon years BP","chronologyid":11741,"chronologyname":"Huntley et al. 2013"}],"datum":[{"units":"percent","value":22.46,"element":"550°C","elementtype":"550°C","variablename":"loss-on-ignition"}],"depth":0.5,"sampleid":185478,"sampleanalyst":[{}]},{"ages":[{"age":0,"agetype":"Calibrated radiocarbon years BP","chronologyid":11741,"chronologyname":"Huntley et al. 2013"}],"datum":[{"units":"percent","value":27.69,"element":"550°C","elementtype":"550°C","variablename":"loss-on-ignition"}],"depth":2,"sampleid":185479,"sampleanalyst":[{}]},{"ages":[{"age":50,"agetype":"Calibrated radiocarbon years BP","chronologyid