{"status":"success","data":[{"site":{"siteid":42019,"sitename":"Lake Skaansø","sitedescription":"Skaansø is a small lake surrounded by conifer plantation with scattered oak and birch on fluvioglacial sand. Sediment distribution is strongly influenced by dominant northwestern winds.","sitenotes":null,"geography":"{\"type\":\"Polygon\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[[[8.82537,56.50698],[8.82537,56.5117],[8.83272,56.5117],[8.83272,56.50698],[8.82537,56.50698]]]}","altitude":8,"collectionunitid":55876,"collectionunit":"Skaanso A2","handle":"SKANSO-2","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74583,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"geochronologic","datasetnotes":null,"recdatecreated":"2026-06-19T20:55:31"},{"doi":["10.21233/3feq-sa72"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":6165.48,"ageyoung":-35},{"units":"Radiocarbon years BP","ageold":5469,"ageyoung":-35}],"database":"European Pollen Database","datasetid":74584,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"pollen","datasetnotes":null,"recdatecreated":"2026-06-19T20:55:41"},{"doi":["10.21233/znf4-qs16"],"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":6165.479492,"ageyoung":-35},{"units":"Radiocarbon years BP","ageold":5469,"ageyoung":-35}],"database":"Neotoma Charcoal Data","datasetid":75265,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"microcharcoal","datasetnotes":"Quantification of microscopic charred particles and dark-coloured hyphae in the pollen slides was done by a calibrated eyepiece graticule with a grid of 21 by 21 lines mounted in a 10X ocular and using