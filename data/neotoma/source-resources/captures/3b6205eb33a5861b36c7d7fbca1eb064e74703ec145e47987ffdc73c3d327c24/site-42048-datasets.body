{"status":"success","data":[{"site":{"siteid":42048,"sitename":"Lake Kragsø","sitedescription":"Small lake. Physiography: depression in fluvioglacial Weichselian sand and surrounded by the same on top of which locally are deposited eolian sands. Surrounded by conifer plantation with scattered oak and birch on fluvioglacial sand.","sitenotes":"The bottom two samples in the series have apparent deviant depths. These samples are from a separate coring which reached a bit further back than the main coring.","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[9.09108,56.29126]}","altitude":47,"collectionunitid":55909,"collectionunit":"core 2A","handle":"KRAGSO2A","unittype":"Core","datasets":[{"doi":[],"agerange":[],"database":"European Pollen Database","datasetid":74636,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"geochronologic","datasetnotes":"Data processor: Jessie Woodbridge","recdatecreated":"2026-07-10T07:25:18"},{"doi":["10.21233/xxzb-9v55"],"agerange":[{"units":"Calendar years AD/BC","ageold":1989,"ageyoung":-8233},{"units":"Calibrated radiocarbon years BP","ageold":9250,"ageyoung":-39}],"database":"European Pollen Database","datasetid":74637,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"charcoal","datasetnotes":"Data contributed by Odgaard, B. to the EPD/Neotoma.","recdatecreated":"2026-07-10T07:25:24"},{"doi":["10.21233/d6zx-ha38"],"agerange":[{"units":"Calendar years AD/BC","ageold":1989,"ageyoung":-8233},{"units":"Calibrated radiocarbon years BP","ageold":9250,"ageyoung":-39}],"database":"European Pollen Database","datasetid":74638,"datasetpi":[{"initials":"B.V.","contactid":1181,"firstname":"Bent V.","familyname":"Odgaard","contactname":"Odgaard, Bent V."}],"datasettype":"pollen","datasetnotes":null