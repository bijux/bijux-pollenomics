{"status":"success","data":[{"download":{"data":{"site":{"area":10,"siteid":33301,"dataset":{"agerange":[{"units":"Calibrated radiocarbon years BP","ageold":13705,"ageyoung":7136}],"database":"European Pollen Database","datasetid":62037,"datasetpi":[{"initials":"A.E.","contactid":8804,"firstname":"Anne Elisabeth","familyname":"Bjune","contactname":"Bjune, Anne Elisabeth"}],"datasetname":"LUSVATN pollen","datasettype":"pollen","datasetnotes":"Dataset contributed by Bjune, A.E. to the EPD/Neotoma."},"altitude":30,"sitename":"Lusvatnet","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[15.56667,69.06667]}","geopolitical":["Norway","Nordland"],"collectionunit":{"notes":"Local vegetation: water.","handle":"LUSVATN","colldate":"2007-07-01","location":"south of the lake","waterdepth":7,"gpslocation":{},"collunittype":"Core","collectionunit":"core LUP207","collectiondevice":"piston corer","collectionunitid":45055,"depositionalenvironment":"Lacustrine"},"sitedescription":"Small oval lake. Physiography: small cirque glacier that drained into Lusvatnet during the\r\nLateglacial. Surrounding vegetation: Open birch woodland dominated by Betula pubescens ssp. tortuosa and with a predominantly ericaceous or tall-fern-dominated understory clothes the steep lower slopes. Above the tree-line, the vegetation is composed of ericaceous dwarf-shrubs and grasses on sheltered slopes, open grass-heath on exposed ridges, and cliff vegetation around the head of the lake where several arctic-alpine and montane species occur."},"samples":[{"ages":[{"age":7136,"agetype":"Calibrated radiocarbon years BP","chronologyid":43946,"chronologyname":"Cal yr BP"}],"datum":[{"units":"NISP","value":1,"element":"pollen","taxonid":361,"taxongroup":"Vascular plants","elementtype":"pollen","variablename":"Cornus","ecologicalgroup":"TRSH"},{"units":"NISP","value":1,"element":"pollen","taxonid":739,"taxongroup":"Vascular plants","elementtype":"po