.J.","contactid":7252,"firstname":"Daniel J.","familyname":"Charman","contactname":"Charman, Daniel J."},{"initials":"E.A.D.","contactid":9337,"firstname":"Edward A. D.","familyname":"Mitchell","contactname":"Mitchell, Edward A. D."},{"initials":"G.","contactid":7272,"firstname":"Gunnar","familyname":"Mallon","contactname":"Mallon, Gunnar"},{"initials":"G.T.","contactid":11443,"firstname":"Graeme","familyname":"Swindles","contactname":"Swindles, Graeme"},{"initials":"H.","contactid":16387,"firstname":"H.","familyname":"Vasander","contactname":"Vasander, H."},{"initials":"J.","contactid":15631,"firstname":"Joseph","familyname":"Holden","contactname":"Holden, Joseph"},{"initials":"K.","contactid":557,"firstname":"K.","familyname":"Tolonen","contactname":"Tolonen, K."},{"initials":"M.","contactid":7267,"firstname":"Mariusz","familyname":"Lamentowicz","contactname":"Lamentowicz, Mariusz"},{"initials":"M.J.","contactid":7245,"firstname":"Matthew J.","familyname":"Amesbury","contactname":"Amesbury, Matthew J."},{"initials":"R.J.","contactid":6543,"firstname":"Richard","familyname":"Payne","contactname":"Payne, Richard"},{"initials":"T.E.","contactid":604,"firstname":"T. Edward","familyname":"Turner","contactname":"Turner, T. Edward"},{"initials":"T.P.","contactid":13988,"firstname":"Thomas P.","familyname":"Roland","contactname":"Roland, Thomas P."},{"initials":"Y.A.","contactid":9442,"firstname":"Yuri","familyname":"Mazei","contactname":"Mazei, Yuri"}],"datasettype":"testate amoebae surface sample","datasetnotes":null,"recdatecreated":"2020-06-18T18:48:21"}]}},{"site":{"siteid":27197,"sitename":"Salmisuo Mire","sitedescription":"Mainly open peatland with scattered, small trees of P. sylvestris. Most parts are weakly minerotrophic, but small ombrotrophic spots exist. The water supply is both soligenous and, to a lesser extent, topogenous. The mire surface slopes slightly (1 : 200) towards the west. The vegetation is dominated by graminoids such as Eriophorum vaginatum and Carex pauciflora and, to a lesser extent, by dwarf shrubs such as A. polifolia, Empetrum nigrum, Chamaedaphne calyculata and Vaccinium oxycoccos. Scattered shoots of Carex lasiocarpa can also be found. On lawn communities, the dominant peat mosses are Sphagnum balticum and S. papillosum with the subdominants S. magellanicum and S. rubellum. Scattered hummocks are dominated by S. angustifolium, S. fuscum, Polytrichum strictum and Aulacomnium palustre.","sitenotes":null,"geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[30.9481,62.785]}","altitude":134,"collectionunitid":34880,"collectionunit":"FIN-1","handle":"SAL_FIN-1","unittype":"Modern","datasets":[{"doi":["10.21233/6ebq-5926","10.21233/6EBQ-5926"],"agerange":[{"units":"Calendar years BP","ageold":-46,"ageyoung":-46}],"database":"Neotoma Testate Amoebae Database","datasetid":48424,"datasetpi":[{"initials":"A.","contactid":15757,"firstname":"Alexandre","familyname":"Buttler","contactname":"Buttler, Alexandre"},{"initials":"A.","contactid":16410,"firstname":"A.","familyname":"Greenup","contactname":"Greenup, A."},{"initials":"A.A.","contactid":14022,"firstname":"Anatoly A","familyname":"Bobrov","contactname":"Bobrov, Anatoly A"},{"initials":"B.G.","contactid":105,"firstname":"Barry G.","familyname":"Warner","contactname":"Warner, Barry G."},{"initials":"C.","contactid":16409,"firstname":"C.","familyname":"Albinsson","contactname":"Albinsson, C."},{"initials":"D.J.","contactid":7252,"firstname":"Daniel J.","familyname":"Charman","contactname":"Charman, Daniel J."},{"initials":"E.A.D.","contactid":9337,"firstname":"Edward A. D.","familyname":"Mitchell","contactname":"Mitchell, Edward A. D."},{"initials":"G.","contactid":7272,"firstname":"Gunnar","familyname":"Mallon","contactname":"Mallon, Gunnar"},{"initials":"G.T.","contactid":11443,"firstname":"Graeme","familyname":"Swindles","contactname":"Swindles, Graeme"},{"initials":"H.","contactid":16408,"fi