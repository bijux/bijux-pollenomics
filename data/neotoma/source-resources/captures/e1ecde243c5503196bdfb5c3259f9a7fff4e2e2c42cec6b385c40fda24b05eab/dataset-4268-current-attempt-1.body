{"status":"success","data":[{"site":{"area":null,"notes":"We assume that the site is Lake Lommesjön in Björck and Digerfeldt 1991 since number of pollen samples and the depth match the publication (except the last sample that originally was 770, but we assume typing error).\r\nHowever, another lake also called Lommesjön is found approx. 1 km NE to the one we have marked on the map. This could also be the likely site since position is not clear in the publication.\r\nAnother possibility is the unnamed lake positioned betwen the two Lommesjön lakes.","siteid":3288,"dataset":{"doi":["10.21233/9qm4-1r02"],"agerange":[{"units":null,"ageold":null,"ageyoung":null}],"database":"European Pollen Database","datasetid":4268,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasetname":"EPD E# 446","datasettype":"pollen","datasetnotes":"Data contributed by Svante Björck."},"altitude":152,"sitename":"M. Lommesjön","geography":"{\"type\":\"Point\",\"crs\":{\"type\":\"name\",\"properties\":{\"name\":\"EPSG:4326\"}},\"coordinates\":[12.13734,58.57941]}","geopolitical":["Sweden","Västra Götaland"],"collectionunit":{"notes":null,"handle":"MLOMMES","colldate":null,"location":"Central part of the lake","collectors":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"waterdepth":1.6,"gpslocation":{"gpserror":null,"latitude":null,"longitude":null,"gpsaltitude":null},"collunittype":"Core","collectionunit":null,"collectiondevice":"Russian corer with 7 cm diameter","collectionunitid":4135,"depositionalenvironment":"Natural Lake","dataset":{"doi":["10.21233/9qm4-1r02"],"agerange":[{"units":null,"ageold":null,"ageyoung":null}],"database":"European Pollen Database","datasetid":4268,"datasetpi":[{"initials":"S.","contactid":122,"firstname":"Svante","familyname":"Björck","contactname":"Björck, Svante"}],"datasetname":"EPD E# 446","datasettype":"pollen","datasetnotes