"""Exercise source contracts and artificial grid failures without opening private archives."""

from __future__ import annotations

import ast
from collections.abc import Callable
from copy import deepcopy
from decimal import Decimal
from functools import partial
import hashlib
from io import BytesIO
import json
import os
from pathlib import Path
import shutil
import sys
from typing import Any
from zipfile import ZipFile

SOURCE = Path(__file__).resolve().parent
sys.path.insert(0, str(SOURCE))
from contracts import (  # noqa: E402
    PYTHON,
    RESOURCES,
    regular_tree,
    strict_equal,
    verify_private_ancestry,
)
from entry import verify  # noqa: E402
from grid_reader import (  # noqa: E402
    CODES,
    HEADER,
    YEARS,
    check_header,
    codes,
    mass,
    member,
    positions,
    table,
)
from launch import remaining_seconds  # noqa: E402
from prepare import copy_rows  # noqa: E402
from run import validate_stages  # noqa: E402
from source_inputs import InputScope, pin  # noqa: E402


def refuses(call: Callable[[], Any]) -> None:
    try:
        call()
    except (ValueError, KeyError, IndexError, UnicodeError):
        return
    raise AssertionError("Invalid controlled case was accepted")


def grid(rows: list[str], width: int = 4, height: int = 2) -> bytes:
    header = [("ncols", str(width)), ("nrows", str(height)), *HEADER[2:]]
    return (
        "\n".join(" ".join(row) for row in header) + "\n" + "\n".join(rows) + "\n"
    ).encode()


def main() -> None:
    groups = 0
    selected, counts = positions(
        BytesIO(grid(["208 246 578 752", "0 208 0 752"])), 4, 2
    )
    assert counts == {"DK": 2, "FI": 1, "NO": 1, "SE": 2}
    totals, valid, zeros = mass(
        BytesIO(grid(["0 2.125 3 4", "-9999 1.5 NaN 0"])), selected, 4, 2
    )
    assert (
        totals
        == dict(zip(CODES, map(Decimal, ["1.5", "2.125", "3", "4"]), strict=True))
        and valid == counts
        and zeros == {"DK": 1, "FI": 0, "NO": 0, "SE": 1}
    )
    groups += 1
    for token in ["-9999", "-0.1", "NaN", "Infinity", "invalid"]:
        refuses(
            partial(mass, BytesIO(grid([f"{token} 2 3 4", "0 1 0 0"])), selected, 4, 2)
        )
        groups += 1
    refuses(lambda: positions(BytesIO(grid(["208 246 578", "208 246 578 752"])), 4, 2))
    refuses(lambda: mass(BytesIO(grid(["0 2 3 4", "0 1 0"])), selected, 4, 2))
    groups += 2
    refuses(
        lambda: positions(
            BytesIO(grid(["208 246 578 752", "208 246 578 752"]) + b"\n"), 4, 2
        )
    )
    refuses(lambda: mass(BytesIO(grid(["0 2 3 4", "0 1 0 0"]) + b"1"), selected, 4, 2))
    refuses(lambda: positions(BytesIO(grid(["208 246 578 0", "208 246 578 0"])), 4, 2))
    groups += 3
    for index, _ in enumerate(HEADER):
        header_lines = grid(["208 246 578 752", "208 246 578 752"]).splitlines(
            keepends=True
        )
        header_lines[index] = b"unknown changed\n"
        refuses(partial(check_header, BytesIO(b"".join(header_lines)), 4, 2))
        groups += 1
    expected = b"region " + b" ".join(str(year).encode() for year in YEARS) + b"\n"
    source_table = expected + b"".join(
        (code + " " + " ".join("1.25" for _ in YEARS) + "\n").encode()
        for code in CODES.values()
    )
    values = table(source_table)
    assert len(values) == 28 and all(
        value == Decimal("1.25") for value in values.values()
    )
    groups += 1
    for raw in [
        source_table + b"208 1 1 1 1 1 1 1\n",
        source_table.replace(b"1.25", b"-1", 1),
        source_table.replace(b"1.25", b"NaN", 1),
        source_table.split(b"752")[0],
    ]:
        refuses(partial(table, raw))
        groups += 1
    payload = BytesIO()
    with ZipFile(payload, "w") as archive:
        archive.writestr("native.asc", b"literal")
    with ZipFile(BytesIO(payload.getvalue())) as archive:
        assert member(archive, "native.asc").filename == "native.asc"
        refuses(lambda: member(archive, "missing.asc"))
    groups += 1

    # Duplicate-member testing uses a controlled explicit ZipInfo list, avoiding a warning-only file writer.
    class Entries:
        def infolist(self) -> list[Any]:
            from zipfile import ZipInfo

            return [ZipInfo("native.asc"), ZipInfo("native.asc")]

    refuses(lambda: member(Entries(), "native.asc"))  # type: ignore[arg-type]
    groups += 1
    assert (
        strict_equal({"rows": 84}, {"rows": 84})
        and not strict_equal({"rows": 84}, {"rows": 84.0})
        and not strict_equal({"rows": 1}, {"rows": True})
        and not strict_equal({"a": 1, "b": 2}, {"b": 2, "a": 1})
    )
    groups += 1
    path = SOURCE / "preflight/artificial-plan.json"
    plan: dict[str, Any] = {
        "resources": dict(RESOURCES),
        "stages": [
            {
                "id": name,
                "action": action,
                "timeout_seconds": 600,
                "argv": [
                    str(PYTHON),
                    "-I",
                    "-B",
                    str(SOURCE / "entry.py"),
                    action,
                    "--plan",
                    str(path),
                ],
            }
            for name, action in [
                ("maintained-grid-producer", "producer"),
                ("independent-source-grid-observer", "observer"),
            ]
        ],
    }
    validate_stages(plan, path)
    for action in ("missing", "order", "budget", "argv"):
        changed = deepcopy(plan)
        if action == "missing":
            changed["stages"].pop()
        elif action == "order":
            changed["stages"].reverse()
        elif action == "budget":
            changed["stages"][0]["timeout_seconds"] = 601
        else:
            changed["stages"][0]["argv"][0] = "/usr/bin/python3"
        refuses(partial(validate_stages, changed, path))
        groups += 1
    assert (
        RESOURCES["overall_timeout_seconds"] == 1260
        and sum(row["timeout_seconds"] for row in plan["stages"]) == 1200
    )
    groups += 1
    scratch = SOURCE / "preflight/artificial-source-copy"
    assert not scratch.exists()
    (scratch / "original").mkdir(parents=True)
    try:
        first = scratch / "original/a.py"
        second = scratch / "original/sub/data.txt"
        second.parent.mkdir()
        first.write_bytes(b"one")
        second.write_bytes(b"two")
        original = [pin(first), pin(second)]
        copied = copy_rows(scratch / "original", scratch / "owned", original)
        assert [row["sha256"] for row in copied] == [row["sha256"] for row in original]
        refuses(lambda: copy_rows(scratch / "original", scratch / "owned", original))
        first.write_bytes(b"changed")
        refuses(lambda: copy_rows(scratch / "original", scratch / "other", original))
        groups += 3
        scope = InputScope([original[1]], [])
        scope.extend([original[1]])
        refuses(lambda: scope.extend([{**original[1], "sha256": "0" * 64}]))
        refuses(lambda: InputScope([original[1], original[1]], []))
        groups += 2
    finally:
        shutil.rmtree(scratch)
    workbook_source = SOURCE / "preflight/artificial-country-source.zip"
    assert not workbook_source.exists()

    def country_archive(rows: list[tuple[str, str]]) -> bytes:
        workbook = BytesIO()
        xmlns = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
        names = ["Denmark", "Finland", "Norway", "Sweden"]
        shared = (
            f'<sst xmlns="{xmlns}">'
            + "".join(f"<si><t>{name}</t></si>" for name in names)
            + "</sst>"
        )
        sheet_rows = "".join(
            f'<row><c r="A{i + 1}"><v>{code}</v></c><c r="B{i + 1}" t="s"><v>{names.index(name)}</v></c></row>'
            for i, (name, code) in enumerate(rows)
        )
        sheet = f'<worksheet xmlns="{xmlns}"><sheetData>{sheet_rows}</sheetData></worksheet>'
        with ZipFile(workbook, "w") as inner:
            inner.writestr("xl/sharedStrings.xml", shared)
            inner.writestr("xl/worksheets/sheet1.xml", sheet)
        outer = BytesIO()
        with ZipFile(outer, "w") as archive:
            archive.writestr("HYDE_country_codes.xlsx", workbook.getvalue())
        return outer.getvalue()

    try:
        country_rows = list(
            zip(["Denmark", "Finland", "Norway", "Sweden"], CODES.values(), strict=True)
        )
        workbook_source.write_bytes(country_archive(country_rows))
        assert codes(workbook_source) == CODES
        groups += 1
        for changed_rows in [
            country_rows + [country_rows[0]],
            [("Denmark", "999"), *country_rows[1:]],
            country_rows[:-1],
        ]:
            workbook_source.write_bytes(country_archive(changed_rows))
            refuses(partial(codes, workbook_source))
            groups += 1
    finally:
        workbook_source.unlink()
    declared = json.loads((SOURCE / "declared-inputs.json").read_bytes())
    assert (
        len(declared["inputs"])
        == len({row["path"] for row in declared["inputs"]})
        == 25
    )
    assert len([row for row in declared["inputs"] if "/zip/" in row["path"]]) == 21
    assert len(declared["module_import_sources"]) == 6
    for row in declared["maintained_sources"] + declared["module_import_sources"]:
        assert pin(SOURCE.parents[2] / row["path"])["sha256"] == row["sha256"]
    groups += 1
    producer_tree = ast.parse(
        (SOURCE.parents[2] / declared["maintained_sources"][0]["path"]).read_bytes()
    )
    publish = next(
        node
        for node in producer_tree.body
        if isinstance(node, ast.FunctionDef) and node.name == "publish"
    )
    assert [item.arg for item in publish.args.args] == ["source_root", "output"]
    observer_tree = ast.parse((SOURCE / "grid_reader.py").read_bytes())
    assert not any(
        isinstance(node, ast.ImportFrom)
        and node.module
        and ("hyde_country" in node.module or "source_completion" in node.module)
        for node in ast.walk(observer_tree)
    )
    groups += 1
    entry_tree = ast.parse((SOURCE / "entry.py").read_bytes())
    entry_main = next(
        node
        for node in entry_tree.body
        if isinstance(node, ast.FunctionDef) and node.name == "main"
    )
    assert any(
        isinstance(node, ast.ImportFrom)
        and node.module == "run"
        and any(alias.name == "main" for alias in node.names)
        for node in ast.walk(entry_main)
    )
    assert any(
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "run"
        for node in ast.walk(entry_main)
    )
    groups += 1
    assert remaining_seconds(10.0, 30.0, 1280) == 1260.0
    refuses(partial(remaining_seconds, 10.0, 1290.0, 1280))
    refuses(partial(remaining_seconds, 10.0, 9.0, 1280))
    refuses(partial(remaining_seconds, 10.0, 30.0, 1300))
    groups += 4
    outer_tree = ast.parse((SOURCE / "launch.py").read_bytes())
    assert any(
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "killpg"
        for node in ast.walk(outer_tree)
    )
    assert any(
        isinstance(node, ast.keyword)
        and node.arg == "start_new_session"
        and isinstance(node.value, ast.Constant)
        and node.value.value is True
        for node in ast.walk(outer_tree)
    )
    assert any(
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name)
        and node.func.id == "launch"
        and any(
            isinstance(arg, ast.Name) and arg.id == "ENTRY_STARTED" for arg in node.args
        )
        for node in ast.walk(entry_main)
    )
    stage_tree = ast.parse((SOURCE / "run.py").read_bytes())
    assert any(
        isinstance(node, ast.keyword)
        and node.arg == "start_new_session"
        and isinstance(node.value, ast.Constant)
        and node.value.value is False
        for node in ast.walk(stage_tree)
    )
    assert not any(
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "killpg"
        for node in ast.walk(stage_tree)
    )
    assert any(
        isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute)
        and node.func.attr == "kill"
        for node in ast.walk(stage_tree)
    )
    groups += 2
    artificial = SOURCE / "preflight/artificial-reviewed-entry"
    assert not artificial.exists()
    artificial.mkdir()
    try:
        names = [
            "entry.py",
            "prepare.py",
            "run.py",
            "launch.py",
            "contracts.py",
            "execute.py",
            "observe.py",
            "grid_reader.py",
            "source_projection.py",
            "source_inputs.py",
            "source_runtime.py",
            "source_admission.py",
            "runtime_contracts.py",
        ]
        for name in names:
            (artificial / name).write_bytes(b"# controlled source\n")
        files = [pin(artificial / name) for name in sorted(names)]

        def authority(rows: list[dict[str, Any]]) -> None:
            raw = (json.dumps({"source_only": True, "files": rows}) + "\n").encode()
            (artificial / "prepared-source-manifest.json").write_bytes(raw)
            (artificial / "independent-source-review.json").write_text(
                json.dumps(
                    {
                        "approved": True,
                        "source_manifest_sha256": hashlib.sha256(raw).hexdigest(),
                    }
                )
            )

        authority(files)
        verify(artificial)
        groups += 1
        authority(list(reversed(files)))
        refuses(partial(verify, artificial))
        authority(files + [files[-1]])
        refuses(partial(verify, artificial))
        authority(files)
        groups += 2
        rogue = artificial / "unlisted.so"
        rogue.write_bytes(b"not a binary")
        refuses(partial(verify, artificial))
        rogue.unlink()
        rogue.symlink_to(artificial / "entry.py")
        refuses(partial(verify, artificial))
        rogue.unlink()
        os.mkfifo(rogue)
        refuses(partial(verify, artificial))
        rogue.unlink()
        groups += 3
        (artificial / "entry.py").write_bytes(b"changed")
        refuses(partial(verify, artificial))
        groups += 1
        regular = artificial / "regular-source"
        regular.mkdir()
        (regular / "empty").mkdir()
        (regular / "a.txt").write_bytes(b"resource")
        namespace, rows = regular_tree(regular)
        assert namespace["entries"]["empty"] == {"kind": "directory"} and len(rows) == 1
        alternate = artificial / "same-bytes-private"
        alternate.mkdir()
        (alternate / "input.txt").write_bytes(b"original bytes")
        link = artificial / "private-alias"
        verify_private_ancestry(alternate, ["input.txt"])
        link.symlink_to(alternate, target_is_directory=True)
        refuses(partial(verify_private_ancestry, link, ["input.txt"]))
        groups += 1
        (regular / "alias").symlink_to(regular / "a.txt")
        refuses(partial(regular_tree, regular))
        groups += 2
    finally:
        shutil.rmtree(artificial)
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "groups": groups,
                "private_archives_opened": False,
                "target_runtime_census_or_import_probe": False,
                "producer_preparer_or_native_called": False,
            }
        )
    )


if __name__ == "__main__":
    main()
