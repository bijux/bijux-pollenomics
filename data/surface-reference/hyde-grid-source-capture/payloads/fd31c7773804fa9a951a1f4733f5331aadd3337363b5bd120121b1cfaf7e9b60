"""Reopen exact source grids independently and distinguish native values from tracked bytes."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from contracts import (
    TRACKED,
    checkpoint,
    execution_scope,
    load,
    require,
    strict_equal,
    write,
)
from grid_reader import reconstruct, report_bytes
from source_inputs import pin


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = load(args.plan)
    authority, scope = execution_scope(plan)
    output = Path(plan["output"])
    producer = load(output / "maintained-producer-execution.json")
    require(
        type(producer["actual_exit"]) is int
        and producer["actual_exit"] == 0
        and producer["candidate"] == plan["candidate"],
        "Actual maintained producer did not pass",
    )
    report, csv_bytes, science = reconstruct(
        Path(plan["private_source_root"]), plan["declared_inputs"]
    )
    actual = output / "producer"
    require(
        {p.name for p in actual.iterdir()} == {"report.json", "grid-conservation.csv"}
        and all(p.is_file() and not p.is_symlink() for p in actual.iterdir()),
        "Exact two regular produced files required",
    )
    require(
        producer["two_produced_products"]
        == [pin(actual / name) for name in ("report.json", "grid-conservation.csv")],
        "Produced result identity differs from native record",
    )
    require(
        strict_equal(json.loads((actual / "report.json").read_bytes()), report),
        "Full ordered typed report differs from independent source reconstruction",
    )
    require(
        (actual / "report.json").read_bytes() == report_bytes(report),
        "Generated report wire bytes differ",
    )
    require(
        (actual / "grid-conservation.csv").read_bytes() == csv_bytes,
        "Complete84 CSV rows/wire bytes differ",
    )
    comparisons = []
    for name in ("report.json", "grid-conservation.csv"):
        tracked = Path(plan["owned_repository"]) / TRACKED / name
        generated = actual / name
        comparisons.append(
            {
                "tracked": pin(tracked),
                "generated": pin(generated),
                "byte_identical": tracked.read_bytes() == generated.read_bytes(),
            }
        )
    checkpoint(authority, scope, plan["owned_namespace_snapshots"])
    write(
        output / "independent-grid-source-review.json",
        {
            "candidate": plan["candidate"],
            "actual_exit": 0
            if all(row["byte_identical"] for row in comparisons)
            else 2,
            "independent_scientific_source_reconstruction_actual_exit": 0,
            "tracked_byte_checker_actual_exit": 0
            if all(row["byte_identical"] for row in comparisons)
            else 2,
            "source_reconstruction": science,
            "maintained_producer": pin(output / "maintained-producer-execution.json"),
            "producer_two_products": [
                pin(actual / name) for name in ("report.json", "grid-conservation.csv")
            ],
            "tracked_byte_checkers": comparisons,
            "tracked_bytes_all_equal": all(
                row["byte_identical"] for row in comparisons
            ),
            "scope": "No primary source redistribution, official release/rights/formal CRS/BP/vegetation/LRA/human admission. Historical unavailable native proof is not recovered; current actual two-stage proof only.",
        },
    )
    require(
        all(row["byte_identical"] for row in comparisons),
        "Native scientific reconstruction passed but tracked byte checker differs; preserve exact deltas",
    )
