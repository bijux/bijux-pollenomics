"""Authenticate completed owned HYDE history without rerunning its producer or grids."""

from __future__ import annotations

import hashlib
from pathlib import Path
from typing import Any

from contracts import (
    LEDGER_SHA,
    NATIVE,
    NATIVE_PINS,
    NATIVE_SOURCE,
    PACKET_LIMIT,
    PLAN_SHA,
    ROOT,
    SOURCE,
    physical,
    require,
    verify_original_private_ancestry,
)
from packet import (
    SCHEMA,
    SCOPE,
    json_object,
    roles_from_records,
    validate_packet,
)
from receipt_contract import qualify_scope
from retention_contract import blob, indexed
from runtime_contracts import namespace_snapshot
from source_admission import reviewed_controls
from source_inputs import exact_union, pin, verify_rows


def expected(path: Path, checksum: str) -> tuple[dict[str, Any], dict[str, Any]]:
    row = pin(path)
    require(row["sha256"] == checksum, "Sealed historical record differs: " + str(path))
    physical(row)
    raw = path.read_bytes()
    require(
        len(raw) == row["bytes"] and hashlib.sha256(raw).hexdigest() == checksum,
        "Expected JSON buffer changed",
    )
    return row, json_object(raw)


def output_namespace(
    plan: dict[str, Any],
    catalogue: dict[str, Any],
    refs: dict[str, Any],
    outer: dict[str, Any],
) -> dict[str, Any]:
    root = Path(plan["output"])
    names = {row["path"] for row in catalogue["files"]}
    names.update(refs[key]["path"] for key in ("catalogue", "inner", "outer"))
    names.update(outer[key]["path"] for key in ("stdout", "stderr"))
    entries: dict[str, dict[str, str]] = {}
    for name in names:
        path = Path(name)
        require(path.is_relative_to(root), "Native output leaves original root")
        relative = path.relative_to(root)
        entries[relative.as_posix()] = {"kind": "file"}
        for parent in relative.parents:
            if parent != Path("."):
                entries[parent.as_posix()] = {"kind": "directory"}
    for snapshot in plan["owned_namespace_snapshots"]:
        prefix = Path(snapshot["root"]).relative_to(root)
        for name, row in snapshot["entries"].items():
            if row["kind"] == "directory":
                entries[(prefix / name).as_posix()] = {"kind": "directory"}
    for name in ("scratch", "cache", "cache/matplotlib"):
        entries[name] = {"kind": "directory"}
    return {"root": str(root), "excluded": [], "entries": dict(sorted(entries.items()))}


def authenticate() -> tuple[dict[str, Any], list[dict[str, Any]], list[dict[str, Any]]]:
    """Root-only preparation consumer; every expected baseline precedes final checks."""
    plan_pin, plan = expected(NATIVE / "plan.json", PLAN_SHA)
    ledger_pin, ledger = expected(NATIVE / "original-source-ledger.json", LEDGER_SHA)
    refs = {"plan": plan_pin, "source_ledger": ledger_pin}
    documents: dict[str, dict[str, Any]] = {}
    keys = {
        "grid-conservation-terminal.json": "inner",
        "grid-launch-terminal.json": "outer",
        "independent-grid-source-review.json": "review",
        "maintained-producer-execution.json": "producer",
        "output-products.json": "catalogue",
    }
    for name, checksum in NATIVE_PINS.items():
        row, document = expected(NATIVE / name, checksum)
        refs[keys[name]] = row
        documents[keys[name]] = document
    result = qualify_scope(
        plan,
        PLAN_SHA,
        documents["inner"],
        documents["outer"],
        documents["producer"],
        documents["review"],
    )
    require(
        result["eligible_for_exact_existing_report_admission"] is True,
        "No successful native tracked result",
    )
    source_path = NATIVE_SOURCE / "prepared-source-manifest.json"
    source_pin, source = expected(
        source_path, "5d872bd9e164d790833875b685541c779faf8c4af2ee41c88ae3aa2ccc15b15c"
    )
    # Its expected peer is taken from the original registered input catalogue,
    # never repinned as a newly observed approval after source execution.
    original_inputs = indexed(plan["input_pins"])
    peer_path = str(NATIVE_SOURCE / "independent-source-review.json")
    require(peer_path in original_inputs, "Original source peer missing")
    peer_pin = original_inputs[peer_path]
    physical(peer_pin)
    source_refs = {"manifest": source_pin, "review": peer_pin}
    authority = plan["qualified_source_runtime"]
    runtime_plan = expected(
        Path(authority["plan"]["path"]), authority["plan"]["sha256"]
    )[1]
    for key in ("plan", "outer", "common", "independent_review"):
        physical(authority[key])
    roles, source_join = roles_from_records(
        plan, ledger, source, source_pin, peer_pin, runtime_plan
    )
    catalogue = documents["catalogue"]
    original_products = exact_union(
        catalogue["files"],
        list(refs.values()),
        [documents["outer"][key] for key in ("stdout", "stderr")],
    )
    require(
        len(catalogue["files"])
        == documents["inner"]["products_count_before_manifest"]
        == 2193,
        "Original complete product catalogue differs",
    )
    expected_namespace = output_namespace(plan, catalogue, refs, documents["outer"])
    actual_namespace = namespace_snapshot(NATIVE, [])
    require(
        actual_namespace["entries"] == expected_namespace["entries"],
        "Complete native file/directory namespace differs",
    )
    own_manifest, own_review, own_controls = reviewed_controls(SOURCE)
    public = exact_union(
        original_products,
        source["files"],
        [source_pin, peer_pin],
        [authority[key] for key in ("plan", "outer", "common", "independent_review")],
        own_controls,
    )
    # Small preserved refusal authorities explain the two non-executed source
    # preparations; they do not become successful native source receipts.
    refusal_specs = [
        (
            ROOT
            / "artifacts/science/hyde-grid-independent-source-review/actual-preparation-refusal.json",
            "979be5518351f6139cff1eaec934cc1c77a123fde3266a6e1ee9efedf0f5249d",
        ),
        (
            ROOT
            / "artifacts/science/hyde-grid-projection-independent-review/actual-preparation-refusal.json",
            "e06cc4140d6f3037153e71dd1385605b5dc62f1454fb69a828a345f237aea0b0",
        ),
    ]
    for path, checksum in refusal_specs:
        row, _ = expected(path, checksum)
        public = exact_union(public, [row])
    members: dict[str, dict[str, Any]] = {}
    bindings: list[dict[str, Any]] = []
    for row in public:
        physical(row)
        name = blob(row)
        value = {key: row[key] for key in ("sha256", "bytes")}
        require(
            name not in members or members[name] == value,
            "Content address has conflicting size",
        )
        members[name] = value
        bindings.append({"original": row, "member": name})
    packet = {
        "schema_version": SCHEMA,
        "owner_id": "regions/nordic/hyde-country-cropland/grid-conservation/report-products",
        "publication_paths": [
            "docs/report/regions/nordic/hyde-country-cropland/grid-conservation/" + name
            for name in ("report.json", "grid-conservation.csv")
        ],
        "native_references": refs,
        "source_controller": source_refs,
        "runtime_authority": authority,
        "public_bindings": bindings,
        "members": dict(sorted(members.items())),
        "original_input_roles": roles,
        "original_source_join": source_join,
        "original_output_namespace": expected_namespace,
        "scope": SCOPE,
    }
    by_member: dict[str, dict[str, Any]] = {
        row["member"]: row["original"] for row in bindings
    }

    def read(name: str) -> bytes:
        row = by_member[name]
        physical(row)
        raw = Path(row["path"]).read_bytes()
        require(
            len(raw) == row["bytes"]
            and hashlib.sha256(raw).hexdigest() == row["sha256"],
            "Same-buffer public payload changed",
        )
        return raw

    validate_packet(packet, read)
    # Freeze every protected original row, including omitted private/runtime
    # payload identities, before a final full check and before any output mkdir.
    inputs = exact_union(plan["input_pins"], public)
    verify_original_private_ancestry()
    verify_rows(inputs)
    for row in plan["declared_inputs"]:
        path = Path(plan["private_source_root"]) / row["path"]
        require(
            not any(node.is_symlink() for node in (path, *path.parents)),
            "Private historical input ancestry alias",
        )
    require(
        namespace_snapshot(NATIVE, [])["entries"] == expected_namespace["entries"],
        "Historical namespace changed during census",
    )
    import json

    packet_bytes = (json.dumps(packet, indent=2, allow_nan=False) + "\n").encode()
    forecast = sum(row["bytes"] for row in members.values()) + len(packet_bytes)
    require(
        forecast <= PACKET_LIMIT,
        "Exact deduplicated packet forecast exceeds finite budget",
    )
    transport = {
        "packet": packet,
        "public_rows": public,
        "member_sources": by_member,
        "exact_packet_bytes": len(packet_bytes),
        "unique_payload_bytes": forecast - len(packet_bytes),
        "total_packet_bytes": forecast,
        "original_source_input_count": 62127,
        "metadata_source_authorities": [pin(own_manifest), pin(own_review)],
    }
    return transport, inputs, [expected_namespace]
