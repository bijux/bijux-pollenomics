"""Exercise the full declared input population with artificial identities only."""

from __future__ import annotations

from copy import deepcopy
from functools import partial
import json
from pathlib import Path
import sys
from typing import Any

SOURCE = Path(__file__).resolve().parent
sys.path.insert(0, str(SOURCE))
from packet import NATIVE_SOURCE_SHA, SOURCE_CANDIDATE, roles_from_records  # noqa: E402
from retention_contract import GENERATED, META  # noqa: E402


def row(path: str, checksum: str = "a", size: int = 1) -> dict[str, Any]:
    return {"path": path, "sha256": checksum * 64, "bytes": size}


def refuses(function: Any) -> None:
    try:
        function()
    except (ValueError, KeyError):
        return
    raise AssertionError("Artificial complete role authority was accepted")


def main() -> None:
    original, owned = "/artificial/original", "/artificial/owned"
    source = [
        row(original + f"/packages/bijux-pollenomics-dev/src/package/source_{i}.py")
        for i in range(2177)
    ]
    source.extend(row(original + "/" + name) for name in sorted(META))
    copied = [
        {**item, "path": owned + item["path"][len(original) :]} for item in source
    ]
    caches = [
        {
            **row(
                original
                + f"/packages/bijux-pollenomics-dev/src/package/__pycache__/cache_{i}.cpython-311.pyc",
                "b",
            ),
            "role": "omitted_unselected_cache_bytecode_identity_only",
            "executed_or_copied": False,
            "source_equivalence_claimed": False,
        }
        for i in range(4356)
    ]
    generated = {
        **row(original + "/" + GENERATED, "c", 539),
        "role": "omitted_configured_generated_version_metadata_identity_only",
        "executed_or_copied": False,
        "source_equivalence_claimed": False,
    }
    identity = {
        "candidate": SOURCE_CANDIDATE,
        "status": "",
        "tracked_inventory_sha256": "d" * 64,
    }
    ledger: dict[str, Any] = {
        "canonical_identity": identity,
        "original_sources": [*source, *caches, generated],
        "selected_execution_sources": source,
        "copied_sources": copied,
        "omitted_unselected_cache_bytecode": caches,
        "omitted_configured_generated_metadata": [generated],
        "generated_metadata_ownership": {
            "module_pin": {key: generated[key] for key in ("path", "sha256", "bytes")},
            "copied_or_executed": False,
            "model_or_version_equivalence_authority": False,
        },
        "bytecode_payloads_copied_or_executed": False,
        "bytecode_source_equivalence_claimed": False,
    }
    controllers = {
        "files": [row(f"/artificial/controllers/file_{i}.py", "e") for i in range(31)]
    }
    manifest = {
        **row("/artificial/controllers/prepared-source-manifest.json"),
        "sha256": NATIVE_SOURCE_SHA,
    }
    peer = row("/artificial/controllers/independent-source-review.json", "f")
    authority = {
        key: row("/artificial/runtime/" + key + ".json", "0")
        for key in ("plan", "outer", "common", "independent_review")
    }
    runtime = {
        "input_pins": [row(f"/artificial/runtime/file_{i}", "1") for i in range(59882)]
    }
    private_names = ["original/general_files.zip"]
    for scenario in ("base", "lower", "upper"):
        private_names.append(f"original/gbc2025_7apr_{scenario}/txt/cropland_c.txt")
        private_names.extend(
            f"original/gbc2025_7apr_{scenario}/zip/{year}AD_lu.zip"
            for year in (500, 1000, 1500, 1700, 1900, 2000, 2025)
        )
    private = [row("/artificial/private/" + name, "2") for name in private_names]
    ledger_pin = row("/artificial/owned/original-source-ledger.json", "3")
    plan: dict[str, Any] = {
        "candidate": SOURCE_CANDIDATE,
        "repository": original,
        "owned_repository": owned,
        "canonical_identity_at_source_freeze": identity,
        "qualified_source_runtime": authority,
        "private_source_root": "/artificial/private",
        "declared_inputs": [
            {"path": name, "sha256": "2" * 64} for name in private_names
        ],
        "source_ledger": ledger_pin,
        "input_pins": [
            *controllers["files"],
            manifest,
            peer,
            *runtime["input_pins"],
            *authority.values(),
            *copied,
            ledger_pin,
            *private,
        ],
    }
    assert len(plan["input_pins"]) == 62127
    roles, joined = roles_from_records(
        plan, ledger, controllers, manifest, peer, runtime
    )
    assert len(roles) == 62127 and len(joined) == 2182
    assert (
        sum(item["role"] == "retained_runtime_authority_metadata" for item in roles)
        == 4
    )
    assert sum(item["role"] == "omitted_private_identity_only" for item in roles) == 25
    cases = 1
    for edit in (
        "missing",
        "extra",
        "repeat",
        "copy",
        "generated",
        "runtime",
        "private",
        "sourceepoch",
    ):
        changed_plan, changed_ledger, changed_runtime = deepcopy(
            (plan, ledger, runtime)
        )
        if edit == "missing":
            changed_plan["input_pins"].pop()
        elif edit == "extra":
            changed_plan["input_pins"].append(row("/unqualified/input"))
        elif edit == "repeat":
            changed_plan["input_pins"].append(dict(changed_plan["input_pins"][0]))
        elif edit == "copy":
            changed_ledger["copied_sources"][0] = {
                **changed_ledger["copied_sources"][0],
                "sha256": "9" * 64,
            }
        elif edit == "generated":
            changed_ledger["generated_metadata_ownership"]["module_pin"]["sha256"] = (
                "9" * 64
            )
        elif edit == "runtime":
            changed_runtime["input_pins"][0] = {
                **changed_runtime["input_pins"][0],
                "sha256": "9" * 64,
            }
        elif edit == "private":
            changed_plan["declared_inputs"][0]["sha256"] = "9" * 64
        else:
            changed_plan["candidate"] = "9" * 40
        refuses(
            partial(
                roles_from_records,
                changed_plan,
                changed_ledger,
                controllers,
                manifest,
                peer,
                changed_runtime,
            )
        )
        cases += 1
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "synthetic_cases": cases,
                "artificial_input_rows": 62127,
                "real_plan_private_runtime_or_payload_read": False,
                "actual_preparer_retainer_native_or_model": False,
            }
        )
    )


if __name__ == "__main__":
    main()
