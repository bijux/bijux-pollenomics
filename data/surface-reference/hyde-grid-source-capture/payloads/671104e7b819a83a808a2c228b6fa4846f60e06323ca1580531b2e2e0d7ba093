"""Independently reconstruct native ISO-selected cropland mass from literal source cells."""

from __future__ import annotations

import csv
from decimal import Decimal, InvalidOperation
from io import BytesIO, StringIO
import json
from pathlib import Path
from typing import IO, Any
from xml.etree import ElementTree
from zipfile import ZipFile

CODES = {"DK": "208", "FI": "246", "NO": "578", "SE": "752"}
NAMES = {"DK": "Denmark", "FI": "Finland", "NO": "Norway", "SE": "Sweden"}
SCENARIOS = ("base", "lower", "upper")
YEARS = (500, 1000, 1500, 1700, 1900, 2000, 2025)
HEADER = (
    ("ncols", "4320"),
    ("nrows", "2160"),
    ("xllcorner", "-180"),
    ("yllcorner", "-90"),
    ("cellsize", "0.0833333"),
    ("NODATA_value", "-9999"),
)
FIELDS = (
    "scenario",
    "country",
    "hyde_iso_code",
    "source_year_ce_label",
    "iso_grid_cells",
    "valid_cropland_cells",
    "zero_cropland_cells",
    "grid_cropland_km2",
    "source_country_cropland_km2",
    "grid_minus_country_km2",
)


def ensure(value: object, message: str) -> None:
    if not value:
        raise ValueError(message)


def member(zipped: ZipFile, name: str) -> Any:
    infos = [item for item in zipped.infolist() if item.filename == name]
    ensure(
        len(infos) == 1 and not infos[0].is_dir() and not infos[0].flag_bits & 1,
        "Missing/duplicate/encrypted grid source member",
    )
    return infos[0]


def check_header(stream: IO[bytes], width: int = 4320, height: int = 2160) -> None:
    expected = (("ncols", str(width)), ("nrows", str(height)), *HEADER[2:])
    for field in expected:
        ensure(
            tuple(stream.readline().decode("ascii").split()) == field,
            "Literal native ASCII header differs",
        )


def positions(
    stream: IO[bytes], width: int = 4320, height: int = 2160
) -> tuple[list[list[tuple[int, str]]], dict[str, int]]:
    check_header(stream, width, height)
    inverse = {value: key for key, value in CODES.items()}
    selected = []
    counts = dict.fromkeys(CODES, 0)
    for _ in range(height):
        tokens = stream.readline().decode("ascii").split()
        ensure(len(tokens) == width, "ISO row dimensions differ")
        row = []
        for column, token in enumerate(tokens):
            if token in inverse:
                country = inverse[token]
                counts[country] += 1
                row.append((column, country))
        selected.append(row)
    ensure(not stream.read(), "ISO trailing content")
    ensure(all(counts.values()), "ISO missing selected country")
    return selected, counts


def mass(
    stream: IO[bytes],
    selected: list[list[tuple[int, str]]],
    width: int = 4320,
    height: int = 2160,
) -> tuple[dict[str, Decimal], dict[str, int], dict[str, int]]:
    ensure(len(selected) == height, "ISO selection row count differs")
    check_header(stream, width, height)
    totals = dict.fromkeys(CODES, Decimal(0))
    valid = dict.fromkeys(CODES, 0)
    zeros = dict.fromkeys(CODES, 0)
    for row in selected:
        values = stream.readline().split()
        ensure(len(values) == width, "Cropland row dimensions differ")
        for column, country in row:
            try:
                area = Decimal(values[column].decode("ascii"))
            except InvalidOperation as error:
                raise ValueError("Invalid selected cropland token") from error
            ensure(
                area.is_finite() and area >= 0,
                "Selected missing/nonfinite/negative cropland",
            )
            totals[country] += area
            valid[country] += 1
            zeros[country] += int(area == 0)
    ensure(not stream.read(), "Cropland trailing content")
    return totals, valid, zeros


def codes(archive: Path) -> dict[str, str]:
    namespace = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    with ZipFile(archive) as outer:
        workbook = outer.read(member(outer, "HYDE_country_codes.xlsx"))
    with ZipFile(BytesIO(workbook)) as inner:
        strings = ElementTree.fromstring(
            inner.read(member(inner, "xl/sharedStrings.xml"))
        )
        names = ["".join(node.itertext()) for node in strings.findall(namespace + "si")]
        sheet = ElementTree.fromstring(
            inner.read(member(inner, "xl/worksheets/sheet1.xml"))
        )
    found = {}
    for row in sheet.findall(".//" + namespace + "sheetData/" + namespace + "row"):
        cells = {}
        for cell in row.findall(namespace + "c"):
            value = cell.find(namespace + "v")
            if value is not None:
                column = "".join(c for c in cell.attrib["r"] if c.isalpha())
                ensure(column not in cells, "Duplicate workbook coordinate")
                cells[column] = (
                    names[int(value.text or "0")]
                    if cell.attrib.get("t") == "s"
                    else value.text or ""
                )
        for country, name in NAMES.items():
            if cells.get("B", "").strip() == name:
                ensure(country not in found, "Duplicate workbook country")
                found[country] = cells["A"]
    ensure(found == CODES, "Source country-code join differs")
    return dict(CODES)


def table(raw: bytes) -> dict[tuple[str, int], Decimal]:
    lines = raw.decode("utf-8-sig").splitlines()
    ensure(bool(lines), "Empty table")
    fields = lines[0].split()
    ensure(
        fields[0] == "region"
        and len(fields) == len(set(fields))
        and all(str(year) in fields for year in YEARS),
        "Table header differs",
    )
    seen = set()
    output = {}
    inverse = {value: key for key, value in CODES.items()}
    for line in lines[1:]:
        values = line.split()
        ensure(
            len(values) == len(fields) and values[0] not in seen,
            "Table duplicate/shape",
        )
        seen.add(values[0])
        if values[0] not in inverse:
            continue
        for year in YEARS:
            area = Decimal(values[fields.index(str(year))])
            ensure(area.is_finite() and area >= 0, "Table invalid area")
            output[inverse[values[0]], year] = area
    ensure(len(output) == 28, "Table missing country/year")
    return output


def reconstruct(
    root: Path, inputs: list[dict[str, Any]]
) -> tuple[dict[str, Any], bytes, dict[str, Any]]:
    general = root / "original/general_files.zip"
    source_codes = codes(general)
    with (
        ZipFile(general) as zipped,
        zipped.open(member(zipped, "general_files/iso_cr.asc")) as stream,
    ):
        selected, counts = positions(stream)
    rows = []
    for scenario in SCENARIOS:
        totals = table(
            (root / f"original/gbc2025_7apr_{scenario}/txt/cropland_c.txt").read_bytes()
        )
        for year in YEARS:
            path = root / f"original/gbc2025_7apr_{scenario}/zip/{year}AD_lu.zip"
            with (
                ZipFile(path) as zipped,
                zipped.open(member(zipped, f"cropland{year}AD.asc")) as stream,
            ):
                sums, valid, zeros = mass(stream, selected)
            for country in CODES:
                expected = totals[country, year]
                delta = sums[country] - expected
                ensure(
                    valid[country] == counts[country]
                    and abs(delta) <= Decimal("0.000001"),
                    "Native grid/country exact-decimal conservation failed",
                )
                rows.append(
                    dict(
                        zip(
                            FIELDS,
                            (
                                scenario,
                                country,
                                CODES[country],
                                year,
                                counts[country],
                                valid[country],
                                zeros[country],
                                str(sums[country]),
                                str(expected),
                                str(delta),
                            ),
                            strict=True,
                        )
                    )
                )
    ensure(len(rows) == 84, "Complete84 source joins required")
    buffer = StringIO(newline="")
    writer = csv.DictWriter(buffer, fieldnames=list(FIELDS), lineterminator="\n")
    writer.writeheader()
    writer.writerows(rows)
    report = {
        "schema_version": "hyde-nordic-native-country-conservation.v1",
        "measure": "Native cropland km2 per source ISO country, seven CE labels and three scenarios",
        "country_codes": source_codes,
        "scenario_count": 3,
        "country_count": 4,
        "source_year_ce_labels": list(YEARS),
        "rows": 84,
        "inputs": inputs,
        "conservation_tolerance_km2": "0.000001",
        "interpretation": "The native ISO and cropland ASCII grids have identical literal headers, every selected ISO cell has a nonnegative cropland value, and its exact decimal sum agrees with the source country table at the stated tolerance for seven CE labels. This checks four countries and cropland only; it does not resolve formal CRS, BP calendar, release rights or independent vegetation truth.",
    }
    return (
        report,
        buffer.getvalue().encode(),
        {
            "ISO_cells": counts,
            "joined_rows": 84,
            "selected_nodata_cells": 0,
            "off_selection_values_not_qualified": True,
            "grid_dimensions": [4320, 2160],
            "literal_header": HEADER,
            "Decimal_mass_tolerance_km2": "0.000001",
        },
    )


def report_bytes(report: dict[str, Any]) -> bytes:
    return (json.dumps(report, indent=2) + "\n").encode()
