"""Copy authenticated public HYDE custody payloads and bind the exact capsule helper."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
from typing import Any

from contracts import (
    CAPTURE,
    PACKET_LIMIT,
    SOURCE,
    checkpoint,
    execution_scope,
    physical,
    registered_plan,
    require,
    write,
)
from packet import SOURCE_CANDIDATE, member_name
from source_inputs import pin


def materialize(source: Path, target: Path, row: dict[str, Any]) -> None:
    physical(row)
    require(str(source) == row["path"], "Payload source path differs")
    require(
        not target.exists()
        and not target.is_symlink()
        and not any(node.is_symlink() for node in (target, *target.parents)),
        "Payload replacement/alias refused",
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    with source.open("rb") as incoming, target.open("xb") as outgoing:
        shutil.copyfileobj(incoming, outgoing, 1024 * 1024)
    actual = pin(target)
    require(
        all(actual[key] == row[key] for key in ("sha256", "bytes")),
        "Copied public payload differs",
    )


def helper_source(capture_sha: str) -> str:
    require(
        len(capture_sha) == 64 and all(c in "0123456789abcdef" for c in capture_sha),
        "Actual capsule SHA required",
    )
    text = (SOURCE / "templates/hyde_grid.py").read_text()
    require(
        text.count("__ACTUAL_CAPTURE_SHA256__") == 1,
        "Closed helper capture placeholder differs",
    )
    return text.replace("__ACTUAL_CAPTURE_SHA256__", capture_sha)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--plan", type=Path, required=True)
    args = parser.parse_args()
    plan = registered_plan(args.plan)
    authority, scope = execution_scope(plan)
    output = Path(plan["output"])
    root = output / "packet"
    require(not root.exists() and not root.is_symlink(), "Fresh packet root required")
    packet = plan["transport"]["packet"]
    raw = (json.dumps(packet, indent=2, allow_nan=False) + "\n").encode()
    forecast = len(raw) + sum(row["bytes"] for row in packet["members"].values())
    require(
        forecast == plan["transport"]["total_packet_bytes"] <= PACKET_LIMIT,
        "Exact packet forecast changed or exceeds bound",
    )
    root.mkdir()
    for name, row in plan["transport"]["member_sources"].items():
        member_name(name)
        require(
            name in packet["members"]
            and packet["members"][name]
            == {key: row[key] for key in ("sha256", "bytes")},
            "Public source/member binding differs",
        )
        materialize(Path(row["path"]), root / name, row)
    with (root / "capture.json").open("xb") as stream:
        stream.write(raw)
    capture = pin(root / "capture.json")
    generated = output / "generated"
    generated.mkdir()
    with (generated / "hyde_grid.py").open("x") as stream:
        stream.write(helper_source(capture["sha256"]))
    checkpoint(authority, scope, plan["historical_namespaces"])
    write(
        output / "assembly-result.json",
        {
            "actual_exit": 0,
            "metadata_retention_only": True,
            "grid_or_model_reexecuted": False,
            "public_capture_path": CAPTURE,
            "capture": capture,
            "generated_helper": pin(generated / "hyde_grid.py"),
            "public_payload_count": len(packet["members"]),
            "exact_packet_bytes": forecast,
            "original_source_candidate": SOURCE_CANDIDATE,
            "source_admission_scope": dict(packet["scope"]),
        },
    )


if __name__ == "__main__":
    main()
