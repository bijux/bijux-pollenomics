"""Exercise the actual grouped helper's ownership predicate without capsule I/O."""

from __future__ import annotations

import ast
from copy import deepcopy
import json
from pathlib import Path
import shutil
import sys
from typing import Any

SOURCE = Path(__file__).resolve().parent
sys.path.insert(0, str(SOURCE))
from packet import same  # noqa: E402
from retention_contract import require  # noqa: E402


def main() -> None:
    tree = ast.parse((SOURCE / "templates/hyde_grid.py").read_text())
    constants = {
        node.target.id: ast.literal_eval(node.value)
        for node in tree.body
        if isinstance(node, ast.AnnAssign)
        and node.value is not None
        and isinstance(node.target, ast.Name)
        and node.target.id in {"OWNER", "OWNER_PATHS", "CAPTURE"}
    }
    function = next(
        node
        for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name == "validate_owners"
    )
    namespace: dict[str, Any] = {
        "JsonObject": dict[str, Any],
        "require": require,
        "same": same,
        **constants,
    }
    exec(
        compile(
            ast.Module(body=[function], type_ignores=[]),
            "actual-helper-owner-predicate",
            "exec",
        ),
        namespace,
    )
    validate = namespace["validate_owners"]
    owner = {
        "owner_id": constants["OWNER"],
        "role": "retained_source",
        "paths": constants["OWNER_PATHS"],
        "producer_paths": [],
        "producer_inputs": [],
    }
    validate([owner])
    validate(
        [
            owner,
            {
                "owner_id": "same-family-disjoint",
                "role": "unresolved",
                "paths": [
                    "docs/report/regions/nordic/hyde-country-cropland/report.json"
                ],
            },
        ]
    )
    cases = 2
    variants = [[], [owner, owner]]
    for key, value in (
        ("role", "unresolved"),
        ("paths", constants["OWNER_PATHS"][:1]),
        ("paths", list(reversed(constants["OWNER_PATHS"]))),
        ("producer_paths", ["not-a-retained-recipe.py"]),
        ("producer_inputs", ["unqualified-input.json"]),
    ):
        changed = deepcopy(owner)
        changed[key] = value
        variants.append([changed])
    for role in ("unresolved", "retained_source", "authored"):
        variants.append(
            [
                owner,
                {
                    "owner_id": "overlap",
                    "role": role,
                    "paths": constants["OWNER_PATHS"][:1],
                },
            ]
        )
    variants.append([owner, {"owner_id": "bad-shape", "paths": True}])
    for variant in variants:
        try:
            validate(variant)
        except ValueError:
            cases += 1
            continue
        raise AssertionError("Unsafe actual ownership predicate accepted")
    public = next(
        node
        for node in tree.body
        if isinstance(node, ast.FunctionDef)
        and node.name == "validated_hyde_grid_source_captures"
    )
    assert [arg.arg for arg in public.args.args] == [
        "repository",
        "tracked_by_path",
        "owners",
    ]
    guarded = public.body[0]
    assert isinstance(guarded, ast.Try)
    assert ast.unparse(guarded.body[1]) == "validate_owners(owners)"
    absent = next(
        node
        for node in tree.body
        if isinstance(node, ast.FunctionDef) and node.name == "source_absent"
    )
    namespace.update(Path=Path, InventoryEntry=Any, ReportRebuildError=RuntimeError)
    exec(
        compile(
            ast.Module(body=[absent, public], type_ignores=[]),
            "actual-optional-capture-predicate",
            "exec",
        ),
        namespace,
    )
    missing_root = SOURCE / "preflight/absent-owner-fixture"
    assert not missing_root.exists()
    assert namespace["source_absent"](missing_root, []) is True
    assert namespace["validated_hyde_grid_source_captures"](missing_root, {}, []) == (
        (),
        {},
    )
    assert namespace["source_absent"](missing_root, [owner]) is False
    cases += 3
    capture = missing_root / constants["CAPTURE"]
    capture.parent.mkdir(parents=True)
    try:
        capture.write_bytes(b"artificial not decoded")
        assert namespace["source_absent"](missing_root, []) is False
        try:
            namespace["validated_hyde_grid_source_captures"](missing_root, {}, [])
        except RuntimeError:
            pass
        else:
            raise AssertionError("Capture present without owner was accepted")
        capture.unlink()
        capture.symlink_to(missing_root / "absent-target")
        assert namespace["source_absent"](missing_root, []) is False
        cases += 3
    finally:
        shutil.rmtree(missing_root)
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "synthetic_cases": cases,
                "actual_helper_predicate_and_signature": True,
                "capsule_private_runtime_or_native_consumed": False,
            }
        )
    )


if __name__ == "__main__":
    main()
