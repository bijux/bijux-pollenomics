"""Check new offline controller sources with absolute configured output paths."""

from __future__ import annotations

import argparse
import ast
from pathlib import Path
import subprocess


def files(source: Path) -> list[Path]:
    return sorted(
        [
            path
            for path in source.rglob("*.py")
            if path.relative_to(source).parts[0] != "preflight"
            and path.name not in {"common_runner.py", "runtime_contracts.py"}
        ],
        key=str,
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--format", action="store_true")
    args = parser.parse_args()
    source = Path(__file__).resolve().parent
    root = source.parents[2]
    ruff = Path(
        "/Users/bijan/.cache/uv/archive-v0/2XF0xMG3jR4vPhZZ/ruff-0.15.8.data/scripts/ruff"
    )
    for action in (
        (["check", "--fix"], ["format"])
        if args.format
        else (["check"], ["format", "--check"])
    ):
        subprocess.run(
            [
                str(ruff),
                *action,
                "--config",
                str(root / "configs/ruff.toml"),
                "--cache-dir",
                str(source / "preflight/ruff-cache"),
                *map(str, files(source)),
            ],
            check=True,
        )
    for path in files(source) + [source / "runtime_contracts.py"]:
        ast.parse(path.read_bytes())


if __name__ == "__main__":
    main()
