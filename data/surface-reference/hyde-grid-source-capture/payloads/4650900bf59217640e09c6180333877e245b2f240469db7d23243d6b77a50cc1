"""Synthetic per-pin source and omission cases; no real filesystem inputs are read."""

from __future__ import annotations

from copy import deepcopy
from functools import partial
import json
from pathlib import Path
import sys
from typing import Any

SOURCE = Path(__file__).resolve().parent
sys.path.insert(0, str(SOURCE))
from retention_contract import (  # noqa: E402 - explicit owned pure metadata fixture.
    GENERATED,
    deduplicated_public_members,
    input_roles,
    join_owned_source,
)


def row(path: str, checksum: str = "a", size: int = 1) -> dict[str, Any]:
    return {"path": path, "sha256": checksum * 64, "bytes": size}


def refuses(function: Any) -> None:
    try:
        function()
    except (ValueError, TypeError):
        return
    raise AssertionError("Expected closed per-pin refusal")


def main() -> None:
    original = "/original/repository"
    owned = "/captured/owned-source"
    selected = [row(original + "/packages/bijux-pollenomics-dev/src/package/module.py")]
    cache = row(
        original
        + "/packages/bijux-pollenomics-dev/src/package/__pycache__/module.cpython-311.pyc",
        "b",
        7,
    )
    version = row(original + "/" + GENERATED, "c", 539)
    copied = [
        {
            **selected[0],
            "path": owned + "/packages/bijux-pollenomics-dev/src/package/module.py",
        }
    ]
    originals = [*selected, cache, version]
    result = join_owned_source(
        original, owned, originals, selected, copied, [cache, version], version
    )
    assert (
        result[0]["original_path"] == selected[0]["path"]
        and result[0]["owned_path"] == copied[0]["path"]
    )
    cases = 1
    for edit in ("missing", "extra", "changed", "repeat", "version", "code"):
        old, chosen, copy, omitted, approved = deepcopy(
            (originals, selected, copied, [cache, version], version)
        )
        if edit == "missing":
            omitted.pop()
        elif edit == "extra":
            copy.append(row(owned + "/unknown.py"))
        elif edit == "changed":
            copy[0]["sha256"] = "f" * 64
        elif edit == "repeat":
            chosen.append(chosen[0])
        elif edit == "version":
            approved = {**approved, "sha256": "f" * 64}
        else:
            extra = row(original + "/packages/bijux-pollenomics-dev/src/unknown.py")
            old.append(extra)
            omitted.append(extra)
        refuses(
            partial(
                join_owned_source, original, owned, old, chosen, copy, omitted, approved
            )
        )
        cases += 1
    # Preserve all five selected metadata inputs outside package source roots.
    metadata = [
        row(original + "/" + name, "4", 4)
        for name in (
            "docs/report/regions/nordic/hyde-country-cropland/grid-conservation/report.json",
            "docs/report/regions/nordic/hyde-country-cropland/grid-conservation/grid-conservation.csv",
            "configs/ci/report-ownership.json",
            "packages/bijux-pollenomics-lra/pyproject.toml",
            "packages/bijux-pollenomics-lra/.gitignore",
        )
    ]
    metadata_copied = [
        {**item, "path": owned + item["path"][len(original) :]} for item in metadata
    ]
    assert (
        len(
            join_owned_source(
                original,
                owned,
                [*originals, *metadata],
                [*selected, *metadata],
                [*copied, *metadata_copied],
                [cache, version],
                version,
            )
        )
        == 6
    )
    cases += 1
    for suffix in (
        "unknown.pyc",
        "module.cpython-311-pytest-invalid.pyc",
        "unknown.txt",
    ):
        extra = row(
            original
            + "/packages/bijux-pollenomics-dev/src/package/__pycache__/"
            + suffix
        )
        refuses(
            partial(
                join_owned_source,
                original,
                owned,
                [*originals, extra],
                selected,
                copied,
                [cache, version, extra],
                version,
            )
        )
        cases += 1
    controllers = [row("/reviewed/entry.py", "d", 10)]
    runtime = [row("/runtime/python", "e", 100)]
    ledger = row("/captured/original-source-ledger.json", "f", 200)
    private_root = "/private/HYDE"
    names = ["original/general_files.zip"]
    for scenario in ("base", "lower", "upper"):
        names.append(f"original/gbc2025_7apr_{scenario}/txt/cropland_c.txt")
        names.extend(
            f"original/gbc2025_7apr_{scenario}/zip/{year}AD_lu.zip"
            for year in (500, 1000, 1500, 1700, 1900, 2000, 2025)
        )
    declared = [{"path": name, "sha256": "1" * 64} for name in names]
    private = [row(private_root + "/" + name, "1", 300) for name in names]
    inputs = [*controllers, *runtime, *copied, ledger, *private]
    roles = input_roles(
        inputs, controllers, runtime, copied, ledger, private_root, declared
    )
    assert [role["original_index"] for role in roles] == list(range(len(inputs)))
    assert sum(role["member"] is None for role in roles) == 26
    members = deduplicated_public_members(inputs, roles)
    assert len(members) == 3
    cases += 1
    for edit in ("unknown", "repeat", "private", "controller", "missing-private"):
        source, controls, declared_copy = deepcopy((inputs, controllers, declared))
        if edit == "unknown":
            source.append(row("/unknown/unclassified", "2"))
        elif edit == "repeat":
            source.append(source[0])
        elif edit == "private":
            declared_copy[0]["sha256"] = "3" * 64
        elif edit == "controller":
            controls = [{**controls[0], "sha256": "3" * 64}]
        else:
            declared_copy.pop()
        refuses(
            partial(
                input_roles,
                source,
                controls,
                runtime,
                copied,
                ledger,
                private_root,
                declared_copy,
            )
        )
        cases += 1
    for edit in ("order", "private-payload", "unknown-role", "public-member"):
        changed = deepcopy(roles)
        if edit == "order":
            changed[0]["original_index"] = 1
        elif edit == "private-payload":
            changed[-1]["member"] = "payloads/" + "1" * 64
        elif edit == "unknown-role":
            changed[0]["role"] = "unreviewed"
        else:
            changed[0]["member"] = "payloads/" + "0" * 64
        refuses(partial(deduplicated_public_members, inputs, changed))
        cases += 1
    # Same exact payload may be reused under two original public paths; differing
    # declared sizes must never share a content address.
    extra = row("/other/reviewed.py", "d", 10)
    extra_roles = [
        *roles,
        {
            "original_index": len(inputs),
            "role": "retained_reviewed_controller",
            "member": "payloads/" + "d" * 64,
        },
    ]
    assert len(deduplicated_public_members([*inputs, extra], extra_roles)) == len(
        members
    )
    extra["bytes"] = 11
    refuses(partial(deduplicated_public_members, [*inputs, extra], extra_roles))
    cases += 2
    print(
        json.dumps(
            {
                "actual_exit": 0,
                "synthetic_cases": cases,
                "real_plan_source_ledger_private_or_runtime_identity_read": False,
                "actual_copy_retention_preparer_model_native_or_Git": False,
                "scope": "Future pure retention design only; not concrete source/capsule/admission authority.",
            }
        )
    )


if __name__ == "__main__":
    main()
