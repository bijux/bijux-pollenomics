{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.io/schemas/pollenomics/country-coverage.v2.json",
  "title": "Bijux Pollenomics Country Coverage Cell v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "country_code", "country_dimension", "country_assignment_method", "source_family", "resolution", "feature_key", "classification_contract_version", "availability_status", "lifecycle_status", "counts", "reason_codes", "source_snapshot_id", "boundary_artifact_digest", "config_digest", "producer_version", "build_id"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "country_code": {
      "enum": ["SE", "DK", "NO", "FI", "UNASSIGNED", "OUTSIDE"],
      "description": "A declared Nordic country partition or an explicit retained non-country partition. UNASSIGNED and OUTSIDE are never silently folded into a country."
    },
    "country_dimension": {
      "enum": ["source_reported", "governed_assignment", "publication"],
      "description": "The country fact being counted. Source-reported identity, governed boundary assignment, and publication membership remain separate."
    },
    "country_assignment_method": {
      "type": ["string", "null"],
      "description": "Null for a source-reported partition; otherwise the versioned governed assignment or publication-partition method."
    },
    "source_family": {"type": "string", "minLength": 1},
    "resolution": {
      "enum": ["source", "whole_pollen", "ecological_group", "ecological_subgroup", "ecological_role", "taxon"],
      "description": "The source value is a coverage-only sentinel for source acquisition and availability. It is never an event, propagation, classification, or map resolution."
    },
    "feature_key": {"type": ["string", "null"]},
    "classification_contract_version": {"type": ["string", "null"]},
    "availability_status": {
      "enum": [
        "available_collected",
        "available_partial",
        "available_not_collected",
        "not_available_from_source",
        "blocked",
        "not_applicable",
        "zero_observations",
        "unresolved",
        "unknown"
      ]
    },
    "lifecycle_status": {
      "enum": ["admitted", "refused", "review_required", "not_required", "unavailable"],
      "description": "Orthogonal review/admission posture. Availability never implies scientific or publication admission."
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_records",
        "received_records",
        "deduplicated_records",
        "failed_records",
        "accepted_records",
        "excluded_records",
        "unresolved_records",
        "published_records",
        "sites",
        "datasets",
        "collection_units",
        "samples",
        "dated_samples",
        "age_claims",
        "observations",
        "distinct_taxa",
        "mapped_taxa",
        "ambiguous_taxa",
        "unmapped_taxa",
        "events",
        "evaluated_pairs",
        "definite_candidates",
        "possible_candidates",
        "indeterminate_order_pairs",
        "unresolved_pairs",
        "excluded_pairs",
        "refused_pre_candidate_pairs"
      ],
      "properties": {
        "requested_records": {"type": ["integer", "null"], "minimum": 0},
        "received_records": {"type": ["integer", "null"], "minimum": 0},
        "deduplicated_records": {"type": ["integer", "null"], "minimum": 0},
        "failed_records": {"type": ["integer", "null"], "minimum": 0},
        "accepted_records": {"type": ["integer", "null"], "minimum": 0},
        "excluded_records": {"type": ["integer", "null"], "minimum": 0},
        "unresolved_records": {"type": ["integer", "null"], "minimum": 0},
        "published_records": {"type": ["integer", "null"], "minimum": 0},
        "sites": {"type": ["integer", "null"], "minimum": 0},
        "datasets": {"type": ["integer", "null"], "minimum": 0},
        "collection_units": {"type": ["integer", "null"], "minimum": 0},
        "samples": {"type": ["integer", "null"], "minimum": 0},
        "dated_samples": {"type": ["integer", "null"], "minimum": 0},
        "age_claims": {"type": ["integer", "null"], "minimum": 0},
        "observations": {"type": ["integer", "null"], "minimum": 0},
        "distinct_taxa": {"type": ["integer", "null"], "minimum": 0},
        "mapped_taxa": {"type": ["integer", "null"], "minimum": 0},
        "ambiguous_taxa": {"type": ["integer", "null"], "minimum": 0},
        "unmapped_taxa": {"type": ["integer", "null"], "minimum": 0},
        "events": {"type": ["integer", "null"], "minimum": 0},
        "evaluated_pairs": {"type": ["integer", "null"], "minimum": 0},
        "definite_candidates": {"type": ["integer", "null"], "minimum": 0},
        "possible_candidates": {"type": ["integer", "null"], "minimum": 0},
        "indeterminate_order_pairs": {"type": ["integer", "null"], "minimum": 0},
        "unresolved_pairs": {"type": ["integer", "null"], "minimum": 0},
        "excluded_pairs": {"type": ["integer", "null"], "minimum": 0},
        "refused_pre_candidate_pairs": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_snapshot_id": {"type": ["string", "null"]},
    "boundary_artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "producer_version": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"country_dimension": {"const": "source_reported"}}, "required": ["country_dimension"]},
      "then": {"properties": {"country_assignment_method": {"type": "null"}}},
      "else": {"properties": {"country_assignment_method": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"availability_status": {"enum": ["available_partial", "blocked", "unresolved", "unknown"]}}, "required": ["availability_status"]},
          {"properties": {"lifecycle_status": {"enum": ["refused", "review_required"]}}, "required": ["lifecycle_status"]},
          {"properties": {"country_code": {"enum": ["UNASSIGNED", "OUTSIDE"]}}, "required": ["country_code"]}
        ]
      },
      "then": {"properties": {"reason_codes": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"resolution": {"const": "source"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "null"},
          "classification_contract_version": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "whole_pollen"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^whole:.+$"}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "ecological_group"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^group:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "ecological_subgroup"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^subgroup:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "ecological_role"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^role:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "taxon"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^taxon:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
