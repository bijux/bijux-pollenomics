{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.io/schemas/pollenomics/propagation-candidate.v1.json",
  "title": "Bijux Pollenomics Propagation Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edge_id",
    "source_event_id",
    "target_event_id",
    "source_site_id",
    "target_site_id",
    "source_country_code",
    "target_country_code",
    "cross_border",
    "shared_location",
    "resolution",
    "feature_key",
    "distance_km_unrounded",
    "distance_km_display",
    "distance_algorithm",
    "distance_library",
    "distance_library_version",
    "minimum_lag_years",
    "maximum_lag_years",
    "candidate_status",
    "reason_code",
    "scenario_id",
    "threshold_profile_id",
    "temporal_contract_version",
    "classification_contract_version",
    "propagation_contract_version",
    "event_manifest_digest",
    "config_digest",
    "producer_version",
    "map_geometry_role",
    "directional_arrow_allowed",
    "route_interpretation_allowed",
    "build_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "edge_id": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "target_event_id": {"type": "string", "minLength": 1},
    "source_site_id": {"type": "string", "minLength": 1, "description": "Must differ from target_site_id after governed site reconciliation."},
    "target_site_id": {"type": "string", "minLength": 1, "description": "Must differ from source_site_id after governed site reconciliation."},
    "source_country_code": {"enum": ["SE", "DK", "NO", "FI"]},
    "target_country_code": {"enum": ["SE", "DK", "NO", "FI"]},
    "cross_border": {"type": "boolean"},
    "shared_location": {
      "type": "boolean",
      "description": "True only for distinct governed sites with identical validated coordinates and zero computed distance; same-site pairs are refused before candidate emission."
    },
    "resolution": {"enum": ["whole_pollen", "ecological_group", "ecological_subgroup", "ecological_role", "taxon"]},
    "feature_key": {"type": "string", "pattern": "^(whole|group|subgroup|role|taxon):.+$"},
    "distance_km_unrounded": {
      "type": "number",
      "minimum": 0,
      "description": "Full numeric result returned by the pinned distance implementation, persisted with round-trip-safe serialization and never rounded for eligibility."
    },
    "distance_km_display": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.001,
      "description": "Display-only value rounded to 0.001 km; never used for eligibility."
    },
    "distance_algorithm": {"const": "WGS84 inverse geodesic"},
    "distance_library": {"type": "string", "minLength": 1},
    "distance_library_version": {"type": "string", "minLength": 1},
    "minimum_lag_years": {"type": ["number", "null"]},
    "maximum_lag_years": {"type": ["number", "null"]},
    "candidate_status": {
      "enum": [
        "definite_candidate",
        "possible_candidate",
        "indeterminate_order",
        "unresolved",
        "excluded_spatial",
        "excluded_temporal_nonpositive",
        "excluded_temporal_too_large"
      ]
    },
    "reason_code": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "threshold_profile_id": {"type": "string", "minLength": 1},
    "temporal_contract_version": {"type": "string", "minLength": 1},
    "classification_contract_version": {"type": ["string", "null"]},
    "propagation_contract_version": {"type": "string", "minLength": 1},
    "event_manifest_digest": {"type": "string", "minLength": 1},
    "config_digest": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "map_geometry_role": {"const": "endpoint_connection_only"},
    "directional_arrow_allowed": {"type": "boolean"},
    "route_interpretation_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate_status": {"enum": ["definite_candidate", "possible_candidate", "indeterminate_order", "excluded_temporal_nonpositive", "excluded_temporal_too_large"]}}, "required": ["candidate_status"]},
      "then": {
        "properties": {
          "minimum_lag_years": {"type": "number"},
          "maximum_lag_years": {"type": "number"}
        }
      }
    },
    {
      "if": {"properties": {"candidate_status": {"enum": ["definite_candidate", "possible_candidate"]}}, "required": ["candidate_status"]},
      "then": {
        "properties": {
          "directional_arrow_allowed": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"candidate_status": {"enum": ["indeterminate_order", "unresolved", "excluded_spatial", "excluded_temporal_nonpositive", "excluded_temporal_too_large"]}}, "required": ["candidate_status"]},
      "then": {
        "properties": {
          "directional_arrow_allowed": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "whole_pollen"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^whole:.+$"}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "ecological_group"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^group:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "ecological_subgroup"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^subgroup:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "ecological_role"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^role:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"resolution": {"const": "taxon"}}, "required": ["resolution"]},
      "then": {
        "properties": {
          "feature_key": {"type": "string", "pattern": "^taxon:.+$"},
          "classification_contract_version": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
