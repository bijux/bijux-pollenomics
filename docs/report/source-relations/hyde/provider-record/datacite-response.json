{"data":{"id":"10.24416/uu01-f45d44","type":"dois","attributes":{"doi":"10.24416/uu01-f45d44","prefix":"10.24416","suffix":"uu01-f45d44","identifiers":[],"alternateIdentifiers":[],"creators":[{"nameType":"Personal","givenName":"Kees","familyName":"Klein Goldewijk","affiliation":["Utrecht University"],"nameIdentifiers":[{"nameIdentifier":"https://orcid.org/0000-0003-2714-7507","nameIdentifierScheme":"ORCID"}]}],"titles":[{"title":"HYDE data for the Global Carbon Budget (2025)"}],"publisher":"Utrecht University","container":{},"publicationYear":2025,"subjects":[{"subject":"FOS: Earth and related environmental sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"land use","subjectScheme":"Keyword"},{"subject":"population","subjectScheme":"Keyword"},{"subject":"cropland","subjectScheme":"Keyword"},{"subject":"pasture","subjectScheme":"Keyword"}],"contributors":[{"name":"Beusen, Arthur","nameType":"Personal","affiliation":["pbl"],"contributorType":"DataManager","nameIdentifiers":[{"nameIdentifier":"https://orcid.org/0000-0003-0104-8615","nameIdentifierScheme":"ORCID"}]}],"dates":[{"date":"2025-06-11T11:42:01","dateType":"Issued"},{"date":"2026-09-28T13:11:36","dateType":"Updated"}],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Research Data","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1.0","rightsList":[{"rights":"Open - freely retrievable","rightsUri":"info:eu-repo/semantics/openAccess"},{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"This HYDE version 3.5 replaces former HYDE 3.4 version.\n\nThis database presents an update and expansion of the History Database of the Global Environment (HYDE, v 3.5). \nHYDE is and internally consistent combination of updated historical population estimates and land use. Categories include cropland, \nwith a new distinction into irrigated and rain fed crops (other than rice) and irrigated and rain fed rice. \nAlso grazing lands are provided, divided into more intensively used pasture, converted rangeland and non-converted natural (less intensively used) rangeland. \nPopulation is represented by maps of total, urban, rural population and population density as well as built-up area. \nThe period covered is 10,000 BCE to 2024 CE. Spatial resolution is 5 arc minutes (approx. 85 km2 at the equator), the files are in Arcmap asciigrid format.\n\nMajor updates include:\n•\tRadiocarbon data from the IMSET project (Marc Vander Linden, pers.comm.) providing new estimates for EurAsia of the onset of agriculture (timing and location, gridded maps)\n•\tImplementation of new archaeological expertise from the ArchaeoGlobe Project (Stephens et al, 2019), onset of agriculture (timing and location per region, outside EurAsia)\n•\tUse of satellite information on land cover from the European Space Agency (ESA) consortium for the spatial land use allocation on a yearly basis from 1992 – 2018.\n•\tUse of different remote sensing imagery (MODIS) and statistics (MapBiomas version C9) for Brazil for the 1985-2023 period, and for Indonesia (MB 3.0) for the 2000-2023 period, China for the 1900-2019 period.\n•       Update FAO data from 1961-2022 (2023-2025 extrapolated)\n•\tExtension of the database to year 2025\n•\tMore input on sub-national level for cropland and grazing land\n•\tnetCDF added as output format","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://public.yoda.uu.nl/geo/UU01/F45D44.html","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":1,"citationsOverTime":[{"year":"2026","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-06-11T09:42:02.000Z","registered":"2025-06-11T09:42:03.000Z","published":"2025","updated":"2026-09-28T11:12:11.000Z"},"relationships":{"client":{"data":{"id":"delft.uu","type":"clients"}},"provider":{"data":{"id":"pzax","type":"providers"}},"media":{"data":{"id":"10.24416/uu01-f45d44","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.1038/s41467-026-73051-x","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}